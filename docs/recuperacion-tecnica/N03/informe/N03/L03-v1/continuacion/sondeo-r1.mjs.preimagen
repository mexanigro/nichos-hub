import fs from 'node:fs';import vm from 'node:vm';import assert from 'node:assert/strict';import crypto from 'node:crypto';import {createRequire} from 'node:module';
const req=createRequire('/deps/package.json'),ts=req('typescript');
const fixture=await import('/d05/fixture-recorridos.mjs');
const rows=[],ui=[],fidelity=[];
const hash=s=>crypto.createHash('sha256').update(s).digest('hex');
function fn(file,name){const source=fs.readFileSync(file,'utf8'),tree=ts.createSourceFile(file,source,ts.ScriptTarget.Latest,true,file.endsWith('tsx')?ts.ScriptKind.TSX:ts.ScriptKind.TS);let found=[];function visit(n){if(ts.isFunctionDeclaration(n)&&n.name?.text===name)found.push(n.getText(tree));ts.forEachChild(n,visit);}visit(tree);assert.equal(found.length,1,name);return found[0];}
const transpile=s=>ts.transpileModule(s,{compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.CommonJS,jsx:ts.JsxEmit.ReactJSX}}).outputText;
function mod(file,requires){const module={exports:{}};new Function('require','module','exports','process',transpile(fs.readFileSync(file,'utf8')))(requires,module,module.exports,{env:{AGENT_ENABLED:'true'}});return module.exports;}
const channels=mod('/template/src/lib/notification-channels.ts',()=>{throw Error('Unexpected import')});
const optional=mod('/template/src/lib/api/optional-services.ts',()=>channels);
const events=['booking_confirmation_customer','cancellation_customer','reschedule_customer','new_lead_owner','new_booking_owner'];
const flags=['enabled','bookingAlerts','contactInquiries'],values=[undefined,false,true];
for(const runtime of ['server','api']){
 const relative=runtime==='server'?'server.ts':'api/index.ts';const source=fn('/template/'+relative,'getChannelConfig');const prior=fn('/d05/copia/'+relative,'getChannelConfig');assert.equal(source,prior);fidelity.push({runtime,function:'getChannelConfig',sha256:hash(source),identicalToD05:true});
 function selector(agent,record){let reads=0;const context={isOptionalServiceEnabled:()=>agent,baseNotificationChannels:optional.baseNotificationChannels,channelConfigCache:null,CHANNEL_CONFIG_TTL_MS:60000,CLIENT_ID:'tenant-control',DEFAULT_CHANNEL_CONFIG:channels.DEFAULT_CHANNEL_CONFIG,resolveChannelConfig:channels.resolveChannelConfig,getAdminDb:async()=>{reads++;return fixture.getFirestore();},firestoreRestGetDocument:async(collection,id)=>{reads++;assert.equal(collection,'config');assert.equal(id,'tenant-control');const n=record.notifications;return {fields:{notifications:{mapValue:{fields:{...Object.fromEntries(flags.filter(k=>n[k]!==undefined).map(k=>[k,{booleanValue:n[k]}])),channels:{mapValue:{fields:Object.fromEntries(Object.entries(n.channels||{}).map(([k,v])=>[k,{stringValue:v}]))}}}}}};}};vm.createContext(context);vm.runInContext(transpile(source)+';globalThis.select=getChannelConfig',context);return {select:context.select,reads:()=>reads};}
 for(const agent of [false,true])for(const enabled of values)for(const bookingAlerts of values)for(const contactInquiries of values){const notifications={channels:{new_lead_owner:'both',new_booking_owner:'both'}};for(const [k,v] of Object.entries({enabled,bookingAlerts,contactInquiries}))if(v!==undefined)notifications[k]=v;const record={notifications};fixture.writeRecord('config/tenant-control',record);const s=selector(agent,record),result=await s.select();const actual=Object.fromEntries(events.map(e=>[e,result[e]]));const expected=Object.fromEntries(events.map(e=>[e,agent?(e.endsWith('_owner')?'both':'whatsapp'):'email']));assert.deepEqual(actual,expected);assert.equal(s.reads(),agent?1:0);rows.push({runtime,agent,flags:Object.fromEntries(flags.map(k=>[k,notifications[k]??'absent'])),actual,configReads:s.reads()});}
 // Positivo de sensibilidad: cambiar canales sí cambia el selector con agente habilitado.
 for(const agent of [false,true]){const record={notifications:{enabled:false,bookingAlerts:false,contactInquiries:false,channels:Object.fromEntries(events.map(e=>[e,'email']))}};fixture.writeRecord('config/tenant-control',record);const s=selector(agent,record),r=await s.select();assert.ok(events.every(e=>r[e]==='email'));rows.push({runtime,agent,positive:'channels=email',actual:Object.fromEntries(events.map(e=>[e,r[e]]))});}
}
const file='/hub/src/components/client-config-tab.tsx';const update=fn(file,'updateNested'),toggle=fn(file,'ToggleField'),save=fn(file,'handleConfirmedSave');
for(const flag of flags)for(const value of values){const seed={notifications:{channels:{new_lead_owner:'both'},keep:'sibling'},outside:1};if(value!==undefined)seed.notifications[flag]=value;let sent,errors=[];
 const source=`let config=seed;const clientId='tenant-control',originalConfigRef={current:{}};const setConfig=f=>{config=f(config)};const setSaving=()=>{},setWarning=()=>{},setIssues=()=>{},setSaved=()=>{},setIsNew=()=>{},setDiffModalOpen=()=>{},onSaved=()=>{};${update}\n${toggle}\n${save}\n async function run(){const button=ToggleField({label:'synthetic',path:'notifications.${flag}',value:config.notifications.${flag},onChange:updateNested});button.props.onClick();await handleConfirmedSave();return config;}`;
 const c={seed,require:req,exports:{},setTimeout:()=>0,setError:e=>errors.push(e),fetch:async(url,options)=>{sent={url,method:options.method,body:JSON.parse(options.body)};return {ok:true,json:async()=>({})};}};vm.createContext(c);vm.runInContext(transpile(source)+';globalThis.run=run',c);await c.run();assert.equal(sent.method,'PUT');assert.equal(sent.url,'/api/config/tenant-control');assert.equal(sent.body.notifications[flag],!(value??false));assert.equal(sent.body.notifications.keep,'sibling');assert.equal(sent.body.notifications.channels.new_lead_owner,'both');assert.ok(errors.every(e=>e===''));ui.push({flag,before:value??'absent',payload:sent.body});
}
fs.writeFileSync('/salida/RESULTADO.json',JSON.stringify({result:'PASS_CARACTERIZACION',matrixCases:108,channelControls:4,uiCases:9,rows,ui,fidelity,limits:'Funciones reales extraídas; frontera config de fixture D05; no nueva corrida HTTP/envío/DB real. Recorridos D05 aceptados reutilizados.'},null,2));console.log(JSON.stringify({result:'PASS',matrix:108,positiveChannels:4,ui:9}));
