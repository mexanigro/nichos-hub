const fs=require('fs'),p=require('path'),crypto=require('crypto'),assert=require('assert/strict');
const base=__dirname,canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',hub='C:/Users/liama/Desktop/Nichos-hub',archive=hub+'/docs/recuperacion-tecnica/N03';
const read=f=>JSON.parse(fs.readFileSync(f,'utf8').replace(/^\uFEFF/,'')),sha=f=>crypto.createHash('sha256').update(fs.readFileSync(f)).digest('hex');
function fresh(f,data){assert.ok(!fs.existsSync(f));fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,data);}
const json=(f,data)=>fresh(f,JSON.stringify(data,null,2)+'\n');
const product=read(canon+'/informe/N03/L02-client-info-v1/aceptacion-local/PRODUCTO-ANTES.json');for(const f of product)assert.equal(sha(hub+'/'+f.ruta),f.sha256);
for(const f of read(p.dirname(base)+'/FUENTES.json'))assert.equal(sha(f.ruta),f.sha256);
assert.equal(read(base+'/resultados-r2/EXIT.json').exit,0);const result=read(base+'/resultados-r2/RESULTADO.json');assert.equal(result.matrixCases,108);assert.equal(result.uiCases,9);assert.ok(result.fidelity.every(f=>f.identicalToD05));
const files=['informe/N03/cierre-sesion-v1/RETOMA.md','informe/N03/reconciliacion-v1/BALANCE.md','informe/N03/reconciliacion-v1/SIGUIENTE-ACCION.md','indice/tareas/N03.md','indice/README.md','indice/CALENDARIO.md'];
const planned=files.map(r=>{assert.equal(sha(canon+'/'+r),sha(archive+'/'+r));const old=fs.readFileSync(canon+'/'+r,'utf8'),link=p.relative(p.dirname(canon+'/'+r),base+'/INFORME.md').replaceAll('\\','/'),proposal=p.relative(p.dirname(canon+'/'+r),base+'/PROPUESTA.md').replaceAll('\\','/');const text='**L03: preparación completada4/4, para revisión; NO descontada.** Liam decidió conservar D05: cinco emails base sin agente aunque toggles apagados.108casos de selectores reales,2controles de sensibilidad/2invariancia y9UI→payload: los tres toggles cambian datos del editor pero no esos cinco canales. Propuesta mínima: ocultar los tres interruptores y explicar la política, sin agregar comportamiento ni tocar datos/backend. No implementado. Esta adenda resuelve la decisión pendiente de cortes inferiores. N03 abierta y entregas aceptadas intactas;techo85%TOTAL observado84%,sin resets,instalaciones,externos,push/deploy. Etapas posteriores y condición por tenant conservadas. [Evidencia/límites]('+link+'). [Propuesta]('+proposal+').\n\n';const end=old.indexOf('\n');return {r,data:old.slice(0,end+1)+'\n'+text+old.slice(end+1)};});
const custody=[];for(const f of planned)for(const [label,dir] of [['canon',canon],['archivo',archive]]){const file=dir+'/'+f.r,backup=base+'/preimagenes/'+label+'/'+f.r;fresh(backup,fs.readFileSync(file));fs.writeFileSync(file,f.data);custody.push({ruta:file,preimagen:backup,antes:sha(backup),despues:sha(file)});}
json(base+'/CUSTODIA.json',custody);
const history='historial/2026-09-10-N03-L03-preparacion.md';const entry='# N03 — L03 preparada para revisión\n\nLiam mantuvo D05 y negó supresión de cinco emails base. Matriz acotada108+4controles y9UI→PUT modelado; tres flags sin efecto observado en cinco selectores de eventos. Propuesta: ocultar3interruptores y nota fiel, sin implementar ni descontarL03. [Informe](../informe/N03/L03-v1/continuacion/INFORME.md). Producto conservado;N03 abierta,techo85%TOTAL observado84%,sin resets/externos/push/deploy. Etapas posteriores y condición por tenant conservadas.\n';fresh(canon+'/'+history,entry);fresh(archive+'/'+history,entry);
for(const f of product)assert.equal(sha(hub+'/'+f.ruta),f.sha256);
json(base+'/RESULTADO-FINAL.json',{result:'GREEN_PREPARACION',gates:4,total:4,srcPreservados:product.length,L03Descontada:false,productoModificado:false,N03:'ABIERTA',consumo:84,techo:85,resets:0,matriz:108,sensibilidad:2,invariancia:2,ui:9,blockers:[],remaining:'Revisión de la propuesta; implementación no autorizada'});
const walk=dir=>fs.readdirSync(dir,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(p.join(dir,e.name)):[p.join(dir,e.name)]);
json(base+'/EVIDENCIA.json',walk(base).map(f=>({ruta:f,sha256:sha(f)})));
const map=[];for(const file of walk(base)){let suffix=p.relative(base,file).replaceAll('\\','/');if(/\.(mjs|cjs|js|ts|ps1)$/.test(suffix))suffix+='.source';const dest=archive+'/informe/N03/L03-v1/continuacion/'+suffix;fresh(dest,fs.readFileSync(file));assert.equal(sha(file),sha(dest));map.push({origen:file,destino:dest,sha256:sha(file)});}json(base+'/ARCHIVO.json',map);
console.log(JSON.stringify({result:'GREEN_PREPARACION',gates:'4/4',registros:custody.length,archivados:map.length,productoPreservado:product.length}));
