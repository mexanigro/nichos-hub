const fs=require('fs'),p=require('path'),crypto=require('crypto'),assert=require('assert/strict');
const base=__dirname,canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',hub='C:/Users/liama/Desktop/Nichos-hub',archive=hub+'/docs/recuperacion-tecnica/N03',template='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main';
const sha=file=>crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex');
const read=file=>JSON.parse(fs.readFileSync(file,'utf8').replace(/^\uFEFF/,''));
function fresh(file,data){assert.ok(!fs.existsSync(file));fs.mkdirSync(p.dirname(file),{recursive:true});fs.writeFileSync(file,data);}
const json=(file,data)=>fresh(file,JSON.stringify(data,null,2)+'\n');
const files=[hub+'/src/components/client-config-tab.tsx',template+'/server.ts',template+'/api/index.ts',template+'/src/lib/api/optional-services.ts',...['FREEZE.md','CONTINUACION-APROBADA.md','ACEPTACION.md','INFORME.md','runner-matriz.mjs','runner-recorridos.mjs'].map(f=>canon+'/informe/N03/D05-v1/'+f)];
json(base+'/FUENTES.json',files.map(file=>({ruta:file,sha256:sha(file)})));
const src=read(canon+'/informe/N03/L02-client-info-v1/aceptacion-local/PRODUCTO-ANTES.json');for(const f of src)assert.equal(sha(hub+'/'+f.ruta),f.sha256);
fresh(base+'/REFUTACION.md','# Contraste independiente acotado\n\n/root/refutacion_wnext (Newton) leyó editor y FREEZE D05. Confirmó ambigüedad de promesa frente a política aceptada, no defecto funcional demostrado. Mantener PENDIENTE_DECISION sin nuevo oráculo de supresión ni pruebas ampliadas. No ejecutó instrumentos ni cambió producto. Esta revisión interna no sustituye decisión de Liam.\n');
const records=['informe/N03/cierre-sesion-v1/RETOMA.md','informe/N03/reconciliacion-v1/BALANCE.md','informe/N03/reconciliacion-v1/SIGUIENTE-ACCION.md','indice/tareas/N03.md','indice/README.md','indice/CALENDARIO.md'];
const pending=records.map(r=>{assert.equal(sha(canon+'/'+r),sha(archive+'/'+r));const old=fs.readFileSync(canon+'/'+r,'utf8');const link=p.relative(p.dirname(canon+'/'+r),base+'/DECISION-PENDIENTE.md').replaceAll('\\','/');const note='**L03: preparación autorizada, detenida en P0 por decisión de alcance pendiente.** Los toggles visibles son generales; D05 aceptado conserva cinco avisos base por email antes de preferencias sin agente. No hay defecto funcional nuevo demostrado. Liam debe decidir si se conserva esa excepción o autoriza revisar su supresión antes de fijar expectativas/ampliar pruebas. Matriz no ejecutada, sin reparación propuesta ni producto modificado. L02POSTclient-info y demás entregas aceptadas conservadas; L03 no descontada y N03 abierta. Techo85% TOTAL,observado83%,sin resets,instalaciones,externos,push/deploy. Etapas posteriores y condición por tenant antes del despliegue vigentes. [Punto concreto y evidencia]('+link+'). Esta adenda sustituye sólo la propuesta L03 aún no autorizada de los cortes inferiores.\n\n';const end=old.indexOf('\n');return {r,body:old.slice(0,end+1)+'\n'+note+old.slice(end+1)};});
const custody=[];for(const f of pending)for(const [name,dir] of [['canon',canon],['archivo',archive]]){const file=dir+'/'+f.r,backup=base+'/preimagenes/'+name+'/'+f.r;fresh(backup,fs.readFileSync(file));fs.writeFileSync(file,f.body);custody.push({ruta:file,preimagen:backup,antes:sha(backup),despues:sha(file)});}
json(base+'/CUSTODIA.json',custody);
const history='historial/2026-09-10-N03-L03-decision-pendiente.md',body='# N03 — L03 en decisión previa\n\nPreparación autorizada. Contraste previo identificó ambigüedad labels generales vs emailbaseD05 sinagente. Decisión solicitada antes de ampliar pruebas/fijarexpectativas. [Evidencia](../informe/N03/L03-v1/DECISION-PENDIENTE.md). P0 pendiente,0/4,preparaciónRED; sin producto/ejecución de matriz. D05/L02 yentregas aceptadas intactas. N03 abierta,techo85% TOTAL observado83%,sin resets/externos/push/deploy;etapas posteriores ycondición por tenant vigentes.\n';fresh(canon+'/'+history,body);fresh(archive+'/'+history,body);
for(const f of src)assert.equal(sha(hub+'/'+f.ruta),f.sha256);for(const f of read(base+'/FUENTES.json'))assert.equal(sha(f.ruta),f.sha256);
json(base+'/RESULTADO.json',{result:'RED',gates:0,total:4,gate:'P0',state:'PENDIENTE_DECISION',blocker:'Alcance de toggles frente a email base D05 sin agente',functionalDefectProven:false,newTests:false,productChanged:false,srcPreserved:src.length,N03:'ABIERTA',consumo:83,techo:85,resets:0});
const walk=dir=>fs.readdirSync(dir,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(p.join(dir,e.name)):[p.join(dir,e.name)]);
const map=[];for(const file of walk(base)){let suffix=p.relative(base,file).replaceAll('\\','/');if(/\.(cjs|ts|js|ps1)$/.test(suffix))suffix+='.source';const dest=archive+'/informe/N03/L03-v1/'+suffix;fresh(dest,fs.readFileSync(file));assert.equal(sha(dest),sha(file));map.push({origen:file,destino:dest,sha256:sha(file)});}json(base+'/ARCHIVO.json',map);
console.log(JSON.stringify({result:'RED_PENDIENTE_DECISION',gate:'P0',productPreserved:src.length,records:custody.length,archived:map.length}));
