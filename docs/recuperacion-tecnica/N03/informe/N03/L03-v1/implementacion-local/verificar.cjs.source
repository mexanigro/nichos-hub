const fs=require('node:fs'),p=require('node:path'),crypto=require('node:crypto'),assert=require('node:assert/strict'),cp=require('node:child_process');
const base=__dirname,hub='C:/Users/liama/Desktop/Nichos-hub',scope='src/components/client-config-tab.tsx';
const hash=b=>crypto.createHash('sha256').update(b).digest('hex');
const json=f=>JSON.parse(fs.readFileSync(f,'utf8').replace(/^\uFEFF/,''));
const guardar=(f,x)=>fs.writeFileSync(p.join(base,f),typeof x==='string'?x:JSON.stringify(x,null,2),{flag:'wx'});
const antes=json(p.join(base,'PRODUCTO-ANTES.json'));
const walk=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(p.join(d,e.name)):[p.join(d,e.name)]);
const actuales=walk(p.join(hub,'src')).map(f=>p.relative(hub,f).replaceAll('\\','/')).sort();
assert.deepEqual(actuales,antes.map(f=>f.ruta.replaceAll('\\','/')).sort());
const changes=antes.filter(f=>hash(fs.readFileSync(p.join(hub,f.ruta)))!==f.sha256);
assert.deepEqual(changes.map(f=>f.ruta.replaceAll('\\','/')),[scope]);
assert.deepEqual(fs.readFileSync(p.join(hub,scope)),fs.readFileSync(p.join(base,'copias/final.tsx')));
assert.deepEqual(fs.readFileSync(p.join(hub,'tsconfig.json')),fs.readFileSync(p.join(base,'preimagenes/tsconfig.json')));
const freeze=json(p.join(base,'FREEZE.json'));
for(const f of freeze.files)assert.equal(hash(fs.readFileSync(p.join(base,f.ruta))),f.sha256,f.ruta);
const previous=json(p.join(base,'../continuacion/EVIDENCIA.json'));
for(const f of previous)assert.equal(hash(fs.readFileSync(f.ruta)),f.sha256,f.ruta);
const sources=json(p.join(base,'../FUENTES.json')).filter(f=>f.ruta!==hub+'/'+scope);
for(const f of sources)assert.equal(hash(fs.readFileSync(f.ruta)),f.sha256,f.ruta);
const green=json(p.join(base,'resultados/green/RESULTADO.json')),mut=json(p.join(base,'resultados/mutante/RESULTADO.json'));
assert.equal(green.result,'GREEN');assert.equal(green.failures.length,0);assert.equal(green.renderCases,29);assert.equal(green.saveCases,29);
assert.equal(mut.result,'RED');assert.equal(mut.failures.length,112);assert.equal(mut.saveCases,29);
assert.ok(mut.failures.every(f=>f.name.includes('sin control')||f.name.includes('solo boton seccion')));
assert.deepEqual(mut.saves,green.saves);
assert.equal(json(p.join(base,'TIPOS.json')).exit,0);assert.equal(json(p.join(base,'LINT-COMPARATIVO.json')).nuevos,0);
const head=cp.execFileSync('git',['rev-parse','HEAD'],{cwd:hub,encoding:'utf8'}).trim();assert.equal(head,fs.readFileSync(p.join(base,'HEAD.txt'),'utf8').trim());
guardar('CAMBIO.diff',cp.execFileSync('git',['diff','--',scope],{cwd:hub,encoding:'utf8'}));
guardar('GIT-STATUS-FINAL.txt',cp.execFileSync('git',['status','--short'],{cwd:hub,encoding:'utf8'}));
const method='C:/Users/liama/Documents/ChatGPT/Test ML/tester-mercado-libre/metodo/METODO.md';
assert.equal(hash(fs.readFileSync(method)),'f090f5f8e5429bc7fcb74d187e105a14e3d1153d37d40b9036436b0e885b0c7d');
guardar('CONSERVACION.json',{result:'PASS',utc:new Date().toISOString(),head,archivosSrc:antes.length,conservados:antes.length-1,cambiados:[scope],fuentesD05TemplateConservadas:sources.length,evidenciasPreparacionConservadas:previous.length,contratoCongeladoConservado:true,tsconfigConservado:true,mutacionSoloControles:true,guardadosIdenticosEnMutante:true,metodo:{ruta:method,sha256:hash(fs.readFileSync(method))},limite:'Hash fuente no sustituye prueba de producción ni certifica dependencias externas'});
console.log(JSON.stringify({result:'PASS',src:antes.length,conservados:antes.length-1,fuentes:sources.length,evidencias:previous.length}));
