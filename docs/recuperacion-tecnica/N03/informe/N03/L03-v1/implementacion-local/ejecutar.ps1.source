param([string]$Etapa,[string]$Source)
$ErrorActionPreference='Stop';$base=$PSScriptRoot;$out=Join-Path $base "resultados/$Etapa"
if(Test-Path $out){throw 'No sobrescribir resultado'}
New-Item -ItemType Directory $out | Out-Null
$argsDocker=@('run','--rm','--pull=never','--network=none','--read-only','--cap-drop=ALL','--security-opt=no-new-privileges','--memory=1g','--user=65534:65534','--tmpfs=/tmp:rw,size=64m','--mount',"type=bind,source=$base,target=/control,readonly",'--mount',"type=bind,source=$out,target=/salida",'--mount','type=bind,source=C:\Users\liama\Desktop\Nichos-hub\node_modules,target=/deps/node_modules,readonly','sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2','/usr/bin/env','-i','PATH=/usr/local/bin:/usr/bin:/bin','HOME=/tmp',"SOURCE=$Source",'node','/control/contrato.mjs')
$argsDocker | ConvertTo-Json | Set-Content -Encoding utf8 "$out/COMANDO.json"
& docker @argsDocker 1> "$out/stdout.txt" 2> "$out/stderr.txt"
$code=$LASTEXITCODE
@{exit=$code;source=$Source;sha256=(Get-FileHash "$base/copias/$Source").Hash.ToLower();utc=[DateTime]::UtcNow.ToString('o')} | ConvertTo-Json | Set-Content -Encoding utf8 "$out/EXIT.json"
Get-Content "$out/stdout.txt","$out/stderr.txt"
exit $code
