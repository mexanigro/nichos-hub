const fs = require('node:fs'), path = require('node:path'), crypto = require('node:crypto'), assert = require('node:assert/strict');
const base = __dirname, hub = 'C:/Users/liama/Desktop/Nichos-hub';
const hash = b => crypto.createHash('sha256').update(b).digest('hex');
const guardar = (p, b) => fs.writeFileSync(path.join(base, p), typeof b === 'string' || Buffer.isBuffer(b) ? b : JSON.stringify(b, null, 2), {flag:'wx'});
const leerJson = p => JSON.parse(fs.readFileSync(path.join(base,p),'utf8').replace(/^\uFEFF/,''));
const archivo = hub+'/src/components/client-config-tab.tsx';
const basal = fs.readFileSync(archivo);
assert.deepEqual(basal, fs.readFileSync(path.join(base,'copias/basal.tsx')));
for(const f of leerJson('PRODUCTO-ANTES.json')) assert.equal(hash(fs.readFileSync(path.join(hub,f.ruta))), f.sha256, f.ruta);
const red = leerJson('resultados/red-congelar/RESULTADO.json');
assert.equal(red.result,'RED'); assert.equal(red.renderCases,29); assert.equal(red.saveCases,29); assert.equal(red.failures.length,140);
const frozen = ['CONTRATO.md','contrato.mjs','ejecutar.ps1','copias/basal.tsx','PRODUCTO-ANTES.json','resultados/red-congelar/RESULTADO.json','resultados/red-congelar/EXIT.json'].map(ruta=>({ruta,sha256:hash(fs.readFileSync(path.join(base,ruta)))}));
guardar('FREEZE.json',{utc:new Date().toISOString(),gate:'P0',result:'RED_VALIDO',blockers:[],scope:['src/components/client-config-tab.tsx'],techoTotalN03:90,reservaN04:10,resets:false,files:frozen});
const text = basal.toString('utf8');
const expresion = /^        <ToggleField label="Notificaciones habilitadas"[^\r\n]+\r?\n        <ToggleField label="Alertas de reserva"[^\r\n]+\r?\n        <ToggleField label="Consultas de contacto"[^\r\n]+\r?\n/gm;
const matches = [...text.matchAll(expresion)]; assert.equal(matches.length,1);
const old = matches[0][0], at=matches[0].index, nl=old.includes('\r\n')?'\r\n':'\n';
const note = '        <p className="text-xs text-text-muted">'+nl+'          Sin agente, los avisos base de contacto y reservas usan email. Con agente, usan los canales configurados.'+nl+'        </p>'+nl;
const prefix=Buffer.from(text.slice(0,at)), suffix=Buffer.from(text.slice(at+old.length));
assert.deepEqual(Buffer.concat([prefix,Buffer.from(old),suffix]),basal);
const final = Buffer.concat([prefix,Buffer.from(note),suffix]);
guardar('preimagenes/client-config-tab.tsx',basal);guardar('bloque-anterior.txt',old);guardar('bloque-final.txt',note);
fs.writeFileSync(archivo,final);
assert.deepEqual(fs.readFileSync(archivo),final);
guardar('copias/final.tsx',final);
guardar('copias/mutante.tsx',Buffer.concat([prefix,Buffer.from(old),Buffer.from(note),suffix]));
guardar('P1.json',{utc:new Date().toISOString(),result:'PASS',before:hash(basal),after:hash(final),prefixBytes:prefix.length,suffixBytes:suffix.length,bytesOutsideChangeEqual:true,mutation:'Restaurar tres ToggleField manteniendo la nota; copia aislada, producto final intacto'});
const previo='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica/informe/N03/L02-client-info-v1/implementacion-local/tipos-lint.cjs';
guardar('tipos-lint.cjs',fs.readFileSync(previo,'utf8').replaceAll('src/app/api/onboarding/client-info/route.ts','src/components/client-config-tab.tsx'));
guardar('tsconfig-pertinente.json',{extends:hub+'/tsconfig.json',compilerOptions:{incremental:false},include:[hub+'/next-env.d.ts',archivo],exclude:[hub+'/node_modules']});
console.log(JSON.stringify({P0:'RED congelado',P1:'PASS',before:hash(basal),after:hash(final)}));
