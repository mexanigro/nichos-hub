const fs=require('fs'),p=require('path');
const d=__dirname;
const backup=p.join(d,'preimagenes','matriz-01');fs.mkdirSync(backup);
for(const f of ['fixture-recorridos.mjs','preload-recorridos.mjs'])fs.copyFileSync(p.join(d,f),p.join(backup,f));
let f=fs.readFileSync(p.join(d,'fixture-recorridos.mjs'),'utf8');
f=f.replace("let sequence=0;",`records.set('admin_users/owner@example.invalid',{clientId:'tenant-control',role:'owner',status:'active'});
records.set('admin_users/foreign@example.invalid',{clientId:'other-tenant',role:'owner',status:'active'});
records.set('config/tenant-control',{notifications:{channels:{new_lead_owner:'both',new_booking_owner:'both'}}});
export function readRecord(path){return records.get(path);}
export function writeRecord(path,data){records.set(path,data);event('write',{path,data});}
let sequence=0;`);
fs.writeFileSync(p.join(d,'fixture-recorridos.mjs'),f);
let preload=fs.readFileSync(p.join(d,'preload-recorridos.mjs'),'utf8');
preload=preload.replace("import fs from 'node:fs';","import fs from 'node:fs';\nimport {readRecord,writeRecord} from './fixture-recorridos.mjs';");
preload=preload.replace("if(u.hostname==='api.resend.com'){",`const record=(kind,data={})=>fs.appendFileSync(process.env.D05_EVENTS,JSON.stringify({kind,...data})+'\\n');
 if(u.hostname==='www.googleapis.com')return Response.json({fixture:fs.readFileSync('/tmp/public.pem','utf8')},{headers:{'cache-control':'max-age=3600'}});
 if(u.hostname==='oauth2.googleapis.com')return Response.json({access_token:'synthetic-access',expires_in:3600});
 if(u.hostname==='firestore.googleapis.com'){
  const path=decodeURIComponent(u.pathname.split('/documents/')[1]||'');
  const encode=v=>typeof v==='string'?{stringValue:v}:typeof v==='number'?{integerValue:String(v)}:v&&typeof v==='object'?{mapValue:{fields:Object.fromEntries(Object.entries(v).map(([k,x])=>[k,encode(x)]))}}:{nullValue:null};
  if(options.method==='POST'){const body=JSON.parse(options.body||'{}');record('rest-write',{path});return Response.json({name:path+'/rest-control',...body});}
  const data=readRecord(path);return data?Response.json({fields:Object.fromEntries(Object.entries(data).map(([k,v])=>[k,encode(v)]))}):Response.json({error:'missing'},{status:404});
 }
 if(u.hostname==='generativelanguage.googleapis.com'){record('ai');return Response.json({candidates:[{content:{parts:[{text:'Respuesta controlada'}]}}]});}
 if(u.hostname==='agent.invalid'){const body=JSON.parse(options.body||'{}');record('agent',{path:u.pathname,type:body.type,clientId:body.clientId});return Response.json({success:true});}
 if(u.hostname==='api.resend.com'){
 `);
fs.writeFileSync(p.join(d,'preload-recorridos.mjs'),preload);
