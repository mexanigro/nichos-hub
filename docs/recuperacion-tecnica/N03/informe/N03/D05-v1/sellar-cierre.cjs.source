const fs=require('fs'),path=require('path'),crypto=require('crypto');const d=__dirname,r=path.resolve(d,'../../..');
const history=path.join(r,'historial/2026-09-09-N03-D05-cierre-local.md');const before=fs.readFileSync(history);const pre=path.join(d,'preimagenes/cierre-02');fs.mkdirSync(pre);fs.writeFileSync(path.join(pre,'historial.md'),before);
fs.writeFileSync(history,before.toString('utf8').replace(/\]\(([^)]+)\)/g,(full,url)=>url.startsWith('../')?full:'](../informe/N03/D05-v1/'+url+')'));
const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex').toUpperCase();const frozen=JSON.parse(fs.readFileSync(path.join(d,'CONTRATO-CONGELADO.json'),'utf8'));if(!frozen.every(e=>hash(path.join(d,e.path))===e.sha256))throw Error('contract drift');
const files=[path.join(d,'INFORME.md'),path.join(d,'REVISION-FINAL.md'),history,path.join(r,'indice/tareas/N03.md'),path.join(r,'indice/README.md'),path.join(r,'indice/PENDIENTES.md')];
const localLinks=[];for(const file of files.slice(0,3))for(const m of fs.readFileSync(file,'utf8').matchAll(/\]\(([^)]+)\)/g)){const target=path.resolve(path.dirname(file),m[1]);localLinks.push({from:path.relative(r,file),target:m[1],exists:fs.existsSync(target)});}if(localLinks.some(l=>!l.exists))throw Error(JSON.stringify(localLinks.filter(l=>!l.exists)));
const seal={result:'GREEN',task:'N03 D05 local',gates:4,total:4,contractUnchanged:true,checks:{runtime:222,health:21,parity:3,typesExit:0,audit:13,mutationExpectedFailures:18},previousDeliveriesPreserved:true,n03:'en_curso',deploymentCondition:'Evidence of tenants/services to retain and Liam decision on exceptions before deployment.',localLinks,records:files.map(file=>({path:path.relative(r,file),sha256:hash(file)})),historyPreimage:{path:'preimagenes/cierre-02/historial.md',sha256:hash(path.join(pre,'historial.md'))}};fs.writeFileSync(path.join(d,'SELLO-CIERRE.json'),JSON.stringify(seal,null,2));console.log(JSON.stringify({result:seal.result,gates:'4/4',links:localLinks.length,contractUnchanged:true}));
