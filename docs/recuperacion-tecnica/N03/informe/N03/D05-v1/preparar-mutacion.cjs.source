const fs=require('fs'),path=require('path'),crypto=require('crypto'),d=__dirname;const target=path.join(d,'copia-mutacion');if(fs.existsSync(target))throw Error('mutation exists');fs.cpSync(path.join(d,'copia'),target,{recursive:true});const file=path.join(target,'src/lib/api/optional-services.ts');const before=fs.readFileSync(file,'utf8'),anchor='return process.env[service === "ai" ? "AI_ENABLED" : "AGENT_ENABLED"] === "true";';if(!before.includes(anchor))throw Error('guard not found');fs.writeFileSync(file,before.replace(anchor,'return true; // Control desarmado sólo en copia aislada.'));
const runner=fs.readFileSync(path.join(d,'runner-matriz.mjs'),'utf8').replace('of scenarios){',"of scenarios.filter(s=>s[0]==='keys')){");if(!runner.includes("scenarios.filter"))throw Error('selection failed');fs.writeFileSync(path.join(d,'runner-mutacion.mjs'),runner);fs.writeFileSync(path.join(d,'MUTACION.json'),JSON.stringify({path:file,change:'only permission predicate -> true',before:crypto.createHash('sha256').update(before).digest('hex'),after:crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex')},null,2));
