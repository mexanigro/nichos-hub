import fs from 'node:fs';
import {spawn} from 'node:child_process';
import {createRequire} from 'node:module';
import vm from 'node:vm';
const require = createRequire('/app/package.json');
const ts = require('typescript');
const results=[];
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
function publicBody(r,status){return JSON.stringify(r.body)===JSON.stringify({status})&&!r.headers['x-client-id']&&!r.headers['x-powered-by'];}
function check(name, valid, evidence){results.push({name,valid,evidence});console.log(JSON.stringify(results.at(-1)));}
async function request(port,path='/api/health',headers={},method='GET'){const start=Date.now();const res=await fetch(`http://127.0.0.1:${port}${path}`,{headers,method,signal:AbortSignal.timeout(3500)});return {code:res.status,body:await res.json().catch(()=>({nonJson:true})),headers:Object.fromEntries(res.headers),ms:Date.now()-start};}
async function monitor(port,expected){let saved;const module={exports:{}};vm.runInNewContext(ts.transpileModule(fs.readFileSync('/control/monitor-apiCheck.ts','utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS}}).outputText,{module,exports:module.exports,console,require:name=>name.includes('db/client')?{db:{query:async(_sql,args)=>{saved=args;}}}:{fetchWithRetry:async url=>{const response=await fetch(url);return {response,statusCode:response.status,responseTimeMs:1};}}});const result=await module.exports.apiCheck({clientId:'monitor-control',url:`http://127.0.0.1:${port}`});return result.success===expected&&saved[3]===expected;}
async function run(runtime,scenario){const id=`${runtime}-${scenario}`,port=runtime==='server'?3000:3001;const modeFile=`/tmp/${id}-mode`,auditFile=`/tmp/${id}-audit`;fs.writeFileSync(modeFile,'ready');fs.writeFileSync(auditFile,'');fs.writeFileSync('/tmp/count-'+id,'');const env={PATH:process.env.PATH,HOME:'/tmp',TMPDIR:'/tmp',NODE_PATH:process.env.NODE_PATH,TSX_DISABLE_CACHE:'1',NODE_ENV:'production',CLIENT_ID:'tenant-control',FIREBASE_PROJECT_ID:'isolated',FIREBASE_ADMIN_PROJECT_ID:'isolated',FIREBASE_ADMIN_CLIENT_EMAIL:'fixture@example.invalid',FIREBASE_ADMIN_PRIVATE_KEY:'synthetic-fixture',HEALTH_MODE_FILE:modeFile,HEALTH_AUDIT_FILE:auditFile,HEALTH_COUNT_FILE:"/tmp/count-"+id};if(scenario!=='default'){env.API_RATE_LIMIT_MAX='3';env.API_RATE_LIMIT_WINDOW_MS='1000';}if(scenario==='failed')fs.writeFileSync(modeFile,'failed');if(scenario==='absent')delete env.FIREBASE_ADMIN_PRIVATE_KEY;if(scenario==='tenant-absent')delete env.CLIENT_ID;if(scenario==='early'||scenario==='late')env.HEALTH_BOOT_FAIL=scenario;
const child=spawn(process.execPath,['--import','/app/node_modules/tsx/dist/loader.mjs','--import','/control/preload.mjs',runtime==='server'?'/app/server.ts':'/control/api-worker.mjs'],{env,cwd:'/app'});let stdout='',stderr='';child.stdout.on('data',b=>stdout+=b);child.stderr.on('data',b=>stderr+=b);try{let listening=false;for(let i=0;i<450;i++){if(child.exitCode!==null)break;try{await request(port,'/api/live');listening=true;break;}catch{}await sleep(100);}check(`${id}: arranque efectivo`,listening,{exit:child.exitCode});if(!listening)return;

const blocked=['early','late','incomplete'].includes(scenario),expected=blocked||scenario==='failed'?503:200,max=scenario==='default'?60:3;
const count=()=>fs.readFileSync('/tmp/count-'+id,'utf8');
const ip={'x-forwarded-for':'198.51.100.1'},warm={'x-forwarded-for':'198.51.100.7'};
await request(port,'/api/health',warm);
let before=count();let liveOk=true;
for(let i=0;i<max+1;i++){const live=await request(port,'/api/live',ip);liveOk&&=live.code===200&&publicBody(live,'ok');}
check(id+': live sin cuota ni DB',liveOk&&before===count(),{unchanged:before===count(),calls:max+1});
before=count();const permitted=[];const started=Date.now();
for(let i=0;i<max;i++)permitted.push(await request(port,'/api/health',ip));
check(id+': permitidas',permitted.every(r=>r.code===expected&&publicBody(r,expected===200?'ok':'unavailable')),{codes:permitted.map(r=>r.code),elapsed:Date.now()-started});
check(id+': carga controlada',blocked?count()===before:count().slice(before.length).split('loader').length-1===max,{delta:count().slice(before.length)});
before=count();const excess=await request(port,'/api/health',ip),alias=await request(port,'/API/health',ip);
check(id+': exceso429 antes de DB',excess.code===429&&alias.code===429&&before===count()&&!excess.headers['x-client-id']&&!excess.headers['x-powered-by']&&excess.body.error==='Too many requests. Please try again shortly.',{codes:[excess.code,alias.code],delta:count().slice(before.length)});
const other=await request(port,'/api/health',{'x-forwarded-for':'198.51.100.2'});check(id+': IP independiente',other.code===expected,{code:other.code});
if(blocked){const guard=await request(port,'/api/tenant/status',ip);check(id+': guard funcional',guard.code===503,{code:guard.code});}
if(scenario==='configured'){
 await sleep(1100);const recovered=await request(port,'/api/health',ip);check(id+': ventana configurable',recovered.code===200,{code:recovered.code});
 const headIp={'x-forwarded-for':'198.51.100.3'};const first=await request(port,'/api/health',headIp,'HEAD');await request(port,'/api/health',headIp);await request(port,'/api/health',headIp);before=count();const last=await request(port,'/api/health',headIp,'HEAD');check(id+': HEAD comparte cuota',first.code===200&&last.code===429&&before===count(),{codes:[first.code,last.code],delta:count().slice(before.length)});
}
}catch(e){check(`${id}: ejecución`,false,String(e));}finally{child.kill('SIGTERM');for(let i=0;i<30&&child.exitCode===null&&child.signalCode===null;i++)await sleep(30);if(child.exitCode===null&&child.signalCode===null)child.kill('SIGKILL');await sleep(100);fs.writeFileSync(`/salida/${id}.stdout.txt`,stdout);fs.writeFileSync(`/salida/${id}.stderr.txt`,stderr);const audit=fs.readFileSync(auditFile,'utf8');check(`${id}: cero intentos externos`,audit.length===0,{audit});check(`${id}: proceso terminado`,child.exitCode!==null||child.signalCode!==null,{exit:child.exitCode,signal:child.signalCode});}}
const selection=process.argv[2];for(const runtime of ['server','api'])for(const scenario of selection==='red'||selection==='mutation'?['configured']:selection==='incomplete'?['incomplete']:['default','configured','failed','early','late'])await run(runtime,scenario);
const audit='/tmp/observer-audit';fs.writeFileSync(audit,'');const observer=spawn(process.execPath,['--import','/control/preload.mjs','-e',"fetch('https://outside.invalid').catch(()=>process.exit(0))"],{env:{PATH:process.env.PATH,NODE_PATH:process.env.NODE_PATH,HEALTH_AUDIT_FILE:audit}});await new Promise(r=>observer.on('exit',r));check('observador sensible',observer.exitCode===0&&fs.readFileSync(audit,'utf8').includes('fetch'),{exit:observer.exitCode,audit:fs.readFileSync(audit,'utf8')});
fs.writeFileSync('/salida/RESULTADOS.json',JSON.stringify(results,null,2));console.log(JSON.stringify({passed:results.filter(r=>r.valid).length,failed:results.filter(r=>!r.valid).length}));process.exitCode=results.every(r=>r.valid)?0:1;
