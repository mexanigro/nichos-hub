const fs=require('fs'),p=require('path'),d=__dirname,b=p.join(d,'preimagenes','refutacion-03');fs.mkdirSync(b);for(const f of ['runner-matriz.mjs','runner-recorridos.mjs'])fs.copyFileSync(p.join(d,f),p.join(b,f));
let matrix=fs.readFileSync(p.join(d,'runner-matriz.mjs'),'utf8');matrix=matrix.replace("const r=await request(path,{AI_ENABLED:true,type:'invalid'});", "const beforeAI=count('ai');const r=await request(path,{AI_ENABLED:true,type:'invalid'});");matrix=matrix.replace("ai==='true'?r.status>=400:r.status===503", "r.status===(ai==='true'&&(keys||path==='/api/ai/action')?400:503)&&count('ai')===beforeAI");fs.writeFileSync(p.join(d,'runner-matriz.mjs'),matrix);
let base=fs.readFileSync(p.join(d,'runner-recorridos.mjs'),'utf8');const start=base.indexOf('module.exports.notifyAppointmentBooked(appt);'),end=base.indexOf('  const before=events()',start);if(start<0||end<0)throw Error('anchor');
base=base.slice(0,start)+`for(const [method,subject] of [['notifyAppointmentBooked','Booking Confirmed'],['notifyAppointmentCancelled','Appointment Cancelled'],['notifyAppointmentRescheduled','Appointment Rescheduled']]){
   const before=events().filter(e=>e.kind==='email').length;
   if(method==='notifyAppointmentRescheduled')module.exports[method](appt,{...appt,time:'13:00'});else module.exports[method](appt);
   await sleep(100);await Promise.all(pending);await sleep(200);
   const fresh=events().filter(e=>e.kind==='email').slice(before);
   check(runtime+': consumidor '+method+' notifica destinatario y evento',fresh.length===1&&JSON.stringify(fresh[0].to).includes('customer@example.invalid')&&fresh[0].subject.startsWith(subject),fresh);
  }
`+base.slice(end);
base=base.replace("check(runtime+': callers cancel/reschedule conservan email disponible',(dashboard.match(/customerEmail: prev.customerEmail/g)||[]).length>=3,{});",`const tree=ts.createSourceFile('dashboard.tsx',dashboard,ts.ScriptTarget.Latest,true,ts.ScriptKind.TSX);let callers=[];function visit(n){if(ts.isCallExpression(n)&&['notifyAppointmentCancelled','notifyAppointmentRescheduled'].includes(n.expression.getText(tree))){const args=[...n.arguments].filter(ts.isObjectLiteralExpression);callers.push({name:n.expression.getText(tree),valid:args.length===(n.expression.getText(tree)==='notifyAppointmentCancelled'?1:2)&&args.every(a=>a.properties.some(prop=>ts.isPropertyAssignment(prop)&&prop.name.getText(tree)==='customerEmail'&&prop.initializer.getText(tree)==='prev.customerEmail'))});}ts.forEachChild(n,visit);}visit(tree);check(runtime+': callers cancel/reschedule conservan email en argumentos efectivos',callers.length===2&&callers.every(c=>c.valid),callers);
  check(runtime+': base sin intentos IA agente simulados',!events().some(e=>e.kind==='ai'||e.kind==='agent'),events().filter(e=>e.kind==='ai'||e.kind==='agent'));`);
fs.writeFileSync(p.join(d,'runner-recorridos.mjs'),base);
