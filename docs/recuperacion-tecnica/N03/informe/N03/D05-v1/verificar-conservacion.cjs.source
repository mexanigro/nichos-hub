const fs=require('fs'),path=require('path'),crypto=require('crypto');const root='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',d=__dirname;const ts=require(path.join(root,'node_modules/typescript'));
const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex').toUpperCase();
const changes=new Set(JSON.parse(fs.readFileSync(path.join(d,'CAMBIOS-P1.json'),'utf8')));const original=JSON.parse(fs.readFileSync(path.join(d,'FUENTES.json'),'utf8'));
const untouched=original.filter(e=>!changes.has(e.path)).map(e=>({path:e.path,valid:hash(path.join(root,e.path))===e.sha256}));
const allowed=new Set(['/api/ai/analyze','/api/ai/chat','/api/ai/action','/api/knowledge/upload','/api/notify-booking']);
function routes(text){const tree=ts.createSourceFile('runtime.ts',text,ts.ScriptTarget.Latest,true);const printer=ts.createPrinter({removeComments:true});const found=[];function visit(n){if(ts.isCallExpression(n)&&ts.isPropertyAccessExpression(n.expression)&&n.expression.expression.getText(tree)==='app'&&['get','post','put','delete','patch','use'].includes(n.expression.name.text)){const route=ts.isStringLiteral(n.arguments[0])?n.arguments[0].text:'<middleware>';found.push({name:n.expression.name.text+' '+route,route,text:printer.printNode(ts.EmitHint.Unspecified,n,tree)});}ts.forEachChild(n,visit);}visit(tree);return found;}
const routing=[];for(const file of ['server.ts','api/index.ts']){const old=routes(fs.readFileSync(path.join(d,'preimagenes/producto-01',file),'utf8')),now=routes(fs.readFileSync(path.join(root,file),'utf8'));routing.push({file,orderUnchanged:JSON.stringify(old.map(x=>x.name))===JSON.stringify(now.map(x=>x.name)),untouched:old.filter(x=>!allowed.has(x.route)).map(x=>({route:x.name,valid:now.some(n=>n.name===x.name&&n.text===x.text)}))});}
const frozen=JSON.parse(fs.readFileSync(path.join(d,'CONTRATO-CONGELADO.json'),'utf8')).map(e=>({path:e.path,valid:hash(path.join(d,e.path))===e.sha256}));
const result={untouched,routing,frozen,copy:[...changes].map(f=>({path:f,valid:hash(path.join(root,f))===hash(path.join(d,'copia',f))}))};const valid=untouched.every(x=>x.valid)&&routing.every(x=>x.orderUnchanged&&x.untouched.every(x=>x.valid))&&frozen.every(x=>x.valid)&&result.copy.every(x=>x.valid);
fs.writeFileSync(path.join(d,'CONSERVACION-P3.json'),JSON.stringify({valid,...result},null,2));console.log(JSON.stringify({valid,unchangedFiles:untouched.length,routes:routing.map(x=>({file:x.file,count:x.untouched.length,order:x.orderUnchanged}))}));process.exitCode=valid?0:1;
