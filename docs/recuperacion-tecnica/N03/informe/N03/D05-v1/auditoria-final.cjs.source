const fs=require('fs'),path=require('path'),crypto=require('crypto'),vm=require('vm');const d=__dirname,root='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',ts=require(path.join(root,'node_modules/typescript'));const checks=[];
const check=(name,valid,evidence)=>checks.push({name,valid,evidence});const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex').toUpperCase();
function walk(dir){return fs.readdirSync(dir,{withFileTypes:true}).flatMap(e=>e.name==='node_modules'?[]:e.isDirectory()?walk(path.join(dir,e.name)):[path.join(dir,e.name)]);}
const copy=walk(path.join(d,'copia')).map(file=>({path:path.relative(path.join(d,'copia'),file).replaceAll('\\','/'),valid:hash(file)===hash(path.join(root,path.relative(path.join(d,'copia'),file)))}));check('copia ejecutada igual a producto completo saneado',copy.every(e=>e.valid),{count:copy.length,drift:copy.filter(e=>!e.valid)});
for(const runtime of ['server','api']){const events=fs.readFileSync(path.join(d,'resultados/green-base-r1',runtime+'.events.jsonl'),'utf8').trim().split('\n').map(JSON.parse);check(runtime+': contacto alcanza persistencia controlada',events.some(e=>e.kind==='write'&&e.path.startsWith('contact_inbox/')||e.kind==='rest-write'&&e.path==='contact_inbox'),{});check(runtime+': base no carga preferencias agente',!events.some(e=>e.kind==='read'&&e.path.startsWith('config/')),{});}
const client=ts.transpileModule(fs.readFileSync(path.join(root,'src/lib/appointment-notify-client.ts'),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS}}).outputText;
(async()=>{
 for(const [name,user] of [['sin usuario',null],['token fallido',{getIdToken:async()=>{throw Error('synthetic failure');}}]]){const module={exports:{}};let attempts=0;vm.runInNewContext(client,{module,exports:module.exports,require:()=>({auth:{currentUser:user}}),console:{warn(){}},fetch:async()=>{attempts++;return {ok:true};}});module.exports.notifyAppointmentBooked({date:'2026-12-20',time:'12:00'});await new Promise(r=>setTimeout(r,20));check('helper '+name+' no emite solicitud',attempts===0,{attempts});}
 for(const name of ['green-server-r1','green-api-r1','green-base-r1','health-protecciones']){const dir=path.join(d,'resultados',name),results=JSON.parse(fs.readFileSync(path.join(dir,'RESULTADOS.json'),'utf8')),state=JSON.parse(fs.readFileSync(path.join(dir,'ESTADO.json'),'utf8').replace(/^\uFEFF/,'')),disposition=JSON.parse(fs.readFileSync(path.join(dir,'DISPOSICION.json'),'utf8').replace(/^\uFEFF/,''));check(name+' contrato completo',results.every(r=>r.valid)&&state.exit===0&&!state.timeout&&disposition.eliminado===true,{passed:results.filter(r=>r.valid).length,failed:results.filter(r=>!r.valid).length,exit:state.exit});}
 const mutation=JSON.parse(fs.readFileSync(path.join(d,'resultados/mutacion-permisos/RESULTADOS.json'),'utf8'));check('mutación detecta ambos servicios en ambos runtimes',['server','api'].every(runtime=>mutation.some(r=>r.name===runtime+'-keys: permiso IA exacto e independiente'&&!r.valid)&&mutation.some(r=>r.name===runtime+'-keys: permiso agente exacto e independiente'&&!r.valid)),{failed:mutation.filter(r=>!r.valid).length});check('mutación conserva controles independientes',mutation.filter(r=>r.name.includes('auth tenant origen')||r.name.includes('límite efectivo')).every(r=>r.valid),{});
 const valid=checks.every(c=>c.valid);fs.writeFileSync(path.join(d,'AUDITORIA-FINAL.json'),JSON.stringify({valid,checks},null,2));fs.writeFileSync(path.join(d,'FUENTES-FINALES.json'),JSON.stringify(copy.map(e=>({path:e.path,sha256:hash(path.join(root,e.path))})),null,2));console.log(JSON.stringify({valid,checks:checks.length,files:copy.length}));process.exitCode=valid?0:1;
})();
