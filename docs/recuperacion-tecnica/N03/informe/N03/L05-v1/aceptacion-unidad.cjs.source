{const h=setup(),a=h.call();await tick();await h.advance(1501,false);h.resolve('active');await a.done;check('resolución tardía antes del timer rechazada',a.http===503&&a.next===0,a);}
{const h=setup(),a=h.call(),b=h.call();await tick();h.resolve('archived');await Promise.all([a.done,b.done]);check('concurrencia bloqueada comparte lectura',h.reads===1&&a.http===423&&b.http===423,{a,b});}
