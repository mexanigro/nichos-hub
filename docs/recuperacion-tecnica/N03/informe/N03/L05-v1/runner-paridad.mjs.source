import fs from 'node:fs';
import {spawnSync} from 'node:child_process';
const cli='/app/node_modules/tsx/dist/cli.mjs';
if(!fs.existsSync(cli))throw Error('tsx existente ausente');
const args=[cli,'--test','--test-name-pattern=route parity|both runtimes|inline duplicates','/app/tests/api-parity.test.ts'];
const r=spawnSync(process.execPath,args,{cwd:'/app',encoding:'utf8',timeout:60000});
fs.writeFileSync('/salida/PARIDAD.txt',r.stdout||'');fs.writeFileSync('/salida/PARIDAD.stderr.txt',r.stderr||'');fs.writeFileSync('/salida/PARIDAD-ESTADO.json',JSON.stringify({exit:r.status,error:r.error?.message,args},null,2));console.log(r.stdout,r.stderr);process.exitCode=r.status===0?0:1;
