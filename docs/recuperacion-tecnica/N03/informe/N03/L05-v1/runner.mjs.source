import fs from 'node:fs';import {spawn} from 'node:child_process';import {generateKeyPairSync} from 'node:crypto';
const {privateKey}=generateKeyPairSync('rsa',{modulusLength:2048,privateKeyEncoding:{type:'pkcs8',format:'pem'}});
const results=[],sleep=ms=>new Promise(r=>setTimeout(r,ms));const check=(name,valid,evidence)=>{results.push({name,valid,evidence});console.log(JSON.stringify(results.at(-1)))};
for(const runtime of ['server','api']){
 const file='/tmp/config-'+runtime,events='/tmp/events-'+runtime,audit='/tmp/audit-'+runtime;let offset=0;const configure=x=>fs.writeFileSync(file,JSON.stringify({offset,...x}));configure({status:'active'});fs.writeFileSync(events,'');fs.writeFileSync(audit,'');
 const env={PATH:process.env.PATH,HOME:'/tmp',TMPDIR:'/tmp',NODE_PATH:process.env.NODE_PATH,TSX_DISABLE_CACHE:'1',NODE_ENV:'production',APP_URL:'http://isolated.invalid',CLIENT_ID:'tenant-control',VITE_FIREBASE_PROJECT_ID:'isolated',FIREBASE_PROJECT_ID:'isolated',FIREBASE_ADMIN_PROJECT_ID:'isolated',FIREBASE_ADMIN_CLIENT_EMAIL:'fixture@example.invalid',FIREBASE_ADMIN_PRIVATE_KEY:privateKey,FIREBASE_SERVICE_ACCOUNT_EMAIL:'fixture@example.invalid',FIREBASE_SERVICE_ACCOUNT_KEY:privateKey,PAYMENT_PROVIDER:'cardcom',L05_CONFIG:file,L05_EVENTS:events,HEALTH_AUDIT_FILE:audit,API_RATE_LIMIT_MAX:'60'};
 const child=spawn(process.execPath,['--import','/app/node_modules/tsx/dist/loader.mjs','--import','/control/preload-l05.mjs',runtime==='server'?'/app/server.ts':'/control/api-worker.mjs'],{env,cwd:'/app'});let stdout='',stderr='';child.stdout.on('data',b=>stdout+=b);child.stderr.on('data',b=>stderr+=b);const port=runtime==='server'?3000:3001;
 const request=async(path='/api/ai/chat',origin=env.APP_URL)=>{const start=Date.now();const r=await fetch('http://127.0.0.1:'+port+path,{method:path==='/api/ai/chat'?'POST':'GET',headers:{origin,'content-type':'application/json'},...(path==='/api/ai/chat'?{body:JSON.stringify({messages:[],status:'active',clientId:'other',active:true})}:{}),signal:AbortSignal.timeout(6500)});return{http:r.status,body:await r.json(),elapsed:Date.now()-start}};
 const count=kind=>fs.readFileSync(events,'utf8').trim().split('\n').filter(Boolean).map(JSON.parse).filter(e=>e.kind===kind).length;
 try{
 let up=false;for(let n=0;n<250;n++){if(child.exitCode!==null)break;try{if((await request('/api/live')).http===200){up=true;break}}catch{}await sleep(100)}check(runtime+' arranque real',up,{});if(!up)continue;
 const cases=[['active',{status:'active'},200],['trial',{status:'trial'},200],['maintenance',{status:'maintenance'},200],['suspended',{status:'suspended'},423],['archived',{status:'archived'},423],['missing',{missing:true},503],['absent',{},503],['null',{status:null},503],['invalid',{status:42},503],['empty',{status:''},503],['unknown',{status:'unknown'},503],['error',{error:true},503],['config optional',{status:'active',configError:true},200]];
 cases.push(...(runtime==='server'?[['sdk failure',{sdkError:true},503],['sdk absent',{noDb:true},503]]:[['token absent',{noToken:true},503],['http403',{httpError:403},503],['http500',{httpError:500},503],['json failure',{jsonError:true},503]]));
 for(const [name,mode,expected]of cases){offset+=4000000;configure(mode);const before=count('consumer');const r=await request();check(runtime+' '+name,expected===200?r.http===503&&r.body.error==='AI service is disabled.'&&count('consumer')===before+1:r.http===expected&&count('consumer')===before&&(expected!==503||r.body.error==='Tenant state unavailable.'),r);if(expected===200){const s=await request('/api/tenant/status');check(runtime+' status público '+name,s.http===200&&s.body.status===mode.status&&s.body.active===true&&(runtime==='server'?!('paymentProvider'in s.body):s.body.paymentProvider===(mode.configError?'tranzila':'stripe')),s);}}
 offset+=4000000;configure({status:'active'});await request();const beforeCache=count('client');configure({status:'suspended'});const fresh=await request();check(runtime+' cache vigente no relee',fresh.body.error==='AI service is disabled.'&&count('client')===beforeCache,{fresh,reads:count('client')});offset+=30000;configure({status:'suspended'});const blocked=await request();check(runtime+' cache vencida suspensión',blocked.http===423,blocked);offset+=30000;configure({error:true});const failed=await request();check(runtime+' vencida falla sin permiso',failed.http===503&&failed.body.error==='Tenant state unavailable.',failed);
 for(const stage of runtime==='server'?['delay','sdkDelay']:['delay','tokenDelay']){offset+=4000000;configure({status:'active',[stage]:2300});const before=count(stage==='tokenDelay'?'token':stage==='sdkDelay'?'sdk':'client');const a=request();await sleep(1250);const b=request();const pair=await Promise.all([a,b]);check(runtime+' deadline completo compartido '+stage,pair.every(r=>r.http===503&&r.body.error==='Tenant state unavailable.')&&pair[0].elapsed<2100&&pair[1].elapsed<850,{pair});const third=await request();check(runtime+' pendiente no reinicia '+stage,third.http===503&&third.elapsed<500&&count(stage==='tokenDelay'?'token':stage==='sdkDelay'?'sdk':'client')===before+1,{third});await sleep(1000);configure({status:'suspended'});const late=await request();check(runtime+' resultado tardío no habilita '+stage,late.http===423,late);}
 offset+=4000000;configure({status:'active'});const origin=await request('/api/ai/chat','http://foreign.invalid');check(runtime+' origen antes de consumidor',origin.http===403,origin);
 configure({status:'suspended'});offset+=30000;configure({status:'suspended'});const live=await request('/api/live'),health=await request('/api/health');check(runtime+' salud independiente',live.http===200&&health.http===503,{live,health});
 check(runtime+' exterior real bloqueado',fs.readFileSync(audit,'utf8')==='',fs.readFileSync(audit,'utf8'));
 }catch(e){check(runtime+' instrumento',false,String(e))}finally{child.kill('SIGTERM');await new Promise(r=>child.exitCode!==null||child.signalCode!==null?r():child.once('exit',r));fs.writeFileSync('/salida/'+runtime+'.stdout.txt',stdout);fs.writeFileSync('/salida/'+runtime+'.stderr.txt',stderr);fs.copyFileSync(events,'/salida/'+runtime+'.events.jsonl');}
}
fs.writeFileSync('/salida/RESULTADOS.json',JSON.stringify(results,null,2));console.log(JSON.stringify({passed:results.filter(r=>r.valid).length,failed:results.filter(r=>!r.valid).length}));process.exitCode=results.every(r=>r.valid)?0:1;
