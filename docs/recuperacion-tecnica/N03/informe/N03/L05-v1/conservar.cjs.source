const fs=require('node:fs'),p=require('node:path'),crypto=require('node:crypto');const ts=require('C:/Users/liama/Desktop/Nichos-hub/node_modules/typescript');
const root='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',d=__dirname;const checks=[];const hash=b=>crypto.createHash('sha256').update(b).digest('hex');
function nodes(text){const ast=ts.createSourceFile('source.ts',text,ts.ScriptTarget.Latest,true);const map=new Map;function walk(n){if(ts.isFunctionDeclaration(n)&&n.name)map.set(n.name.text,n.getText(ast));if(ts.isCallExpression(n)&&['app.get','app.post','app.use'].includes(n.expression.getText(ast))){const key=n.expression.getText(ast)+':'+n.arguments[0]?.getText(ast);if(n.arguments[0]&&ts.isStringLiteral(n.arguments[0]))map.set(key,n.getText(ast));}ts.forEachChild(n,walk)}walk(ast);return map;}
for(const file of ['server.ts','api/index.ts']){const before=fs.readFileSync(p.join(d,'preimagenes-producto',file),'utf8'),after=fs.readFileSync(p.join(root,file),'utf8'),a=nodes(before),b=nodes(after);
for(const name of ['getClientRuntimeState','getAdminDb','getFirestoreAccessToken','attachTenantContext','requireTrustedOrigin','rateLimit','app.post:"/api/webhook"','app.post:"/api/create-checkout-session"','app.get:"/api/daily-digest"'])if(a.has(name))checks.push({name:file+' conserva '+name,valid:a.get(name)===b.get(name)});
const original=a.get('app.get:"/api/tenant/status"');const expected=file==='server.ts'?original.replace('const { status } = await getClientRuntimeState();','const status = res.locals.tenantAccessStatus;'):original.replace('const { status, provider } = await getClientRuntimeState();','const status = res.locals.tenantAccessStatus;\n    const { provider } = await getClientRuntimeState();');checks.push({name:file+' status exclusivamente del guard; provider independiente',valid:expected.replace(/\r\n/g,'\n')===b.get('app.get:"/api/tenant/status"').replace(/\r\n/g,'\n')});
const beforeCache=before.match(/let clientStateCache:[^\n]+/)[0],afterCache=after.match(/let clientStateCache:[^\n]+/)[0];checks.push({name:file+' cache provider intacta',valid:beforeCache===afterCache});
for(const [key,value]of a)if(key.startsWith('app.')&&!key.includes('/api/tenant/status'))checks.push({name:file+' registro/cuerpo '+key,valid:value===b.get(key)});
}
const rows=JSON.parse(fs.readFileSync(p.join(d,'../D05-v1/FUENTES-FINALES-r2.json'),'utf8')).filter(x=>!['server.ts','api/index.ts'].includes(x.path));checks.push({name:rows.length+' fuentes previas intactas',valid:rows.every(x=>hash(fs.readFileSync(p.join(root,x.path)))===x.sha256.toLowerCase())});
fs.writeFileSync(process.argv[2]||p.join(d,'CONSERVACION-FINAL.json'),JSON.stringify({passed:checks.filter(x=>x.valid).length,failed:checks.filter(x=>!x.valid).length,checks},null,2),{flag:'wx'});console.log(JSON.stringify({passed:checks.filter(x=>x.valid).length,failed:checks.filter(x=>!x.valid).length}));process.exitCode=checks.every(x=>x.valid)?0:1;
