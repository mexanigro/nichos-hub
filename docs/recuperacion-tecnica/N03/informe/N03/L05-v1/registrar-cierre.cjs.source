const fs=require('node:fs'),p=require('node:path'),c=require('node:crypto');
const root='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',d=__dirname,template='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main';
const hash=b=>c.createHash('sha256').update(b).digest('hex');
const read=file=>JSON.parse(fs.readFileSync(p.join(d,file),'utf8').replace(/^\uFEFF/,''));
const accepted=[];
const originalGreen=read('resultados/l05-green/RESULTADOS.json');
const excluded=originalGreen.filter(x=>!x.valid);
if(excluded.length!==1||excluded[0].name!=='api status público config optional')throw Error('fallos inesperados');
accepted.push(...originalGreen.filter(x=>x.valid).map(x=>({...x,source:'l05-green'})));
for(const name of ['l05-complemento','l05-bootstrap','l05-config','l05-recuperacion']){const rows=read('resultados/'+name+'/RESULTADOS.json');if(rows.some(x=>!x.valid)||read('resultados/'+name+'/ESTADO.json').exit!==0)throw Error('corrida '+name);accepted.push(...rows.map(x=>({...x,source:name})));}
const unit=read('UNIDAD.json'),conservation=read('CONSERVACION-FINAL-r2.json'),mutation=read('resultados/l05-mutacion/RESULTADOS.json');
if(unit.failed||conservation.failed||read('TIPOS-ESTADO.json').exit!==0||read('resultados/l05-paridad/PARIDAD-ESTADO.json').exit!==0)throw Error('aceptación');
const mutationFailures=mutation.filter(x=>!x.valid);if(mutationFailures.length!==4||mutationFailures.some(x=>!/^((server|api) (missing|error))$/.test(x.name)))throw Error('sensibilidad');
for(const row of read('FREEZE.json'))if(hash(fs.readFileSync(p.join(d,row.file)))!==row.sha256)throw Error('freeze alterado');
const manifest=['server.ts','api/index.ts','src/lib/api/tenant-access.ts'].map(file=>{const b=fs.readFileSync(p.join(template,file));if(hash(b)!==hash(fs.readFileSync(p.join(d,'copia',file))))throw Error('copia distinta');return{path:file,bytes:b.length,sha256:hash(b)}});
const hub=JSON.parse(fs.readFileSync(p.join(root,'informe/N03/lint-v1/FUENTES-FINALES.json'),'utf8'));if(hub.some(x=>hash(fs.readFileSync(p.join('C:/Users/liama/Desktop/Nichos-hub',x.path)))!==x.sha256))throw Error('lint deriva');
fs.writeFileSync(p.join(d,'FUENTES-FINALES-L05.json'),JSON.stringify(manifest,null,2),{flag:'wx'});
fs.writeFileSync(p.join(d,'ACEPTACION-FINAL.json'),JSON.stringify({result:'GREEN',gates:4,totalGates:4,httpChecks:accepted.length,http:accepted,unitChecks:unit.passed,conservationChecks:conservation.passed,parityChecks:3,typesExit:0,mutationExpectedFailures:mutationFailures.map(x=>x.name),supersededOracle:{source:'l05-green',name:excluded[0].name,reason:'tranzila no pertenece a VALID_PROVIDERS real; fallback original cardcom corroborado antes/después',replacement:'l05-complemento: api provider exacto {status:active,configError:true}'},previousDeliveriesPreserved:true},null,2),{flag:'wx'});
const write=(file,text)=>fs.writeFileSync(p.join(d,file),text.replace(/\r?\n/g,'\r\n'),{flag:'wx'});
write('REVISION-CIERRE.md',`# Revisión final y procedencia

Revisor independiente /root/refutar_soporte (Harvey), lectura completa del módulo y diff contra preimagenes-producto en este turno. No escribió ni repitió pruebas. Veredicto: sin BLOCKERS ni MATERIAL demostrables en producto; deadline precede al lector, solicitudes comparten plazo/lectura, caché desde inicio, rechazo de tardía aun antes del timer, res.locals separado de getter/cache legacy. Perspectivas: tiempo/concurrencia, consumidor/orden, conservación de pagos y claridad.

NON-BLOCKING de claridad corregido con preimagen adicional: el título y comentario API que decían fail-open general ahora delimitan el fallback al getter legacy de pagos. No se cambió log ni lógica de ese getter. Después, conservación83/83 y paridad3/3 verifican la versión final. Los tipos y pruebas funcionales previos permanecen vigentes porque sólo cambió prosa desde esa medición.

Corrección del instrumento, con responsabilidad explícita: en la revisión previa el integrador y el revisor dieron por válido tranzila como fallback. El sondeo preparatorio inyectaba una lista de proveedores que lo incluía, pero VALID_PROVIDERS real en src/lib/api/payment-gateways.ts:26–37 NO lo contiene. El getter API original y final devuelven cardcom (env sintético) ante configError y legacy inválido. l05-provider-original10/10 lo reproduce sobre preimágenes en runtime completo; l05-complemento20/20 acredita mismo resultado final, también invalid/none, webhook y estado discordante.

Por ello l05-red-r3 se interpreta correctamente como31PASS,34 fallos funcionales y1 fallo de oráculo; la afirmación previa de35 fallos exclusivamente contractuales en FREEZE.md se conserva históricamente pero queda corregida aquí. Ambos arranques y el RED funcional sí estaban acreditados. l05-green tiene65 controles válidos y1 oráculo incorrecto; ese único resultado se sustituye explícitamente en ACEPTACION-FINAL.json. No se rehízo el producto ni se cambió el criterio de conservar pagos. FREEZE.json y runner original permanecen intactos. runner-complemento precisa el oráculo por evidencia del código original, no para encubrir una implementación incorrecta. Las caracterizaciones de provider del sondeo inicial son insuficientes por esa lista; los casos de estado de acceso no dependían de ella.

El criterio preparado decía estado público de res.locals; conservar.cjs lo comprueba por AST y la corrida complementaria lo refuta además con caché legacy discordante (webhook calienta active, acceso posterior verifica trial). No basta igualdad accidental de las dos cachés.

Custodia: fixture defectuoso guardado antes de corregir sólo llave y formato; preimagenes-producto guarda los dos runtimes originales, preimagenes-claridad el API antes de la segunda edición. Módulo tenant-access.ts no existía antes. Copia final coincide con los tres archivos. Mutación sólo en mutacion/src/lib/api/tenant-access.ts: reemplaza resultado no disponible por active; provoca exactamente4 fallos funcionales en ambos runtimes y conserva10 positivos. Producto no mutado.

Detector de bucles: STOP P0 previo respetado hasta orden nueva. La retoma produce sintaxis10/10, fixture8/8 y ambos arranques. P1 reduce34 defectos funcionales a0; el único oráculo errado se corrige con comprobación acotada antes/después. Primer intento local de paridad usó una ruta tsx inexistente del hub (PARIDAD.txt/ESTADO conservados); una continuación usa el tsx instalado en la infraestructura Docker existente y pasa3/3. No instalaciones, bucle reiterado ni ampliación de alcance. Cada continuación produjo evidencia material nueva.

Límites: simulación local, no SDK/DB/Auth remotos certificados; la lectura SDK pendiente no es cancelada, queda compartida hasta asentarse. Provider legacy puede demorar tenant/status tras la decisión de acceso. Navegador/Firestore directo no intervenidos; N03 conserva esa deuda y las condiciones previas al despliegue por prestaciones de tenant.
`);
write('CIERRE-LOCAL.md',`# L05 servidor — GREEN exclusivamente local

Se completó el guard servidor de N03: sólo active/trial/maintenance comprobados permiten; suspended/archived conservan423; estado ausente/inválido/imposible de verificar503 genérico. El plazo completo1500ms comienza antes de token/SDK; caché30s desde inicio; peticiones concurrentes comparten operación y plazo, sin permiso vencido ni caché por respuesta tardía.

P0/P1/P2/P3 alcanzados,4/4. Autorización de política, implementación y retoma incorporadas; [freeze previo](FREEZE.md), [decisión](DECISION-APROBADA.md), [revisión y corrección del oráculo](REVISION-CIERRE.md). No se reabrió reconocimiento ni sondeo válido. Se conservan resultados anteriores, incluyendo errores del instrumento.

Sólo cambian server.ts, api/index.ts y nuevo src/lib/api/tenant-access.ts. Guard compartido con lectores Admin/REST que conservan selectores; estado público desde res.locals. Getter/cache de proveedor, pagos/webhook, autenticación, origen, límites, señales de salud y demás cuerpos/registro de rutas conservados. Sin browser, provisioning, documentos reales, precio ni política comercial nueva.

## Acceptance Contract completo

| Criterio | Resultado y evidencia |
|---|---|
| A1 estados/consumidor | Válidos, suspendidos/archivados y desconocidos/ausentes/tipos inválidos, ante el handler realmente registrado en server CLI y API export. Contador del consumidor distingue503 del guard de503 de IA deshabilitada. |
| A2 verificación/fallos | SDK/config/token ausentes o fallidos,HTTP403/500/404/JSON, lectura/SDK/token lentos;503 antes de consumidor. l05-green y l05-config. |
| A3 cache/plazo |24 controles temporales deterministas y HTTP: T0+30000 exacto, error tras vencimiento, recuperación suspended→active, segunda solicitud cerca de deadline, tercera tras timeout sin nuevo lector, tardía no habilita. |
| A4 pagos separados | Getter/cache/cuerpos intactos por AST, provider original10/10 y complemento exacto; webhook de prueba sin firma conserva400 incluso suspended. Ningún cobro. |
| A5 orden/compatibilidad | Estado público con cachés discordantes, auth401, origen403, cuota429 sin nuevo consumidor; health/live independientes y bootstrap fallido503 sin lecturas/consumidor. |
| A6 sensibilidad/conservación | Mutación aislada4 fallos esperados/10 positivos; tipos exit0, paridad3/3, conservación83/83.330 fuentes previas template y6 fuentes lint hub intactas. |

[Aceptación consolidada](ACEPTACION-FINAL.json):${accepted.length} controles HTTP retenidos,24 temporales,83 conservación y3 paridad. Tipos0. La corrida l05-green conserva65/66: su oráculo incorrecto se reemplaza sólo por comprobación exacta sobre original/final, con explicación en revisión; no se esconde ese resultado ni se declara la corrida original enteramente verde. Sensibilidad no cuenta sus fallos esperados como tests de producto aprobados.

Corridas HTTP en Docker local existente, network=none/read-only/cap-drop, env saneado sin .env ni claves reales; credenciales sintéticas y fixtures. Contadores y bloqueo de salidas del preload conservado, sin red externa real. Arranque real acreditado, no persistencia/transacciones/SDK remoto. No se repiten suites book/support/stock/D05 intactas; sólo controles afectados por el nuevo guard y conservación por huellas/AST. Paridad usa tres controles pertinentes sin modificar excepciones.

[Huellas finales](FUENTES-FINALES-L05.json) y copia coincidentes. Fuentes de evidencia por corrida en resultados; cada una conserva exit, stdout/stderr y disposición. No hay soluciones temporales ocultas ni servicios propios pendientes; el mutante permanece sólo en el expediente aislado.

N03 continúa. Cierre de esta entrega para revisión de Liam, no aceptación del usuario anticipada. Navegador/directo Firestore y certificación remota pendientes; resto del balance intacto. Antes de despliegue deben presentarse tenants/servicios a conservar con evidencia y decisión de Liam sobre excepciones; no inferir compromisos de claves/planes. Sin instalaciones, operaciones remotas, commit, push, deploy ni resets. Techo80% TOTAL N03, último checkpoint75%; consumo final se conserva en CONSUMO-CIERRE.json.
`);
const registries=['informe/N03/L05-v1/INFORME.md','indice/tareas/N03.md','indice/README.md','indice/PENDIENTES.md','indice/CALENDARIO.md'];const custody=[];
for(const rel of registries){const f=p.join(root,rel),before=fs.readFileSync(f),backup=p.join(d,'preimagenes-cierre',rel);fs.mkdirSync(p.dirname(backup),{recursive:true});fs.writeFileSync(backup,before,{flag:'wx'});if(hash(fs.readFileSync(backup))!==hash(before))throw Error('custodia registro');const link=rel.startsWith('informe/')?'CIERRE-LOCAL.md':rel.includes('/tareas/')?'../../informe/N03/L05-v1/CIERRE-LOCAL.md':'../informe/N03/L05-v1/CIERRE-LOCAL.md';const s=before.toString('utf8'),i=s.indexOf('\n')+1;fs.writeFileSync(f,s.slice(0,i)+'\r\n**N03 L05 servidor cerrada exclusivamente local — GREEN4/4, entregada para revisión.** [Contrato/evidencia y límites]('+link+'). Guard separado de pagos: cache30s desde inicio, verificación completa1500ms, concurrencia/plazo compartidos, tardía no habilita; estados permitidos y423 conservados, desconocido/error503. HTTP'+accepted.length+', unidad24, conservación83, tipos0, paridad3 y mutación4 fallos esperados. Corrección de oráculo provider documentada, evidencia anterior intacta. N03 sigue en curso; navegador y certificación remota pendientes. Prestaciones por tenant antes de despliegue intactas. Techo80% TOTAL, checkpoint75%, sin resets. No siguiente reparación. Cortes inferiores históricos.\r\n'+s.slice(i));custody.push({path:rel,preimage:p.relative(root,backup),sha256Before:hash(before),sha256After:hash(fs.readFileSync(f))});}
write('CUSTODIA-CIERRE.json',JSON.stringify(custody,null,2));
fs.writeFileSync(p.join(root,'historial/2026-09-09-N03-L05-servidor-cierre-local.md'),`# N03 L05 servidor — cierre local para revisión\r\n\r\nRetoma explícitamente autorizada trasSTOP: fixture corregido con preimagen, sintaxis10/10 y básicos8/8; ambos runtimes arrancados yRED funcional observado. Freeze, guard separado y conexiones en tres archivos. Aceptación finalGREEN4/4: HTTP${accepted.length},temporales24,conservación83,tipos0,paridad3;mutación4 fallos esperados. [Acta y revisión con corrección de oráculo](../informe/N03/L05-v1/CIERRE-LOCAL.md).\r\n\r\nProducto previo/entregas aceptadas conservados. Sin remoto, instalación, commit,push,deploy,resets. Checkpoint75%/techo80%TOTAL N03. Se detiene para revisión; N03 sigue en curso, navegador/remoto pendientes y condición previa al despliegue por prestaciones de tenant intacta.\r\n`,{flag:'wx'});
console.log(JSON.stringify({result:'GREEN',http:accepted.length,unit:unit.passed,conservation:conservation.passed,parity:3,types:0,mutationFailures:4}));
