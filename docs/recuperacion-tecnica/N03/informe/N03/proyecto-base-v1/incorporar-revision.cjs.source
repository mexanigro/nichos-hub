const fs=require('fs'),p=require('path');const d=__dirname;const f=p.join(d,'INFORME.md');fs.mkdirSync(p.join(d,'preimagenes/revision'),{recursive:true});fs.copyFileSync(f,p.join(d,'preimagenes/revision/INFORME.md'));
let s=fs.readFileSync(f,'utf8');s=s.replace('estos dos accesores Admin y los helpers REST general deben operar sobre un mismo proyecto/base; si la configuración o una aplicación existente no son compatibles, rechazar antes de operar, sin escoger silenciosamente otro proyecto ni recrear aplicaciones.','cuando ambos selectores producen un destino, exigir coincidencia de proyecto/base; contrastar además la app Admin existente con el proyecto Admin configurado y rechazar discrepancias antes de operar, sin escoger silenciosamente otro proyecto ni recrear aplicaciones. Conservar los retornos actuales de configuración incompleta y ausencia de token; no prohibir por inferencia configuraciones Admin-only/REST-only.');fs.writeFileSync(f,s);
fs.writeFileSync(p.join(d,'REVISION.md'),'# Refutación independiente final — Newton\n\nSin BLOCKER de evidencia. Confirmados 35 casos/175 filas/556 checks GREEN, exit0, registro y SDK reales, cachés aislados. Mutantes RED atribuibles a app seleccionada server/API y URL REST. Capturas alteradas son controles instrumentales adicionales, no reparación.\n\nMATERIAL incorporado a la recomendación: distinguir contradicción de incompletitud. Coincidencia cuando ambos destinos existen; app existente contrastada también con proyecto Admin configurado. Conservar null/silencio/throw por falta de env/token. Prohibir Admin-only/REST-only sería otra política, no inferida. No se expandieron casos ni se implementó producto. Sin descuento ni certificado remoto.\n',{flag:'wx'});
