const fs=require('fs'),p=require('path'),crypto=require('crypto'),assert=require('assert/strict');const d=__dirname,hash=b=>crypto.createHash('sha256').update(b).digest('hex');const read=f=>JSON.parse(fs.readFileSync(p.join(d,f),'utf8').replace(/^\uFEFF/,''));
const result=read('resultados/RESULTADO.json'),cases=read('CASOS.json');let matrix='# Matriz local de destinos efectivos\n\n35 entradas fijas; cada una ejecuta ambos accesores Admin y los tres helpers REST. La tabla resume; RESULTADO.json conserva 175 filas, URL completa, método, app y referencia. Ausente se representa omitiendo la propiedad; vacío y blancos conservados en CASOS.json.\n\n| Caso | Admin server / API (ambos) | REST POST / GET / PATCH |\n|---|---|---|\n';
for(const c of cases){const a=result.rows.find(r=>r.case===c.id&&r.consumer==='server'),rr=result.rows.filter(r=>r.case===c.id&&r.consumer.startsWith('firestore'));const av=a.operations.length?a.selected[0].name+' → '+a.operations[0].project+'/'+a.operations[0].database:a.result+(a.error?' '+a.error:'');const rv=rr.map(r=>r.consumer.replace('firestoreRest','')+': '+(r.operations.length?r.operations[0].url.match(/projects\/(.*?)\/documents/)[1]+'; ':'')+r.result).join(' / ');matrix+='| '+c.id+' | '+av+' | '+rv+' |\n'}
fs.writeFileSync(p.join(d,'MATRIZ.md'),matrix,{flag:'wx'});
const baseline=read('PRODUCTO-ANTES.json');for(const f of baseline){const root=f.repo==='hub'?'C:/Users/liama/Desktop/Nichos-hub':'C:/Users/liama/Desktop/Nichos/Barber-shop-template-main';assert.equal(hash(fs.readFileSync(p.join(root,f.ruta))),f.sha256,f.ruta)}
for(const f of read('FREEZE.json'))assert.equal(hash(fs.readFileSync(p.join(d,f.ruta))),f.sha256,f.ruta);
for(const f of read('FUENTES.json'))assert.equal(hash(fs.readFileSync(p.join('C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',f.ruta))),f.sha256,f.ruta);
fs.writeFileSync(p.join(d,'CONSERVACION.json'),JSON.stringify({result:'PASS',producto:baseline.length,fuentes:6,contrato:'sin cambios',presupuesto:{inicio:86,actual:87,techo:90,reservaN04:10,resets:0}},null,2),{flag:'wx'});
console.log({producto:baseline.length,casos:cases.length});
