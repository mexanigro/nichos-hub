const fs=require('fs'),p=require('path'),crypto=require('crypto'),assert=require('assert/strict');const d=__dirname,archive='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03/informe/N03/proyecto-base-v1/aceptacion-local';const hash=b=>crypto.createHash('sha256').update(b).digest('hex'),read=f=>JSON.parse(fs.readFileSync(p.join(d,f),'utf8').replace(/^\uFEFF/,'')),walk=x=>fs.readdirSync(x,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(p.join(x,e.name)):[p.join(x,e.name)]),write=(f,v)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,typeof v==='string'||Buffer.isBuffer(v)?v:JSON.stringify(v,null,2),{flag:'wx'})};
for(const f of read('PRODUCTO-ANTES.json'))assert.equal(hash(fs.readFileSync(p.join(f.repo==='hub'?'C:/Users/liama/Desktop/Nichos-hub':'C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',f.ruta))),f.sha256);
for(const r of read('REGISTROS.json')){assert.equal(hash(fs.readFileSync(r.backup)),r.before);assert.equal(hash(fs.readFileSync(r.dest)),r.after)}
const evidence=walk(d).map(f=>({ruta:p.relative(d,f).replaceAll('\\','/'),bytes:fs.statSync(f).size,sha256:hash(fs.readFileSync(f))}));write(p.join(d,'EVIDENCIA.json'),evidence);const copies=[];for(const f of walk(d)){const dest=p.join(archive,p.relative(d,f))+(p.extname(f)==='.cjs'?'.source':'');const b=fs.readFileSync(f);write(dest,b);assert.equal(hash(fs.readFileSync(dest)),hash(b));copies.push({origen:f,destino:dest,sha256:hash(b),bytes:b.length})}write(p.join(d,'ARCHIVO.json'),copies);write(p.join(archive,'ARCHIVO.json'),copies);
const check=f=>{for(const m of fs.readFileSync(f,'utf8').matchAll(/\]\(([^)]+)\)/g)){if(!m[1].includes('://'))assert.ok(fs.existsSync(p.resolve(p.dirname(f),m[1])),f+' '+m[1])}};for(const name of ['ACEPTACION.md','SIGUIENTE-ACCION.md']){check(p.join(d,name));check(p.join(archive,name))}for(const r of read('REGISTROS.json').filter(r=>r.rel.endsWith('/BALANCE.md')))check(r.dest);
write(p.join(d,'VERIFICACION-FINAL.json'),{result:'PASS',producto:623,registros:12,enlaces:'PASS',evidencia:evidence.length,archivo:copies.length,suites:0});write(p.join(archive,'VERIFICACION-FINAL.json'),fs.readFileSync(p.join(d,'VERIFICACION-FINAL.json')));console.log(JSON.stringify({result:'PASS',producto:623,registros:12,archivo:copies.length,suites:0}));
