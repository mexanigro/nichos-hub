const fs=require('fs'),p=require('path'),crypto=require('crypto'),assert=require('assert/strict');const d=__dirname,impl=p.join(d,'../implementacion-local'),canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',archive='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03';const hash=b=>crypto.createHash('sha256').update(b).digest('hex'),json=f=>JSON.parse(fs.readFileSync(f,'utf8').replace(/^\uFEFF/,''));const write=(f,b)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,typeof b==='string'||Buffer.isBuffer(b)?b:JSON.stringify(b,null,2),{flag:'wx'})};
const baseline=json(p.join(impl,'PRODUCTO-ANTES.json')),changes=json(p.join(impl,'CONSERVACION.json')).changes;const current=baseline.map(f=>({...f,sha256:changes.find(c=>c.repo===f.repo&&c.ruta===f.ruta)?.after||f.sha256}));for(const f of current)assert.equal(hash(fs.readFileSync(p.join(f.repo==='hub'?'C:/Users/liama/Desktop/Nichos-hub':'C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',f.ruta))),f.sha256,f.ruta);write(p.join(d,'PRODUCTO-ANTES.json'),current);
const evidence=json(p.join(impl,'EVIDENCIA.json'));for(const f of evidence)assert.equal(hash(fs.readFileSync(p.join(impl,f.ruta))),f.sha256);const archived=json(p.join(impl,'ARCHIVO.json'));for(const f of archived)assert.equal(hash(fs.readFileSync(f.destino)),f.sha256);
write(p.join(d,'REVISION.md'),'# Refutación documental independiente — Newton\n\nSin BLOCKER. Selección de preparación visibleServices coherente con balance y deuda L12, sin reabrir entregas aceptadas. MATERIAL incorporado: reemplazar en balance estados antiguos de política/revisión pendientes; descontar sólo2Admin/3RESTcontexto. Familia residual no cerrada. Propuesta contrasta promesa antes de presumir defecto e incluye mezcla conocidos/desconocidos; no abre modo/rutasstaff/nullmergegeneral. No ejecutada.\n');
const records=['informe/N03/cierre-sesion-v1/RETOMA.md','informe/N03/reconciliacion-v1/BALANCE.md','informe/N03/reconciliacion-v1/SIGUIENTE-ACCION.md','indice/tareas/N03.md','indice/README.md','indice/CALENDARIO.md'],entries=[];for(const rel of records)for(const [kind,root] of [['canonico',canon],['archivo',archive]]){const dest=p.join(root,rel),bytes=fs.readFileSync(dest),backup=p.join(d,'preimagenes',kind,rel);write(backup,bytes);entries.push({rel,root,dest,backup,bytes,before:hash(bytes)})}
const old=fs.readFileSync(p.join(canon,records[1]),'utf8');let balance='# N03 — balance vigente tras aceptación local proyecto/base\n\n**N03 sigue abierta. Proyecto/base se descuenta exclusivamente en los dos accesores Admin y los tres helpers REST examinados, incluido su contexto compartido.** [Aceptación y límites](../proyecto-base-v1/aceptacion-local/ACEPTACION.md). Se conserva la dependencia del getter interno projectId del SDK instalado y la prueba local con operaciones interceptadas; no se certifica DB, identidad, permisos ni compatibilidad de futuras versiones. Los estados anteriores de espera de política/revisión quedan sustituidos; preimágenes completas conservadas.\n\n'+old.slice(old.indexOf('## Entregas locales descontadas'));
balance=balance.replace(' y ahora [L01 conexión local](../L01-v1/aceptacion-local/ACEPTACION.md).',', [L01 conexión local](../L01-v1/aceptacion-local/ACEPTACION.md) y [proyecto/base local 2 Admin + 3 REST/contexto](../proyecto-base-v1/aceptacion-local/ACEPTACION.md).');
balance=balance.replace('los tres controles L03 ni la conexión L01.','los tres controles L03, la conexión L01 ni el subconjunto proyecto/base ahora aceptado.');
balance=balance.replace('Contrato/reconciliación de selección de proyecto y databaseId; clientId-v1 no certifica proyecto/base ni toda coherencia browser/Admin/REST. No unificar por preferencia.','Resta reconciliar la coherencia local de los consumidores fuera del subconjunto aceptado. Descontados getAdminDb, loadAdminFirestore y Create/Get/Patch REST general con contexto; no otros accesores, browser ni propagación. clientId-v1 sigue aceptado por separado. El getter interno y los límites locales permanecen; no equivalen a certificación global.');
const a=balance.indexOf('## Única siguiente acción'),b=balance.indexOf('## Fronteras conservadas');assert.ok(a>0&&b>a);balance=balance.slice(0,a)+'## Única siguiente acción\n\nProponer preparar, sin ejecutar todavía, el contrato local de visibleServices vacío o sin IDs conocidos hasta la selección efectiva de servicios del template. Pendiente concreto L12 ya adjudicado; [alcance, reutilización y criterio de descuento](../proyecto-base-v1/aceptacion-local/SIGUIENTE-ACCION.md). No presumir defecto ni abrir modo, rutas staff o null/merge general.\n\n'+balance.slice(b);balance=balance.replace('observado86%','observado88%');
write(p.join(d,'FREEZE.json'),{scope:'aceptacion y descuento documental acotado; propuesta L12 sin ejecucion',gates:3,producto:623,evidenciaAceptada:evidence.length,archivado:archived.length,docs:['ACEPTACION.md','SIGUIENTE-ACCION.md'].map(ruta=>({ruta,sha256:hash(fs.readFileSync(p.join(d,ruta)))}))});
for(const e of entries){let after;if(e.rel.endsWith('/BALANCE.md'))after=Buffer.from(balance);else{const link=name=>p.relative(p.dirname(e.dest),p.join(e.root,'informe/N03/proyecto-base-v1/aceptacion-local',name)).replaceAll('\\','/');const note='**Proyecto/base aceptado localmente y descontado sólo en dos accesores Admin + tres helpers REST/contexto.** Se conservan getter interno del SDK instalado y límites de operaciones interceptadas. La familia residual no se cierra. Única siguiente propuesta: preparar contrato local L12 visibleServices vacío/desconocidos hasta servicios efectivos, reutilizando evidencia; NO ejecutada. Sin suites ni cambios de producto. Esta actualización sustituye la espera de revisión/política y las siguientes acciones previas; los cortes inferiores son historia. N03 abierta; techo90% TOTAL compartido, observado88%,último10%N04; sin resets/externos/push/deploy. Entregas aceptadas, etapas posteriores y condición por tenant intactas. [Aceptación]('+link('ACEPTACION.md')+'). [Propuesta]('+link('SIGUIENTE-ACCION.md')+').';const at=e.bytes.indexOf(10)+1;after=Buffer.concat([e.bytes.subarray(0,at),Buffer.from('\r\n'+note+'\r\n\r\n'),e.bytes.subarray(at)])}fs.writeFileSync(e.dest,after);e.after=hash(after);delete e.bytes;delete e.root}
write(p.join(d,'REGISTROS.json'),entries);const hist='historial/2026-09-10-N03-proyecto-base-aceptacion.md';const h='# N03 — proyecto/base aceptado localmente\n\nLiam acepta y se descuenta sólo2Admin+3RESTcontexto. Getter interno/límites locales conservados; resto de familia pendiente. [Aceptación](../informe/N03/proyecto-base-v1/aceptacion-local/ACEPTACION.md). [Única propuesta](../informe/N03/proyecto-base-v1/aceptacion-local/SIGUIENTE-ACCION.md): preparar L12 visibleServices, sin ejecutar ni asumir reparación. No suites/producto. N03 abierta; techo90%TOTAL, observado88%,reserva10%N04; etapas posteriores y condición por tenant intactas; sin resets/externos/push/deploy.\n';write(p.join(canon,hist),h);write(p.join(archive,hist),h);
write(p.join(d,'RESULTADO.json'),{result:'GREEN',gates:3,total:3,productoConservado:623,evidenciaConservada:evidence.length,archivoConservado:archived.length,descuento:'2Admin+3RESTgeneral/contexto solamente',N03:'abierta',propuesta:'L12 visibleServices; NO ejecutada',suitesEjecutadas:0,presupuesto:{observado:88,techo:90,reservaN04:10,resets:0}});console.log('Aceptacion y balance registrados; 12 preimagenes, producto623 intacto');
