for(const file of ['server.ts','api/index.ts']){const target=p.join(root,file),b=fs.readFileSync(target);const backup=p.join(d,'preimagenes/antes-tipos',file);fs.mkdirSync(p.dirname(backup),{recursive:true});fs.writeFileSync(backup,b,{flag:'wx'});let s=b.toString('utf8');const comment='  // Verificar el destino efectivo antes de entregar una referencia utilizable.';assert.equal(s.split(comment).length,2);s=s.replace(comment,comment+'\n  const effectiveProjectId = "projectId" in db ? db.projectId : undefined;');s=s.replaceAll('    db.projectId !== projectId ||','    effectiveProjectId !== projectId ||').replaceAll('(restProjectId && db.projectId !== restProjectId)','(restProjectId && effectiveProjectId !== restProjectId)');fs.writeFileSync(target,s)}
const v=p.join(d,'tipos-lint.cjs');const s=fs.readFileSync(v,'utf8').replaceAll("'tsconfig.json'","'tsconfig-final.json'").replaceAll("'TIPOS-LINT.","'TIPOS-LINT-FINAL.");fs.writeFileSync(p.join(d,'tipos-lint-final.cjs'),s,{flag:'wx'});
