const fs=require('fs'),p=require('path'),assert=require('assert/strict'),crypto=require('crypto');const d=__dirname,root='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',ts=require(root+'/node_modules/typescript'),hash=b=>crypto.createHash('sha256').update(b).digest('hex');const read=f=>JSON.parse(fs.readFileSync(p.join(d,f),'utf8').replace(/^\uFEFF/,''));
const final=read('resultados/final/RESULTADO.json'),red=read('resultados/red/RESULTADO.json'),cases=read('CASOS.json');assert.equal(final.result,'GREEN');assert.equal(red.result,'RED');let conserved=0;
for(const row of final.observations){const c=cases.find(c=>c.id===row.case),reject=['server','api'].includes(row.consumer)?c.rejectAdmin:c.rejectRest;if(!reject){assert.deepStrictEqual(row,red.observations.find(r=>r.case===row.case&&r.consumer===row.consumer));conserved++}else assert.equal(row.operations.length,0)}
for(const f of read('FREEZE.json'))assert.equal(hash(fs.readFileSync(p.join(d,f.ruta))),f.sha256);
const changes=[];for(const f of read('PRODUCTO-ANTES.json')){const rootRepo=f.repo==='hub'?'C:/Users/liama/Desktop/Nichos-hub':root,after=hash(fs.readFileSync(p.join(rootRepo,f.ruta)));if(after!==f.sha256){assert.ok(f.repo==='template'&&['server.ts','api/index.ts'].includes(f.ruta));changes.push({...f,after})}}assert.equal(changes.length,2);
function outside(text,file,names){const ast=ts.createSourceFile(file,text,ts.ScriptTarget.Latest,true);const nodes=ast.statements.filter(n=>ts.isFunctionDeclaration(n)&&names.includes(n.name?.text));assert.equal(nodes.length,names.length);for(const n of nodes.reverse())text=text.slice(0,n.getStart(ast))+'FUNCTION_SCOPE'+text.slice(n.end);return text}
for(const file of ['server.ts','api/index.ts']){const names=file==='server.ts'?['getAdminDb']:['loadAdminFirestore','firestoreRestCreate','getFirestoreRestContext'];const before=fs.readFileSync(p.join(d,'preimagenes',file),'utf8'),after=fs.readFileSync(p.join(root,file),'utf8');assert.equal(outside(after,file,names),outside(before,file,names),file+' fuera funciones');fs.mkdirSync(p.dirname(p.join(d,'final',file)),{recursive:true});fs.writeFileSync(p.join(d,'final',file),after,{flag:'wx'})}
const mutants=[];for(const name of ['server','api','create','context']){const r=read('resultados/mutante-'+name+'/RESULTADO.json');assert.equal(r.result,'RED');assert.equal(r.mutations,1);assert.ok(r.failures.some(f=>f.label.endsWith('/operations')&&f.expected===0&&f.actual>0));mutants.push({name,failures:r.failures.length,mutation:r.mutations,forbiddenOperationChecks:r.failures.filter(f=>f.label.endsWith('/operations')&&f.expected===0&&f.actual>0).length})}
assert.equal(read('TIPOS-LINT-FINAL.json').exit,0);
fs.writeFileSync(p.join(d,'CONSERVACION.json'),JSON.stringify({result:'PASS',population:623,unchanged:621,changes,compatibleRowsIdentical:conserved,forbiddenRows:final.rows-conserved,functionsOutsideScope:'bytes iguales',freeze:'PASS',typesLint:0,mutants},null,2),{flag:'wx'});console.log(JSON.stringify({compatibleRowsIdentical:conserved,mutants,unchanged:621}));
