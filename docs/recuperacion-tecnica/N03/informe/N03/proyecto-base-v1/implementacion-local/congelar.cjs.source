const fs=require('fs'),p=require('path'),crypto=require('crypto');const d=__dirname,f=p.join(d,'contrato.cjs');let s=fs.readFileSync(f,'utf8');s=s.replace("error(){logs.push('error registrado')}","error(...args){logs.push(args.map(a=>a instanceof Error?a.message:String(a)).join(' '))}");s=s.replace(' const originalError=logs.push.bind(logs);\n','');fs.writeFileSync(f,s);
const cases=JSON.parse(fs.readFileSync(p.join(d,'CASOS.json')));const c=structuredClone(cases.find(c=>c.id==='app-sin-env-admin'));c.id='app-ajena-sin-env-admin';c.apps[0].project='project-b';cases.push(c);fs.writeFileSync(p.join(d,'CASOS.json'),JSON.stringify(cases,null,2));
const cf=p.join(d,'CONTRATO.md');fs.writeFileSync(cf,fs.readFileSync(cf,'utf8').replace('43 casos fijos','44 casos fijos'));
const hash=b=>crypto.createHash('sha256').update(b).digest('hex');fs.writeFileSync(p.join(d,'FREEZE.json'),JSON.stringify(['CONTRATO.md','CASOS.json','contrato.cjs'].map(ruta=>({ruta,sha256:hash(fs.readFileSync(p.join(d,ruta)))})),null,2));
