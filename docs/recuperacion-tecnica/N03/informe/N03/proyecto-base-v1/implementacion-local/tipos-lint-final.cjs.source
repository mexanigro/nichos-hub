const fs=require('fs'),p=require('path'),{spawnSync}=require('child_process');const d=__dirname,root='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main';const config={extends:root+'/tsconfig.json',compilerOptions:{incremental:false},include:[root+'/server.ts',root+'/api/index.ts',root+'/src/vite-env.d.ts'],exclude:[root+'/node_modules']};fs.writeFileSync(p.join(d,'tsconfig-final.json'),JSON.stringify(config,null,2),{flag:'wx'});const args=[root+'/node_modules/typescript/bin/tsc','--project',p.join(d,'tsconfig-final.json'),'--noEmit','--incremental','false'];const r=spawnSync(process.execPath,args,{cwd:root,encoding:'utf8',timeout:120000});for(const key of ['stdout','stderr'])fs.writeFileSync(p.join(d,'TIPOS-LINT-FINAL.'+key+'.txt'),r[key]||'',{flag:'wx'});fs.writeFileSync(p.join(d,'TIPOS-LINT-FINAL.json'),JSON.stringify({exit:r.status,error:r.error?.message,command:[process.execPath,...args],lint:'package.json lint = tsc --noEmit; ejecutado sobre ambos archivos y dependencias transitivas'},null,2),{flag:'wx'});console.log(JSON.stringify({exit:r.status,stdout:r.stdout,stderr:r.stderr}));process.exitCode=r.status??2;
