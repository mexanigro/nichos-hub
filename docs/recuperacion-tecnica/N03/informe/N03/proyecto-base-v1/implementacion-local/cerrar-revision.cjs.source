const fs=require('fs'),p=require('path'),crypto=require('crypto'),assert=require('assert/strict');const d=__dirname,root='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',hash=b=>crypto.createHash('sha256').update(b).digest('hex');
const sources=['server.ts','api/index.ts'].map(ruta=>{const b=fs.readFileSync(p.join(root,ruta));assert.deepStrictEqual(b,fs.readFileSync(p.join(d,'final',ruta)));return{ruta,sha256:hash(b),copia:'final/'+ruta}});
const evidence=['FREEZE.json','CONSERVACION.json','resultados/final/RESULTADO.json','resultados/final/COMANDO.json','resultados/final/exit.txt','TIPOS-LINT-FINAL.json'].map(ruta=>({ruta,sha256:hash(fs.readFileSync(p.join(d,ruta)))}));
fs.writeFileSync(p.join(d,'CUSTODIA-FINAL.json'),JSON.stringify({sources,evidence,nota:'Fuentes finales conservadas tras ajuste de tipos, sin escrituras posteriores; vinculadas a corrida final y conservacion. CAMBIOS.json es historico de P1 antes de ajuste tipos, no manifiesto final.'},null,2),{flag:'wx'});
fs.writeFileSync(p.join(d,'REVISION.md'),'# Refutación independiente final — Newton\n\nSin BLOCKER funcional. Diff limitado a cuatro funciones en dos archivos. Final44casos/697checks GREEN; mutantes server/API/Create/contexto con21/21/4/12 fallos e incumplimientos por operaciones prohibidas. Retornos incompletos y catch REST preservados.\n\nMATERIAL resuelto: CAMBIOS.json conserva hashes históricos anteriores al ajuste de tipos. Se mantiene intacto y CUSTODIA-FINAL.json vincula hashes finales a copias byteiguales, corrida final, contrato y conservación. No se presenta CAMBIOS.json como final.\n\nLímite SDK: getter projectId interno, disponible en versión instalada y protegido por verificación de presencia/igualdad; no compatibilidad universal de versiones ni certificación del proveedor real. Conservar límite declarado en acta. Suficiencia para entregar implementación local a revisión, sin descuento ni ampliación.\n',{flag:'wx'});
const report=p.join(d,'CIERRE-LOCAL.md');fs.mkdirSync(p.join(d,'preimagenes/antes-custodia'),{recursive:true});fs.copyFileSync(report,p.join(d,'preimagenes/antes-custodia/CIERRE-LOCAL.md'));fs.appendFileSync(report,'\n## Custodia final y refutación\n\n[Revisión independiente](REVISION.md): sin BLOCKER funcional. [Custodia final](CUSTODIA-FINAL.json) vincula los hashes finales de ambos archivos y sus copias a la corrida final, conservación y contrato. CAMBIOS.json se conserva exclusivamente como registro histórico anterior al ajuste de tipos; no representa la versión entregada.\n');
