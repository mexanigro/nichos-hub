const fs=require('fs'),p=require('path'),assert=require('assert/strict'),crypto=require('crypto');const d=__dirname,root='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',hash=b=>crypto.createHash('sha256').update(b).digest('hex');
for(const x of JSON.parse(fs.readFileSync(p.join(d,'FREEZE.json'))))assert.equal(hash(fs.readFileSync(p.join(d,x.ruta))),x.sha256);
const red=JSON.parse(fs.readFileSync(p.join(d,'resultados/red/RESULTADO.json')));assert.equal(red.result,'RED');assert.ok(red.failures.some(f=>f.label.endsWith('/operations')&&f.actual>0&&f.expected===0));
const edits=[];for(const file of ['server.ts','api/index.ts']){const target=p.join(root,file),before=fs.readFileSync(target);assert.deepStrictEqual(before,fs.readFileSync(p.join(d,'preimagenes',file)));const nl=before.includes(Buffer.from('\r\n'))?'\r\n':'\n';let text=before.toString('utf8');
const old=file==='server.ts'?'  return getAdminFirestore(app, databaseId);':'  return { db: getAdminFirestore(adminApp, databaseId), FieldValue };';assert.equal(text.split(old).length,2);
const lines=[`  const db = getAdminFirestore(${file==='server.ts'?'app':'adminApp'}, databaseId);`,'  const restProjectId =','    process.env.FIREBASE_PROJECT_ID?.trim() ||','    process.env.VITE_FIREBASE_PROJECT_ID?.trim() ||','    process.env.NEXT_PUBLIC_FIREBASE_PROJECT_ID?.trim();','  // Verificar el destino efectivo antes de entregar una referencia utilizable.','  if (','    db.projectId !== projectId ||','    db.databaseId !== databaseId ||','    (restProjectId && db.projectId !== restProjectId)','  ) {','    throw new Error("Firestore destination mismatch");','  }',file==='server.ts'?'  return db;':'  return { db, FieldValue };'];text=text.replace(old,lines.join(nl));
if(file==='api/index.ts'){
const guard=indent=>[indent+'const adminProjectId = process.env.FIREBASE_ADMIN_PROJECT_ID?.trim();',indent+'if (adminProjectId && adminProjectId !== projectId) {',indent+'  throw new Error("Firestore destination mismatch");',indent+'}'].join(nl);
const marker='    if (!projectId) return;'+nl+nl+'    const url = `https://firestore.googleapis.com/v1/projects/${projectId}/databases/${databaseId}/documents/${collectionId}`;';assert.equal(text.split(marker).length,2);text=text.replace(marker,'    if (!projectId) return;'+nl+guard('    ')+nl+nl+'    const url = `https://firestore.googleapis.com/v1/projects/${projectId}/databases/${databaseId}/documents/${collectionId}`;');
const marker2='    throw new Error("FIREBASE_PROJECT_ID not set");'+nl+'  }'+nl+nl+'  return {';assert.equal(text.split(marker2).length,2);text=text.replace(marker2,'    throw new Error("FIREBASE_PROJECT_ID not set");'+nl+'  }'+nl+guard('  ')+nl+nl+'  return {');
}
fs.writeFileSync(target,text);edits.push({ruta:file,before:hash(before),after:hash(Buffer.from(text))});}
fs.writeFileSync(p.join(d,'CAMBIOS.json'),JSON.stringify(edits,null,2),{flag:'wx'});console.log(edits);
