const fs=require('fs'),p=require('path'),crypto=require('crypto'),assert=require('assert/strict');const d=__dirname,root='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',archive='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03/informe/N03/proyecto-base-v1/implementacion-local';
const hash=b=>crypto.createHash('sha256').update(b).digest('hex'),json=f=>JSON.parse(fs.readFileSync(p.join(d,f),'utf8').replace(/^\uFEFF/,'')),write=(f,b)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,typeof b==='string'||Buffer.isBuffer(b)?b:JSON.stringify(b,null,2),{flag:'wx'})},walk=x=>fs.readdirSync(x,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(p.join(x,e.name)):[p.join(x,e.name)]);
assert.ok(fs.existsSync(p.join(d,'REVISION.md')));const conservation=json('CONSERVACION.json');for(const f of json('PRODUCTO-ANTES.json')){const c=conservation.changes.find(c=>c.repo===f.repo&&c.ruta===f.ruta);assert.equal(hash(fs.readFileSync(p.join(f.repo==='hub'?'C:/Users/liama/Desktop/Nichos-hub':root,f.ruta))),c?c.after:f.sha256)}
for(const f of json('FREEZE.json'))assert.equal(hash(fs.readFileSync(p.join(d,f.ruta))),f.sha256);
for(const f of json('REGISTROS.json')){assert.equal(hash(fs.readFileSync(f.backup)),f.before);assert.equal(hash(fs.readFileSync(f.dest)),f.after)}
for(const [name,exit] of [['red',1],['final',0],['mutante-server',1],['mutante-api',1],['mutante-create',1],['mutante-context',1]])assert.equal(Number(fs.readFileSync(p.join(d,'resultados',name,'exit.txt'),'utf8')),exit);
write(p.join(d,'RESULTADO.json'),{result:'GREEN',gates:4,total:4,scope:'reparacion local autorizada, para revision sin descuento',casos:44,comprobaciones:697,observaciones:220,compatiblesConservadas:200,prohibidasSinOperaciones:20,mutantes:conservation.mutants,tiposLint:0,producto:623,ajenosConservados:621,N03:'abierta',blockers:[],presupuesto:{inicio:87,observado:87,techo:90,reservaN04:10,resets:0}});
const evidence=walk(d).map(f=>({ruta:p.relative(d,f).replaceAll('\\','/'),bytes:fs.statSync(f).size,sha256:hash(fs.readFileSync(f))}));write(p.join(d,'EVIDENCIA.json'),evidence);const copies=[];
for(const f of walk(d)){const dest=p.join(archive,p.relative(d,f))+(/\.(cjs|js|ts|tsx|ps1)$/.test(f)?'.source':'');const b=fs.readFileSync(f);write(dest,b);assert.equal(hash(fs.readFileSync(dest)),hash(b));copies.push({origen:f,destino:dest,bytes:b.length,sha256:hash(b)})}write(p.join(d,'ARCHIVO.json'),copies);write(p.join(archive,'ARCHIVO.json'),copies);
for(const name of ['CIERRE-LOCAL.md','CONTRATO.md','REVISION.md'])for(const dir of [d,archive])for(const m of fs.readFileSync(p.join(dir,name),'utf8').matchAll(/\]\(([^)]+)\)/g))assert.ok(fs.existsSync(p.resolve(dir,m[1])),name+' '+m[1]);
write(p.join(d,'VERIFICACION-FINAL.json'),{result:'PASS',evidencia:evidence.length,archivo:copies.length,registros:12,producto:623,modificados:2,freeze:'PASS',enlaces:'PASS'});write(p.join(archive,'VERIFICACION-FINAL.json'),fs.readFileSync(p.join(d,'VERIFICACION-FINAL.json')));console.log(JSON.stringify({result:'PASS',evidencia:evidence.length,archivo:copies.length}));
