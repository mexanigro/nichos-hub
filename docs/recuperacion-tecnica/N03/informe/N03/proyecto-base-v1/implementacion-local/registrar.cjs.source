const fs=require('fs'),p=require('path'),crypto=require('crypto'),assert=require('assert/strict');const base=__dirname;
const canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',archive='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03';
const hash=b=>crypto.createHash('sha256').update(b).digest('hex'),write=(f,b)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,typeof b==='string'||Buffer.isBuffer(b)?b:JSON.stringify(b,null,2),{flag:'wx'})};
const records=['informe/N03/cierre-sesion-v1/RETOMA.md','informe/N03/reconciliacion-v1/BALANCE.md','informe/N03/reconciliacion-v1/SIGUIENTE-ACCION.md','indice/tareas/N03.md','indice/README.md','indice/CALENDARIO.md'],entries=[];
for(const rel of records)for(const [kind,root] of [['canonico',canon],['archivo',archive]]){const dest=p.join(root,rel),bytes=fs.readFileSync(dest),backup=p.join(base,'preimagenes/registros',kind,rel);write(backup,bytes);entries.push({rel,root,dest,backup,bytes,before:hash(bytes)})}
for(const e of entries){const link=p.relative(p.dirname(e.dest),p.join(e.root,'informe/N03/proyecto-base-v1/implementacion-local/CIERRE-LOCAL.md')).replaceAll('\\','/');const note='**Proyecto/base Admin–REST: reglas aprobadas e implementación local GREEN 4/4, para revisión; NO descontada.** Liam aprobó coincidencia con ambos destinos definidos y rechazo de app Admin efectiva incompatible. Sólo server.ts/api/index.ts: dos accesores, Create y contexto usado por Get/Patch. P0 RED58; final44casos/697checks,200 observaciones conservadas y20 prohibidas con cero operaciones; cuatro mutantesRED, tipos/lint0,621 archivos restantes intactos. No quedan decisiones de política pendientes en este alcance. Único siguiente paso: revisión/aceptación de esta implementación; no otra reparación. Sustituye la espera de decisión/preparación anterior. N03 abierta, techo90%TOTAL compartido, observado87%, último10%N04; sin resets/instalaciones/credenciales reales/externos/push/deploy. Entregas aceptadas, etapas posteriores y condición por tenant antes del despliegue intactas. [Acta y límites]('+link+').';const at=e.bytes.indexOf(10)+1;assert.ok(at>0);let after=Buffer.concat([e.bytes.subarray(0,at),Buffer.from('\r\n'+note+'\r\n\r\n'),e.bytes.subarray(at)]);
if(e.rel.endsWith('/BALANCE.md'))after=Buffer.from(after.toString('utf8').replace('Resolver únicamente la decisión de compatibilidad del contrato ya preparado: [evidencia, límites y recomendación](../proyecto-base-v1/INFORME.md). Preparación ejecutada por autorización; no se implementó reparación ni se descontó el subconjunto. No reabrir clientId-v1 ni entornos reales.','Revisar exclusivamente la implementación local autorizada de [proyecto/base Admin–REST](../proyecto-base-v1/implementacion-local/CIERRE-LOCAL.md). Las reglas fueron aprobadas y la reparación está GREEN local; no descontar hasta aceptación. No reabrir clientId-v1 ni entornos reales.'));
fs.writeFileSync(e.dest,after);e.after=hash(after);delete e.bytes;delete e.root;assert.equal(hash(fs.readFileSync(e.backup)),e.before)}
write(p.join(base,'REGISTROS.json'),entries);
const history='historial/2026-09-10-N03-proyecto-base-implementacion.md';const h='# N03 — proyecto/base implementado localmente\n\nLiam aprobó compatibilidad cuando ambos destinos definidos y rechazo de app Admin efectiva incompatible; autorizó sólo server.ts/api/index.ts. Contrato congelado, RED previo58 y finalGREEN44casos/697checks; cuatro mutantes permiten operaciones prohibidas y fallan.200 observaciones conservadas,20 prohibidas bloqueadas,621 archivos ajenos intactos. [Acta y límites](../informe/N03/proyecto-base-v1/implementacion-local/CIERRE-LOCAL.md). Sólo para revisión, sin descuento. N03 abierta; techo90%TOTAL, observado87%, último10%N04. Sin resets/instalaciones/externos/push/deploy. Etapas posteriores y condición por tenant vigentes.\n';write(p.join(canon,history),h);write(p.join(archive,history),h);console.log('Registros12 actualizados con preimagenes; sin descuento');
