const fs=require('fs'),p=require('path'),crypto=require('crypto'),assert=require('assert/strict');const base=__dirname;
const canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',archive='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03';
const hash=b=>crypto.createHash('sha256').update(b).digest('hex'),write=(f,b)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,typeof b==='string'||Buffer.isBuffer(b)?b:JSON.stringify(b,null,2),{flag:'wx'})};
const records=['informe/N03/cierre-sesion-v1/RETOMA.md','informe/N03/reconciliacion-v1/BALANCE.md','informe/N03/reconciliacion-v1/SIGUIENTE-ACCION.md','indice/tareas/N03.md','indice/README.md','indice/CALENDARIO.md'],entries=[];
for(const rel of records)for(const [kind,root] of [['canonico',canon],['archivo',archive]]){const dest=p.join(root,rel),bytes=fs.readFileSync(dest),backup=p.join(base,'preimagenes',kind,rel);write(backup,bytes);entries.push({rel,root,dest,backup,bytes,before:hash(bytes)})}
for(const e of entries){const link=p.relative(p.dirname(e.dest),p.join(e.root,'informe/N03/proyecto-base-v1/INFORME.md')).replaceAll('\\','/');const note='**Proyecto/base Admin↔REST general: preparación local GREEN 4/4, pendiente revisión y decisión de política.** 35 casos/175 capturas/556 comprobaciones, SDK real con operaciones interceptadas y tres mutantes RED. Compatibilidad condicionada; app existente ajena usa su proyecto y REST conserva el propio. No hay política vigente que autorice imponer unificación. Recomendación acotada: exigir destino compatible y rechazar incompatibilidad antes de operar; pendiente decisión de Liam. Ninguna reparación ni descuento. 623 archivos de producto conservados. Sustituye sólo la propuesta de preparar este contrato; entregas aceptadas y siete familias residuales siguen vigentes. N03 abierta, techo90%TOTAL compartido, observado87%, último10%N04; sin resets/instalaciones/credenciales reales/externos/push/deploy. Etapas posteriores y condición por tenant antes del despliegue intactas. [Matriz, límites y decisión]('+link+').';const at=e.bytes.indexOf(10)+1;assert.ok(at>0);let after=Buffer.concat([e.bytes.subarray(0,at),Buffer.from('\r\n'+note+'\r\n\r\n'),e.bytes.subarray(at)]);
 if(e.rel.endsWith('/BALANCE.md'))after=Buffer.from(after.toString('utf8').replace('Proponer **preparar el contrato local de proyecto/base entre Admin y REST general del template**, porque aborda una condición explícita pendiente y un par acotado de consumidores. [Alcance, resultado y criterio de descuento](../L01-v1/aceptacion-local/SIGUIENTE-ACCION.md). No se ejecutó esa preparación ni se implementó otra reparación. No reabrir clientId-v1 ni entornos reales.','Resolver únicamente la decisión de compatibilidad del contrato ya preparado: [evidencia, límites y recomendación](../proyecto-base-v1/INFORME.md). Preparación ejecutada por autorización; no se implementó reparación ni se descontó el subconjunto. No reabrir clientId-v1 ni entornos reales.'));
 fs.writeFileSync(e.dest,after);e.after=hash(after);delete e.bytes;delete e.root;assert.equal(hash(fs.readFileSync(e.backup)),e.before)}
write(p.join(base,'REGISTROS.json'),entries);
const history='historial/2026-09-10-N03-proyecto-base-preparacion.md';const h='# N03 — preparación proyecto/base local\n\nContrato preparado por autorización; 35 casos,175 filas,556 checks GREEN y tres variantes RED. Compatibilidad condicionada; decisión pendiente ante proyectos/app existente incompatibles. Sin producto modificado ni descuentos. [Informe](../informe/N03/proyecto-base-v1/INFORME.md). N03 abierta, techo90% TOTAL, observado87%, reserva10%N04; etapas posteriores y condición por tenant intactas. Sin resets, instalaciones, credenciales reales, externos, push ni deploy.\n';write(p.join(canon,history),h);write(p.join(archive,history),h);
console.log('12 registros con preimagenes; expediente no descontado');
