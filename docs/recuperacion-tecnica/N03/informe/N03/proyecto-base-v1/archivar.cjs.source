const fs=require('fs'),p=require('path'),crypto=require('crypto'),assert=require('assert/strict');const d=__dirname,archive='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03/informe/N03/proyecto-base-v1';const hash=b=>crypto.createHash('sha256').update(b).digest('hex'),json=f=>JSON.parse(fs.readFileSync(p.join(d,f),'utf8').replace(/^\uFEFF/,'')),walk=x=>fs.readdirSync(x,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(p.join(x,e.name)):[p.join(x,e.name)]),write=(f,b)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,typeof b==='string'||Buffer.isBuffer(b)?b:JSON.stringify(b,null,2),{flag:'wx'})};
for(const f of json('PRODUCTO-ANTES.json'))assert.equal(hash(fs.readFileSync(p.join(f.repo==='hub'?'C:/Users/liama/Desktop/Nichos-hub':'C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',f.ruta))),f.sha256,f.ruta);
for(const f of json('FREEZE.json'))assert.equal(hash(fs.readFileSync(p.join(d,f.ruta))),f.sha256);
for(const f of json('REGISTROS.json')){assert.equal(hash(fs.readFileSync(f.backup)),f.before);assert.equal(hash(fs.readFileSync(f.dest)),f.after)}
assert.equal(fs.readFileSync(p.join(d,'resultados/exit-r2.txt'),'utf8').trim(),'0');for(const k of ['server','api','rest']){assert.equal(fs.readFileSync(p.join(d,'resultados/mutante-'+k+'.exit.txt'),'utf8').trim(),'1');assert.match(fs.readFileSync(p.join(d,'resultados/mutante-'+k+'.log'),'utf8'),/AssertionError/)}
write(p.join(d,'CIERRE.json'),{result:'GREEN',scope:'preparacion local, no reparacion ni descuento',gates:4,total:4,cases:35,rows:175,checks:556,mutantes:3,productoConservado:623,N03:'abierta',decision:'compatibilidad de destinos conocidos y app existente, conservar incompletitud',blockersEvidencia:[],presupuesto:{observado:87,techo:90,reservaN04:10,resets:0}});
const manifest=walk(d).map(f=>({ruta:p.relative(d,f).replaceAll('\\','/'),bytes:fs.statSync(f).size,sha256:hash(fs.readFileSync(f))}));write(p.join(d,'EVIDENCIA.json'),manifest);
const copies=[];for(const f of walk(d)){const rel=p.relative(d,f),dest=p.join(archive,rel)+(/\.(cjs|js|ts|tsx|ps1)$/.test(f)?'.source':'');const b=fs.readFileSync(f);write(dest,b);assert.equal(hash(fs.readFileSync(dest)),hash(b));copies.push({origen:f,destino:dest,bytes:b.length,sha256:hash(b)})}write(p.join(d,'ARCHIVO.json'),copies);write(p.join(archive,'ARCHIVO.json'),copies);
for(const name of ['INFORME.md','MATRIZ.md','CONTRATO.md','REVISION.md'])for(const root of [d,archive])for(const m of fs.readFileSync(p.join(root,name),'utf8').matchAll(/\]\(([^)]+)\)/g))assert.ok(fs.existsSync(p.resolve(root,m[1])),name+' '+m[1]);
write(p.join(d,'VERIFICACION-FINAL.json'),{result:'PASS',producto:623,preimagenesRegistros:12,manifest:manifest.length,archivo:copies.length,enlaces:'PASS',freeze:'PASS',mutantes:'3 RED atribuibles'});write(p.join(archive,'VERIFICACION-FINAL.json'),fs.readFileSync(p.join(d,'VERIFICACION-FINAL.json')));
console.log(JSON.stringify({result:'PASS',manifest:manifest.length,archivo:copies.length,producto:623}));
