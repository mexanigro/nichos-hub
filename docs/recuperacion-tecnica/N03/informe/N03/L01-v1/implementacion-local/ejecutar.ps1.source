param([string]$Etapa,[string]$Mutant='none')
$ErrorActionPreference='Stop';$base=$PSScriptRoot;$out=Join-Path $base "resultados/$Etapa"
if(Test-Path -LiteralPath $out){throw 'No sobrescribir evidencia'}
New-Item -ItemType Directory -Path $out | Out-Null
$dockerArgs=@('run','--rm','--pull=never','--network=none','--read-only','--cap-drop=ALL','--security-opt=no-new-privileges','--memory=1g','--tmpfs=/tmp:rw,size=64m','--mount',"type=bind,source=$base,target=/control,readonly",'--mount',"type=bind,source=$out,target=/salida",'--mount','type=bind,source=C:\Users\liama\Desktop\Nichos-hub\node_modules,target=/deps/node_modules,readonly','--mount','type=bind,source=C:\Users\liama\Desktop\Nichos-hub\src,target=/hub/src,readonly','--mount','type=bind,source=C:\Users\liama\Desktop\Nichos\Barber-shop-template-main\src,target=/template/src,readonly','sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2','/usr/bin/env','-i','PATH=/usr/local/bin:/usr/bin:/bin','HOME=/tmp',"MUTANT=$Mutant",'node','/control/contrato.cjs')
$dockerArgs | ConvertTo-Json | Set-Content -Encoding utf8 "$out/COMANDO.json"
& docker @dockerArgs 1> "$out/stdout.txt" 2> "$out/stderr.txt"
$result=$LASTEXITCODE
@{exit=$result;mutante=$Mutant;utc=[DateTime]::UtcNow.ToString('o')} | ConvertTo-Json | Set-Content -Encoding utf8 "$out/EXIT.json"
Get-Content -LiteralPath "$out/stdout.txt"
if($result -eq 2){Get-Content -LiteralPath "$out/stderr.txt"}
exit $result
