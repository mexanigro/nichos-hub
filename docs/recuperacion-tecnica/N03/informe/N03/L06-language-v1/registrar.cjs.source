const fs=require('node:fs'),p=require('node:path'),crypto=require('node:crypto');
const d=__dirname,root=p.resolve(d,'../../..'),hub='C:/Users/liama/Desktop/Nichos-hub',template=p.resolve(root,'../Barber-shop-template-main');
const sha=b=>crypto.createHash('sha256').update(b).digest('hex');
const read=file=>JSON.parse(fs.readFileSync(file,'utf8').replace(/^\uFEFF/,''));
const write=(file,data)=>{fs.mkdirSync(p.dirname(file),{recursive:true});fs.writeFileSync(file,data,{flag:'wx'});};
const previous=p.resolve(d,'../appointment-notify-auth-v1');
const sourceRows=read(p.join(previous,'FUENTES-FINALES.json'));
if(sourceRows.length!==333||sourceRows.some(x=>sha(fs.readFileSync(p.join(template,x.path)))!==x.sha256))throw Error('template drift');
for(const row of read(p.join(d,'FUENTES.json')))if(sha(fs.readFileSync(p.join(hub,row.path)))!==row.sha256||sha(fs.readFileSync(p.join(d,'preimagenes',row.path)))!==row.sha256)throw Error('hub/preimagen drift');
const data=read(p.join(d,'MEDICION.json')),expected=['he','en','ru','ar','es','en','ru','en','he','he'];
if(data.length!==10)throw Error('población');
const checks=data.flatMap((row,i)=>[{case:i,criterion:'config conserva idioma hub',valid:row.configLanguage===row.hubLanguage},{case:i,criterion:'payload de idioma',valid:row.propagatedLanguage===expected[i]}]);
if(checks.filter(x=>!x.valid).length!==17)throw Error('RED inesperado');
write(p.join(d,'RED.json'),JSON.stringify({result:'RED',instrumentExit:0,cases:10,checks,expectedFailures:17,externalCalls:0,aiAttempts:0},null,2));
write(p.join(previous,'ACEPTACION-Y-REVISION-EXTERNA.md'),`# appointment-notify-auth-v1 — aceptación local y revisión externa trasladada\n\nAutoridad/procedencia: Liam en esta conversación,2026-09-09,acepta cierre local y traslada revisión del segundo pensamiento, separada de Harvey. Objeto: CIERRE-LOCAL.md SHA256 ${sha(fs.readFileSync(p.join(previous,'CIERRE-LOCAL.md')))}.\n\nResumen recibido: diff exacto de dos instrucciones;332 fuentes restantes intactas; evidencia HTTP270/270 y mutación90fallos funcionales esperados. El segundo pensamiento reejecutó tipos y nueve casos del handler con dependencias simuladas, confirmando rechazo antes de leer cuerpo y sin notificaciones. No se atribuyen estas reejecuciones a Harvey ni al integrador. Revisión interna anterior permanece en REVISION-FINAL.md.\n\nAceptación incorporada.333fuentes finales verificadas vigentes en esta continuación,sin repetir suites. Reparación descontada de pendientes locales de N03; N04 mantiene certificación de identidad/entorno reales. N03 abierta y condición previa al despliegue por prestaciones de tenant vigente.\n`);
const custody=[];
function update(rel,notice){const file=p.join(root,rel),bytes=fs.readFileSync(file),pre=p.join(d,'preimagenes-registros',rel);write(pre,bytes);if(sha(fs.readFileSync(pre))!==sha(bytes))throw Error('custody');fs.writeFileSync(file,bytes.toString('utf8').replace('\n','\n\n'+notice+'\n'));custody.push({path:rel,before:sha(bytes),after:sha(fs.readFileSync(file)),preimage:p.relative(root,pre)});}
update('informe/N03/appointment-notify-auth-v1/INFORME.md','**Cierre local aceptado por Liam.** [Aceptación y revisión externa del segundo pensamiento, separada de Harvey](ACEPTACION-Y-REVISION-EXTERNA.md). Dos instrucciones/332fuentes conservadas,HTTP270,mutación90;tipos y9casos reejecutados por revisión externa. Reparación descontada de N03. N04 identidad/entorno reales y condición de prestaciones por tenant vigentes; N03 sigue abierta.');
update('informe/N03/reconciliacion-v1/BALANCE.md','**Adenda vigente, sin rehacer la reconciliación:** descontadas las entregas locales aceptadas posteriores: lint-v1, L05 servidor/navegador, clientId-v1 y ahora [appointment-notify-auth-v1](../appointment-notify-auth-v1/ACEPTACION-Y-REVISION-EXTERNA.md), además de book/support/stock/health-SP-H01/D05 ya aceptadas. L05 y selección clientId local quedan satisfechas en esos alcances; proyecto/base/coherencia real y demás obligaciones originales permanecen. Única selección de esta continuación: parte L06 de idioma omitido en config por onboarding, [propuesta acotada](../L06-language-v1/PROPUESTA.md). No cierra H01/ES-A completo ni autoriza implementación; no se reabren entregas aceptadas. N04 conserva identidad/entorno reales y condición previa de prestaciones por tenant permanece. Techo vigente80%TOTAL N03,observado78%,sin resets. Tabla y recomendación lint inferiores son corte histórico, no nueva cola de trabajo.');
for(const rel of ['indice/tareas/N03.md','indice/README.md','indice/PENDIENTES.md','indice/CALENDARIO.md']){
 const prefix=rel.includes('/tareas/')?'../../':'../';
 update(rel,`**N03 vigente: appointment-notify-auth-v1 aceptada y descontada; única preparación L06-language-v1.** [Propuesta](${prefix}informe/N03/L06-language-v1/PROPUESTA.md): onboarding guarda idioma en hub pero omite config.language;10casos simulados acreditan fallback he del consumidor. Se propone sólo language:locale en config del POST onboarding. Producto sin editar; pendiente autorización y contrato final/freeze. No se cierra H01/ES-A completo ni se reabren entregas aceptadas. N04 identidad/entorno reales,N08 propagación real y condición prestaciones por tenant vigentes. Consumo78%/80%TOTAL,sin resets; detenido para revisión. Estados inferiores históricos.`);
}
write(p.join(d,'CUSTODIA-REGISTROS.json'),JSON.stringify(custody,null,2));
write(p.join(root,'historial/2026-09-09-N03-L06-language-preparacion.md'),`# N03 — aceptación auth y preparación L06\n\nAceptado appointment-notify-auth-v1; revisión externa del segundo pensamiento integrada separada de Harvey (tipos y9casos propios, además contraste270HTTP/90mutación/332fuentes).333fuentes actuales verificadas,sin repetir pruebas aceptadas. Balance actualizado mediante adenda descontando entregas cerradas.\n\nÚnica obligación seleccionada: L06 idioma guardado sólo en hub, ausente en config del onboarding. POST y deployToVercel ejecutados con dependencias simuladas,10casos;config sin idioma ypayloadhe en todos.17fallos de contrato esperado en20comprobaciones,sondeoexit0,sinred niIA. [Propuesta](../informe/N03/L06-language-v1/PROPUESTA.md): una propiedad en un archivo;es mantiene fallbacken de template yausencia sigue defaulten del productor,efectos explicitados para autorización. Sin producto modificado ni freeze.\n\nRetoma: aprobación de propuesta, completar adversos/referencias antesfreeze,P0→P3. No otras obligaciones. N03 abierta,N04 identidad/entorno reales y condición prestaciones por tenant intactas. Consumo78%/80%TOTAL,sin resets,instalaciones,operaciones remotas,ramas/worktrees,commit,push/deploy.\n`);
console.log(JSON.stringify({registered:true,templateSourcesUnchanged:333,hubSourcesUnchanged:5,redChecks:17,cases:10,records:custody.length}));
