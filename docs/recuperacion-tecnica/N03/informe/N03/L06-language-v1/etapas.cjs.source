const fs=require('node:fs'),p=require('node:path'),crypto=require('node:crypto'),{spawnSync}=require('node:child_process');
const d=__dirname,hub='C:/Users/liama/Desktop/Nichos-hub',template='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main';
const read=file=>JSON.parse(fs.readFileSync(file,'utf8').replace(/^\uFEFF/,''));
const sha=b=>crypto.createHash('sha256').update(b).digest('hex');
const write=(file,data)=>{fs.mkdirSync(p.dirname(file),{recursive:true});fs.writeFileSync(file,data,{flag:'wx'});};
const rows=read(p.join(d,'FUENTES.json')),target='src/app/api/onboarding/route.ts';
const prefix='    await db.collection("config").doc(slug).set({',addition='      language: locale,';
function patched(before){const start=before.indexOf(prefix);if(start<0||before.split(prefix).length!==2)throw Error('config anchor');const pos=start+prefix.length;const eol=before.slice(pos,pos+2)==='\r\n'?'\r\n':'\n';return before.slice(0,pos)+eol+addition+before.slice(pos);}
if(process.argv[2]==='freeze'){
 for(const row of rows)if(sha(fs.readFileSync(p.join(hub,row.path)))!==row.sha256)throw Error('hub drift '+row.path);
 const prior=read(p.resolve(d,'../appointment-notify-auth-v1/FUENTES-FINALES.json'));for(const row of prior)if(sha(fs.readFileSync(p.join(template,row.path)))!==row.sha256)throw Error('template drift');
 const prepared=read(p.join(d,'CIERRE-PREPARACION.json'));if(sha(fs.readFileSync(p.join(d,'PROPUESTA.md')))!==prepared.proposalSha256)throw Error('proposal drift');
 const files=['PROPUESTA.md','sondeo.cjs','acceptance.cjs','tsconfig.json','MEDICION.json','referencia-r2/MEDICION.json'];
 const hashes=files.map(path=>({path,sha256:sha(fs.readFileSync(p.join(d,path)))}));
 for(const file of ['sondeo.cjs','acceptance.cjs','etapas.cjs']){const r=spawnSync(process.execPath,['--check',p.join(d,file)],{encoding:'utf8'});if(r.status!==0)throw Error(r.stderr);}
 const red=spawnSync(process.execPath,[p.join(d,'acceptance.cjs'),'referencia-r2'],{encoding:'utf8'});
 write(p.join(d,'RED-P0.stdout.txt'),red.stdout);write(p.join(d,'RED-P0.stderr.txt'),red.stderr);
 const result=read(p.join(d,'referencia-r2/ACEPTACION.json'));if(red.status!==1||result.failed!==17||result.checks.some(c=>!c.valid&&c.name.endsWith(':conservation')))throw Error('RED inválido');
 const git=[];for(const repo of [hub,template]){const r=spawnSync('git',['-C',repo,'worktree','list','--porcelain'],{encoding:'utf8'});if(r.status!==0||(r.stdout.match(/^worktree /gm)||[]).length!==1||!r.stdout.includes('branch refs/heads/main'))throw Error('git');git.push({repo,state:r.stdout});}
 write(p.join(d,'REVISION-EXTERNA-PREPARACION.md'),'# Revisión externa trasladada por Liam\n\nProcedencia: autorización de implementación en esta conversación,2026-09-09. Separada de Harvey. El segundo pensamiento reejecutó14escenarios sin red ni escrituras a disco y coincidieron con la referencia;5fuentes hub y333template conservaron huellas. Omisión entre onboarding yconfig comprobada. No se atribuye esa reejecución al integrador. Liam aprueba exclusivamente language:locale, incluyendo ausencia→defaultinglés y es→fallbackinglés,sin migrar existentes.\n');
 write(p.join(d,'FREEZE.json'),JSON.stringify({gate:'P0',reached:true,time:new Date().toISOString(),authorization:'Liam autoriza P0→P3, una propiedad, efectos ausencia/es explícitos',hashes,hubSources:rows,templateSources:prior,git,redExit:1,redFailures:17,blockers:[],usage:78,totalCapN03:80},null,2));console.log('P0: freeze, 17 fallos funcionales conservados; fuentes vigentes');
}else if(process.argv[2]==='implement'){
 const freeze=read(p.join(d,'FREEZE.json'));for(const row of freeze.hashes)if(sha(fs.readFileSync(p.join(d,row.path)))!==row.sha256)throw Error('freeze changed');
 const file=p.join(hub,target),before=fs.readFileSync(file);if(sha(before)!==rows.find(r=>r.path===target).sha256)throw Error('source drift');
 write(p.join(d,'preimagenes-p1',target),before);
 if(sha(fs.readFileSync(p.join(d,'preimagenes-p1',target)))!==sha(before))throw Error('preimage');
 const after=patched(before.toString('utf8'));fs.writeFileSync(file,after);
 write(p.join(d,'P1.json'),JSON.stringify({gate:'P1',reached:true,path:target,before:sha(before),after:sha(after),onlyPropertyAdded:true},null,2));console.log('P1: sólo language: locale en config');
}else if(process.argv[2]==='mutate'){
 const before=fs.readFileSync(p.join(d,'preimagenes-p1',target),'utf8'),current=fs.readFileSync(p.join(hub,target),'utf8');if(current!==patched(before))throw Error('unexpected diff');
 const copy=p.join(d,'copia-mutacion');fs.mkdirSync(copy);
 for(const row of rows){const bytes=fs.readFileSync(p.join(hub,row.path));if(row.path!==target&&sha(bytes)!==row.sha256)throw Error('foreign drift');write(p.join(copy,row.path),bytes);}
 write(p.join(d,'preimagen-mutacion.ts'),current);
 // La copia recibe exactamente la preimagen: se elimina únicamente la propiedad insertada.
 fs.writeFileSync(p.join(copy,target),before);
 write(p.join(d,'MUTACION.json'),JSON.stringify({path:target,before:sha(current),after:sha(before),onlyPropertyRemoved:true},null,2));console.log(copy);
}else throw Error('freeze | implement | mutate');
