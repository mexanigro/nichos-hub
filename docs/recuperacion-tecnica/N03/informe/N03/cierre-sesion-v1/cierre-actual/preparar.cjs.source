const fs=require('fs'),p=require('path'),cp=require('child_process'),crypto=require('crypto'),d=__dirname,canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',hub='C:/Users/liama/Desktop/Nichos-hub',mirror=hub+'/docs/recuperacion-tecnica/N03',template='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',hash=b=>crypto.createHash('sha256').update(b).digest('hex');const create=(f,b)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,b,{flag:'wx'})};const run=(r,a)=>cp.execFileSync('git',a,{cwd:r,maxBuffer:32e6}).toString();
const products={hub:['src/app/api/onboarding/client-info/route.ts','src/components/client-config-tab.tsx','src/components/client-language-banner.tsx','src/components/config-editors/payment-provider-editor.tsx','src/lib/wizard/config-to-wizard.ts','src/lib/email-templates.ts','src/proxy.ts','src/middleware.ts'],template:['AGENTS.md','server.ts','api/index.ts','src/components/admin/AdminDashboard.tsx','src/components/admin/AppointmentCalendar.tsx','src/components/booking/BookingWizard.tsx','src/config/site.ts','src/config/tour.config.ts','src/lib/api/admin-auth.ts','src/lib/api/payment-gateways.ts','src/lib/api/checkout-handler.ts','src/lib/api/crm-appointments-handler.ts','src/services/crm-appointments.ts']};
const inventories=[];for(const[name,r]of Object.entries({hub,template})){if(run(r,['diff','--cached','--name-only']).trim())throw Error('index not empty');const status=run(r,['status','--porcelain=v1','-z','--untracked-files=all']);create(d+'/STATUS-PRE-'+name+'.txt',status.replaceAll('\0','\n'));const dirty=run(r,['diff','--name-only','-z']).split('\0').filter(Boolean);inventories.push({name,root:r,head:run(r,['rev-parse','HEAD']).trim(),selected:products[name],preserved:dirty.filter(f=>!products[name].includes(f)&&!f.startsWith('docs/recuperacion-tecnica/N03/')).map(file=>({file,sha256:fs.existsSync(p.join(r,file))?hash(fs.readFileSync(p.join(r,file))):null})),selectedHashes:products[name].map(file=>({file,sha256:fs.existsSync(p.join(r,file))?hash(fs.readFileSync(p.join(r,file))):null}))})}
create(d+'/SELECCION-PRODUCTO.json',JSON.stringify(inventories,null,2));
const text='# Cierre de sesión N03 — abierta\n\nLímite vigente: trabajo técnico hasta99% TOTAL; último1% reservado para commit/push. No hace falta agotarlo. Sustituye reserva98–100; sin resets. Último consumo observado96%.\n\nRevisión externa comunicada por Liam: reprodujo48casos/264comprobaciones y los mismos16fallos; verificó custodia y huellas. Resultado conservado, sin repetir suites: agenda integrada localmente; reserva→checkout pendiente por autoridad de precio. No representa cierre de N03.\n\nBloqueo: book no escribepriceCents/price y checkout rechaza400. Decisión pendiente: fuente autoritativa del precio porserviceId y conducta cuando no verificable. Propuesta ya presentada: catálogo config backend y rechazo antes de reserva online si no puede verificarse. Liam dejó esa decisión pendiente. No modificar booking ni históricos mientras continúe así; no asumir aprobación por autorización de commit.\n\nRetoma: leer BALANCE vigente y integracion-final/ACTA-RED-RETOMA.md. Resolver sólo esa decisión antes de implementar. Después debe pasar el mismo contrato pipeline48casos264comprobaciones, conservando expectativa200 para reserva→checkout sin insertar precio artificial. Revalidar positivos/negativos afectados y mutaciones de guarda/sobrerrechazo; no repetir suites aceptadas ajenas. Revisión integrada final antes de declarar N03completa.\n\nPublicación: commit local autorizado del trabajo propio; push condicionado a no desplegar. Consulta Vercel de sólo lectura confirma varios proyectos ligados al repo Barber-shop-template. get_project no informa desactivación de auto-deploy; railway.toml tampoco garantiza desactivación y no hay verificación remota Railway. No se puede acreditar la condición: PUSH NO EJECUTADO, no se cambia hosting ni se usa skip-ci como garantía. Se requiere evidencia vigente de automatismos deshabilitados antes de publicar estas ramas main. No es falta de autorización para push: es impedimento concreto de su condición.\n\nSelección explícita en SELECCION-PRODUCTO.json: producto N03 propio y archivo documental N03; sin git add general, reset, limpieza ni force-add de evidencias ignoradas. Trabajo ajeno/preexistente preservado según inventario anterior y actual; no se incluyen locales/db/deploy/cardcom ajenos, imágenes, ruvector, .gitignore ni herramientas externas. El AGENTS hub mixto/noatribuible completo queda fuera; su corrección H07 permanece custodiada localmente.\n\nEtapas posteriores y prestaciones por tenant antes de despliegue conservadas. Sin cambio funcional, nuevas pruebas, instalaciones, ramas/worktrees ni despliegue en este cierre. Commits/resultados se registran en COMMITS.json.\n';create(d+'/CIERRE-SESION.md',text);
const rels=['informe/N03/reconciliacion-v1/BALANCE.md','informe/N03/reconciliacion-v1/SIGUIENTE-ACCION.md','informe/N03/cierre-sesion-v1/RETOMA.md','indice/tareas/N03.md','indice/README.md','indice/CALENDARIO.md'];const records=[];for(const[i,root]of[canon,mirror].entries())for(const rel of rels){const target=p.join(root,rel),b=fs.readFileSync(target);create(d+'/preimagenes/'+i+'/'+rel,b);let s=b.toString('utf8'),n=s.indexOf('\n'),link=p.relative(p.dirname(target),p.join(root,p.relative(canon,d),'CIERRE-SESION.md')).replaceAll('\\','/');s=s.slice(0,n+1)+'\n**Cierre de sesión vigente: N03 abierta.** Agenda integrada localmente; reserva→checkout pendiente por autoridad del precio, que Liam mantiene sin decidir. Revisión externa comunicada reproduce48/264con16fallos y custodia/huellas. Trabajo técnico hasta99% TOTAL; último1% commit/push. Commit propio autorizado; push detenido hasta acreditar que no despliega (conexiones Git Vercel constatadas; desactivación automática no verificada). No modificar booking/históricos; etapas y condición por tenant intactas. [Retoma y publicación](<'+link+'>). Cortes inferiores históricos.\n\n'+s.slice(n+1);fs.writeFileSync(target,s);records.push({target,before:hash(b),after:hash(Buffer.from(s))})}create(d+'/REGISTROS.json',JSON.stringify(records,null,2));
const readme=mirror+'/README.md',b=fs.readFileSync(readme);create(d+'/preimagenes/README-archivo.md',b);fs.writeFileSync(readme,'# N03 — custodia de sesión, tarea abierta\n\n[Retoma vigente](informe/N03/cierre-sesion-v1/cierre-actual/CIERRE-SESION.md). Agenda integrada localmente; precio reserva→checkout pendiente.\n\n'+b.toString('utf8').slice(b.toString('utf8').indexOf('Copia seleccionada'))+'\nEl ARCHIVO.json original describe su corte histórico. Las adendas posteriores conservan manifiestos propios; cierre-actual documenta selección/publicación sin reescribir custodia anterior.\n');console.log(JSON.stringify({products:products,records:records.length}));
