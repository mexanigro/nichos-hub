const fs=require('fs'),p=require('path'),cp=require('child_process'),crypto=require('crypto'),d=__dirname,canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',hub='C:/Users/liama/Desktop/Nichos-hub',mirror=hub+'/docs/recuperacion-tecnica/N03',prefix='docs/recuperacion-tecnica/N03/',hash=b=>crypto.createHash('sha256').update(b).digest('hex'),git=a=>cp.execFileSync('git',a,{cwd:hub,maxBuffer:32e6}).toString();const create=(f,b)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,b,{flag:'wx'})};function files(dir){return fs.readdirSync(dir,{withFileTypes:true}).flatMap(e=>e.isDirectory()?files(p.join(dir,e.name)):[p.join(dir,e.name)])}
const ignored=git(['ls-files','--others','--ignored','--exclude-standard','-z','--',prefix]).split('\0').filter(Boolean).map(file=>{const b=fs.readFileSync(hub+'/'+file);return{file,bytes:b.length,sha256:hash(b),excluded:true}});create(d+'/EVIDENCIA-EXCLUIDA.json',JSON.stringify(ignored,null,2));
const custody=[];for(const f of files(d)){const b=fs.readFileSync(f),target=p.join(mirror,p.relative(canon,f))+( /\.(cjs|ps1)$/.test(f)?'.source':'');create(target,b);custody.push({source:f,target,bytes:b.length,sha256:hash(b)})}create(d+'/CUSTODIA-SESION.json',JSON.stringify(custody,null,2));create(p.join(mirror,p.relative(canon,d),'CUSTODIA-SESION.json'),JSON.stringify(custody,null,2));
const selected=[...new Set([...git(['diff','--name-only','-z','--',prefix]).split('\0'),...git(['ls-files','--others','--exclude-standard','-z','--',prefix]).split('\0')])].filter(Boolean);if(selected.some(f=>/\.(ts|tsx)$/.test(f)))throw Error('compiled archive source');const inventory=selected.map(file=>{const b=fs.readFileSync(hub+'/'+file);return{file,bytes:b.length,sha256:hash(b)}});const manifest={files:inventory.length,bytes:inventory.reduce((s,x)=>s+x.bytes,0),ignoredPreserved:ignored.length,selection:inventory};create(d+'/SELECCION-ARCHIVO.json',JSON.stringify(manifest,null,2));const mf=p.join(mirror,p.relative(canon,d),'SELECCION-ARCHIVO.json');create(mf,JSON.stringify(manifest,null,2));selected.push(p.relative(hub,mf).replaceAll('\\','/'));
if(git(['diff','--cached','--name-only']).trim())throw Error('nonempty index');for(let i=0;i<selected.length;i+=40)git(['-c','core.autocrlf=false','add','--',...selected.slice(i,i+40)]);const staged=git(['diff','--cached','--name-only','-z']).split('\0').filter(Boolean);if(staged.length!==selected.length||staged.some(f=>!selected.includes(f)))throw Error('selection mismatch');for(const f of inventory){const b=cp.execFileSync('git',['show',':'+f.file],{cwd:hub,maxBuffer:25e6});if(hash(b)!==f.sha256)throw Error('stage bytes differ '+f.file)}console.log(JSON.stringify({staged:staged.length,bytes:manifest.bytes,excluded:ignored.length}));
