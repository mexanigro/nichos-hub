const fs=require('fs'),cp=require('child_process'),crypto=require('crypto'),d=__dirname,selection=JSON.parse(fs.readFileSync(d+'/SELECCION-PRODUCTO.json','utf8')),hash=b=>crypto.createHash('sha256').update(b).digest('hex');const commits=[];for(const r of selection){const git=a=>cp.execFileSync('git',a,{cwd:r.root,maxBuffer:20e6});for(const x of r.selectedHashes)if(x.sha256&&hash(fs.readFileSync(r.root+'/'+x.file))!==x.sha256)throw Error('drift');git(['-c','core.autocrlf=false','add','--',...r.selected]);const selected=git(['diff','--cached','--name-only','-z']).toString().split('\0').filter(Boolean);if(selected.some(f=>!r.selected.includes(f)))throw Error('foreign staged');fs.writeFileSync(d+'/DIFF-STAGED-'+r.name+'.patch',git(['diff','--cached','--binary']),{flag:'wx'});const check=cp.spawnSync('git',['diff','--cached','--check'],{cwd:r.root,encoding:'utf8'});fs.writeFileSync(d+'/CHECK-'+r.name+'.txt',check.stdout+check.stderr,{flag:'wx'});if(check.status!==0)throw Error('diffcheck '+r.name);const result=git(['commit','-m',r.name==='hub'?'fix(n03): preserve accepted hub connections and payment controls':'fix(n03): connect CRM origins and backend payment authority']);const commit=git(['rev-parse','HEAD']).toString().trim();commits.push({repo:r.name,commit,paths:selected,output:result.toString(),push:'NOT_ATTEMPTED_NO_DEPLOY_NOT_VERIFIED'});for(const x of r.preserved)if(x.sha256&&hash(fs.readFileSync(r.root+'/'+x.file))!==x.sha256)throw Error('foreign changed');}
fs.writeFileSync(d+'/COMMITS.json',JSON.stringify(commits,null,2),{flag:'wx'});console.log(JSON.stringify(commits.map(({repo,commit,paths,push})=>({repo,commit,files:paths.length,push}))));
