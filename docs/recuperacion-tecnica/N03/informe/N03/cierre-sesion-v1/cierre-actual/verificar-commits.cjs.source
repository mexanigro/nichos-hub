const fs=require('fs'),p=require('path'),cp=require('child_process'),crypto=require('crypto'),d=__dirname,rows=JSON.parse(fs.readFileSync(d+'/SELECCION-PRODUCTO.json','utf8')),hash=b=>crypto.createHash('sha256').update(b).digest('hex'),commits=[];for(const r of rows){for(const x of [...r.preserved,...r.selectedHashes])if(x.sha256&&hash(fs.readFileSync(r.root+'/'+x.file))!==x.sha256)throw Error('working bytes drift '+x.file);const sha=cp.execFileSync('git',['rev-parse','HEAD'],{cwd:r.root}).toString().trim();const files=cp.execFileSync('git',['diff-tree','--no-commit-id','--name-only','-r',sha],{cwd:r.root}).toString().trim().split('\n');if(files.some(x=>!r.selected.includes(x)))throw Error('unexpected committed');commits.push({repo:r.name,commit:sha,files,push:'NO_EJECUTADO_CONDICION_NO_DEPLOY_NO_VERIFICADA',preservedHashesVerified:r.preserved.length})}fs.writeFileSync(d+'/COMMITS.json',JSON.stringify(commits,null,2),{flag:'wx'});
fs.writeFileSync(d+'/REVISION-SELECCION.md','# Revisión de selección\n\nÍndices inicialmente vacíos. Selección explícita propia N03; hashes del resto de cambios tracked conservados. Commit hub y template verificados por diff-tree; sin cambios de producto en este cierre. Primer check reportó CRLF como whitespace; comprobación cr-at-eol sólo para interpretar terminadores, sin cambiar configuración persistente. Template mantiene11espacios de líneas previas de BookingWizard y1línea vacía final de handler nuevo. Hallazgo NON-BLOCKING de formato; se preservan bytes revisados y se registra check no limpio, sin atribuirle GREEN. No se repiten suites.\n\nIntentos instrumentales preservados: staging original realizado; el segundo intento quiso volver a añadir middleware ya eliminado del índice y falló pathspec. Se reutilizó índice comprobado y se completó commit. No hubo reset ni restauración de trabajo ajeno.\n\nPush no intentado: integración Git Vercel observada y desactivación no acreditada; Railway tampoco verificado. No se cambiaron proveedores/automatismos para forzar publicación.\n',{flag:'wx'});console.log(JSON.stringify(commits));
