+          const service = SERVICES.find(s => s.id === result.serviceId);
+          if (service) setSelectedService(service);
+        }
+      }
+    } catch (err) {
+      console.error("AI Consult failed:", err);
+    } finally {
+      setIsConsulting(false);
+    }
+  };
+
+  const renderHeader = () => {
