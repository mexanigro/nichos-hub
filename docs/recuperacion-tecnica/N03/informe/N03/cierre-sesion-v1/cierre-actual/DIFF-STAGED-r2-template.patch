+      const response = await fetch(`/api/crm/appointments/${encodeURIComponent(item.origin.documentId)}`, {
+        method: "PATCH", headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
+        body: JSON.stringify(patch),
+      });
