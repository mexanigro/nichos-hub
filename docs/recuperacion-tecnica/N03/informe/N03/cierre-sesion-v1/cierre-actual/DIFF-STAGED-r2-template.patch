+                  </button>
+                ))}
+              </div>
+            </motion.div>
+          )}
+
+          {step === "datetime" && (
+            <motion.div
+              initial={{ opacity: 0, x: 20 }}
+              animate={{ opacity: 1, x: 0 }}
+              exit={{ opacity: 0, x: -20 }}
