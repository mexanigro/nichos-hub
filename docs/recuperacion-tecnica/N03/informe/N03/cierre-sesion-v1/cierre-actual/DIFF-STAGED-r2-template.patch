+            <KnowledgeTab />
+          ) : activeTab === "users" ? (
+            <UsersTab />
+          ) : activeTab === "tasks" ? (
+            <TasksTab currentRole={currentRole} currentEmail={currentEmail} />
+          ) : null}
+        </div>
+      </div>
+    </div>
+  );
+}
