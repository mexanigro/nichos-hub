+
+                <div className="my-2 h-px bg-border" />
+
+                {staffList.map((b) => (
+                  <button
+                    type="button"
+                    key={b.id}
+                    onClick={() => { setSelectedStaff(b); setAnySpecialist(false); setStep("datetime"); }}
