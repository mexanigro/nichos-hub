const fs=require('node:fs');
const path=require('node:path');
const cp=require('node:child_process');
const crypto=require('node:crypto');
const root=__dirname, n03=path.dirname(root);
const repos={template:'C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',hub:'C:/Users/liama/Desktop/Nichos-hub'};
const hash=b=>crypto.createHash('sha256').update(b).digest('hex');
const read=p=>JSON.parse(fs.readFileSync(p,'utf8').replace(/^\uFEFF/,''));
const entries=read(path.join(root,'PROCEDENCIA-PRODUCTO.json'));
const checks=[];
for(const [repo,file] of [['template','appointment-notify-auth-v1/FUENTES-FINALES.json'],['hub','lint-v1/FUENTES-FINALES.json']]) {
  const sources=read(path.join(n03,file));
  for(const s of sources) if(hash(fs.readFileSync(path.join(repos[repo],s.path)))!==s.sha256.toLowerCase()) throw Error(`Evidence drift ${repo}:${s.path}`);
  checks.push({repo,manifest:file,count:sources.length,valid:true});
}
for(const repo of Object.keys(repos)) {
  const staged=cp.execFileSync('git',['diff','--cached','--name-only'],{cwd:repos[repo]}).toString().trim();
  if(staged) throw Error('Index not empty '+repo);
}
for(const e of entries) {
  if(hash(fs.readFileSync(path.join(repos[e.repo],e.rel)))!==e.workingSha256) throw Error('Working drift');
  const b=fs.readFileSync(path.join(root,'indice-producto',e.repo,e.rel));
  if(hash(b)!==e.stagedSha256) throw Error('Staged preparation drift');
  const oid=cp.execFileSync('git',['hash-object','-w','--stdin'],{cwd:repos[e.repo],input:b}).toString().trim();
  cp.execFileSync('git',['update-index','--add','--cacheinfo',`100644,${oid},${e.rel}`],{cwd:repos[e.repo]});
  e.stagedBlob=oid;
}
for(const repo of Object.keys(repos)) {
  const run=args=>cp.execFileSync('git',args,{cwd:repos[repo],maxBuffer:16*1024*1024});
  fs.writeFileSync(path.join(root,`DIFF-STAGED-${repo}.patch`),run(['diff','--cached']));
  fs.writeFileSync(path.join(root,`CHECK-STAGED-${repo}.txt`),run(['diff','--cached','--check']));
  console.log(repo+' '+run(['diff','--cached','--stat']).toString());
}
fs.writeFileSync(path.join(root,'INDICE-VERIFICADO.json'),JSON.stringify({time:new Date().toISOString(),checks,entries},null,2)+'\n');
