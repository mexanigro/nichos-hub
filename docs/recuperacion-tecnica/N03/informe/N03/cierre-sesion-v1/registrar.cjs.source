const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),cp=require('node:child_process');
const root=__dirname, recovery=path.resolve(root,'../../..'),n03=path.dirname(root);
const hash=b=>crypto.createHash('sha256').update(b).digest('hex');
const write=(p,b)=>{fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,b);};
const template='edd8f76345000bb669322486895b0e2d55eac480', hub='3917700a26cc0d59b96325865d96e14bf56234d5';
const custody=[];
function prepend(rel,text) {
  const p=path.join(recovery,rel),b=fs.readFileSync(p);
  const pre=path.join(root,'preimagenes-registros',rel);
  if(fs.existsSync(pre)) throw Error('Registro ya preparado '+rel);
  write(pre,b); custody.push({path:p,preimage:pre,sha256:hash(b)});
  const old=b.toString('utf8');const end=old.indexOf('\n');
  write(p,old.slice(0,end+1)+'\n'+text+'\n\n'+old.slice(end+1));
}
