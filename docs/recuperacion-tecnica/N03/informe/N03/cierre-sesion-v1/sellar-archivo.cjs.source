const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),cp=require('node:child_process');
const root=__dirname,repo='C:/Users/liama/Desktop/Nichos-hub',prefix='docs/recuperacion-tecnica/N03/',dest=path.join(repo,prefix);
const hash=b=>crypto.createHash('sha256').update(b).digest('hex');
const write=(p,b)=>{fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,b);};
const manifest=JSON.parse(fs.readFileSync(path.join(root,'ARCHIVO.json'),'utf8'));
const old=fs.readFileSync(path.join(root,'ARCHIVO.json'));
write(path.join(root,'preimagenes-registros/ARCHIVO-antes-sello.json'),old);
const checkPath=path.join(root,'CHECK-ARCHIVO.txt'),checkBytes=fs.readFileSync(checkPath);
write(path.join(root,'INFORME.md'),`# N03 — cierre de sesión y custodia\n\nProducto propio commiteado en main: template edd8f76345000bb669322486895b0e2d55eac480 (22 archivos, cinco parciales) y hub3917700a26cc0d59b96325865d96e14bf56234d5 (7 archivos). Sin cambios funcionales en esta continuación. [Retoma](RETOMA.md). Archivo documental en hub/docs/recuperacion-tecnica/N03; su commit se verifica en VERIFICACION-FINAL.json fuera de Git al terminar, evitando autorreferencia.\n\nGates de este cierre: procedencia/preimágenes verificadas;commits de producto;archivo y retoma preparados;verificación final tras commit documental. N03 y W-NEXT no cerrados. W-NEXT sin implementación autorizada ni comparación adicional esta sesión. Consumo observado80%,techo85% TOTAL N03,sin resets;la sesión nueva hereda techo y consumo.\n\nControles:333 fuentes template y6lint coincidentes;29 contenidos propios del índice verificados;diff de producto revisado y git diff --cached --check0 en ambos. Índice parcial separa trabajo previo,conservado físicamente. No hooks ejecutables de commit ni core.hooksPath configurado identificados;no push. No suites vigentes repetidas ni certificación de un checkout limpio.\n\nArchivo: origen/destino/SHA256 en ARCHIVO.json;preimágenes,copias y salidas voluminosas en EVIDENCIA-FISICA-FINAL.json y CUSTODIA-CIERRE.json. Código con .source,no fuente de compilación añadida. Scanner acotado sin patrones de credenciales detectados;no .env real. Registros N04/N06/N10 y método son contexto identificado, no autoría nueva ni modificaciones de producto.\n\nControl de whitespace del archivo devuelve2 por14072 ubicaciones de evidencia histórica (incluidos CRLF);no se altera para ocultar el resultado ni se relaja configuración. Se preservan bytes y huellas. Salida completa excluida por volumen: ${checkPath}, SHA256 ${hash(checkBytes)}, ${checkBytes.length}bytes. Manifiesto previo al sello: ${path.join(root,'preimagenes-registros/ARCHIVO-antes-sello.json')}, SHA256 ${hash(old)}.\n\nRefutación interna Harvey, separada de revisiones externas trasladadas: procedencia,completitud ylímites;sin BLOCKER/MATERIAL. Segunda revisión de retoma/archivo: cinco muestras de origen/copia/huella coincidentes, W-NEXT pendiente y locales/posteriores correctamente diferenciados. No suites/ediciones del revisor.\n\nCada ciclo produjo avance material: separación de cambios,29 entradas preparadas,commits reales,archivo con custodia yretoma. Sin fallos de instrumento ni repetición de estrategia. El resultado whitespace se clasifica por custodia,no como reparación de producto. N03 sigue abierta;prestaciones por tenant antes de despliegue vigentes.\n`);
const extras=['stage-archivo.cjs','sellar-archivo.cjs','REVISION-ARCHIVO.json','INFORME.md'];
for(const name of extras) {
  const source=path.join(root,name),b=fs.readFileSync(source),relative='informe/N03/cierre-sesion-v1/'+name+(name.endsWith('.cjs')?'.source':'');
  write(path.join(dest,relative),b);
  manifest.files.push({source,archive:relative,bytes:b.length,sha256:hash(b),context:false});
}
manifest.seal={time:new Date().toISOString(),review:'Harvey; procedencia y traspaso sin MATERIAL/BLOCKER',productDiffCheck:0,archivedHistoricalWhitespace:'Conservado sin alterar bytes;CHECK-ARCHIVO.txt local con huella en INFORME.md'};
const updated=JSON.stringify(manifest,null,2)+'\n';
write(path.join(root,'ARCHIVO.json'),updated);write(path.join(dest,'ARCHIVO.json'),updated);
const paths=extras.map(name=>prefix+'informe/N03/cierre-sesion-v1/'+name+(name.endsWith('.cjs')?'.source':'')).concat(prefix+'ARCHIVO.json');
cp.execFileSync('git',['-c','core.autocrlf=false','add','-f','--',...paths],{cwd:repo});
console.log(JSON.stringify({manifestEntries:manifest.files.length,added:extras.length}));
