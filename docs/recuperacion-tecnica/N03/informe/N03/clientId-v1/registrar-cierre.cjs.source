function update(rel,notice){const file=p.join(root,rel),before=fs.readFileSync(file),pre=p.join(d,'preimagenes-registros-cierre',rel);write(pre,before);if(sha(fs.readFileSync(pre))!==sha(before))throw Error('custodia');const old=before.toString('utf8');fs.writeFileSync(file,old.replace('\n','\n\n'+notice+'\n'));custody.push({path:rel,before:sha(before),after:sha(fs.readFileSync(file)),preimage:p.relative(root,pre)});}
