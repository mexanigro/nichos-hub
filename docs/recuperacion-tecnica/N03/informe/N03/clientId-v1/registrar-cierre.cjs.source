const fs=require('node:fs'),p=require('node:path'),c=require('node:crypto');
const d=__dirname,root=p.resolve(d,'../../..'),sha=b=>c.createHash('sha256').update(b).digest('hex');
const write=(file,text)=>{fs.mkdirSync(p.dirname(file),{recursive:true});fs.writeFileSync(file,text,{flag:'wx'})};
const result=JSON.parse(fs.readFileSync(p.join(d,'ACEPTACION-FINAL.json'),'utf8'));if(result.result!=='GREEN')throw Error('aceptación no GREEN');
