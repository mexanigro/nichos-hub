const fs=require('node:fs'),p=require('node:path'),c=require('node:crypto');
const d=__dirname,root=p.resolve(d,'../../..'),template='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main';
const hash=b=>c.createHash('sha256').update(b).digest('hex');
const write=(file,text)=>{fs.mkdirSync(p.dirname(file),{recursive:true});fs.writeFileSync(file,text,{flag:'wx'})};
const manifest=JSON.parse(fs.readFileSync(p.join(d,'../L05-browser-v1/FUENTES-FINALES.json'),'utf8'));
for(const row of manifest)if(hash(fs.readFileSync(p.join(template,row.path)))!==row.sha256)throw Error('producto distinto '+row.path);
const pre=JSON.parse(fs.readFileSync(p.join(d,'PREFLIGHT.json'),'utf8'));for(const row of pre.manifest)if(hash(fs.readFileSync(p.join(template,row.path)))!==row.sha256)throw Error('fuente distinta '+row.path);
const custody=[];
function update(rel,notice){const file=p.join(root,rel),before=fs.readFileSync(file),target=p.join(d,'preimagenes-registros-stop',rel);write(target,before);if(hash(fs.readFileSync(target))!==hash(before))throw Error('custodia');const text=before.toString('utf8');fs.writeFileSync(file,text.replace('\n','\n\n'+notice+'\n'));custody.push({path:rel,before:hash(before),after:hash(fs.readFileSync(file)),preimage:p.relative(root,target)});}
update('informe/N03/clientId-v1/INFORME.md','**Implementación autorizada: STOP en P0, RED0/4.** [Bloqueo y retoma exacta](STOP-P0.md). Dos fallos de instrumento: archivo D05 inexistente, corregido una vez; luego Docker125 por punto /app/node_modules ausente en copia readonly. No Node/runtimes ejecutados; no freeze ni producto. Política aprobada vigente; consumo76%/80% TOTAL,sin resets. Detener; estados inferiores históricos.');
for(const rel of ['indice/tareas/N03.md','indice/README.md','indice/PENDIENTES.md','indice/CALENDARIO.md']){
const link=rel.includes('/tareas/')?'../../informe/N03/clientId-v1/STOP-P0.md':'../informe/N03/clientId-v1/STOP-P0.md';
update(rel,`**N03 clientId-v1: reparación autorizada, STOP P0 — RED0/4.** [Fallo, conservación y retoma](${link}). No freeze/producto;333 fuentes aceptadas y13 fuentes pertinentes intactas. Preflight Docker125: falta punto copia/node_modules para /app readonly, tras única corrección previa de archivo inexistente. Contenedor eliminado; no runtimes arrancados. Retoma: orden de continuar STOP, crear sólo punto vacío, comprobar arnés/montajes y nueva corrida sin relajar aislamiento; después baseline/refutación/freeze y P1→P3. No volver a pedir política ni presupuesto. Consumo76%/80% TOTAL,sin resets. N03 sigue en curso, coherencia real/proyecto/base y condición prestaciones tenant pendientes. Estados inferiores históricos.`);}
write(p.join(root,'historial/2026-09-09-N03-clientId-STOP-P0.md'),`# N03 clientId-v1 — implementación autorizada, STOP P0

Liam aprobó los dos selectores C→N→V con trim previo y documentación pertinente. Se preparó arnés HTTP aislado reutilizando D05, sin producto. Primer fallo ENOENT de archivo inexistente en copiaD05; única corrección y copia333 verificada. Preflight Docker falló125 porque /app readonly no contiene punto node_modules. Contenedor creado no arrancó,Pid0 y eliminado. Detector obliga detener; no encadenar otro intento.

[Retoma exacta](../informe/N03/clientId-v1/STOP-P0.md): crear directorio vacío en copia aislada, sin aflojar readonly/network=none; verificar arnés y nueva corrida cuando Liam indique retomar. Política/budget vigentes, no reconfirmarlos. Baseline/refutación/freeze pendientes;0/4 gates. Revisión interna Harvey sólo lectura precisó baseline comparable y permisos/config incompleta, sin pruebas nuevas atribuibles.333 fuentes y13 pertinentes conservadas; registros/preimágenes preservados. N03 en curso;consumo76%/80% TOTAL,sin resets. Sin remoto,instalaciones,producto,.env,commit,push,deploy. Prestaciones por tenant antes de despliegue siguen pendientes.
`);
write(p.join(d,'CUSTODIA-STOP.json'),JSON.stringify(custody,null,2));
write(p.join(d,'ESTADO-STOP.json'),JSON.stringify({result:'RED',gate:'P0',reached:0,total:4,productChanges:0,preserved:333,usage:76,totalCeiling:80,resets:0,freeze:false,containerRemoved:true,blocker:'copia/node_modules ausente para montaje readonly; Docker125 antes de Node',N03:'en_curso'},null,2));
console.log(JSON.stringify({recorded:true,result:'RED',productChanges:0,preserved:333,records:custody.length}));
