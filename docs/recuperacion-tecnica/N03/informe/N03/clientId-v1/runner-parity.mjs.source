import fs from 'node:fs';
import {spawnSync} from 'node:child_process';
const r=spawnSync(process.execPath,['--import','/app/node_modules/tsx/dist/loader.mjs','--test','/app/tests/api-parity.test.ts'],{cwd:'/app',env:{PATH:process.env.PATH,HOME:'/tmp',TMPDIR:'/tmp',NODE_PATH:process.env.NODE_PATH,TSX_DISABLE_CACHE:'1'},encoding:'utf8',timeout:120000});
fs.writeFileSync('/salida/parity.stdout.txt',r.stdout||'');fs.writeFileSync('/salida/parity.stderr.txt',r.stderr||'');
fs.writeFileSync('/salida/PARITY.json',JSON.stringify({exit:r.status,error:r.error?.message||null}));console.log(r.stdout);process.exitCode=r.status===0?0:1;
