const fs=require('fs'),p=require('path'),crypto=require('crypto'),assert=require('assert/strict');
const base=__dirname,parent=p.dirname(base),impl=parent+'/implementacion-local',root='C:/Users/liama/Desktop/Nichos-hub',canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',archive=root+'/docs/recuperacion-tecnica/N03';
const rel='informe/N03/L02-client-info-v1/aceptacion-local';
const sha=file=>crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex');
const read=file=>JSON.parse(fs.readFileSync(file,'utf8').replace(/^\uFEFF/,''));
function fresh(file,data){assert.ok(!fs.existsSync(file),'No sobrescribir '+file);fs.mkdirSync(p.dirname(file),{recursive:true});fs.writeFileSync(file,data);}
const json=(file,data)=>fresh(file,JSON.stringify(data,null,2)+'\n');
const walk=dir=>fs.readdirSync(dir,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(p.join(dir,e.name)):[p.join(dir,e.name)]);
const accepted=read(impl+'/RESULTADO.json');assert.equal(sha(root+'/'+accepted.scope),accepted.finalHash);
const population=read(impl+'/PRODUCTO-ANTES.json').map(f=>({...f,sha256:f.ruta.replaceAll('\\','/')===accepted.scope?accepted.finalHash:f.sha256}));
for(const f of population)assert.equal(sha(root+'/'+f.ruta),f.sha256);assert.equal(walk(root+'/src').length,population.length);
json(base+'/PRODUCTO-ANTES.json',population);
let preserved=0;for(const manifest of [parent+'/EVIDENCIA-FISICA.json',impl+'/EVIDENCIA-FISICA.json',canon+'/informe/N03/W-NEXT-v1/comparacion-local/EVIDENCIA-FISICA.json',canon+'/informe/N03/W-NEXT-v1/implementacion-local/EVIDENCIA-FISICA.json']){const m=read(manifest);for(const f of m.archivos||m.files){assert.equal(sha(f.ruta),f.sha256);preserved++;}}
for(const f of read(impl+'/ARCHIVO.json')){assert.equal(sha(f.source),f.sha256);assert.equal(sha(f.destination),f.sha256);}
const template='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main';
const sources=[root+'/src/components/client-config-tab.tsx',template+'/server.ts',template+'/api/index.ts',template+'/src/lib/notification-channels.ts',canon+'/informe/N03/D05-v1/INFORME.md',canon+'/informe/N01/SA-01-L-v1/DEUDA.md'];
json(base+'/FUENTES-PROPUESTA.json',{limite:'Sólo lectura acotada para proponer L03; no se ejecutó ni preparó su arnés',files:sources.map(file=>({ruta:file,sha256:sha(file)}))});
const records=['informe/N03/cierre-sesion-v1/RETOMA.md','informe/N03/reconciliacion-v1/BALANCE.md','informe/N03/reconciliacion-v1/SIGUIENTE-ACCION.md','indice/tareas/N03.md','indice/README.md','indice/CALENDARIO.md'];
const planned=[];
for(const r of records){assert.equal(sha(canon+'/'+r),sha(archive+'/'+r));let text=fs.readFileSync(canon+'/'+r,'utf8');assert.ok(text.includes('L02 client-info implementada: GREEN local4/4, para revisión; NO descontada.'));const evidence=p.relative(p.dirname(canon+'/'+r),base+'/ACEPTACION.md').replaceAll('\\','/'),next=p.relative(p.dirname(canon+'/'+r),base+'/SIGUIENTE-ACCION.md').replaceAll('\\','/');
 const note='**L02 aceptada localmente y descontada sólo para POST /api/onboarding/client-info.** Liam aceptó la corrección de configUpdate/hubUpdate con sus límites; versión y evidencias vigentes, sin repetir suites. Resto L02, L01/L12 y N03 siguen abiertos. W-NEXT y demás entregas aceptadas intactas. Única siguiente propuesta: preparar contrato local L03 de los tres toggles de notificaciones frente a eventos/canales, sin ejecutarlo; preservar D05 y resolver con Liam cualquier contradicción con email base antes de fijar RED. Consumo83%/techo85% TOTAL compartido,sin resets,efectos externos,push/deploy. Etapas posteriores y condición de prestaciones por tenant antes del despliegue conservadas. Esta adenda sustituye sólo el estado de revisión/no descuento del POST en cortes inferiores. [Aceptación y límites]('+evidence+'). [Única siguiente acción]('+next+').\n\n';
 if(r.endsWith('/BALANCE.md')){
  const row='| L02 — POST /api/onboarding/client-info, aceptada localmente | Parches config/hub_clients con mapas explícitos y conservación, contrato29/39 GREEN, mutantes765/70 ytipos/lint. [Aceptación](../L02-client-info-v1/aceptacion-local/ACEPTACION.md). Sólo esta parte descontada; restoL02 y validaciones remotas siguen pendientes. |';
  assert.ok(/^\| W-NEXT[^\n]*$/m.test(text));text=text.replace(/^\| W-NEXT[^\n]*$/m,line=>line+'\n'+row);
  const old='| D03/D04; L01/L02/L12: modos, claves con puntos, merge/override, build/preset y rutas accesibles | Pendiente reconciliar contrato efectivo y reparar conexiones necesarias en N03;';
  assert.ok(text.includes(old));text=text.replace(old,'| D03/D04; L01/L02/L12: modos, claves con puntos, merge/override, build/preset y rutas accesibles | Descontada únicamente L02 de POST /api/onboarding/client-info, aceptada localmente. Resto L02 y L01/L12 pendientes: reconciliar contrato efectivo y reparar conexiones necesarias en N03;');
 }
 const end=text.indexOf('\n');planned.push({r,data:text.slice(0,end+1)+'\n'+note+text.slice(end+1)});
}
json(base+'/PREVIO.json',{documentaryAcceptance:'RED_PENDIENTE_REGISTRO_DE_NUEVA_ACEPTACION',productAcceptedHash:accepted.finalHash,evidencePreserved:preserved,records:records.map(r=>({ruta:r,sha256:sha(canon+'/'+r)}))});
const custody=[];for(const f of planned)for(const [version,dir] of [['canon',canon],['archivo',archive]]){const file=dir+'/'+f.r,backup=base+'/preimagenes/'+version+'/'+f.r;fresh(backup,fs.readFileSync(file));fs.writeFileSync(file,f.data);custody.push({ruta:file,preimagen:backup,antes:sha(backup),despues:sha(file)});}
json(base+'/CUSTODIA.json',custody);
const hist='historial/2026-09-10-N03-L02-client-info-aceptacion.md';
const entry='# N03 — aceptación local L02 client-info\n\nLiam aceptó y se descontó exclusivamente L02 de POST /api/onboarding/client-info. Version/evidencia verificadas por huella; no producto ni nuevas suites. [Aceptación](../informe/N03/L02-client-info-v1/aceptacion-local/ACEPTACION.md). [Única propuesta](../informe/N03/L02-client-info-v1/aceptacion-local/SIGUIENTE-ACCION.md): preparar contrato L03 de toggles/notificaciones con D05 conservado; no ejecutada. RestoL02 y N03 abiertos. Techo85% TOTAL,observado83%,sin resets,externos,push/deploy. Etapas posteriores y condición de prestaciones por tenant antes del despliegue conservadas.\n';fresh(canon+'/'+hist,entry);fresh(archive+'/'+hist,entry);
const toCheck=[...planned.map(f=>canon+'/'+f.r),base+'/ACEPTACION.md',base+'/SIGUIENTE-ACCION.md'];let links=0;
for(const file of toCheck){const text=fs.readFileSync(file,'utf8');const fragment=planned.some(f=>canon+'/'+f.r===file)?text.split('\n\n')[1]:text;for(const m of fragment.matchAll(/\]\(([^)]+)\)/g)){if(m[1].startsWith('http'))continue;assert.ok(fs.existsSync(p.resolve(p.dirname(file),m[1])),m[1]);links++;}}
for(const f of population)assert.equal(sha(root+'/'+f.ruta),f.sha256);for(const f of sources)assert.equal(sha(f),read(base+'/FUENTES-PROPUESTA.json').files.find(x=>x.ruta===f).sha256);
json(base+'/RESULTADO.json',{result:'GREEN',gates:4,total:4,accepted:'L02_POST_CLIENT_INFO_LOCAL',L02:{clientInfo:'aceptada_local_descontada',resto:'pendiente'},N03:'ABIERTA',propuestaUnica:'Preparar contrato local L03 toggles/notificaciones',L03Ejecutada:false,productoModificado:false,srcPreservados:population.length,evidenciasPreservadas:preserved,registros:custody.length,enlacesComprobados:links,consumo:83,techo:85,resets:0,blockers:[]});
const files=walk(base);json(base+'/EVIDENCIA.json',files.map(file=>({ruta:file,sha256:sha(file),bytes:fs.statSync(file).size})));
const map=[];for(const file of walk(base)){let dest=p.relative(base,file).replaceAll('\\','/');if(/\.(cjs|js|ts|ps1)$/.test(dest))dest+='.source';const target=archive+'/'+rel+'/'+dest;fresh(target,fs.readFileSync(file));assert.equal(sha(file),sha(target));map.push({origen:file,destino:target,sha256:sha(file)});}json(base+'/ARCHIVO.json',map);
console.log(JSON.stringify({result:'GREEN',gates:'4/4',srcPreservados:population.length,evidenciasPreservadas:preserved,registros:custody.length,archivados:map.length,next:'Proponer preparación L03, no ejecutada'}));
