const fs=require('fs'),p=require('path'),crypto=require('crypto'),assert=require('assert/strict');const d=__dirname,hash=b=>crypto.createHash('sha256').update(b).digest('hex');
const edits=[['C:/Users/liama/Desktop/Nichos/Barber-shop-template-main/AGENTS.md','There is no automated test suite (no Jest/Vitest configured). Validation is done via `tsc --noEmit` (type checking) and manual browser testing.','Existe una suite automatizada de paridad y módulos compartidos: `npm run test:parity` ejecuta `tsx --test tests/api-parity.test.ts`. `npm run lint` ejecuta `tsc --noEmit`. Estos controles locales no sustituyen la certificación funcional integral.'],['C:/Users/liama/Desktop/Nichos-hub/AGENTS.md','Sin middleware — proteccion via `app-shell.tsx`.','El control de entrada está en `src/proxy.ts`, con configuración en `src/auth.config.ts`; se conservan los wrappers de autorización y `app-shell.tsx`.'],['C:/Users/liama/Desktop/Nichos/Barber-shop-template-main/src/config/tour.config.ts','// Default FALSE for security — demo mode bypasses auth.','// Deshabilitado por defecto. El modo demo no omite la autenticación de ProtectedRoute.'],['C:/Users/liama/Desktop/Nichos/Barber-shop-template-main/src/config/tour.config.ts','— Auth is BYPASSED, admin shows fake data. Fix immediately.','— Modo demo activo fuera de localhost; revisar configuración. ProtectedRoute mantiene la autenticación.']];
const grouped=new Map();for(const [file,from,to] of edits){if(!grouped.has(file))grouped.set(file,{before:fs.readFileSync(file),changes:[]});grouped.get(file).changes.push({from,to})}
const checks=[];for(const [file,e] of grouped){let s=e.before.toString('utf8');for(const {from,to} of e.changes){assert.equal(s.split(from).length,2,file);s=s.replace(from,to)}const relative=file.includes('/Nichos-hub/')?'hub/AGENTS.md':file.split('/Barber-shop-template-main/')[1],backup=p.join(d,'preimagenes/h07',relative);fs.mkdirSync(p.dirname(backup),{recursive:true});fs.writeFileSync(backup,e.before,{flag:'wx'});fs.writeFileSync(file,s);let reversed=s;for(const {from,to} of e.changes)reversed=reversed.replace(to,from);assert.equal(reversed,e.before.toString('utf8'));checks.push({file,backup,before:hash(e.before),after:hash(Buffer.from(s)),soloTexto:true})}
assert.ok(fs.existsSync('C:/Users/liama/Desktop/Nichos-hub/src/auth.config.ts'));fs.writeFileSync(p.join(d,'H07-CORRECCIONES.json'),JSON.stringify(checks,null,2),{flag:'wx'});console.log('H07: 3 archivos, 4 correcciones textuales; controles y resto de bytes conservados');
