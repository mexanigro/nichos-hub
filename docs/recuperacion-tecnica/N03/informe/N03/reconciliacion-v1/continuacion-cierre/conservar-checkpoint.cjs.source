const fs=require('fs'),p=require('path'),crypto=require('crypto'),assert=require('assert/strict');const d=__dirname,roots={hub:'C:/Users/liama/Desktop/Nichos-hub',template:'C:/Users/liama/Desktop/Nichos/Barber-shop-template-main'},baseline=JSON.parse(fs.readFileSync(p.resolve(d,'../../proyecto-base-v1/aceptacion-local/PRODUCTO-ANTES.json'),'utf8'));const hash=f=>crypto.createHash('sha256').update(fs.readFileSync(f)).digest('hex');const allowed=new Set(['hub/src/components/client-language-banner.tsx','hub/src/lib/email-templates.ts','hub/AGENTS.md','template/AGENTS.md','template/src/config/site.ts','template/src/config/tour.config.ts','template/src/lib/api/payment-gateways.ts','template/server.ts','template/api/index.ts']);const changed=[],same=[];for(const row of baseline){const f=p.join(roots[row.repo],row.ruta),actual=fs.existsSync(f)?hash(f):null;const result={...row,actual};(actual===row.sha256?same:changed).push(result)}const unexpected=changed.filter(r=>!allowed.has(r.repo+'/'+r.ruta));const extra=['template/src/lib/api/checkout-handler.ts','hub/AGENTS.md','template/AGENTS.md'].map(key=>{const [repo,...rest]=key.split('/');const file=p.join(roots[repo],...rest);return{repo,ruta:rest.join('/'),actual:hash(file)}});const output={baseline:baseline.length,identical:same.length,changed,extra,unexpected,acceptedDeliveryScope:'Archivos fuera de cambios previstos conservados. Funciones aceptadas dentro de site/server/API requieren conservación de bloques; ver revisión independiente y preimágenes. No se repiten suites aceptadas.'};fs.writeFileSync(p.join(d,'CONSERVACION-CHECKPOINT.json'),JSON.stringify(output,null,2),{flag:'wx'});console.log({baseline:baseline.length,identical:same.length,changed:changed.map(r=>r.repo+'/'+r.ruta),unexpected:unexpected.length});assert.equal(unexpected.length,0);
