const fs=require('fs'),p=require('path'),assert=require('assert/strict'),crypto=require('crypto');const d=__dirname,root='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',ts=require(root+'/node_modules/typescript'),hash=b=>crypto.createHash('sha256').update(b).digest('hex');for(const f of JSON.parse(fs.readFileSync(p.join(d,'CHECKOUT-FREEZE.json'))))assert.equal(hash(fs.readFileSync(p.join(d,f.ruta))),f.sha256);assert.equal(JSON.parse(fs.readFileSync(p.join(d,'resultados/checkout-red-fijo/CHECKOUT.json'))).result,'RED');
function find(file){const text=fs.readFileSync(p.join(root,file),'utf8');assert.equal(text,fs.readFileSync(p.join(d,'preimagenes/checkout',file),'utf8'));const ast=ts.createSourceFile(file,text,ts.ScriptTarget.Latest,true),found=[];function visit(n){if(ts.isCallExpression(n)&&n.expression.getText(ast)==='app.post'&&n.arguments[0]?.text==='/api/create-checkout-session')found.push(n);ts.forEachChild(n,visit)}visit(ast);assert.equal(found.length,1);return{text,ast,node:found[0]}}
const server=find('server.ts'),api=find('api/index.ts');let body=server.node.arguments[1].body.getText(server.ast);body=body.replace('const baseUrl = process.env.APP_URL || `http://localhost:${port}`;','const baseUrl = getBaseUrl();');
const header=`import type { Request, Response } from "express";
import type { Firestore } from "firebase-admin/firestore";
import type { PaymentProvider, ServerPaymentGateway } from "./payment-gateways";

type CheckoutDependencies = {
  getAdminDb: () => Promise<Firestore | null>;
  getClientRuntimeState: () => Promise<{ provider: PaymentProvider }>;
  resolvePaymentGateway: (provider: PaymentProvider) => Promise<ServerPaymentGateway>;
  sanitizeText: (input: unknown, maxLen: number) => string;
  isValidEmail: (value: string) => boolean;
  clientId: string;
  getBaseUrl: () => string;
};

/** Checkout compartido: el importe procede de la cita, nunca del visitante. */
export function createCheckoutHandler(deps: CheckoutDependencies) {
  const { getAdminDb, getClientRuntimeState, resolvePaymentGateway, sanitizeText, isValidEmail, clientId: CLIENT_ID, getBaseUrl } = deps;
  return async (req: Request, res: Response) => `;
const shared=p.join(root,'src/lib/api/checkout-handler.ts');assert.ok(!fs.existsSync(shared));fs.writeFileSync(shared,header+body+';\n}\n',{flag:'wx'});
for(const [file,source] of [['server.ts',server],['api/index.ts',api]]){const db=file==='server.ts'?'getAdminDb':'getAdminDb: async () => (await loadAdminFirestore())?.db ?? null';const replacement=`app.post("/api/create-checkout-session", createCheckoutHandler({
    ${db},
    getClientRuntimeState,
    resolvePaymentGateway,
    sanitizeText,
    isValidEmail,
    clientId: CLIENT_ID,
    getBaseUrl: () => process.env.APP_URL || \`http://localhost:\${port}\`,
  }))`;const changed=source.text.slice(0,source.node.getStart(source.ast))+replacement+source.text.slice(source.node.end);const importPath=file==='server.ts'?'./src/lib/api/checkout-handler':'../src/lib/api/checkout-handler';fs.writeFileSync(p.join(root,file),'import { createCheckoutHandler } from "'+importPath+'";\n'+changed)}
fs.writeFileSync(p.join(d,'CHECKOUT-CAMBIOS.json'),JSON.stringify(['server.ts','api/index.ts','src/lib/api/checkout-handler.ts'].map(ruta=>({ruta,sha256:hash(fs.readFileSync(p.join(root,ruta)))})),null,2),{flag:'wx'});console.log('Checkout compartido: importe persistido y errores redactados en ambas entradas');
