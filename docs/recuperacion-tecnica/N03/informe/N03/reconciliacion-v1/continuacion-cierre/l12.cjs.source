// Reutiliza carga/transpilación y fronteras del instrumento L01; sólo contrato residual L12.
const fs=require('fs'),path=require('path'),assert=require('assert/strict'),crypto=require('crypto'),{createRequire}=require('module');const req=createRequire('/deps/package.json'),ts=req('typescript'),React=req('react'),{renderToStaticMarkup:render}=req('react-dom/server');const compiled=new Map(),sources=new Map(),fileCache=new Map();let cache,niche,doc,effects=0;const failures=[],rows=[];let checks=0;
function check(id,a,b){checks++;if(!require('util').isDeepStrictEqual(a,b))failures.push({id,actual:a,expected:b})}
const transpile=s=>{if(!compiled.has(s))compiled.set(s,ts.transpileModule(s,{compilerOptions:{module:ts.ModuleKind.CommonJS,esModuleInterop:true,target:ts.ScriptTarget.ES2022,jsx:ts.JsxEmit.ReactJSX}}).outputText);return compiled.get(s)};
const motion=new Proxy({},{get:(_,tag)=>({children,className})=>React.createElement(tag,{className},children)});
function load(f){if(cache.has(f))return cache.get(f);const m={exports:{}};cache.set(f,m.exports);if(!fileCache.has(f))fileCache.set(f,fs.readFileSync(f,'utf8'));let source=fileCache.get(f);sources.set(f,crypto.createHash('sha256').update(source).digest('hex'));if(process.argv[2]==='mutant'&&f.endsWith('/config/site.ts')){const ast=ts.createSourceFile(f,source,ts.ScriptTarget.Latest,true),n=ast.statements.find(n=>ts.isFunctionDeclaration(n)&&n.name?.text==='_applyVisibleServicesFilter');assert.ok(n);source=source.slice(0,n.getStart(ast))+'function _applyVisibleServicesFilter(): void {}'+source.slice(n.end)}
const deps=id=>{if(id.endsWith('/env')||id==='./env')return{env:{activeNiche:niche,uiLanguage:'en',clientId:'n03-local'}};if(id.endsWith('/firebase'))return{db:{},isFirebaseConfigured:true};if(id==='firebase/firestore')return{doc:(_db,col)=>col,getDoc:async()=>({exists:()=>true,data:()=>structuredClone(doc)}),getDocFromServer:async()=>({exists:()=>true,data:()=>({status:'active'})})};if(id.endsWith('/services/db'))return{dbService:new Proxy({},{get:()=>()=>{effects++;throw Error('DB prohibida')}})};if(id.endsWith('/services/ai'))return{aiService:new Proxy({},{get:()=>()=>{effects++;throw Error('IA prohibida')}})};if(id==='motion/react')return{motion,AnimatePresence:({children})=>children};if(id.endsWith('/ui/calendar'))return{Calendar:()=>null};if(id.startsWith('.')){const base=path.resolve(path.dirname(f),id);return load(['.ts','.tsx','/index.ts'].map(x=>base+x).find(x=>fs.existsSync(x))||base)}return req(id)};
new Function('require','module','exports','__env','window',transpile(source.replaceAll('import.meta.env','__env')))(deps,m,m.exports,{}, {location:{search:''}});cache.set(f,m.exports);return m.exports}
function setup(n){niche=n;cache=new Map();return load('/template/src/config/site.ts')}
const esc=s=>render(React.createElement('span',null,s)).replace(/^<span>|<\/span>$/g,'');
(async()=>{for(const n of ['barberia','estetica','tattoo','nails','cafeteria','remodelaciones']){let site=setup(n);const ids=site.siteConfig.services.map(s=>s.id);assert.ok(ids.length);const lists=[['absent',undefined],['null',null],['empty',[]],['unknown',['n03-unknown']],['valid',ids.slice(0,1)],['mixed',['n03-unknown',...ids.slice(0,1)]],['all',ids]];
for(const type of [n,undefined,n==='barberia'?'tattoo':'barberia'])for(const [name,list] of lists){site=setup(n);const before=structuredClone(site.siteConfig);doc={...(type?{business:{type}}:{}),...(list!==undefined?{visibleServices:list}:{}),contact:{phone:'local-marker'},features:{enableStaffPages:false},serviceOverrides:{[ids[0]]:{price:123,duration:13,image:'synthetic-image',name:'n03-override-name',description:'n03-override-description'}}};const expected=list==null?ids:list.filter(id=>ids.includes(id)),id=n+'/'+String(type)+'/'+name;await load('/template/src/services/tenant.ts').bootstrapTenantConfig();const observations=[];
for(const lang of ['en','he','ru','ar']){if(lang!=='en')site.switchSiteLanguage(lang);const actual=site.siteConfig.services;check(id+'/'+lang+'/ids',actual.map(s=>s.id),expected);check(id+'/'+lang+'/contact',site.siteConfig.contact.phone,'local-marker');check(id+'/'+lang+'/staffflag',site.siteConfig.features.enableStaffPages,false);const Component=load('/template/src/components/booking/BookingWizard.tsx').BookingWizard;const html=render(React.createElement(Component,{onClose(){}}));for(const s of actual)check(id+'/'+lang+'/render/'+s.id,html.includes(esc(s.name)),true);check(id+'/'+lang+'/price',actual.find(s=>s.id===ids[0])?.price,expected.includes(ids[0])?123:undefined);const first=actual.find(s=>s.id===ids[0]);check(id+'/'+lang+'/duration',first?.duration,expected.includes(ids[0])?13:undefined);if(first){check(id+'/'+lang+'/image',site.siteConfig.sections.services.images[actual.indexOf(first)],'synthetic-image');check(id+'/'+lang+'/text-policy',first.name==='n03-override-name',lang==='en');} observations.push({lang,ids:actual.map(s=>s.id),html});}
const staff=load('/template/src/components/staff/StaffProfilePage.tsx').StaffProfilePage;const html=render(React.createElement(staff,{slug:site.siteConfig.staff[0]?.id||'missing',onBackHome(){}}));const locale=load('/template/src/config/locale.ts').localeConfig;check(id+'/staffdisabled',html.includes(esc(locale.staffProfile.featureDisabledTitle)),true);rows.push({id,expected,observations,staffDisabledHtml:html});}
}
check('sin efectos',effects,0);const result={result:failures.length?'RED':'GREEN',cases:rows.length,checks,failures,effects};fs.writeFileSync('/salida/L12-RESULTADO.json',JSON.stringify(result,null,2));fs.writeFileSync('/salida/L12-CASOS.json',JSON.stringify(rows,null,2));fs.writeFileSync('/salida/FUENTES.json',JSON.stringify([...sources].map(([ruta,sha256])=>({ruta,sha256})),null,2));console.log(JSON.stringify({...result,failures:failures.length}));process.exitCode=failures.length?1:0})().catch(e=>{console.error(e.stack);process.exitCode=2});

