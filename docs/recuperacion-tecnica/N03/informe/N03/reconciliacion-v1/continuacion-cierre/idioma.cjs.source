const fs=require('fs'),p=require('path'),{createRequire}=require('module');const d=__dirname,hub='C:/Users/liama/Desktop/Nichos-hub',req=createRequire(hub+'/package.json'),ts=req('typescript'),React=req('react'),{renderToStaticMarkup}=req('react-dom/server'),assert=require('assert/strict');const name=process.argv[2],file=process.argv[3]||hub+'/src/components/client-language-banner.tsx';const transpile=s=>ts.transpileModule(s,{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022,jsx:ts.JsxEmit.ReactJSX,esModuleInterop:true}}).outputText;function load(file){const m={exports:{}};new Function('require','module','exports',transpile(fs.readFileSync(file,'utf8')))(id=>id==='@/lib/client-language'?load(hub+'/src/lib/client-language.ts'):req(id),m,m.exports);return m.exports}const Component=load(file).ClientLanguageBanner;const rows=[],failures=[];for(const language of ['he','en','ru','ar','es']){const html=renderToStaticMarkup(React.createElement(Component,{clientId:'n03-local',language}));const notice=html.includes('La interfaz de la web usa inglés como alternativa al español.');if(notice!==(language==='es'))failures.push(language);rows.push({language,notice,html})}const out=p.join(d,'resultados',name);fs.mkdirSync(out,{recursive:true});fs.writeFileSync(p.join(out,'IDIOMA.json'),JSON.stringify({result:failures.length?'RED':'GREEN',failures,rows},null,2));console.log({result:failures.length?'RED':'GREEN',failures});process.exitCode=failures.length?1:0;
