const fs=require('fs'),p=require('path'),crypto=require('crypto');const d=__dirname;const contract=`# Extensión fija: moneda por tenant\nRegla aprobada por Liam: USD fijo es incorrecto, moneda depende del tenant. Config/{clientId}.payment.currency es la fuente; request.currency nunca manda. Casos ILS/USD/EUR deben llegar en minúsculas al adaptador Stripe real y al payload sessions.create interceptado; falta/null/vacío/blancos/valor no admitido rechazan antes de crear sesión. Sin default USD silencioso. Se preserva importe validado, tenant y resto L08. No se decide aquí seña ni modo. Cardcom requiere representar la moneda en su API: no inventar CoinId ni certificación sin fuente local. Esa parte permanece abierta.\nP0 controles previos y RED; P1 mínimo handler+gateway; P2 conservación/mutación/tipos; P3 integración al balance sin cerrar L04 completa.\n`;
fs.writeFileSync(p.join(d,'CONTRATO-MONEDA.md'),contract,{flag:'wx'});
let s=fs.readFileSync(p.join(d,'checkout.cjs'),'utf8');s=s.replace("appointment:{clientId:'tenant',priceCents:15000},body", "currency:'ILS',appointment:{clientId:'tenant',priceCents:15000},body");s=s.replace("add('request-adulterado',{});","add('request-adulterado',{}); for(const currency of ['USD','EUR'])add('moneda-'+currency,{currency,body:{...base.body,currency:'JPY'}});for(const currency of [undefined,null,'','   ','XYZ'])add('moneda-invalida-'+String(currency),{currency,status:503});");s=s.replace("exists:!!c.appointment,data:()=>structuredClone(c.appointment)","exists:col==='config'||!!c.appointment,data:()=>col==='config'?{payment:{currency:c.currency}}:structuredClone(c.appointment)");s=s.replace("check(label+'/reads',reads,", "check(label+'/reads',reads.filter(x=>!x.startsWith('config/')),");s=s.replace("check(label+'/amount',calls[0]?.amountCents,c.amount);", "check(label+'/currency',calls[0]?.currency,c.currency.toLowerCase());check(label+'/currency-read',reads.includes('config/tenant'),true);check(label+'/amount',calls[0]?.amountCents,c.amount);");s=s.replace("'/salida/CHECKOUT.json'","'/salida/MONEDA-HANDLER.json'");fs.writeFileSync(p.join(d,'moneda-handler.cjs'),s,{flag:'wx'});
for(const rel of ['src/lib/api/checkout-handler.ts','src/lib/api/payment-gateways.ts']){const src='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main/'+rel;const out=p.join(d,'preimagenes','moneda',rel);fs.mkdirSync(p.dirname(out),{recursive:true});fs.copyFileSync(src,out,fs.constants.COPYFILE_EXCL);}
