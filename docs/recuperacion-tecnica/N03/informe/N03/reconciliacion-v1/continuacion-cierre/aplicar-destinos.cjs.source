const fs=require('fs'),p=require('path'),assert=require('assert/strict');const root='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',ts=require(root+'/node_modules/typescript'),f=root+'/api/index.ts';let s=fs.readFileSync(f,'utf8');fs.copyFileSync(f,p.join(__dirname,'preimagenes/api-antes-destinos.ts'),fs.constants.COPYFILE_EXCL);const ast=ts.createSourceFile(f,s,99,true);const changes=[];for(const name of ['getClientRuntimeState','enforceClientActive','getPaymentCredentials']){const node=name==='getClientRuntimeState'?ast.statements.find(n=>ts.isFunctionDeclaration(n)&&n.name?.text===name):ast.statements.flatMap(n=>ts.isVariableStatement(n)?[...n.declarationList.declarations]:[]).find(n=>n.name.getText(ast)===name).initializer;let text=node.getText(ast);const anchor=name==='getClientRuntimeState'?'  if (!token) return { status: "active", provider: envProvider };':name==='enforceClientActive'?'  if (!token) return null;':'  if (!projectId || !CLIENT_ID) return {};';assert.equal(text.split(anchor).length,2);const guard=`
  const configuredAdminProject = process.env.FIREBASE_ADMIN_PROJECT_ID?.trim();
  const configuredRestProject = process.env.FIREBASE_PROJECT_ID?.trim();
  if ((configuredAdminProject && configuredAdminProject !== projectId) ||
      (configuredRestProject && configuredRestProject !== projectId)) {
    throw new Error("Firestore destination mismatch");
  }`;text=text.replace(anchor,anchor+guard);changes.push({start:node.getStart(ast),end:node.end,text})}for(const c of changes.sort((a,b)=>b.start-a.start))s=s.slice(0,c.start)+c.text+s.slice(c.end);fs.writeFileSync(f,s);
