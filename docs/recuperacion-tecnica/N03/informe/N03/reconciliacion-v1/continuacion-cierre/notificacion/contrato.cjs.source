const fs=require('fs'),path=require('path'),crypto=require('crypto'),{createRequire}=require('module'),assert=require('assert/strict');
const hub='C:/Users/liama/Desktop/Nichos-hub',req=createRequire(hub+'/package.json'),ts=req('typescript'),dir=__dirname;
const name=process.argv[2],mutant=process.argv[3]==='mutant',out=path.join(dir,'resultados',name);if(fs.existsSync(out))throw Error('Resultado existente');fs.mkdirSync(out,{recursive:true});
const file=hub+'/src/lib/email-templates.ts',before=fs.readFileSync(dir+'/preimagenes/email-templates.ts','utf8');let source=fs.readFileSync(file,'utf8');
const hash=s=>crypto.createHash('sha256').update(s).digest('hex');function node(s){const a=ts.createSourceFile('email.ts',s,99,true);return a.statements.find(n=>ts.isFunctionDeclaration(n)&&n.name?.text==='liamMessage')}
const old=node(before),current=node(source);if(mutant)source=source.slice(0,current.getStart())+old.getText()+source.slice(current.end);
function load(s,site){const m={exports:{}};new Function('module','exports','process',ts.transpileModule(s,{compilerOptions:{module:1,target:9}}).outputText)(m,m.exports,{env:site?{NEXT_PUBLIC_SITE_URL:site}:{}});return m.exports.liamMessage}
const failures=[],rows=[],checks=[];function eq(a,b,label){checks.push(label);try{assert.deepStrictEqual(a,b)}catch{failures.push({label,actual:a,expected:b})}}
eq(source.slice(0,node(source).getStart())+source.slice(node(source).end),before.slice(0,old.getStart())+before.slice(old.end),'otras-plantillas-y-declaraciones-intactas');
eq(hash(fs.readFileSync(hub+'/src/app/api/messages/route.ts')),hash(fs.readFileSync(dir+'/preimagenes/messages-route.ts')),'caller-intacto');
let i=0;for(const site of [undefined,'https://site.example.invalid'])for(const portalUrl of [undefined,'','https://portal.example.invalid/thread/1'])for(const body of ['Mensaje simple','<b>Texto & "comillas"</b>\nSegunda línea']){const id=++i,v={name:'Ana<&> Apellido',body,...(portalUrl===undefined?{}:{portalUrl})},actual=load(source,site)(v),basal=load(before,site)(v),portal=!!portalUrl,destination=portalUrl||site||'https://arzac.studio';
eq(actual.subject,'Mensaje de Arzac Studio',id+'/subject');eq(actual.text.includes(portal?'Podés responderme entrando al portal:':'Podés visitar Arzac Studio:'),true,id+'/invitacion');eq(actual.html.includes(portal?'Responder en el portal →':'Visitar Arzac Studio →'),true,id+'/boton');eq(actual.text.includes(destination),true,id+'/destino-texto');eq(actual.html.includes('href="'+destination+'"'),true,id+'/destino-html');if(!portal){eq(actual.text.includes('Podés responderme entrando al portal:'),false,id+'/sin-promesa-texto');eq(actual.html.includes('Responder en el portal →'),false,id+'/sin-promesa-html')}
const expected=portal?basal:{...basal,text:basal.text.replace('Podés responderme entrando al portal:','Podés visitar Arzac Studio:'),html:basal.html.replace('Responder en el portal →','Visitar Arzac Studio →')};eq(actual,expected,id+'/conservacion-integral');rows.push({id,site:site||null,portalUrl:portalUrl??null,actual})}
const result={result:failures.length?'RED':'GREEN',cases:rows.length,checks:checks.length,failures,mutant,sourceSha256:hash(fs.readFileSync(file)),executedSha256:hash(source),baselineSha256:hash(before),rows};fs.writeFileSync(out+'/RESULTADO.json',JSON.stringify(result,null,2));console.log(JSON.stringify({result:result.result,cases:rows.length,checks:checks.length,failures:failures.length,mutant}));process.exitCode=failures.length?1:0;
