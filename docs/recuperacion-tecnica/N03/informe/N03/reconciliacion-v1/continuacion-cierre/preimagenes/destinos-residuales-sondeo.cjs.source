const fs=require('fs'),{createRequire}=require('module'),crypto=require('crypto'),assert=require('assert/strict');const req=createRequire('/deps/package.json'),ts=req('typescript');const file='/template/api/index.ts',s=fs.readFileSync(file,'utf8'),ast=ts.createSourceFile(file,s,99,true);const fn=n=>ast.statements.find(x=>ts.isFunctionDeclaration(x)&&x.name?.text===n).getText(ast);const variable=n=>ast.statements.flatMap(x=>ts.isVariableStatement(x)?[...x.declarationList.declarations]:[]).find(x=>x.name.getText(ast)===n).initializer.getText(ast);const texts={runtime:fn('getClientRuntimeState'),guard:variable('enforceClientActive'),credentials:variable('getPaymentCredentials')}; const rows=[];
(async()=>{for(const [id,env,token] of [['coinciden',{FIREBASE_PROJECT_ID:'p-a',FIREBASE_ADMIN_PROJECT_ID:'p-a',VITE_FIREBASE_PROJECT_ID:'p-a'},true],['contradiccion',{FIREBASE_PROJECT_ID:'p-a',FIREBASE_ADMIN_PROJECT_ID:'p-a',VITE_FIREBASE_PROJECT_ID:'p-b'},true],['solo-server',{FIREBASE_PROJECT_ID:'p-a',FIREBASE_ADMIN_PROJECT_ID:'p-a'},true],['sin-token',{VITE_FIREBASE_PROJECT_ID:'p-a'},false],['blancos',{VITE_FIREBASE_PROJECT_ID:'   ',NEXT_PUBLIC_FIREBASE_PROJECT_ID:' p-c ',FIREBASE_DATABASE_ID:' ',VITE_FIREBASE_DATABASE_ID:' (default) '},true]])for(const [kind,body]of Object.entries(texts)){const calls=[];const source=kind==='runtime'?body+'\nreturn getClientRuntimeState;':'return '+body;const js=ts.transpileModule(source,{compilerOptions:{module:1,target:9}}).outputText;const f=new Function('process','getFirestoreAccessToken','fetch','CLIENT_ID','VALID_PROVIDERS','clientStateCache','createTenantAccessGuard','createCredentialCache',js)({env},async()=>token?'synthetic':null,async(url)=>{calls.push(url);return{ok:true,status:200,json:async()=>({fields:{status:{stringValue:'active'},defaultPaymentProvider:{stringValue:'none'}}})}},'n03',['none','stripe'],null,x=>x,x=>x);const result=await f();rows.push({id,kind,result,calls});}assert.equal(rows.find(x=>x.id==='contradiccion'&&x.kind==='guard').calls[0].includes('/projects/p-b/'),true);assert.equal(rows.find(x=>x.id==='solo-server'&&x.kind==='guard').calls.length,0);fs.writeFileSync('/salida/DESTINOS-RESIDUALES.json',JSON.stringify({source:crypto.createHash('sha256').update(s).digest('hex'),rows,limite:'Funciones/callbacks reales con fetch y token interceptados; no aplicación alojada ni reglas ni DB.'},null,2));console.log({rows:rows.length,mismatch:'p-a configurado general/Admin, tres consumidores operan p-b'});})().catch(e=>{console.error(e);process.exitCode=1});
