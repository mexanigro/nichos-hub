const fs=require('fs'),p=require('path'),c=require('crypto'),assert=require('assert/strict');const d=__dirname,canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',mirror='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03',h=b=>c.createHash('sha256').update(b).digest('hex');const create=(f,b)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,b,{flag:'wx'});};const report=p.join(d,'ESTADO-INTEGRADO-AGENDA-COBRO.md'),relReport=p.relative(canon,report);const note='**Estado vigente — N03 abierta; conexión global detenida por autoridad de estado pendiente, no por presupuesto.** Liam aprobó identidad Auth navegador→email verificado→admin_users backend y las reglas de seña/Cardcom/credenciales. Reparación local de agenda y cobro ejecutada con controles positivos/adversos/mutantes, tipos hub/template0; no se descuenta la conexión: pipeline Vercel real devuelve503 con proyectos separados antes del handler por guarda clients basada enVITE. Se solicita autoridad acotada del estado/config/credenciales backend y disposición de controles L04/fallback/UI. Sin aplicar esas decisiones nuevas. Cobro Cardcom bloqueado, no certificado; revisión integrada y acta final pendientes. Aceptaciones previas, etapas y condición por tenant conservadas. Techo100% TOTAL, observado93%, últimos2puntos reservados; sin resets/externos/push/deploy.';
const rels=['informe/N03/reconciliacion-v1/BALANCE.md','informe/N03/reconciliacion-v1/SIGUIENTE-ACCION.md','informe/N03/cierre-sesion-v1/RETOMA.md','indice/tareas/N03.md','indice/README.md','indice/CALENDARIO.md'];const records=[];for(const [index,root]of[canon,mirror].entries())for(const rel of rels){const target=p.join(root,rel),before=fs.readFileSync(target),backup=p.join(d,'preimagenes-agenda-cobro-registros',String(index),rel);create(backup,before);let s=before.toString('utf8');const first=s.indexOf('\n'),link=p.relative(p.dirname(target),p.join(root,relReport)).replaceAll('\\','/');s=s.slice(0,first+1)+'\n'+note+' [Estado integrado y retoma](<'+link+'>). Los cortes inferiores son históricos.\n\n'+s.slice(first+1);if(rel.endsWith('BALANCE.md')){s=s.split('\n').map(line=>line.startsWith('| RE-EXT-02/03, RE-01, AR-N01 |')?'| RE-EXT-02/03, RE-01, AR-N01 | Compatibilidad local por consumidor, sin unificación automática. | Aceptaciones 2Admin+3REST y selección/rechazo métricas conservadas sin repetir. Identidad cruzada aprobada; agenda handlers/servicio/acciones locales GREEN y mutaciones; histórico browser preservado. | ABIERTA: pipeline global Vercel ejecutado da503 con proyectos separados antes de auth/lectura agenda. Falta decidir autoridad clients/config/credentials previa y comprobar recorrido completo; no descontar por pruebas aisladas. Evidencia y causa en ESTADO-INTEGRADO-AGENDA-COBRO. | N04 identidades/reglas/variables reales; N08 propagación; N10 integración. El bloqueo local no se transfiere. |':line.startsWith('| L04/L08, COB-A |')?'| L04/L08, COB-A | Importe autorizado y moneda/seña/provider/credencial coherentes con promesa existente. | L08/Stripe aceptados conservados. Seña y modo desde config:23casos366GREEN, mutantes6/146/6. Cardcom se bloquea antes de resolver gateway por decisión explícita. Credenciales editor→writer→dosloaders37GREEN, mutantelegacy16; nested autoritativo/apiName independiente. | ABIERTA: Cardcom no operativo/no certificado; autoridad previa de destinos de pagos y disposición de acceptCash/depositRequired, fallback proveedor y seña visual pendientes de respuesta. No cerrar por GREEN de representación ni mover estas obligaciones locales a N07. | N01 compromisos; N05 manual/CSV; N06 relación cita; N07 proveedor/cargo/webhook/idempotencia reales. |':line).join('\n');}fs.writeFileSync(target,s);records.push({target,backup,before:h(before),after:h(fs.readFileSync(target))});}
const old=p.join(d,'credencial/INFORME.md'),pre=fs.readFileSync(old);create(p.join(d,'credencial/reparacion/preimagenes-registro/INFORME.md'),pre);const text='# Estado vigente de esta preparación\n\nRetoma autorizada completó RED semántico y reparación de representación: [contrato y controles](reparacion/CONTRATO.md), GREEN37 y mutanteRED16. El STOP inferior es histórico, conservado. No certifica destino físico ni proveedor; [estado integrado N03](../ESTADO-INTEGRADO-AGENDA-COBRO.md).\n\n'+pre.toString('utf8');fs.writeFileSync(old,text);
create(p.join(d,'REGISTROS-AGENDA-COBRO.json'),JSON.stringify(records,null,2));for(const root of[canon,mirror])create(p.join(root,'historial/N03-agenda-cobro-continuacion.md'),'# N03 — continuación autorizada agenda/cobro\n\n'+note+'\n\nSe completó reparación local y verificaciones de identidad, handlers, histórico/origen, seña y representación de credenciales. Revisión de conexión previa reprodujo bloqueo global503: guardaVercel no incluida en contratos aislados. Se conservan límites y no se simula cierre. Próximo paso único: resolver decisiones acotadas ya presentadas y retomar mismoN03; luego integración de BALANCE y acta.\n');console.log({records:records.length,preimages:records.length+1,n03:'RED/ABIERTA'});
