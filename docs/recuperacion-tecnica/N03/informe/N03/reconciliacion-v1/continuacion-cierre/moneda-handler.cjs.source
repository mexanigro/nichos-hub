const fs=require('fs'),path=require('path'),{createRequire}=require('module'),assert=require('assert/strict');const req=createRequire('/deps/package.json'),ts=req('typescript');const failures=[],rows=[];let checks=0;
const compile=s=>ts.transpileModule(s,{compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.CommonJS,esModuleInterop:true}}).outputText;function check(id,a,b){checks++;if(!require('util').isDeepStrictEqual(a,b))failures.push({id,actual:a,expected:b})}
const base={currency:'ILS',appointment:{clientId:'tenant',priceCents:15000},body:{appointmentId:'appt',name:'Service',customerEmail:'test@example.invalid',price:75},status:200,amount:15000};const cases=[];function add(id,patch){cases.push({...structuredClone(base),id,...patch})}
add('request-adulterado',{});add('config-ausente',{configMissing:true,status:503});add('config-falla',{configError:true,status:500}); for(const currency of ['USD','EUR'])add('moneda-'+currency,{currency,body:{...base.body,currency:'JPY'}});for(const currency of [undefined,null,'','   ','XYZ'])add('moneda-invalida-'+String(currency),{currency,status:503});add('sin-request-price',{body:{...base.body,price:undefined}});add('request-price-invalido',{body:{...base.body,price:'oops'}});add('legacy',{appointment:{clientId:'tenant',price:125.5},amount:12550});add('cents-prioridad',{appointment:{clientId:'tenant',priceCents:13000,price:5},amount:13000});for(const value of [49,50,2000000,2000001,5.5,0,-1])add('precio-'+value,{appointment:{clientId:'tenant',priceCents:value},status:Number.isInteger(value)&&value>=50&&value<=2000000?200:400,amount:value});add('sin-precio',{appointment:{clientId:'tenant'},status:400});add('sin-doc',{appointment:null,status:404});add('sin-db',{db:false,status:503});add('otro-tenant',{appointment:{clientId:'foreign',priceCents:15000},status:403});add('sin-id',{body:{...base.body,appointmentId:''},status:400});add('email-invalido',{body:{...base.body,customerEmail:'bad'},status:400});add('provider-none',{provider:'none',status:400});add('credenciales-fallan',{resolveError:true,status:503});add('gateway-falla',{gatewayError:true,status:500});add('deposit',{body:{...base.body,mode:'deposit'}});
function getRegistration(file){const text=fs.readFileSync(file,'utf8'),ast=ts.createSourceFile(file,text,ts.ScriptTarget.Latest,true);const matches=[];function visit(n){if(ts.isCallExpression(n)&&n.expression.getText(ast)==='app.post'&&n.arguments[0]?.text==='/api/create-checkout-session')matches.push(n.getText(ast));ts.forEachChild(n,visit)}visit(ast);assert.equal(matches.length,1);const validators=['sanitizeText','isValidEmail'].map(name=>ast.statements.find(n=>ts.isFunctionDeclaration(n)&&n.name?.text===name).getText(ast)).join('\n');return{registration:matches[0],validators}}
let createCheckoutHandler;const shared='/template/src/lib/api/checkout-handler.ts';if(fs.existsSync(shared)){const module={exports:{}};let s=fs.readFileSync(shared,'utf8');if(process.argv[2]==='mutant'){assert.ok(s.includes('amountCents: authorizedPrice'));s=s.replace('amountCents: authorizedPrice','amountCents: Number(req.body?.price)')}new Function('require','module','exports',compile(s))(req,module,module.exports);createCheckoutHandler=module.exports.createCheckoutHandler}
(async()=>{for(const runtime of ['server.ts','api/index.ts']){const extracted=getRegistration('/template/'+runtime);for(const c of cases){const calls=[],reads=[];const getDb=async()=>c.db===false?null:{collection:col=>({doc:id=>({get:async()=>{reads.push(col+'/'+id);if(col==='config'&&c.configError)throw Error('SENSITIVE config failure');return{exists:col==='config'?!c.configMissing:!!c.appointment,data:()=>col==='config'?{payment:{currency:c.currency}}:structuredClone(c.appointment)}}})})};const state=async()=>({provider:c.provider||'stripe'}),gateway=async()=>{if(c.resolveError)throw Error('SENSITIVE: secret');return{createCheckoutSession:async params=>{calls.push(params);if(c.gatewayError)throw Error('SENSITIVE: secret');return{sessionId:'session',redirectUrl:'https://synthetic.invalid/checkout'}}}};let handler;const app={post:(_path,h)=>handler=h};new Function('app','getAdminDb','loadAdminFirestore','getClientRuntimeState','resolvePaymentGateway','CLIENT_ID','port','process','console','createCheckoutHandler',compile(extracted.validators+'\n'+extracted.registration))(app,getDb,async()=>({db:await getDb()}),state,gateway,'tenant',3000,{env:{APP_URL:'https://synthetic.invalid'}},{log(){},warn(){},error(){}},createCheckoutHandler);
let status=200,response;const res={status:s=>{status=s;return res},json:r=>response=r};await handler({body:c.body},res);const label=runtime+'/'+c.id;check(label+'/status',status,c.status);check(label+'/gateway-calls',calls.length,c.status===200||c.gatewayError?1:0);if(c.status===200){check(label+'/currency',calls[0]?.currency,c.currency.toLowerCase());check(label+'/currency-read',reads.includes('config/tenant'),true);check(label+'/amount',calls[0]?.amountCents,c.amount);check(label+'/mode',calls[0]?.mode,c.body.mode==='deposit'?'deposit':'full');check(label+'/result',response,{id:'session',url:'https://synthetic.invalid/checkout'});check(label+'/tenant',calls[0]?.clientId,'tenant')}check(label+'/reads',reads.filter(x=>!x.startsWith('config/')),['sin-id','email-invalido','sin-db'].includes(c.id)?[]:['appointments/appt']);if(c.status===200){check(label+'/appointment',calls[0]?.appointmentId,'appt');check(label+'/email',calls[0]?.customerEmail,'test@example.invalid');check(label+'/name',calls[0]?.serviceName,'Service');check(label+'/successUrl',calls[0]?.successUrl,'https://synthetic.invalid/?booking_status=success&session_id={CHECKOUT_SESSION_ID}');check(label+'/cancelUrl',calls[0]?.cancelUrl,'https://synthetic.invalid/?booking_status=cancelled');}if(c.id.startsWith('moneda-invalida')||c.id.startsWith('config-'))check(label+'/config-exacta',reads.filter(x=>x.startsWith('config/')),['config/tenant']);check(label+'/redacted',JSON.stringify(response).includes('SENSITIVE'),false);rows.push({label,status,response,calls,reads})}}
fs.writeFileSync('/salida/MONEDA-HANDLER.json',JSON.stringify({result:failures.length?'RED':'GREEN',cases:cases.length,checks,failures,rows},null,2));console.log(JSON.stringify({cases:cases.length,checks,failures:failures.length}));process.exitCode=failures.length?1:0})().catch(e=>{console.error(e.stack);process.exitCode=2});
