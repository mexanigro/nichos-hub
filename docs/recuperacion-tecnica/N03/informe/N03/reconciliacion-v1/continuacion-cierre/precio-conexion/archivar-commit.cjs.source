const fs=require('fs'),p=require('path'),cp=require('child_process'),crypto=require('crypto'),d=__dirname,canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',hub='C:/Users/liama/Desktop/Nichos-hub',mirror=hub+'/docs/recuperacion-tecnica/N03',hash=b=>crypto.createHash('sha256').update(b).digest('hex'),git=a=>cp.execFileSync('git',a,{cwd:hub,maxBuffer:16e6}),create=(f,b)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,b,{flag:'wx'})};function walk(dir){return fs.readdirSync(dir,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(p.join(dir,e.name)):[p.join(dir,e.name)])}const records=JSON.parse(fs.readFileSync(d+'/REGISTROS.json','utf8'));for(const x of records)if(hash(fs.readFileSync(x.target))!==x.after)throw Error('record drift');const copied=[];for(const f of walk(d)){const b=fs.readFileSync(f),dest=p.join(mirror,p.relative(canon,f))+(/\.(cjs|ps1|ts|tsx)$/.test(f)?'.source':'');create(dest,b);if(hash(fs.readFileSync(dest))!==hash(b))throw Error('copy');copied.push({source:f,destination:dest,bytes:b.length,sha256:hash(b)})}create(d+'/CUSTODIA.json',JSON.stringify(copied,null,2));const manifest=p.join(mirror,p.relative(canon,d),'CUSTODIA.json');create(manifest,JSON.stringify(copied,null,2));const selected=[...copied.map(x=>p.relative(hub,x.destination).replaceAll('\\','/')),p.relative(hub,manifest).replaceAll('\\','/'),...records.filter(x=>x.target.startsWith(mirror)).map(x=>p.relative(hub,x.target).replaceAll('\\','/')),'docs/recuperacion-tecnica/N03/README.md','docs/recuperacion-tecnica/N03/historial/N03-precio-conexion-cierre-local.md'];if(git(['diff','--cached','--name-only']).toString().trim())throw Error('index dirty');for(let i=0;i<selected.length;i+=40)git(['-c','core.autocrlf=false','add','--',...selected.slice(i,i+40)]);const staged=git(['diff','--cached','--name-only','-z']).toString().split('\0').filter(Boolean);if(staged.length!==selected.length||staged.some(f=>!selected.includes(f)))throw Error('selection');const out=git(['commit','-m','docs(n03): record verified local closure and conditional publication']).toString();fs.writeFileSync(d+'/COMMIT-EXPEDIENTE.json',JSON.stringify({commit:git(['rev-parse','HEAD']).toString().trim(),files:staged.length,output:out,push:'NOT_ATTEMPTED_NO_DEPLOY_NOT_VERIFIED'},null,2),{flag:'wx'});console.log(JSON.stringify({commit:git(['rev-parse','HEAD']).toString().trim(),files:staged.length,custody:copied.length}));
