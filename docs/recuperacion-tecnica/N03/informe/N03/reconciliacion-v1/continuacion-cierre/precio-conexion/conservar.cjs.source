const fs=require('fs'),crypto=require('crypto'),cp=require('child_process'),d=__dirname,t='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',h=b=>crypto.createHash('sha256').update(b).digest('hex'),old=JSON.parse(fs.readFileSync(d+'/../integracion-final/resultados/parcial-final/PIPELINE.json','utf8')),green=JSON.parse(fs.readFileSync(d+'/resultados/green/PIPELINE.json','utf8')),mut=JSON.parse(fs.readFileSync(d+'/resultados/mutante/PIPELINE.json','utf8'));const changed=Object.entries(old.sourceHashes).filter(([f,sha])=>h(fs.readFileSync(t+'/'+f))!==sha).map(([f])=>f);if(JSON.stringify(changed)!==JSON.stringify(['src/lib/api/booking-handler.ts']))throw Error(JSON.stringify(changed));if(green.failures.length||!mut.failures.length)throw Error('contract');const prior=JSON.parse(fs.readFileSync(d+'/../../../cierre-sesion-v1/cierre-actual/SELECCION-PRODUCTO.json','utf8'));let preserved=0;for(const r of prior)for(const x of [...r.preserved,...r.selectedHashes])if(x.sha256){if(h(fs.readFileSync(r.root+'/'+x.file))!==x.sha256)throw Error('other drift '+x.file);preserved++}const frozen=JSON.parse(fs.readFileSync(d+'/FREEZE.json','utf8').replace(/^\uFEFF/,''));for(const x of frozen)if(h(fs.readFileSync(x.Path)).toUpperCase()!==x.Hash)throw Error('freeze drift');fs.writeFileSync(d+'/CONSERVACION.json',JSON.stringify({changed,priorSourceFiles:Object.keys(old.sourceHashes).length,preservedSelectedAndForeign:preserved,frozen:true,sourceHashes:green.sourceHashes,green:{cases:green.cases,checks:green.checks,failures:0},mutant:{cases:mut.cases,checks:mut.checks,failures:mut.failures.length}},null,2),{flag:'wx'});console.log({changed,preserved,green:green.checks,mutantFailures:mut.failures.length});
