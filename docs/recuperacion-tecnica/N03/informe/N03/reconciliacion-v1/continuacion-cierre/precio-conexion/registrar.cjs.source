const fs=require('fs'),p=require('path'),crypto=require('crypto'),d=__dirname,canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',mirror='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03',hash=b=>crypto.createHash('sha256').update(b).digest('hex'),create=(f,b)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,b,{flag:'wx'})};const note='**Estado vigente: N03 completada localmente — GREEN, P0→P3 4/4.** Liam aprobó autoridad de precio del catálogo config backend por serviceId y rechazo previo si no verificable. Handler compartido persiste priceCents sin confiar en body ni alterar históricos. Reserva→agenda→checkout por middleware real de ambos runtimes:78casos452checksGREEN; preimagenRED100 y mutanteRED60; tipos0, conservación y revisión independiente sin BLOCKERS. Las siete filas del balance original quedan acreditadas localmente, sin transferir pendientes para cerrar. Cardcom sigue bloqueado; no se certifica cobro remoto. Commit producto0670e71. Push pendiente: condición no desplegar no acreditada; no se ejecutó ni se cambió hosting. Técnico hasta99%TOTAL, último1%commit/push; observado97%, sin resets. Etapas posteriores y prestaciones por tenant antes de despliegue intactas.';const relReport=p.relative(canon,d)+'/ACTA-CIERRE-LOCAL.md';const rels=['informe/N03/reconciliacion-v1/BALANCE.md','informe/N03/reconciliacion-v1/SIGUIENTE-ACCION.md','informe/N03/cierre-sesion-v1/RETOMA.md','indice/tareas/N03.md','indice/README.md','indice/CALENDARIO.md'];const records=[];for(const[i,root]of[canon,mirror].entries())for(const rel of rels){const target=p.join(root,rel),before=fs.readFileSync(target);create(d+'/preimagenes-registros/'+i+'/'+rel,before);let s=before.toString('utf8'),n=s.indexOf('\n'),link=p.relative(p.dirname(target),p.join(root,relReport)).replaceAll('\\','/');s=s.slice(0,n+1)+'\n'+note+' [Acta, alcance y evidencia](<'+link+'>). Todos los cortes inferiores de autoridad pendiente/16fallos son históricos y conservan sus límites.\n\n'+s.slice(n+1);
if(rel.endsWith('BALANCE.md')){s=s.replace('## Qué todavía impide cerrar N03','## Disposición final de pendientes adjudicados');s=s.split('\n').map(line=>line.startsWith('| L04/L08, COB-A |')?'| L04/L08, COB-A | Importe autorizado y moneda/seña/provider/credencial coherentes. | Autoridad backend y representación vigentes; reserva guarda priceCents desde config.services/serviceOverrides, sin body. HTTP78casos452checksGREEN, mutanteRED60; precio/fuentes/manipulación/rechazo verificados. Cardcom explícitamente bloqueado. | Acreditada localmente; decisión de precio resuelta por Liam y conexión reparada. No se asignan precios históricos ni se declara proveedor remoto operativo. | N01 compromisos; N05 manual/CSV; N06 reservas/concurrencia; N07 cobro/webhook reales. Sin nuevas transferencias. |':line).join('\n');s+='\n## Cierre local vigente\n\nP0→P3 4/4; no BLOCKERS locales restantes. Precio era el último impedimento concreto y ya pasa el recorrido efectivo; demás seis filas conservan evidencia/adjudicación vigente revisada. No depende del agotamiento presupuestario. N03 completada localmente; publicación Git aún bloqueada hasta verificar no-deploy. N04–N10 y prestaciones por tenant mantienen su alcance.\n';}
if(rel.endsWith('CALENDARIO.md'))s=s.replace('| N03 | Backend y funciones opcionales | en curso; book-v1, support-v1 y stock-v1 locales cumplidas | Resto de N03 pendiente; remoto no certificado | [Ficha](tareas/N03.md) |','| N03 | Backend y funciones opcionales | completada localmente; GREEN 4/4 | Push condicionado; remoto no certificado; N04–N10 vigentes | [Ficha](tareas/N03.md) |');
if(rel.endsWith('SIGUIENTE-ACCION.md'))s+='\n## Siguiente acción vigente\n\nNo otra reparación N03. Publicar los commits sólo tras acreditar desactivación de despliegues automáticos; no cambia hosting ni crea ramas esta autorización. Siguiente etapa técnica según calendario, sin ejecutarla aquí. Si aparece evidencia invalidante, reabrir únicamente obligación afectada; no repetir suites aceptadas por rutina.\n';
fs.writeFileSync(target,s);records.push({target,before:hash(before),after:hash(Buffer.from(s))});}create(d+'/REGISTROS.json',JSON.stringify(records,null,2));for(const root of[canon,mirror])create(root+'/historial/N03-precio-conexion-cierre-local.md','# N03 — cierre local\n\n'+note+'\n\nNo nuevas suites ajenas ni cambios de históricos. Precio pendiente sustituido por autorización/implementación verificada; evidencia anterior conservada.\n');
const rm=mirror+'/README.md',b=fs.readFileSync(rm);create(d+'/preimagenes-registros/README-archivo.md',b);fs.writeFileSync(rm,'# N03 — custodia de cierre local\n\n[Acta vigente](informe/N03/reconciliacion-v1/continuacion-cierre/precio-conexion/ACTA-CIERRE-LOCAL.md). GREEN local; publicación pendiente de no-deploy.\n\n'+b.toString('utf8').slice(b.toString('utf8').indexOf('Copia seleccionada')));console.log({records:records.length,state:'GREEN_LOCAL_PUSH_PENDING'});
