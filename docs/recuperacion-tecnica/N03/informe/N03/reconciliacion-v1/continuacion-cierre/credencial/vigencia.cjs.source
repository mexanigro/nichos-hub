const fs=require('fs'),crypto=require('crypto'),ts=require('/hub/node_modules/typescript');
const hash=s=>crypto.createHash('sha256').update(s).digest('hex');
const files=[['editor.tsx','/hub/src/components/config-editors/payment-provider-editor.tsx',null],['route.ts','/hub/src/app/api/config/[clientId]/payment-credentials/route.ts',null],['server.ts','/template/server.ts','getPaymentCredentials'],['api.ts','/template/api/index.ts','getPaymentCredentials'],['gateway.ts','/template/src/lib/api/payment-gateways.ts','buildCardcomGateway'],['gateway.ts','/template/src/lib/api/payment-gateways.ts','createCredentialCache']];
function select(s,name,file){if(!name)return s;const ast=ts.createSourceFile(file,s,99,true);let result;function visit(n){if(ts.isVariableDeclaration(n)&&n.name.getText(ast)===name)result=n.initializer.getText(ast);if(ts.isFunctionDeclaration(n)&&n.name?.text===name)result=n.getText(ast);ts.forEachChild(n,visit)}visit(ast);if(!result)throw Error('No encontrado '+name);return result}
const rows=files.map(([old,current,name])=>{const before=select(fs.readFileSync('/control/preimagenes/'+old,'utf8'),name,old),now=select(fs.readFileSync(current,'utf8'),name,current);return{snapshot:old,current,unit:name??'archivo completo',beforeSha256:hash(before),currentSha256:hash(now),same:before===now}});
fs.writeFileSync('/salida/VIGENCIA.json',JSON.stringify(rows,null,2));console.log(JSON.stringify(rows.map(x=>({unit:x.unit,file:x.snapshot,same:x.same}))));process.exitCode=rows.every(x=>x.same)?0:1;
