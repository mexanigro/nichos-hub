const fs=require('fs'),p=require('path'),{pathToFileURL}=require('url');const root='C:/Users/liama/Desktop/Nichos-hub',d=__dirname;
(async()=>{const{ESLint}=require(root+'/node_modules/eslint');const v=(await import(pathToFileURL(root+'/node_modules/eslint-config-next/dist/core-web-vitals.js'))).default,t=(await import(pathToFileURL(root+'/node_modules/eslint-config-next/dist/typescript.js'))).default;const lint=new ESLint({cwd:root,overrideConfigFile:true,overrideConfig:[...v,...t]});const file='src/components/config-editors/payment-provider-editor.tsx';const before=await lint.lintText(fs.readFileSync(p.join(d,'preimagenes-integracion/hub',file),'utf8'),{filePath:p.join(root,file)}),after=await lint.lintFiles([file]);fs.writeFileSync(p.join(d,'LINT.json'),JSON.stringify({before,after},null,2),{flag:'wx'});const summary=x=>x.map(f=>({errors:f.errorCount,warnings:f.warningCount,messages:f.messages.map(m=>({rule:m.ruleId,message:m.message}))}));console.log(JSON.stringify({before:summary(before),after:summary(after)}));process.exitCode=JSON.stringify(summary(before))===JSON.stringify(summary(after))?0:1;})().catch(e=>{console.error(e.stack);process.exitCode=2});
