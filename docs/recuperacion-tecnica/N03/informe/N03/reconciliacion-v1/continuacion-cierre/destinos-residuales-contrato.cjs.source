const fs=require('fs'),{createRequire}=require('module'),crypto=require('crypto'),assert=require('assert/strict');const req=createRequire('/deps/package.json'),ts=req('typescript'),file='/template/api/index.ts',s=fs.readFileSync(file,'utf8'),ast=ts.createSourceFile(file,s,99,true);const fn=n=>ast.statements.find(x=>ts.isFunctionDeclaration(x)&&x.name?.text===n).getText(ast);const variable=n=>ast.statements.flatMap(x=>ts.isVariableStatement(x)?[...x.declarationList.declarations]:[]).find(x=>x.name.getText(ast)===n).initializer.getText(ast);const texts={runtime:fn('getClientRuntimeState'),guard:variable('enforceClientActive'),credentials:variable('getPaymentCredentials')};const rows=[],failures=[];let checks=0;function eq(id,a,b){checks++;try{assert.deepEqual(a,b)}catch(e){failures.push({id,actual:a,expected:b})}}
const common={FIREBASE_PROJECT_ID:'p-a',FIREBASE_ADMIN_PROJECT_ID:'p-a',VITE_FIREBASE_PROJECT_ID:'p-a'};
const cases=[{id:'coinciden',env:common,project:'p-a',db:'default'},{id:'contradiccion',env:{...common,VITE_FIREBASE_PROJECT_ID:'p-b'},reject:true},{id:'admin-general',env:{...common,FIREBASE_PROJECT_ID:'p-b'},reject:true},{id:'admin-otro',env:{...common,FIREBASE_ADMIN_PROJECT_ID:'p-b'},reject:true},{id:'solo-server',env:{FIREBASE_PROJECT_ID:'p-a',FIREBASE_ADMIN_PROJECT_ID:'p-b'}},{id:'sin-token-contradictorio',env:{...common,VITE_FIREBASE_PROJECT_ID:'p-b'},token:false},{id:'blancos',env:{FIREBASE_PROJECT_ID:' ',FIREBASE_ADMIN_PROJECT_ID:' ',VITE_FIREBASE_PROJECT_ID:' ',NEXT_PUBLIC_FIREBASE_PROJECT_ID:' p-c ',FIREBASE_DATABASE_ID:' ',VITE_FIREBASE_DATABASE_ID:' (default) '},project:'p-c',db:'(default)'},{id:'solo-vite',env:{VITE_FIREBASE_PROJECT_ID:'p-a',FIREBASE_DATABASE_ID:'named',VITE_FIREBASE_DATABASE_ID:'other'},project:'p-a',db:'named'},{id:'vacio',env:{FIREBASE_PROJECT_ID:'',VITE_FIREBASE_PROJECT_ID:''}},{id:'ausencia',env:{}}];
(async()=>{for(const c of cases)for(const [kind,body]of Object.entries(texts)){const calls=[];let source=kind==='runtime'?body+'\nreturn getClientRuntimeState;':'return '+body;if(process.argv[2]==='mutant')source=source.replaceAll('throw new Error("Firestore destination mismatch");','void 0;');const js=ts.transpileModule(source,{compilerOptions:{module:1,target:9}}).outputText;const f=new Function('process','getFirestoreAccessToken','fetch','CLIENT_ID','VALID_PROVIDERS','clientStateCache','createTenantAccessGuard','createCredentialCache',js)({env:c.env},async()=>c.token===false?null:'synthetic',async(url)=>{calls.push(url);return{ok:true,status:200,json:async()=>({fields:{status:{stringValue:'active'},defaultPaymentProvider:{stringValue:'none'}}})}},'n03',['none','stripe'],null,x=>x,x=>x);let result,error;try{result=await f()}catch(e){error=e.message}const active=!!c.project,cols=kind==='runtime'?['clients','config']:kind==='guard'?['clients']:['payment_credentials'];eq(c.id+'/'+kind+'/urls',calls,active?cols.map(col=>'https://firestore.googleapis.com/v1/projects/'+c.project+'/databases/'+c.db+'/documents/'+col+'/n03'):[]);eq(c.id+'/'+kind+'/error',error,c.reject?'Firestore destination mismatch':undefined);eq(c.id+'/'+kind+'/return',result,c.reject?undefined:kind==='runtime'?{status:'active',provider:active?'none':'stripe'}:kind==='guard'?(active?'active':null):(active?{status:'active',defaultPaymentProvider:'none'}:{}));rows.push({id:c.id,kind,result,error,calls})}fs.writeFileSync('/salida/DESTINOS-RESIDUALES.json',JSON.stringify({result:failures.length?'RED':'GREEN',checks,failures,source:crypto.createHash('sha256').update(s).digest('hex'),rows,limite:'Funciones/callbacks reales con fetch y token interceptados; no aplicación alojada ni reglas ni DB.'},null,2));console.log({rows:rows.length,checks,failures:failures.length});process.exitCode=failures.length?1:0})().catch(e=>{console.error(e);process.exitCode=2});
