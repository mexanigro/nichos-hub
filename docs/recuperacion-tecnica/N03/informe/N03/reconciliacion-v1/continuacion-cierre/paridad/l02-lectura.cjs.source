// Censo acotado de sintaxis de patches en población explícita; no importa producto.
const fs=require('fs'),crypto=require('crypto'),{createRequire}=require('module');
const root='C:/Users/liama/Desktop/Nichos-hub',ts=createRequire(root+'/package.json')('typescript');
const files=['crm/import','whatsapp-config/[clientId]/templates','whatsapp-config/[clientId]','api-keys','config/[clientId]','voice-config/[clientId]','api-costs/fetch','auth/upsert-lead','api-costs/[serviceId]','clients/kill','clients/[clientId]','clients','clients/provision','appointments/book','onboarding/draft','clients/changes-request','onboarding/client-info','onboarding'].map(p=>'src/app/api/'+p+'/route.ts');
const rows=files.map(file=>{const text=fs.readFileSync(root+'/'+file,'utf8'),ast=ts.createSourceFile(file,text,ts.ScriptTarget.Latest,true);if(ast.parseDiagnostics.length)throw Error('No parsea '+file);const mergeSets=[],dotted=[];function line(n){return ast.getLineAndCharacterOfPosition(n.getStart(ast)).line+1}function parentCall(n){while(n){if(ts.isCallExpression(n))return n.expression.getText(ast);n=n.parent}return null}function walk(n){if(ts.isCallExpression(n)&&ts.isPropertyAccessExpression(n.expression)&&n.expression.name.text==='set'&&n.arguments.some(a=>ts.isObjectLiteralExpression(a)&&a.properties.some(p=>ts.isPropertyAssignment(p)&&p.name.getText(ast)==='merge'&&p.initializer.kind===ts.SyntaxKind.TrueKeyword)))mergeSets.push({line:line(n),callee:n.expression.getText(ast),arguments:n.arguments.map(a=>a.getText(ast))});if(ts.isPropertyAssignment(n)&&ts.isStringLiteral(n.name)&&n.name.text.includes('.'))dotted.push({line:line(n),key:n.name.text,sink:parentCall(n),syntax:n.getText(ast)});if(ts.isBinaryExpression(n)&&n.operatorToken.kind===ts.SyntaxKind.EqualsToken&&ts.isElementAccessExpression(n.left)&&ts.isStringLiteral(n.left.argumentExpression)&&n.left.argumentExpression.text.includes('.'))dotted.push({line:line(n),key:n.left.argumentExpression.text,sink:parentCall(n),syntax:n.getText(ast)});ts.forEachChild(n,walk)}walk(ast);return{file,sha256:crypto.createHash('sha256').update(text).digest('hex'),mergeSets,dotted}});
const result={scope:'17 rutas con merge:true literal en src/app/api y onboarding/route.ts adjudicada. Sólo sintaxis propia de patches; no datos arbitrarios del request ni consumidores externos/scripts.',files:rows.length,mergeCalls:rows.reduce((n,r)=>n+r.mergeSets.length,0),dotted:rows.flatMap(r=>r.dotted.map(d=>({file:r.file,...d}))),rows};
fs.writeFileSync(__dirname+'/L02-POBLACION.json',JSON.stringify(result,null,2));console.log(JSON.stringify({files:result.files,mergeCalls:result.mergeCalls,dotted:result.dotted},null,2));
