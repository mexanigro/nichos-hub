const fs=require('fs'),path=require('path'),crypto=require('crypto'),assert=require('assert/strict'),{createRequire}=require('module');
const req=createRequire('/deps/package.json'),ts=req('typescript'),express=req('express');
const dir='/control/preimagenes', mutant=process.argv[2]||null,checks=[],failures=[],rows=[];
const hash=s=>crypto.createHash('sha256').update(s).digest('hex');
const source={api:fs.readFileSync(dir+'/api.ts','utf8'),server:fs.readFileSync(dir+'/server.ts','utf8')};
const selectors=[['get','/api/services'],['post','/api/availability'],['post','/api/bookings/validate'],['get','/api/daily-digest'],['get','*']];
function eq(actual,expected,label){checks.push(label);try{assert.deepStrictEqual(actual,expected)}catch{failures.push({label,actual,expected})}}
function registrations(text){const ast=ts.createSourceFile('source.ts',text,ts.ScriptTarget.Latest,true),out=[];function walk(n){if(ts.isCallExpression(n)&&ts.isPropertyAccessExpression(n.expression)&&n.expression.expression.getText(ast)==='app'&&['get','post'].includes(n.expression.name.text)&&n.arguments.length&&ts.isStringLiteral(n.arguments[0]))out.push({method:n.expression.name.text,route:n.arguments[0].text,text:n.getText(ast)});ts.forEachChild(n,walk)}walk(ast);return out}
const api=registrations(source.api),server=registrations(source.server),texts=selectors.map(([method,route])=>{const found=(route==='*'?server:api).filter(x=>x.method===method&&x.route===route);assert.equal(found.length,1,route);return found[0]});
const extracted=texts.map(x=>({...x,sha256:hash(x.text)}));
let mutations=0;
if(mutant?.startsWith('remove-')){const i=Number(mutant.slice(7));assert.ok(i>=0&&i<5);texts[i]={...texts[i],text:''};mutations=1}
if(mutant==='cron'){const ast=ts.createSourceFile('digest.ts',texts[3].text,ts.ScriptTarget.Latest,true);let span;function walk(n){if(ts.isIfStatement(n)&&n.expression.getText(ast).includes('req.headers.authorization'))span=[n.getStart(ast),n.end];ts.forEachChild(n,walk)}walk(ast);assert.ok(span);texts[3].text=texts[3].text.slice(0,span[0])+texts[3].text.slice(span[1]);mutations=1}
function compile(text,bindings,tail=''){const js=ts.transpileModule(text,{compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.CommonJS}}).outputText;return new Function(...Object.keys(bindings),js+'\n'+tail)(...Object.values(bindings))}
const moduleExport={};compile(fs.readFileSync(dir+'/booking-validation.ts','utf8'),{exports:moduleExport});
const config={fields:{services:{arrayValue:{values:[{mapValue:{fields:{id:{stringValue:'cut'},name:{stringValue:'Corte'},duration:{integerValue:'30'},price:{doubleValue:125.5}}}}]}}}};
const docs=['confirmed','cancelled','pending'].map(status=>({document:{fields:{status:{stringValue:status},serviceId:{stringValue:'cut'}}}}));
let state;
function reset(over={}){state={env:{CRON_SECRET:'synthetic-cron',FIREBASE_PROJECT_ID:'project-local',FIREBASE_DATABASE_ID:'base-local',BUSINESS_OWNER_EMAIL:'owner@example.invalid',EMAIL_FROM_ADDRESS:'sender@example.invalid'},token:true,status:200,fetchThrows:false,resend:true,emailError:false,emailThrows:false,ops:[],emails:[],logs:[],...over};return state}
const env=new Proxy({}, {get:(_,name)=>state.env[name]});
const fetchStub=async(url,options={})=>{state.ops.push({url,method:options.method||'GET',body:options.body?JSON.parse(options.body):null});if(state.fetchThrows)throw Error('synthetic DB failure');return{ok:state.status<300,status:state.status,text:async()=>'synthetic upstream',json:async()=>url.endsWith(':runQuery')?docs:config}};
const bindings={process:{env},getFirestoreAccessToken:async()=>state.token?'synthetic-token':null,CLIENT_ID:'tenant-local',fetch:fetchStub,getResend:()=>state.resend?{emails:{send:async mail=>{state.emails.push(mail);if(state.emailThrows)throw Error('synthetic send failure');return state.emailError?{error:{message:'synthetic rejected'}}:{data:{id:'synthetic-provider-id'},error:null}}}}:null,writeNotificationLog:log=>state.logs.push(log),console:{log(){},error(){},warn(){}},...moduleExport};
async function run(){
 reset();const app=express();app.use(express.json());compile(texts.slice(0,4).map(x=>x.text+';').join('\n'),{app,...bindings});
 fs.mkdirSync('/tmp/paridad-static',{recursive:true});fs.writeFileSync('/tmp/paridad-static/index.html','<html>LOCAL-SPA-SENTINEL</html>');fs.writeFileSync('/tmp/paridad-static/asset.txt','STATIC-SENTINEL');
 const spa=express();spa.get('/api/probe',(_req,res)=>res.status(418).json({api:true}));spa.use(express.static('/tmp/paridad-static'));compile(texts[4].text+';',{app:spa,path,distPath:'/tmp/paridad-static'});
 const registry=app._router.stack.filter(x=>x.route).map(x=>({route:x.route.path,methods:Object.keys(x.route.methods)}));
 const spaRegistry=spa._router.stack.filter(x=>x.route).map(x=>({route:x.route.path,methods:Object.keys(x.route.methods)}));
 for(const [method,route] of selectors)eq((route==='*'?spaRegistry:registry).some(x=>x.route===route&&x.methods.includes(method)),true,'registro/'+route);
 for(const [method,route] of selectors.slice(0,4))eq(server.some(x=>x.route===route&&x.method===method),false,'excepcion-solo-api/'+route);
 const vercel=JSON.parse(fs.readFileSync(dir+'/vercel.json','utf8'));eq(vercel.rewrites.find(x=>x.source==='/api/:path*')?.destination,'/api','rewrite-api');eq(vercel.rewrites.at(-1),{source:'/(.*)',destination:'/index.html'},'rewrite-spa');eq(vercel.rewrites.findIndex(x=>x.source==='/api/:path*')<vercel.rewrites.findIndex(x=>x.source==='/(.*)'),true,'rewrite-precedencia');eq(vercel.crons,[{path:'/api/daily-digest',schedule:'0 8 * * *'}],'cron-config');
 const listen=a=>new Promise(resolve=>{const s=a.listen(0,'127.0.0.1',()=>resolve(s))});const servers=[await listen(app),await listen(spa)];
 async function call(id,route,options={},over={},test){reset(over);const which=route.startsWith('SPA:')?1:0,url='http://127.0.0.1:'+servers[which].address().port+route.replace(/^SPA:/,'');const response=await fetch(url,{...options,signal:AbortSignal.timeout(3000)});const text=await response.text();let body;try{body=JSON.parse(text)}catch{body=text}rows.push({id,status:response.status,body,operations:state.ops,emails:state.emails,logs:state.logs});test(response.status,body,state)}
 const post=body=>({method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}),auth={headers:{authorization:'Bearer synthetic-cron'}};
 try{
 await call('services-positive','/api/services',{}, {},(s,b,x)=>{eq(s,200,'services/status');eq(b,{services:[{id:'cut',name:'Corte',duration:30,price:125.5}]},'services/projection');eq(x.ops,[{url:'https://firestore.googleapis.com/v1/projects/project-local/databases/base-local/documents/config/tenant-local',method:'GET',body:null}],'services/tenant-destination')});
 for(const [id,over,status] of [['no-token',{token:false},503],['no-project',{env:{}},503],['upstream404',{status:404},404],['upstream500',{status:500},502],['throw',{fetchThrows:true},500]])await call('services-'+id,'/api/services',{},over,(s,b,x)=>{eq(s,status,'services/'+id);eq(x.ops.length,id.startsWith('no-')?0:1,'services/'+id+'/reads');eq(x.emails.length,0,'services/'+id+'/emails')});
 for(const [id,body,status] of [['valid',{date:'2026-09-11',serviceId:'cut'},200],['missing',{},400],['format',{date:'bad',serviceId:'cut'},400]])await call('availability-'+id,'/api/availability',post(body),{},(s,b,x)=>{eq(s,status,'availability/'+id);if(status===200)eq(b,{available:true,...body},'availability/echo-only');eq(x.ops.length,0,'availability/'+id+'/no-slot-read')});
 const valid={serviceId:'cut',date:'2026-09-11',time:'10:00',clientName:'Synthetic',clientPhone:'123',duration:30};
 for(const [id,body,status] of [['valid',valid,200],['missing',{},400],['bad-duration',{...valid,duration:4},400],['bad-time',{...valid,time:'bad'},400]])await call('validate-'+id,'/api/bookings/validate',post(body),{},(s,b,x)=>{eq(s,status,'validate/'+id);eq(b.valid,status===200,'validate/'+id+'/verdict');if(status!==200)eq(Array.isArray(b.errors)&&b.errors.length>0,true,'validate/'+id+'/errors');eq(x.ops.length,0,'validate/'+id+'/no-persistence')});
 for(const [id,options,over,status] of [['no-secret',auth,{env:{}},500],['wrong-secret',{headers:{authorization:'Bearer wrong'}},{},401],['no-token',auth,{token:false},503],['no-project',auth,{env:{CRON_SECRET:'synthetic-cron'}},500]])await call('digest-'+id,'/api/daily-digest',options,over,(s,b,x)=>{eq(s,status,'digest/'+id);eq(x.ops.length,0,'digest/'+id+'/zero-db');eq(x.emails.length,0,'digest/'+id+'/zero-email')});
 for(const [id,over,status,log,sends] of [['db-error',{status:500},502,null,0],['db-throws',{fetchThrows:true},502,null,0],['no-owner',{env:{CRON_SECRET:'synthetic-cron',FIREBASE_PROJECT_ID:'project-local'}},500,'failed',0],['queued',{resend:false},200,'queued',0],['sent',{},200,'sent',1],['provider-error',{emailError:true},502,'failed',1],['provider-throws',{emailThrows:true},500,'failed',1]])await call('digest-'+id,'/api/daily-digest',auth,over,(s,b,x)=>{eq(s,status,'digest/'+id);eq(x.emails.length,sends,'digest/'+id+'/send-count');eq(x.logs.map(y=>y.status),log?[log]:[],'digest/'+id+'/log');if(log==='queued'||log==='sent')eq(b.status,log,'digest/'+id+'/response');if(id==='sent'){eq(x.ops[0].body.structuredQuery.where.compositeFilter.filters[0].fieldFilter,{field:{fieldPath:'clientId'},op:'EQUAL',value:{stringValue:'tenant-local'}},'digest/tenant-filter');eq(x.ops[0].method,'POST','digest/read-query');eq(x.emails[0].to,'owner@example.invalid','digest/recipient');eq(x.emails[0].from,'sender@example.invalid','digest/sender');eq(x.emails[0].html.includes('$251'),true,'digest/estimated-revenue');eq(b.appointments,3,'digest/count');eq(x.logs[0].providerMessageId,'synthetic-provider-id','digest/provider-response-only')}});
 await call('spa-deep-link','SPA:/deep/link',{}, {},(s,b)=>{eq(s,200,'spa/deeplink-status');eq(b,'<html>LOCAL-SPA-SENTINEL</html>','spa/index')});
 await call('spa-static','SPA:/asset.txt',{}, {},(s,b)=>{eq(s,200,'spa/static-status');eq(b,'STATIC-SENTINEL','spa/static')});
 await call('spa-api-priority','SPA:/api/probe',{}, {},(s,b)=>{eq(s,418,'spa/api-priority');eq(b,{api:true},'spa/api-body')});
 }finally{await Promise.all(servers.map(s=>new Promise(resolve=>s.close(resolve))))}
 const result={result:failures.length?'RED':'GREEN',cases:rows.length,checks:checks.length,failures,mutant,mutations,registry,spaRegistry,sources:Object.fromEntries(Object.entries(source).map(([k,v])=>[k,hash(v)])),extracted,observations:rows};fs.writeFileSync('/salida/RESULTADO.json',JSON.stringify(result,null,2));console.log(JSON.stringify({result:result.result,cases:rows.length,checks:checks.length,failures:failures.length,mutant,mutations}));process.exitCode=failures.length?1:0;
}
run().catch(e=>{fs.writeFileSync('/salida/ERROR-INSTRUMENTO.txt',e.stack);console.error(e.stack);process.exitCode=2});
