const fs=require('fs'),p=require('path'),assert=require('assert/strict');const root='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',ts=require(root+'/node_modules/typescript'),file=root+'/api/index.ts';let s=fs.readFileSync(file,'utf8');fs.copyFileSync(file,p.join(__dirname,'preimagenes/api-antes-inline.ts'),fs.constants.COPYFILE_EXCL);const ast=ts.createSourceFile(file,s,99,true),changes=[];const anchors={'/api/daily-digest':'    const today = new Date().toISOString().slice(0, 10);','/sitemap.xml':'          const configUrl =','/api/crm-metrics':'      const now = new Date();','/api/services':'    try {'};function visit(n){if(ts.isCallExpression(n)&&n.expression.getText(ast)==='app.get'&&Object.hasOwn(anchors,n.arguments[0]?.text)){const route=n.arguments[0].text,anchor=anchors[route];let text=n.getText(ast);assert.equal(text.split(anchor).length,2,route);const indent=anchor.match(/^ */)[0],guard=indent+'const adminProjectId = process.env.FIREBASE_ADMIN_PROJECT_ID?.trim();\n'+indent+'if (adminProjectId && adminProjectId !== projectId) {\n'+indent+(route==='/sitemap.xml'?'  throw new Error("Firestore destination mismatch");':'  return res.status(503).json({ error: "Firestore destination mismatch" });')+'\n'+indent+'}\n\n';text=text.replace(anchor,guard+anchor);changes.push({start:n.getStart(ast),end:n.end,text})}ts.forEachChild(n,visit)}visit(ast);assert.equal(changes.length,4);for(const c of changes.sort((a,b)=>b.start-a.start))s=s.slice(0,c.start)+c.text+s.slice(c.end);fs.writeFileSync(file,s);
