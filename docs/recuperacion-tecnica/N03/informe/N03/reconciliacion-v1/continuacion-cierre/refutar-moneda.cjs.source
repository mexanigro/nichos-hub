const fs=require('fs'),p=require('path'),crypto=require('crypto');const d=__dirname;const f=p.join(d,'moneda-handler.cjs');fs.copyFileSync(f,p.join(d,'preimagenes/moneda-handler-r1.cjs'));let s=fs.readFileSync(f,'utf8');s=s.replace("add('request-adulterado',{});","add('request-adulterado',{});add('config-ausente',{configMissing:true,status:503});add('config-falla',{configError:true,status:500});");s=s.replace("reads.push(col+'/'+id);return", "reads.push(col+'/'+id);if(col==='config'&&c.configError)throw Error('SENSITIVE config failure');return");s=s.replace("exists:col==='config'||!!c.appointment", "exists:col==='config'?!c.configMissing:!!c.appointment");s=s.replace("check(label+'/redacted'", "if(c.id.startsWith('moneda-invalida')||c.id.startsWith('config-'))check(label+'/config-exacta',reads.filter(x=>x.startsWith('config/')),['config/tenant']);check(label+'/redacted'");fs.writeFileSync(f,s);const cf=p.join(d,'CONTRATO-MONEDA.md');fs.copyFileSync(cf,p.join(d,'preimagenes/CONTRATO-MONEDA-r1.md'));fs.appendFileSync(cf,'\nRefutación incorporada antes de producción: config ausente503; error lectura500 redactado; cero llamadas gateway en ambos. Config/tenant exacto también en negativos. El requisito de lectura y currency se aplica a Stripe; Cardcom conserva su precondición anterior y permanece pendiente, sin atribución de moneda.\n');fs.writeFileSync(p.join(d,'MONEDA-FREEZE-R2.json'),JSON.stringify(['CONTRATO-MONEDA.md','moneda-handler.cjs','moneda-gateway.cjs'].map(f=>({file:f,sha256:crypto.createHash('sha256').update(fs.readFileSync(p.join(d,f))).digest('hex')})),null,2),{flag:'wx'});
