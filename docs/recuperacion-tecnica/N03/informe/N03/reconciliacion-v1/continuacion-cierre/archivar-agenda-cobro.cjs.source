const fs=require('fs'),p=require('path'),c=require('crypto'),assert=require('assert/strict');const d=__dirname,canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',mirror='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03',h=b=>c.createHash('sha256').update(b).digest('hex'),read=f=>fs.readFileSync(f),json=f=>JSON.parse(read(f).toString('utf8').replace(/^\uFEFF/,''));const create=(f,b)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,b,{flag:'wx'});};const walk=x=>fs.readdirSync(x,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(p.join(x,e.name)):[p.join(x,e.name)]);const files=[...['contrato-cita-separada/ejecucion','credencial','cobro-politica','preimagenes-agenda-cobro-registros'].flatMap(x=>walk(p.join(d,x))),...['ESTADO-INTEGRADO-AGENDA-COBRO.md','REGISTROS-AGENDA-COBRO.json','registrar-agenda-cobro.cjs','archivar-agenda-cobro.cjs'].map(x=>p.join(d,x))];const custody=[];for(const source of files){const b=read(source),rel=p.relative(canon,source),target=p.join(mirror,rel)+(/\.(cjs|js|ts|tsx|ps1)$/.test(source)?'.source':'');if(fs.existsSync(target)){const previous=read(target);if(h(previous)!==h(b)){const backup=p.join(d,'preimagenes-agenda-cobro-archivo',p.relative(mirror,target));create(backup,previous);fs.writeFileSync(target,b);const mirroredBackup=p.join(mirror,p.relative(canon,backup));create(mirroredBackup,previous);}}else create(target,b);assert.equal(h(read(target)),h(b));custody.push({source,target,sha256:h(b),bytes:b.length});}
for(const r of json(p.join(d,'REGISTROS-AGENDA-COBRO.json'))){assert.equal(h(read(r.backup)),r.before);assert.equal(h(read(r.target)),r.after);const match=read(r.target).toString('utf8').match(/\[Estado integrado y retoma\]\(<([^>]+)>\)/);assert.ok(match);assert.ok(fs.existsSync(p.resolve(p.dirname(r.target),match[1])));}
const pipeline=p.join(d,'contrato-cita-separada/ejecucion/pipeline-tenant/CUSTODIA.json'),root='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main';for(const entry of json(pipeline))assert.equal(h(read(p.join(root,entry.source))).toUpperCase(),entry.sha256.toUpperCase());const result={custodyFiles:custody.length,recordsVerified:12,pipelineSourcesStillValid:4,templateConservation:json(p.join(d,'contrato-cita-separada/ejecucion/CONSERVACION.json')).unchanged,n03:'RED abierta, decisiones nuevas pendientes',scope:'agenda handlers local + cobro subset; pipeline separado503',ceiling:100,reserved:2,usageObserved:93,externalEffects:false};for(const root of[canon,mirror]){const dest=p.join(root,p.relative(canon,d));create(p.join(dest,'ARCHIVO-AGENDA-COBRO.json'),JSON.stringify(custody,null,2));create(p.join(dest,'VERIFICACION-AGENDA-COBRO.json'),JSON.stringify(result,null,2));}console.log(result);
