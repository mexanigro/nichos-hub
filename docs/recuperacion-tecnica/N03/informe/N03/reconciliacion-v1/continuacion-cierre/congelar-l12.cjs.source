const fs=require('fs'),p=require('path'),crypto=require('crypto');const d=__dirname,f=p.join(d,'l12.cjs');fs.copyFileSync(f,p.join(d,'preimagenes/l12-r2.cjs'));let s=fs.readFileSync(f,'utf8');s=s.replace('const compiled=new Map(),sources=new Map();','const compiled=new Map(),sources=new Map(),fileCache=new Map();');s=s.replace("let source=fs.readFileSync(f,'utf8');","if(!fileCache.has(f))fileCache.set(f,fs.readFileSync(f,'utf8'));let source=fileCache.get(f);");s=s.replace("{price:123,image:'synthetic-image'}","{price:123,duration:13,image:'synthetic-image',name:'n03-override-name',description:'n03-override-description'}");const marker="observations.push({lang,ids:actual.map(s=>s.id),html});";s=s.replace(marker,"const first=actual.find(s=>s.id===ids[0]);check(id+'/'+lang+'/duration',first?.duration,expected.includes(ids[0])?13:undefined);if(first){check(id+'/'+lang+'/image',site.siteConfig.sections.services.images[actual.indexOf(first)],'synthetic-image');check(id+'/'+lang+'/text-policy',first.name==='n03-override-name',lang==='en');} "+marker);fs.writeFileSync(f,s);const hash=b=>crypto.createHash('sha256').update(b).digest('hex');fs.writeFileSync(p.join(d,'L12-FREEZE.json'),JSON.stringify(['CONTRATO-L12.md','l12.cjs'].map(ruta=>({ruta,sha256:hash(fs.readFileSync(p.join(d,ruta)))})),null,2),{flag:'wx'});
