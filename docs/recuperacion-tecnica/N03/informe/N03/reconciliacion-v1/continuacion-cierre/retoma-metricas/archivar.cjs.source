const fs=require('fs'),p=require('path'),assert=require('assert/strict'),crypto=require('crypto');const d=__dirname,a='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03/informe/N03/reconciliacion-v1/continuacion-cierre/retoma-metricas',hash=b=>crypto.createHash('sha256').update(b).digest('hex'),write=(f,b)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,b,{flag:'wx'})},walk=x=>fs.readdirSync(x,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(p.join(x,e.name)):[p.join(x,e.name)]);const records=JSON.parse(fs.readFileSync(p.join(d,'REGISTROS.json'),'utf8'));for(const r of records){assert.equal(hash(fs.readFileSync(r.dest)),r.after);assert.equal(hash(fs.readFileSync(r.backup)),r.before)}for(const s of JSON.parse(fs.readFileSync(p.join(d,'FREEZE.json'),'utf8')).sources)assert.equal(hash(fs.readFileSync(s.path)),s.sha256);write(p.join(d,'preparar-retoma-metricas.cjs.source'),fs.readFileSync(p.join(d,'../preparar-retoma-metricas.cjs')));const files=walk(d),rows=[];for(const f of files){const out=p.join(a,p.relative(d,f))+(/\.(cjs|ts|tsx|js|ps1)$/.test(f)?'.source':'');const b=fs.readFileSync(f);write(out,b);assert.equal(hash(fs.readFileSync(out)),hash(b));rows.push({source:f,target:out,sha256:hash(b),bytes:b.length})}write(p.join(d,'ARCHIVO.json'),JSON.stringify(rows,null,2));write(p.join(a,'ARCHIVO.json'),JSON.stringify(rows,null,2));for(const r of records)for(const m of fs.readFileSync(r.dest,'utf8').matchAll(/\[Resultado y límites\]\(([^)]+)\)/g))assert.ok(fs.existsSync(p.resolve(p.dirname(r.dest),m[1])));const final={result:'PASS custody; GREEN scoped control; N03 open',copies:rows.length,records:12,product:'5 sources unchanged, including endpoint',expectations:'unchanged',outputs:'three new directories, existing evidence preserved'};write(p.join(d,'CIERRE.json'),JSON.stringify(final,null,2));write(p.join(a,'CIERRE.json'),JSON.stringify(final,null,2));console.log(final);
