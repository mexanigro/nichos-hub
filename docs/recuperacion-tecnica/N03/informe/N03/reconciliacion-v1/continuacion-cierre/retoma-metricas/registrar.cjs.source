const fs=require('fs'),p=require('path'),assert=require('assert/strict'),crypto=require('crypto');const d=__dirname,hash=b=>crypto.createHash('sha256').update(b).digest('hex'),read=f=>JSON.parse(fs.readFileSync(p.join(d,f),'utf8')),write=(f,b)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,b,{flag:'wx'})};const frozen=read('FREEZE.json');for(const s of frozen.sources)assert.equal(hash(fs.readFileSync(s.path)),s.sha256,s.path);assert.equal(hash(fs.readFileSync(p.join(d,'inline-destinos.cjs'))),frozen.instrumentAfter);const evidence=[];for(const [name,count,exit]of [['preimagen',7,1],['producto',0,0],['mutante',7,1]]){const r=read('resultados/'+name+'/INLINE-DESTINOS.json');assert.equal(r.checks,48);assert.equal(r.rows.length,16);assert.equal(r.failures.length,count);assert.equal(Number(fs.readFileSync(p.join(d,'resultados',name,'exit.txt'),'utf8').trim()),exit);assert.ok(r.failures.every(f=>f.id.includes('/incompatible/')));const metric=r.rows.find(r=>r.route==='/api/crm-metrics'&&r.kind==='compatible');assert.equal(metric.calls.length,3);assert.equal(metric.internalErrors[0][1].message,'STOP_LOCAL_READ');assert.ok(!JSON.stringify(r.rows.map(x=>x.internalErrors)).includes('ReferenceError'));const negative=r.rows.find(r=>r.route==='/api/crm-metrics'&&r.kind==='incompatible');assert.equal(negative.calls.length,name==='producto'?0:3);evidence.push({name,checks:r.checks,cases:r.rows.length,failures:count,exit,source:r.source,metricsCompatible:{calls:metric.calls.length,status:metric.status,error:metric.internalErrors[0][1].message},metricsIncompatible:{calls:negative.calls.length,status:negative.status}})}assert.deepEqual(read('resultados/preimagen/INLINE-DESTINOS.json').failures,read('resultados/mutante/INLINE-DESTINOS.json').failures);write(p.join(d,'VERIFICACION.json'),JSON.stringify({scope:'Selección/rechazo de destinos inline',result:'GREEN local para revisión',productUnchanged:frozen.sources,expectationsUnchanged:true,evidence},null,2));
write(p.join(d,'INFORME.md'),`# N03 — retoma del control de destinos de métricas\n\nRESULT: GREEN local, para revisión. N03 permanece abierta.\nTASK: reparar únicamente el montaje detenido, sin endpoint ni expectativas.\nGATES: 3/3: P0 preimagen/freeze; P1 reproducción de los tres estados; P2 atribución/conservación/registros. No son los gates globales de N03.\nTESTS: preimagen RED7 (exit1), producto GREEN48 (exit0), guarda desarmada RED7 (exit1);16 escenarios por ejecución.\nBLOCKERS: ninguno de este tramo instrumental.\nCHANGES: versión del instrumento con dos dependencias reales y captura de errores; registros actualizados.\nREMAINING: revisión de esta evidencia, contrato de destinos separados y pendientes de cobro del balance; no ejecutados aquí.\n\n## Causa y corrección\n\ncrmRangeWindow llama startOfDay e isoDay. El arnés extraía crmRangeWindow pero omitía ambas funciones; además descartaba console.error del catch del callback. Por eso un error interno se manifestaba como500 sin operaciones observadas, indistinguible del fallo deliberado de lectura usado por el contrato. Añadir sólo CRM_METRICS_DOC_CAP no solucionaba esas dependencias. El replanteo independiente comunicado por Liam autorizó esta reproducción concreta.\n\nSe conservó inline-destinos.cjs previo en preimagenes y no se sobrescribió la versión anterior del expediente. La nueva versión extrae ambas funciones por AST del archivo montado en cada corrida, con cuerpos idénticos en preimagen y producto; captura nombre/mensaje de Error y argumentos de console.error en internalErrors. FREEZE.json prueba por reversión exacta que sólo cambiaron carga de dependencias y observabilidad: entradas, expectativas, guardas simuladas y mutación permanecen iguales. No se modificó producto.\n\n## Atribución del resultado\n\nEn el caso compatible de métricas se observan las tres consultas iniciadas a projects/p-a/databases/(default)/documents:runQuery. El500 y Error STOP_LOCAL_READ son deliberados: fetch se intercepta y falla antes de cualquier acceso real. Ya no aparece ReferenceError. En configuración incompatible, producto devuelve503 sin consultas; preimagen y mutante vuelven a iniciar tres consultas y fallan las expectativas de destino/rechazo. Los siete fallos de ambos RED son idénticos y pertenecen exclusivamente a casos incompatibles de los cuatro callbacks.\n\nSe conserva el mismo contrato de16escenarios/48controles: digest, sitemap, crm-metrics y services frente a compatible/incompatible/sin-token/sin-proyecto. No se ejecutaron suites ajenas. Salidas nuevas: resultados/preimagen, resultados/producto y resultados/mutante; comandos, exit y errores internos íntegros. Docker existente con --pull=never --network=none y fuentes sólo lectura; sin instalaciones, credenciales reales ni efectos externos.\n\n## Qué permite descontar y qué no\n\nResuelve el impedimento de montaje del control positivo y acredita localmente selección/rechazo de destinos en esta población. No certifica cálculo, agregaciones, exactitud de rangos, timezone, caché, datos reales, autorización completa, HTTP alojado ni métricas completas. No unifica destinos del navegador y backend; la decisión de conservarlos separados y definir su contrato sigue vigente. El balance continúa siendo lista única de cierre; no se reabren entregas aceptadas ni se trasladan obligaciones a N04.\n\nProducto preservado por huella antes/después, incluido api/index.ts. La evidencia y parada anteriores se conservan como históricas, junto con el incidente de custodia anterior; esta retoma no los borra. Techo100% TOTAL compartido, lectura inicial91%, sin resets/push/deploy. Etapas posteriores y condición sobre prestaciones por tenant antes del despliegue intactas.\n`);
const canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',archive='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03';const rels=['informe/N03/reconciliacion-v1/BALANCE.md','informe/N03/reconciliacion-v1/SIGUIENTE-ACCION.md','informe/N03/cierre-sesion-v1/RETOMA.md','indice/tareas/N03.md','indice/README.md','indice/CALENDARIO.md'];const records=[];for(const rel of rels){const file=p.join(canon,rel),b=fs.readFileSync(file),link=p.relative(p.dirname(file),p.join(d,'INFORME.md')).replaceAll('\\','/');let s=b.toString('utf8');const note='**Estado vigente: control detenido de destinos de métricas resuelto localmente y entregado para revisión; N03 sigue abierta.** Replanteo autorizado: startOfDay/isoDay reales incorporados al arnés, errores internos capturados, sin producto ni expectativas modificados. Mismo contrato: preimagen RED7, producto GREEN48, mutante RED7. Se levanta únicamente ese impedimento instrumental; no se certifican métricas completas ni se acepta/cierra N03. [Resultado y límites]('+link+'). Permanecen contrato de destinos separados, cobro y demás obligaciones del balance, etapas posteriores y condición por tenant. Techo100% TOTAL compartido, observado91%, sin resets/externos/push/deploy. Los cortes anteriores quedan como historia.';assert.ok(s.includes('**Estado vigente: N03 RED global, STOP'));s=s.replace(/\*\*Estado vigente: N03 RED global, STOP[\s\S]*?(?=\r?\n\r?\n)/,note);if(rel.endsWith('BALANCE.md')){const old='Cuatro inlineREST guardados: RED global1 por montaje positivo crm-metrics; STOP método, no descontado. Ver RETOMA-RESULTADO.';assert.ok(s.includes(old));s=s.replace(old,'Cuatro inlineREST: impedimento del arnés resuelto con dependencias reales; preimagen RED7, producto GREEN48 y mutante RED7, para revisión. Acredita selección/rechazo, no métricas completas. Contrato navegador/backend separado sigue abierto.');}for(const [label,root]of [['canon',canon],['archivo',archive]]){const dest=p.join(root,rel),old=fs.readFileSync(dest),backup=p.join(d,'preimagenes/registros',label,rel);write(backup,old);fs.writeFileSync(dest,s);records.push({dest,backup,before:hash(old),after:hash(Buffer.from(s))})}}write(p.join(d,'REGISTROS.json'),JSON.stringify(records,null,2));const hist='historial/N03-retoma-metricas-v1.md';const history='# N03: retoma acotada de métricas\n\nSe reprodujo el replanteo autorizado: arnés completado con startOfDay/isoDay del producto y errores internos observables. Preimagen RED7, producto GREEN48, mutante RED7; mismo contrato y producto intacto. Impedimento instrumental resuelto para revisión; N03 abierta, pendientes y límites conservados. [Informe](../informe/N03/reconciliacion-v1/continuacion-cierre/retoma-metricas/INFORME.md). Techo100% TOTAL sin resets ni efectos externos.\n';write(p.join(canon,hist),history);write(p.join(archive,hist),history);console.log({result:'GREEN local',records:records.length,evidence});
