const fs=require('fs'),p=require('path'),crypto=require('crypto'),assert=require('assert/strict');const d=__dirname,out=p.join(d,'retoma-metricas');fs.mkdirSync(out);fs.mkdirSync(p.join(out,'preimagenes'));const hash=b=>crypto.createHash('sha256').update(b).digest('hex');const source=fs.readFileSync(p.join(d,'inline-destinos.cjs'),'utf8');fs.writeFileSync(p.join(out,'preimagenes/inline-destinos.cjs'),source,{flag:'wx'});let next=source.replace("['isValidRange','crmRangeWindow']","['isValidRange','startOfDay','isoDay','crmRangeWindow']").replace('const calls=[];let handler;','const calls=[],internalErrors=[];let handler;').replace('console:{error(){},warn(){},log(){}}','console:{error(...args){internalErrors.push(args.map(v=>v instanceof Error?{name:v.name,message:v.message}:String(v)))},warn(){},log(){}}').replace('response,escaped,calls})','response,escaped,calls,internalErrors})');assert.notEqual(next,source);const reversed=next.replace("['isValidRange','startOfDay','isoDay','crmRangeWindow']","['isValidRange','crmRangeWindow']").replace('const calls=[],internalErrors=[];let handler;','const calls=[];let handler;').replace('console:{error(...args){internalErrors.push(args.map(v=>v instanceof Error?{name:v.name,message:v.message}:String(v)))},warn(){},log(){}}','console:{error(){},warn(){},log(){}}').replace('response,escaped,calls,internalErrors})','response,escaped,calls})');assert.equal(reversed,source,'Sólo dependencias y observabilidad; expectativas intactas');fs.writeFileSync(p.join(out,'inline-destinos.cjs'),next,{flag:'wx'});
const root='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',ts=require(root+'/node_modules/typescript');const sources=['api/index.ts','server.ts','src/config/site.ts','src/lib/api/checkout-handler.ts','src/lib/api/payment-gateways.ts'].map(rel=>({path:p.join(root,rel),sha256:hash(fs.readFileSync(p.join(root,rel)))}));const helpers=[];for(const file of [root+'/api/index.ts',p.join(d,'preimagenes/api-antes-inline.ts')]){const s=fs.readFileSync(file,'utf8'),a=ts.createSourceFile(file,s,99,true);for(const name of ['startOfDay','isoDay','crmRangeWindow']){const n=a.statements.find(n=>ts.isFunctionDeclaration(n)&&n.name?.text===name);assert.ok(n,name);helpers.push({file,name,text:n.getText(a),sha256:hash(n.getText(a))})}}for(const name of ['startOfDay','isoDay','crmRangeWindow'])assert.equal(helpers.find(h=>h.name===name).sha256,helpers.filter(h=>h.name===name)[1].sha256);fs.writeFileSync(p.join(out,'FREEZE.json'),JSON.stringify({instrumentBefore:hash(source),instrumentAfter:hash(next),expectations:'Conservadas por reversión exacta de las únicas cuatro sustituciones instrumentales',sources,helpers},null,2),{flag:'wx'});fs.writeFileSync(p.join(out,'PLAN.md'),'# Retoma acotada del control de destinos\n\nAutorización específica de Liam tras segundo pensamiento: incorporar startOfDay e isoDay reales y observar errores internos. No producto ni expectativas, sin suites ajenas. P0: preimagen, causa y freeze; P1: mismo contrato sobre preimagen, producto y guarda desarmada en tres salidas nuevas; P2: comprobar atribución, conservación, actualizar impedimento y entregar para revisión. GREEN local no certifica métricas completas ni cierra N03. Techo100% TOTAL, observado91%; sin resets/externos/push/deploy; obligaciones y condición por tenant intactas.\n\nRefutación: evitar volver a omitir dependencias, ocultar errores y cambiar el oráculo. Ambas funciones se extraen por AST del archivo realmente montado; cuerpos iguales en preimagen/producto. Reversión exacta del diff instrumental demuestra expectativas intactas. La ejecución independiente informada por Liam se reproduce, no se toma como prueba propia.\n',{flag:'wx'});console.log({dir:out,expectationsUnchanged:true,helpersMatch:true});
