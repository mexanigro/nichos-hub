const fs=require('fs'),p=require('path'),crypto=require('crypto');const d=__dirname,f=p.join(d,'checkout.cjs');fs.copyFileSync(f,p.join(d,'preimagenes/checkout-r1.cjs'));let s=fs.readFileSync(f,'utf8');s=s.replace("check(label+'/redacted'",`check(label+'/reads',reads,['sin-id','email-invalido','sin-db'].includes(c.id)?[]:['appointments/appt']);if(c.status===200){check(label+'/appointment',calls[0]?.appointmentId,'appt');check(label+'/email',calls[0]?.customerEmail,'test@example.invalid');check(label+'/name',calls[0]?.serviceName,'Service');check(label+'/successUrl',calls[0]?.successUrl,'https://synthetic.invalid/?booking_status=success&session_id={CHECKOUT_SESSION_ID}');check(label+'/cancelUrl',calls[0]?.cancelUrl,'https://synthetic.invalid/?booking_status=cancelled');}check(label+'/redacted'`);fs.writeFileSync(f,s);const hash=b=>crypto.createHash('sha256').update(b).digest('hex');fs.writeFileSync(p.join(d,'CHECKOUT-FREEZE.json'),JSON.stringify(['CONTRATO-CHECKOUT.md','checkout.cjs'].map(ruta=>({ruta,sha256:hash(fs.readFileSync(p.join(d,ruta)))})),null,2),{flag:'wx'});
