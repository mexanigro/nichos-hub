const fs=require('fs'),p=require('path'),crypto=require('crypto'),d=__dirname,canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',mirror='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03',hash=b=>crypto.createHash('sha256').update(b).digest('hex');const create=(f,b)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,b,{flag:'wx'})};
const report='informe/N03/reconciliacion-v1/continuacion-cierre/integracion-final/ACTA-RED-RETOMA.md';
const note='**Estado vigente — N03 RED/abierta por autoridad de precio pendiente.** Aprobaciones de autoridad backend clients/config/credenciales y coherencia de cobro aplicadas y verificadas localmente. Reserva→lectura/acción de agenda alcanza la misma cita con destinos separados y middleware real; no se descuenta cobro completo: book no guarda precio y checkout rechaza400. Liam decidió mantener pendiente la propuesta de precio del catálogo backend; booking-handler e históricos no se modifican. Pipeline48casos264checks conserva16fallos de ese impedimento; mutantes detectan bypass24adicionales y rechazo de válidos52nuevos. Revisión integrada de siete filas y cambios recientes registrada; entregas aceptadas intactas. Techo100% TOTAL, observado96%, reserva98–100sinconsumir, sinresets/externos/push/deploy; etapas y prestaciones por tenant antes de despliegue vigentes.';
const rels=['informe/N03/reconciliacion-v1/BALANCE.md','informe/N03/reconciliacion-v1/SIGUIENTE-ACCION.md','informe/N03/cierre-sesion-v1/RETOMA.md','indice/tareas/N03.md','indice/README.md','indice/CALENDARIO.md'],records=[];
for(const[index,root]of[canon,mirror].entries())for(const rel of rels){const target=p.join(root,rel),before=fs.readFileSync(target),backup=p.join(d,'preimagenes-registros',String(index),rel);create(backup,before);let s=before.toString('utf8'),first=s.indexOf('\n'),link=p.relative(p.dirname(target),p.join(root,report)).replaceAll('\\','/');s=s.slice(0,first+1)+'\n'+note+' [Acta, evidencia y retoma](<'+link+'>). Los cortes inferiores quedan históricos.\n\n'+s.slice(first+1);
if(rel.endsWith('BALANCE.md')){s=s.split('\n').map(line=>line.startsWith('| RE-EXT-02/03, RE-01, AR-N01 |')?'| RE-EXT-02/03, RE-01, AR-N01 | Compatibilidad local por consumidor, sin unificación. | Aceptaciones 2Admin+3REST/métricas conservadas. Agenda histórica/origen/auth vigente más pipeline real de ambos runtimes: book→GET/PATCH misma cita en destinos separados. Estado/config/credenciales de backend por accesores existentes; guardas conservadas, mutaciones efectivas. | Alcance local acreditado y revisado, sin inventar nueva aceptación de Liam. Ya no bloquea el503delmiddleware; checkout sinprecio se mantiene en COB-A. No certifica IAM ni histórico universal. | N04 identidades/reglas/variables reales; N08 propagación; N10 integración; límites originales intactos. |':line.startsWith('| L04/L08, COB-A |')?'| L04/L08, COB-A | Importe autorizado y moneda/seña/provider/credencial coherentes. | Seña/modo config y Cardcom bloqueado vigentes. Credencial anidada37GREEN y destino backend integrado. Manual/none no cobran, inválido/error no habilita fallback, UI sin toggles muertos/2000. Tipos0 y mutaciones efectivas. | ABIERTA: book no escribe precio autorizado; checkout rechaza400. Instrumento ya no inserta precio artificial. Liam deja pendiente autoridad de precio del catálogo backend. No reparar booking ni descontar esta familia; Cardcom sigue no operativo por decisión. | N01 compromisos; N05 manual/CSV; N06 reservas; N07 cobro/webhook reales. La conexión local pendiente NO se transfiere. |':line.replace('Revisión integrada pendiente, sin otra reparación demostrada.','Revisión integrada registrada en integracion-final, sin otra reparación demostrada.')).join('\n');s+='\n## Checkpoint vigente de revisión integrada\n\nP0/P1 globales completos; P2 parcial exclusivamente por precio book→checkout. P3 tiene acta RED/retoma, no cierre GREEN. Las siete filas se revisaron con evidencia vigente; no se reconstruyó auditoría ni herramientas. Próxima acción única: resolver autoridad de precio pendiente por decisión de Liam, antes de cualquier modificación de booking-handler. Consumo96%; no cierre por presupuesto.\n';}
if(rel.endsWith('SIGUIENTE-ACCION.md'))s+='\n## Acción vigente única\n\nResolver la decisión funcional de autoridad/escritura de precio para book→checkout, dejada pendiente por Liam. Propuesta ya presentada: serviceId en catálogo config backend y rechazo previo si precio no verificable en reserva online; no está aprobada. No ejecutar reparación de booking ni otra familia. Reutilizar pipeline congelado, que conserva200esperado y REDporprecio.\n';
fs.writeFileSync(target,s);records.push({target,backup,before:hash(before),after:hash(fs.readFileSync(target))});}
create(d+'/REGISTROS.json',JSON.stringify(records,null,2));for(const root of[canon,mirror])create(p.join(root,'historial/N03-integracion-final-autoridad-cobro.md'),'# N03 — integración de autoridad y cobro\n\n'+note+'\n\nSe conserva acta RED; no aceptación inventada ni cierre por cuota. La decisión de precio permanece pendiente y no se aplica.\n');console.log(JSON.stringify({records:records.length,n03:'RED',pending:'autoridad precio book→checkout'}));
