const fs=require('fs'),crypto=require('crypto'),{createRequire}=require('module'),path=require('path'),d=__dirname,t='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',h='C:/Users/liama/Desktop/Nichos-hub',hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex'),ts=createRequire(t+'/package.json')('typescript');
