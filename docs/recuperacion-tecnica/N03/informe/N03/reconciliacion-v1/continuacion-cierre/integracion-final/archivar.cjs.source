const fs=require('fs'),p=require('path'),crypto=require('crypto'),assert=require('assert/strict'),d=__dirname,canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',mirror='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03',h=b=>crypto.createHash('sha256').update(b).digest('hex');const create=(f,b)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,b,{flag:'wx'});};
const conservation=JSON.parse(fs.readFileSync(d+'/CONSERVACION-FINAL.json','utf8'));for(const[file,sha]of Object.entries(conservation.finalHashes)){const b=fs.readFileSync('C:/Users/liama/Desktop/Nichos/Barber-shop-template-main/'+file);assert.equal(h(b),sha);create(d+'/producto-final/template/'+file+'.source',b)}const eb=fs.readFileSync('C:/Users/liama/Desktop/Nichos-hub/src/components/config-editors/payment-provider-editor.tsx');assert.equal(h(eb),conservation.hubEditorHash);create(d+'/producto-final/hub/payment-provider-editor.tsx.source',eb);
const rows=[];function copy(f){const rel=p.relative(canon,f),dest=p.join(mirror,rel)+(/\.(cjs|mjs|js|ts|tsx|ps1)$/.test(f)?'.source':'');const b=fs.readFileSync(f);if(fs.existsSync(dest)){const old=fs.readFileSync(dest);if(h(old)!==h(b))create(d+'/preimagenes-espejo/'+p.relative(mirror,dest),old)}fs.mkdirSync(p.dirname(dest),{recursive:true});fs.writeFileSync(dest,b);assert.equal(h(fs.readFileSync(dest)),h(b));rows.push({source:f,destination:dest,bytes:b.length,sha256:h(b)});}
const cred=p.join(d,'../credencial/reparacion');for(const f of ['contrato.cjs','contrato.cjs.pre-integracion-final.source','resultados/integracion-final/CONTRATO.json','resultados/integracion-final/COMANDO.json','resultados/integracion-final/ejecucion.log','resultados/integracion-final/exit.txt'])copy(p.join(cred,f));
function walk(dir){return fs.readdirSync(dir,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(p.join(dir,e.name)):[p.join(dir,e.name)])}for(const f of walk(d))copy(f);const records=JSON.parse(fs.readFileSync(d+'/REGISTROS.json','utf8'));for(const r of records)assert.equal(h(fs.readFileSync(r.target)),r.after);const manifest={files:rows.length,rows,recordsVerified:records.length,productVerified:11,result:'GREEN_CUSTODIA_NO_CIERRE_N03'};create(d+'/CUSTODIA-FINAL.json',JSON.stringify(manifest,null,2));create(p.join(mirror,p.relative(canon,d),'CUSTODIA-FINAL.json'),JSON.stringify(manifest,null,2));console.log(JSON.stringify({files:rows.length,records:records.length,product:11,result:manifest.result}));
