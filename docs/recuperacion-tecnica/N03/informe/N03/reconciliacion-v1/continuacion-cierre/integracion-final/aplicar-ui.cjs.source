const fs=require('fs'),crypto=require('crypto'),path=require('path');const root=__dirname,hub='C:/Users/liama/Desktop/Nichos-hub',template='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main';
const files={editor:hub+'/src/components/config-editors/payment-provider-editor.tsx',wizard:template+'/src/components/booking/BookingWizard.tsx',gateway:template+'/src/lib/api/payment-gateways.ts'};fs.mkdirSync(root+'/preimagenes-ui',{recursive:true});for(const[k,p]of Object.entries(files))fs.copyFileSync(p,root+'/preimagenes-ui/'+k+'.source',fs.constants.COPYFILE_EXCL);
fs.writeFileSync(root+'/FREEZE-UI.json',JSON.stringify({rules:'53 controles UI-PROVIDER-RED fijos, RED35; no modifica expectativas. EditorSSR modos y legacy, datos conservados, Cardcom bloqueado, proveedor explícito inválido rechaza, ausencia legacy. Wizard deja importe al servidor sin2000 ni price enviado. P0RED→P1edición→P2GREEN+mutación→P3revisión. Refutación: precio debe tener autoridad backend, pendiente decisión usuario; no se presume resuelto por UI. Política de Cardcom no convierte reserva en pagada.',contractHash:crypto.createHash('sha256').update(fs.readFileSync(root+'/ui-provider.cjs')).digest('hex'),files},null,2),{flag:'wx'});
let s=fs.readFileSync(files.editor,'utf8');s=s.replace('Proveedor israelí — shekels, tarjetas locales','Cardcom bloqueado: moneda pendiente de validación');s=s.replace('allCredsConfigured && !credsDirty && (','currentProvider !== "cardcom" && allCredsConfigured && !credsDirty && (');const start=s.indexOf('          {/* Accept cash */}'),end=s.indexOf('            <div>',start);if(start<0||end<0)throw Error('editor anchors');s=s.slice(0,start)+'          <p className="text-[11px] text-text-muted">\n            El cobro lo determina payment.mode. Los datos históricos de efectivo y seña se conservan, pero no gobiernan el cobro.\n          </p>\n\n          {payment?.mode === "deposit" && (\n'+s.slice(end);fs.writeFileSync(files.editor,s);
s=fs.readFileSync(files.wizard,'utf8');const st=s.indexOf('        const depositAmount = PAYMENT_CONFIG.depositAmount ?? 2000;'),en=s.indexOf('        const response = await fetch("/api/create-checkout-session"',st);if(st<0||en<0)throw Error('wizard anchors');s=s.slice(0,st)+'        // El backend determina modo, moneda e importe autorizado de esta cita.\n'+s.slice(en);s=s.replace('            price: amount,\r\n','').replace('            price: amount,\n','');fs.writeFileSync(files.wizard,s);
s=fs.readFileSync(files.gateway,'utf8');s+='\n/** Proveedor explícito tiene autoridad; sólo la ausencia admite compatibilidad legacy. */\nexport function resolveConfiguredPaymentProvider(payment: unknown, legacy: unknown, environment: unknown): PaymentProvider {\n  if (payment !== undefined && (!payment || typeof payment !== "object" || Array.isArray(payment))) {\n    throw new Error("Invalid payment configuration");\n  }\n  const config = payment as Record<string, unknown> | undefined;\n  const raw = config && Object.prototype.hasOwnProperty.call(config, "provider")\n    ? config.provider\n    : legacy ?? environment ?? "stripe";\n  if (raw === "manual") return "none";\n  if (typeof raw !== "string" || !VALID_PROVIDERS.includes(raw as PaymentProvider)) {\n    throw new Error("Invalid payment provider");\n  }\n  return raw as PaymentProvider;\n}\n';fs.writeFileSync(files.gateway,s);
