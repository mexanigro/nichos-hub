const fs=require('fs'),p=require('path'),assert=require('assert/strict'),crypto=require('crypto');const d=__dirname,f='C:/Users/liama/Desktop/Nichos-hub/src/components/client-language-banner.tsx',b=fs.readFileSync(f);assert.deepStrictEqual(b,fs.readFileSync(p.join(d,'preimagenes/client-language-banner.tsx')));const hash=b=>crypto.createHash('sha256').update(b).digest('hex');fs.writeFileSync(p.join(d,'IDIOMA-FREEZE.json'),JSON.stringify({contract:'ES-A conserva es interno; interfazweb fallbacken explícito sin cambiar enum/carga/guardado',red:'resultados/idioma-red/IDIOMA.json',instrument:hash(fs.readFileSync(p.join(d,'idioma.cjs'))),before:hash(b)},null,2),{flag:'wx'});const marker='              traduce textos ya cargados.';let s=b.toString('utf8');assert.equal(s.split(marker).length,2);s=s.replace(marker,marker+`\n              {current === "es" && (\n                <span className="block">\n                  La interfaz de la web usa inglés como alternativa al español.\n                  El español se conserva en el hub y en los contenidos existentes.\n                </span>\n              )}`);s=s.replace('   *   - locale inicial del wizard de onboarding y del template,','   *   - locale inicial del wizard de onboarding y del template,');fs.writeFileSync(f,s);fs.writeFileSync(p.join(d,'IDIOMA-CAMBIO.json'),JSON.stringify({file:f,before:hash(b),after:hash(Buffer.from(s)),guardado:'sin cambios de código, sólo span explicativo'},null,2),{flag:'wx'});
