const fs=require('fs'),p=require('path'),crypto=require('crypto');const d=__dirname,canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',archive='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03';const hash=b=>crypto.createHash('sha256').update(b).digest('hex');const write=(f,s)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,s,{flag:'wx'})};
const report=`# N03 — checkpoint y retoma honesta\n\nRESULT: RED global. N03 no cerrada.\nTASK: completar las condiciones originales de N03 usando el balance vigente.\nGATES: P0 alcanzado; P1/P2 parciales; P3 cierre pendiente (1/4 completos). La custodia de retoma no se cuenta como cierre técnico.\nTESTS: evidencias locales abajo; control inline final RED1.\nBLOCKERS: montaje de control compatible crm-metrics; contrato funcional navegador/backend con destinos separados; L04 seña/moneda Cardcom/credencial y controles pendientes.\nCHANGES: reparaciones locales y evidencia integradas; sin efectos externos.\nREMAINING: obligaciones de las filas abiertas del BALANCE, no nueva lista de deuda.\n\n## Autoridad y presupuesto\n\nLiam autorizó continuar N03 hasta100% TOTAL compartido sin resets, reemplazando90% y reservaN04. Última lectura91%; el freno no es agotamiento presupuestario. Las etapas N04–N10 y condición de identificar prestaciones por tenant y decisión de Liam antes del despliegue siguen vigentes. Sin instalaciones, credenciales reales, red externa, push ni deploy.\n\nLiam aprobó moneda variable por tenant: «esta mal que este fijo en usd, estoy de acuerdo que tiene que variar dependiendo el tenat». No se interpreta como aprobación de la regla de seña consultada. Eligió «Conservar destinos separados y definir su contrato» ante la conexión navegador–Admin/REST; no se extenderá rechazo ni se unificarán selectores de esa conexión. La consulta comercial de digest no tiene respuesta registrada; no se inventa.\n\n## Condiciones satisfechas localmente\n\n- L12: allow-list vacía/desconocida ya no recupera servicios del preset; precio/duración/imagen del override se conservan al cambiar idioma y se admite imagen cuando preset carece de ella. Bootstrap real, presets de seis nichos, BookingWizard/StaffProfilePage reales SSR:126casos4771controles GREEN; mutante que desarmafiltro RED1926. Merge/SAFE:18combinaciones360controles, sin otra reparación. No equivale a edición remota repetida ni permisos.\n- L02 remanente:18rutas28setmerge examinados; no otro literal propio defectuoso. brand.logo pertenece a update, semántica de fieldpath del SDK vigente. Alcance y hashes en paridad/L02-REMANENTE.md; no se repitió client-info aceptado.\n- ES-A: banner sóloes explica fallback inglés; cinco renders y control desarmado, payload/callbacks conservados. No se exige ni se implementa traducción española completa.\n- L08: sharedcheckout entre server/API toma precio de cita, conserva guardias/límites y redacción de error. RED66→GREEN320; mutanteprecio request RED16. La extensión moneda Stripe conserva esos controles:31casos482checks GREEN; config ausente/inválida/fallida rechaza antesgateway; tresmonedas capturadas por builder real contransporteinterceptado; mutantes RED20/2. Cardcom y seña NO resueltos.\n- Tres lectores REST residuales (state, guardtenant, credenciales) rechazan proyecto incompatible definido sin cambiar selector ni retornos incompletos:90checksGREEN, desarmadoRED27. No cambian reglas aceptadas de2Admin+3RESTgeneral.\n- Excepciones de paridad: contrato/final27HTTP101checksGREEN y6mutantes históricos atribuibles. Se repitió basal sobre producto final porque los callbacks digest/services cambiaron por guardas de destino; no se repitió sin motivo. availability sólo caracteriza eco, validate no reserva, SPA no certifica plataforma, digest no acredita entrega/schedulerreal.\n- E-NOT-01: fallbackSITE de mensaje ya no promete responder en portal inexistente.12casos90checksGREEN y mutanteRED40; caller, sender, contenido, escaping, portal explícito conservados. No se envió correo ni se creó portal.\n- H07: AGENTS hub/template y texto tour corregidos con preimágenes y reversa; recepción documental no se toma como ready global.\n\n## STOP concreto del método\n\nGate: P2, control de destinos REST inline, específicamente /api/crm-metrics compatible. Cuatro callbacks tienen guardas locales nuevas; tres alcanzan el control positivo, métricas no llega al fetch esperado en el montaje. No se acredita ese cuarto control ni se descuenta la fila por tiposGREEN.\n\nIntentos: inline-red/green identificó además del rechazo faltante un positivo de métricas sinlectura. Se añadió la constante real CRM_METRICS_DOC_CAP omitida por extracción y se contrastó conjunto de URLs porque inicia consultas paralelas. Se repitió mismo contrato contra preimagen y final: inline-red-r3 RED7, inline-green-r3 RED1, mutanteRED7. El positivo siguió fallando; se detuvo sin otro ciclo.\n\nHipótesis descartada: que suministrar sólo esa constante resolviera el montaje. Información nueva conservada: respuesta500 del callback, cerooperacionescapturadas en compatible; el arnés silencia console.error, por lo que no hay causa interna probada. No atribuir el fallo a Firestore real ni al producto sin evidencia. Siguiente paso necesario: exponer de forma acotada el error interno del callback en el instrumento antes de cualquier nuevo intento de reparación; usar mismo contrato, sin debilitar expectativas.\n\nPreparación credencial también queda incompleta: editor apiKey frente a gateway apiName; escritor nested credentials frente a loaders planos. Su sondeo tuvo SyntaxError antes de ejecutar: NO es RED semántico y no autoriza producto. Propuesta/errores conservados en credencial/INFORME.md.\n\n## Destinos separados: contrato pendiente, no traslado a N04\n\nSDK navegador real inicializa aplicación/base VITE y lecturaping interceptada en8casos; ausencia/incompleto deshabilita, default/(default) distintos, variables server no sustituyen aVITE. src/services/db.ts subscribeToAppointments consulta appointments con clientId en esa base; book/checkout operan medianteAdmin. Conservar destinos separados no demuestra por sísolo la conexión de la misma cita entre ambos. Falta fijar qué colecciones/recorridos corresponden a cada destino y cómo se mantiene esa conexión. No se modifica ni se oculta esa obligación local; N04 conserva validación real de roles/identidades, no recibe este pendiente como resuelto.\n\n## H07 y avisos: disposición de evidencia recibida\n\nAPI-COSTS-AUDIT y AUDIT de template/hub son históricos y no certifican costos, seguridad ni ready actuales; los contratos locales específicos gobiernan estas afirmaciones. AGENTS hub mantiene herramientas internas de Liam y pricing histórico sujeto a N01, con authprose corregida. Contrato_Arzac_Studio_ES.pdf y arzac-sales-assistant.skill se preservan empaquetados sin asumir contrato firmado, equivalencia ni ejecutarlos. arzac-sales-assistant-SKILL.md no autoriza promesas IA/voice/Calendar/facturas de nueva base. AUDIT-MONITOR-AGENT histórico17f30ac no acredita monitoractual; paridad estudia sus contratos concretos. N09/N10 siguen con sus obligaciones originales.\n\nD05 y L03 aceptados no se reabren. Reconciliación N01 ya ubica reminder/staff en N06/N07/N04 y compromisos Gmail/Resend/avisosSaaS en N01/N07; no se añade proveedor ni se confunde queued conentrega. Digestexistente conserva email yguardia; inclusión comercial consultada no decide transporte ni autoriza envío. Esta disposición no borra pendientes locales de cobro/destinos.\n\n## Conservación y límites\n\nCONSERVACION-CHECKPOINT.json:623archivos de línea basal,616idénticos y7modificados previstos; nuevo checkout-handler separado. AGENTS documentales tambiénconservados porpreimagen. ACEPTADOS-CONSERVADOS.json:7funciones/bloques aceptados idénticos; archivos W-NEXT/L02/L03/L01hub intactos. Tipos templatefinal0; hubbanner/plantilla tiposlint0. No se declara bundling/hostingreal. Guardas inline permanecen enproducto sinacreditacióncompleta, explícitamente bloqueadas para cierre/despliegue.\n\nIncidente de custodia: montaje destinos-red escribió en salida delsondeo; se conserva RED y reproducción separada anterior a producto, sin afirmar conservación de bytes iniciales sustituidos. INCIDENCIA detallada en INCIDENTE-MONTAJE-DESTINOS.md. Resto de preimágenes, fallos, contratos yresultados preservados.\n`;
write(p.join(d,'RETOMA-RESULTADO.md'),report);
const rels=['informe/N03/reconciliacion-v1/BALANCE.md','informe/N03/reconciliacion-v1/SIGUIENTE-ACCION.md','informe/N03/cierre-sesion-v1/RETOMA.md','indice/tareas/N03.md','indice/README.md','indice/CALENDARIO.md'];const records=[];
for(const rel of rels){const file=p.join(canon,rel),before=fs.readFileSync(file),bak=p.join(d,'preimagenes/checkpoint-final/canon',rel);write(bak,before);let s=before.toString('utf8');if(rel.endsWith('BALANCE.md')){s=s.replace('Abierta: browser y otros inlineREST no acreditados por ese subconjunto. No confundir aplicación/base declarada con operación efectiva.','Abierta: Liam decidió conservar destinos navegador/backend separados y definir contrato. Browser real8casos caracteriza destino, no la conexión de citas/config compartidas. Cuatro inlineREST guardados: RED global1 por montaje positivo crm-metrics; STOP método, no descontado. Ver RETOMA-RESULTADO.');s=s.replace('Abierta: terminar disposición local de E-NOT-01/03/04; inclusión comercial digest consultada, no aprobada por silencio. Plantilla de mensaje promete portal, caller actual debe reconciliarse.','E-NOT-01 fallbackSITE corregido12casos90checks, mutanteRED40. Disposición restante conserva responsables originales de N01/N06/N07; no declara entrega ni decide inclusión comercial digest sin respuesta. Ver RETOMA-RESULTADO.');s=s.replace('Cardcom moneda no demostrada y apiKey/apiName inconsistente; controles sin función/provider requieren resolución.','Cardcom moneda no demostrada; editor apiKey/apiName y escritor credentials anidado frente a lectores planos: preparación incompleta por SyntaxError, sin producto. Controles sin función/provider requieren resolución.');s=s.replace('91registros ajenos acheckout idénticos antes/después.','91registros ajenos acheckout idénticos antes deguardasinline; basal27HTTP101checks repetido yGREEN enproducto final por cambios digest/services.');s=s.replace('Consumo observado90% TOTAL','Consumo observado91% TOTAL');}
const target=p.join(d,'RETOMA-RESULTADO.md'),link=p.relative(p.dirname(file),target).replaceAll('\\','/');const note='**Estado vigente: N03 RED global, STOP de ejecución en P2 por control compatible crm-metrics aún no acreditado tras ajuste del montaje.** P0 completo; P1/P2 parciales; P3 cierre pendiente. Techo100% TOTAL sin resets, observado91%; no es agotamiento presupuestario. Liam aprobó moneda por tenant y conservar destinos navegador/backend separados para definir su contrato; no se infiere decisión de seña ni inclusión comercial digest. Avances y bloqueos concretos en [retoma integrada]('+link+'). El BALANCE sigue siendo lista única; no reabrir aceptaciones. Etapas posteriores y condición por tenant antes de desplegar intactas. Sin efectos externos, instalaciones, push ni deploy. Los estados inferiores son historia y no autorizan repetir entregas.\n\n';const at=s.indexOf('\n')+1;s=s.slice(0,at)+'\n'+note+s.slice(at);fs.writeFileSync(file,s);const dst=p.join(archive,rel),ab=fs.readFileSync(dst);write(p.join(d,'preimagenes/checkpoint-final/archivo',rel),ab);fs.writeFileSync(dst,s);records.push({rel,canonical:file,mirror:dst,preimage:bak,before:hash(before),after:hash(Buffer.from(s))});}
write(p.join(d,'REGISTROS-FINALES.json'),JSON.stringify(records,null,2));console.log({records:records.length,global:'RED',usage:91});
