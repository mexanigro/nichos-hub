const fs=require('fs'),path=require('path'),{createRequire}=require('module'),assert=require('assert/strict');const req=createRequire('/deps/package.json'),ts=req('typescript');const failures=[],rows=[];let checks=0;
const compile=s=>ts.transpileModule(s,{compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.CommonJS,esModuleInterop:true}}).outputText;function check(id,a,b){checks++;if(!require('util').isDeepStrictEqual(a,b))failures.push({id,actual:a,expected:b})}
const base={currency:'ILS',payment:{currency:'ILS',mode:'deposit',depositAmount:2500},appointment:{clientId:'tenant',priceCents:15000},body:{appointmentId:'appt',name:'Service',customerEmail:'test@example.invalid',price:999,mode:'full'},status:200,amount:2500};const cases=[];function add(id,patch){cases.push({...structuredClone(base),id,...patch})}
add('deposit-server-authority',{});add('full-server-authority',{payment:{currency:'ILS',mode:'full'},body:{...base.body,mode:'deposit'},amount:15000});for(const value of [undefined,null,0,-1,49,2.5,15001,'2500'])add('deposit-invalid-'+String(value),{payment:{currency:'ILS',mode:'deposit',depositAmount:value},status:503});for(const value of [50,15000])add('deposit-boundary-'+value,{payment:{currency:'ILS',mode:'deposit',depositAmount:value},amount:value});for(const mode of [undefined,null,'','none','cash-only','invalid'])add('mode-invalid-'+String(mode),{payment:{currency:'ILS',mode,depositAmount:2500},status:503});add('config-ausente',{configMissing:true,status:503});add('config-falla',{configError:true,status:500});add('cardcom-bloqueado',{provider:'cardcom',status:503});add('full-eur',{payment:{currency:'EUR',mode:'full'},currency:'EUR',amount:15000});add('request-mode-invalid',{body:{...base.body,mode:'invalid',price:undefined}});
function getRegistration(file){const text=fs.readFileSync(file,'utf8'),ast=ts.createSourceFile(file,text,ts.ScriptTarget.Latest,true);const matches=[];function visit(n){if(ts.isCallExpression(n)&&n.expression.getText(ast)==='app.post'&&n.arguments[0]?.text==='/api/create-checkout-session')matches.push(n.getText(ast));ts.forEachChild(n,visit)}visit(ast);assert.equal(matches.length,1);const validators=['sanitizeText','isValidEmail'].map(name=>ast.statements.find(n=>ts.isFunctionDeclaration(n)&&n.name?.text===name).getText(ast)).join('\n');return{registration:matches[0],validators}}
let createCheckoutHandler;const shared='/template/src/lib/api/checkout-handler.ts';if(fs.existsSync(shared)){const module={exports:{}};let s=fs.readFileSync(shared,'utf8');new Function('require','module','exports',compile(s))(req,module,module.exports);createCheckoutHandler=module.exports.createCheckoutHandler}
(async()=>{for(const runtime of ['server.ts','api/index.ts']){const extracted=getRegistration('/template/'+runtime);for(const c of cases){const calls=[],reads=[];const getDb=async()=>c.db===false?null:{collection:col=>({doc:id=>({get:async()=>{reads.push(col+'/'+id);if(col==='config'&&c.configError)throw Error('SENSITIVE config failure');return{exists:col==='config'?!c.configMissing:!!c.appointment,data:()=>col==='config'?{payment:c.payment}:structuredClone(c.appointment)}}})})};const state=async()=>({provider:c.provider||'stripe'}),gateway=async()=>{if(c.resolveError)throw Error('SENSITIVE: secret');return{createCheckoutSession:async params=>{calls.push(params);if(c.gatewayError)throw Error('SENSITIVE: secret');return{sessionId:'session',redirectUrl:'https://synthetic.invalid/checkout'}}}};let handler;const app={post:(_path,h)=>handler=h};new Function('app','getAdminDb','loadAdminFirestore','getClientRuntimeState','resolvePaymentGateway','CLIENT_ID','port','process','console','createCheckoutHandler',compile(extracted.validators+'\n'+extracted.registration))(app,getDb,async()=>({db:await getDb()}),state,gateway,'tenant',3000,{env:{APP_URL:'https://synthetic.invalid'}},{log(){},warn(){},error(){}},createCheckoutHandler);
let status=200,response;const res={status:s=>{status=s;return res},json:r=>response=r};await handler({body:c.body},res);const label=runtime+'/'+c.id;check(label+'/status',status,c.status);check(label+'/gateway-calls',calls.length,c.status===200||c.gatewayError?1:0);if(c.status===200){check(label+'/currency',calls[0]?.currency,c.currency.toLowerCase());check(label+'/currency-read',reads.includes('config/tenant'),true);check(label+'/amount',calls[0]?.amountCents,c.amount);check(label+'/mode',calls[0]?.mode,c.payment.mode);check(label+'/result',response,{id:'session',url:'https://synthetic.invalid/checkout'});check(label+'/tenant',calls[0]?.clientId,'tenant')}check(label+'/reads',reads.filter(x=>!x.startsWith('config/')),['sin-id','email-invalido','sin-db'].includes(c.id)?[]:['appointments/appt']);if(c.status===200){check(label+'/appointment',calls[0]?.appointmentId,'appt');check(label+'/email',calls[0]?.customerEmail,'test@example.invalid');check(label+'/name',calls[0]?.serviceName,'Service');check(label+'/successUrl',calls[0]?.successUrl,'https://synthetic.invalid/?booking_status=success&session_id={CHECKOUT_SESSION_ID}');check(label+'/cancelUrl',calls[0]?.cancelUrl,'https://synthetic.invalid/?booking_status=cancelled');}if(c.id.startsWith('moneda-invalida')||c.id.startsWith('config-'))check(label+'/config-exacta',reads.filter(x=>x.startsWith('config/')),['config/tenant']);check(label+'/redacted',JSON.stringify(response).includes('SENSITIVE'),false);rows.push({label,status,response,calls,reads})}}
fs.writeFileSync('/salida/COBRO-HANDLER.json',JSON.stringify({result:failures.length?'RED':'GREEN',cases:cases.length,checks,failures,rows},null,2));console.log(JSON.stringify({cases:cases.length,checks,failures:failures.length}));process.exitCode=failures.length?1:0})().catch(e=>{console.error(e.stack);process.exitCode=2});
