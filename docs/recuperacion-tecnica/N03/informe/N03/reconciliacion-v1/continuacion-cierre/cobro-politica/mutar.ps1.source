param([string]$Base,[string]$Comando,[string]$Nombre,[string]$Mutante,[string]$Target)
$ErrorActionPreference='Stop'
$out=Join-Path $Base ('resultados\'+$Nombre)
if(Test-Path $out){throw 'No sobrescribir'}
New-Item -ItemType Directory -Path $out|Out-Null
$argsList=Get-Content -Raw $Comando|ConvertFrom-Json
$argsList=@($argsList|ForEach-Object{if($_ -like '*target=/salida'){"type=bind,source=$out,target=/salida"}else{$_}})
$imageIndex=[array]::IndexOf($argsList,'sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2')
$argsList=@($argsList[0..($imageIndex-1)])+@('--mount',"type=bind,source=$Base\mutantes\$Mutante,target=$Target,readonly")+@($argsList[$imageIndex..($argsList.Length-1)])
$argsList|ConvertTo-Json|Set-Content (Join-Path $out 'COMANDO.json') -Encoding utf8
& docker @argsList *> (Join-Path $out 'ejecucion.log')
$code=$LASTEXITCODE
$code|Set-Content (Join-Path $out 'exit.txt')
Get-Content (Join-Path $out 'ejecucion.log')
exit $code
