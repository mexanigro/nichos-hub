`+s.slice(b);s=s.replace('{payment:{currency:c.currency}}','{payment:c.payment}').replace("c.body.mode==='deposit'?'deposit':'full'","c.payment.mode").replaceAll('MONEDA-HANDLER.json','COBRO-HANDLER.json');s=s.replace("let s=fs.readFileSync(shared,'utf8');if(process.argv[2]==='mutant'){assert.ok(s.includes('amountCents: authorizedPrice'));s=s.replace('amountCents: authorizedPrice','amountCents: Number(req.body?.price)')}","let s=fs.readFileSync(shared,'utf8');");fs.writeFileSync(p.join(d,'contrato.cjs'),s,{flag:'wx'});fs.mkdirSync(p.join(d,'preimagenes'));fs.copyFileSync('C:/Users/liama/Desktop/Nichos/Barber-shop-template-main/src/lib/api/checkout-handler.ts',p.join(d,'preimagenes/checkout-handler.ts'),fs.constants.COPYFILE_EXCL);
