const fs=require('fs'),p=require('path'),d=__dirname;let s=fs.readFileSync(p.join(d,'../moneda-handler.cjs'),'utf8');const a=s.indexOf('const base='),b=s.indexOf('function getRegistration',a);s=s.slice(0,a)+`const base={currency:'ILS',payment:{currency:'ILS',mode:'deposit',depositAmount:2500},appointment:{clientId:'tenant',priceCents:15000},body:{appointmentId:'appt',name:'Service',customerEmail:'test@example.invalid',price:999,mode:'full'},status:200,amount:2500};const cases=[];function add(id,patch){cases.push({...structuredClone(base),id,...patch})}
