const fs=require('fs'),{createRequire}=require('module'),assert=require('assert/strict');const req=createRequire('/deps/package.json'),ts=req('typescript'),rows=[],failures=[];const path='/template/src/lib/api/payment-gateways.ts';let source=fs.readFileSync(path,'utf8');if(process.argv[2]==='mutant')source=source.replace('currency: p.currency','currency: "usd"');const moduleLocal={exports:{}};let captured;class Stripe{constructor(){this.checkout={sessions:{create:async(body,opts)=>{captured={body,opts};return{id:'local',url:'https://synthetic.invalid'}}}}}}new Function('require','module','exports','process',ts.transpileModule(source,{compilerOptions:{module:1,target:9,esModuleInterop:true}}).outputText)(id=>id==='stripe'?Stripe:req(id),moduleLocal,moduleLocal.exports,{env:{}});
(async()=>{for(const currency of ['ils','usd','eur']){await moduleLocal.exports.buildStripeGateway({secretKey:'synthetic'}).createCheckoutSession({appointmentId:'appt',customerEmail:'local@example.invalid',serviceName:'svc',amountCents:15000,currency,mode:'full',successUrl:'https://synthetic.invalid/ok',cancelUrl:'https://synthetic.invalid/cancel',clientId:'tenant'});const actual=captured.body.line_items[0].price_data;try{assert.deepEqual(actual,{currency,product_data:{name:'svc'},unit_amount:15000});assert.equal(captured.opts.idempotencyKey,'checkout_tenant_appt')}catch(e){failures.push({currency,actual,message:e.message})}rows.push({currency,captured})}fs.writeFileSync('/salida/MONEDA-GATEWAY.json',JSON.stringify({result:failures.length?'RED':'GREEN',rows,failures,limite:'Builder real, transporte Stripe interceptado, sin red ni proveedor real'},null,2));console.log({failures:failures.length});process.exitCode=failures.length?1:0})().catch(e=>{console.error(e);process.exitCode=2});
