const fs=require('fs'),p=require('path'),crypto=require('crypto'),assert=require('assert/strict');const d=__dirname,archive='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03/informe/N03/reconciliacion-v1/continuacion-cierre',roots={hub:'C:/Users/liama/Desktop/Nichos-hub',template:'C:/Users/liama/Desktop/Nichos/Barber-shop-template-main'},hash=b=>crypto.createHash('sha256').update(b).digest('hex'),write=(f,b)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,b,{flag:'wx'})},walk=root=>fs.readdirSync(root,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(p.join(root,e.name)):[p.join(root,e.name)]);const conservation=JSON.parse(fs.readFileSync(p.join(d,'CONSERVACION-CHECKPOINT.json'),'utf8'));for(const row of [...conservation.changed,...conservation.extra]){const src=p.join(roots[row.repo],row.ruta),dest=p.join(d,'fuentes-finales',row.repo,row.ruta),b=fs.readFileSync(src);assert.equal(hash(b),row.actual,src);if(!fs.existsSync(dest))write(dest,b)}for(const row of JSON.parse(fs.readFileSync(p.join(d,'REGISTROS-FINALES.json'),'utf8'))){assert.equal(hash(fs.readFileSync(row.canonical)),row.after);assert.equal(hash(fs.readFileSync(row.mirror)),row.after);assert.equal(hash(fs.readFileSync(row.preimage)),row.before)}
const evidence=walk(d).map(f=>({ruta:p.relative(d,f).replaceAll('\\','/'),bytes:fs.statSync(f).size,sha256:hash(fs.readFileSync(f))}));write(p.join(d,'EVIDENCIA-FINAL.json'),JSON.stringify(evidence,null,2));const copies=[];for(const f of walk(d)){const suffix=/\.(cjs|mjs|js|ts|tsx|ps1)$/.test(f)?'.source':'';const dest=p.join(archive,p.relative(d,f))+suffix,b=fs.readFileSync(f);write(dest,b);assert.equal(hash(fs.readFileSync(dest)),hash(b));copies.push({source:f,target:dest,bytes:b.length,sha256:hash(b)})}write(p.join(d,'ARCHIVO-FINAL.json'),JSON.stringify(copies,null,2));write(p.join(archive,'ARCHIVO-FINAL.json'),JSON.stringify(copies,null,2));const result={custody:'PASS con incidente declarado de sondeo sustituido; no custodia absoluta afirmada',global:'RED',files:copies.length,bytes:copies.reduce((n,x)=>n+x.bytes,0),records:6,productBaseline:623,unchanged:616,expectedChanged:7,addedSharedHandler:1,acceptedFunctionsIdentical:7,usageObserved:91,ceiling:100,resets:0,externalEffects:false};write(p.join(d,'VERIFICACION-RETOMA.json'),JSON.stringify(result,null,2));write(p.join(archive,'VERIFICACION-RETOMA.json'),JSON.stringify(result,null,2));console.log(result);
