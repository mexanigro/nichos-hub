const fs=require('fs'),p=require('path'),{spawnSync}=require('child_process');
const d=__dirname,t='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',h='C:/Users/liama/Desktop/Nichos-hub';
(async()=>{const results=[];for(const [name,root,files] of [['template',t,['server.ts','api/index.ts','src/config/site.ts','src/config/tour.config.ts','src/vite-env.d.ts']],['hub',h,['src/components/client-language-banner.tsx','next-env.d.ts']]]){const c=p.join(d,'tsconfig-'+name+'.json');fs.writeFileSync(c,JSON.stringify({extends:root+'/tsconfig.json',compilerOptions:{incremental:false},include:files.map(f=>root+'/'+f),exclude:[root+'/node_modules']},null,2),{flag:'wx'});const r=spawnSync(process.execPath,[root+'/node_modules/typescript/bin/tsc','--project',c,'--noEmit','--incremental','false'],{cwd:root,encoding:'utf8',timeout:120000});fs.writeFileSync(p.join(d,'TIPOS-'+name+'.log'),(r.stdout||'')+(r.stderr||''),{flag:'wx'});results.push({name,exit:r.status,error:r.error?.message});} const {ESLint}=require(h+'/node_modules/eslint');const {pathToFileURL}=require('url');const v=(await import(pathToFileURL(h+'/node_modules/eslint-config-next/dist/core-web-vitals.js'))).default,tsConfig=(await import(pathToFileURL(h+'/node_modules/eslint-config-next/dist/typescript.js'))).default;const eslint=new ESLint({cwd:h,overrideConfigFile:true,overrideConfig:[...v,...tsConfig]});const lint=await eslint.lintFiles(['src/components/client-language-banner.tsx']);fs.writeFileSync(p.join(d,'LINT-hub.json'),JSON.stringify(lint,null,2),{flag:'wx'});results.push({name:'lint-hub',errors:lint.reduce((n,r)=>n+r.errorCount,0),warnings:lint.reduce((n,r)=>n+r.warningCount,0)});fs.writeFileSync(p.join(d,'TIPOS-LINT.json'),JSON.stringify(results,null,2),{flag:'wx'});console.log(results);})().catch(e=>{console.error(e);process.exitCode=2;});
