const f=p.join(base,'BALANCE.md');const old=fs.readFileSync(f,'utf8');const backup=p.join(d,'preimagenes/checkpoint-1');fs.mkdirSync(backup,{recursive:true});fs.copyFileSync(f,p.join(backup,'BALANCE.md'),fs.constants.COPYFILE_EXCL);let s=old.replace('# N03 — balance vigente tras aceptación local proyecto/base','# N03 — balance único de cierre, continuación integrada');const start=s.indexOf('| Pendiente adjudicado |'),end=s.indexOf('\nFuentes conservadas:',start);if(start<0||end<0)throw Error('tabla no encontrada');const table='| Pendiente adjudicado | Obligación concreta | Evidencia aprovechada / resultado | Falta local / límite | Etapas ya asignadas |\n| --- | --- | --- | --- | --- |\n'+rows.map(r=>'| '+r.join(' | ')+' |').join('\n')+'\n';s=s.slice(0,start)+table+s.slice(end);s=s.replace('Primer hueco justificado en comprobación: L12 visibleServices, contrato allow-list ya escrito en docs/config-remote.md. No se considera reparada toda L12 por ese resultado.','Checkpoint: P0 cubre las siete obligaciones de esta tabla; P1/P2 progresan con contratos y resultados en [continuacion-cierre](continuacion-cierre/PLAN.md). N03 continúa RED global por los resultados faltantes explícitos. No son entregas nuevas ni otra lista de deuda. Consumo observado90% TOTAL; techo100%, sin resets.');fs.writeFileSync(f,s);fs.writeFileSync(p.join(d,'CHECKPOINT-1.json'),JSON.stringify({before:crypto.createHash('sha256').update(old).digest('hex'),after:crypto.createHash('sha256').update(s).digest('hex'),usage:90,global:'RED',rows:7},null,2),{flag:'wx'});
