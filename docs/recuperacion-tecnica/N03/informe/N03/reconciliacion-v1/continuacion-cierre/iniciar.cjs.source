const fs=require('fs'),p=require('path'),crypto=require('crypto');const d=__dirname,canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',archive='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03';const hash=b=>crypto.createHash('sha256').update(b).digest('hex'),rows=[];
for(const root of [canon,archive])for(const rel of ['informe/N03/reconciliacion-v1/BALANCE.md','informe/N03/reconciliacion-v1/SIGUIENTE-ACCION.md','informe/N03/cierre-sesion-v1/RETOMA.md','indice/tareas/N03.md','indice/README.md','indice/CALENDARIO.md']){const f=p.join(root,rel),b=fs.readFileSync(f),backup=p.join(d,'preimagenes',root===canon?'canon':'archivo',rel);fs.mkdirSync(p.dirname(backup),{recursive:true});fs.writeFileSync(backup,b,{flag:'wx'});const note='**Autorización vigente: continuar hasta el cierre completo de N03, techo100% TOTAL compartido sin resets.** Reemplaza techo90% y reservaN04; no cambia alcance técnico ni etapas posteriores. Balance existente es lista única: acreditar evidencia vigente, comprobar huecos y reparar sólo defectos necesarios, con gates y consulta de política nueva. No abrir auditoría general ni repetir entregas aceptadas. Margen operativo previsto: dejar al menos los últimos2 puntos para verificación/custodia/retoma; no garantiza poder cerrar. Inicio observado88%. Sin efectos externos/push/deploy; condición por tenant antes de despliegue intacta. Los cortes inferiores son históricos.';let s=b.toString('utf8');const at=s.indexOf('\n')+1;s=s.slice(0,at)+'\n'+note+'\n\n'+s.slice(at);if(rel.endsWith('/BALANCE.md')){s=s.replace('## Única siguiente acción','## Ejecución vigente y gates');const a=s.indexOf('Proponer preparar, sin ejecutar todavía'),z=s.indexOf('## Fronteras conservadas');s=s.slice(0,a)+'P0: ligar las siete filas de esta tabla a obligaciones, evidencia aprovechable y resultado faltante, sin otra lista de deuda. P1: acreditar casos cubiertos y congelar controles para huecos efectivos. P2: reparar únicamente defectos demostrados con RED/GREEN, conservación y mutación; decisiones nuevas se consultan. P3: verificar cobertura completa y acta, o retoma honesta si persisten bloqueos/presupuesto.\n\nPrimer hueco justificado en comprobación: L12 visibleServices, contrato allow-list ya escrito en docs/config-remote.md. No se considera reparada toda L12 por ese resultado.\n\n'+s.slice(z);s=s.replace('Techo90% TOTAL compartido N03; observado88%, último10% reservado N04;','Techo100% TOTAL compartido N03; inicio88%, sin reserva presupuestaria obligatoria N04;')}
fs.writeFileSync(f,s);rows.push({path:f,backup,before:hash(b),after:hash(Buffer.from(s))})}fs.writeFileSync(p.join(d,'REGISTROS-P0.json'),JSON.stringify(rows,null,2),{flag:'wx'});
fs.writeFileSync(p.join(d,'PLAN.md'),'# Continuación integrada N03\n\nAutorización expresa de cierre completo, 100%TOTAL compartido sin resets. El BALANCE.md padre es lista única; este directorio conserva instrumentos/evidencias y checkpoints, no entregas independientes. P0 recepción y cobertura; P1 contratos/RED; P2 reparación mínima/controles; P3 cierre o retoma honesta. No descuento global por suites aisladas.\n\nSe conservan aceptaciones; la vigencia se verifica por hash donde se reutilicen resultados, no reejecutando suites. Fuentes nuevas sólo para resolver filas existentes. Política nueva no se inventa; consulta mientras avanzan obligaciones independientes. Sin instalaciones/credenciales reales/red externa/push/deploy. N04–N10 y condición por tenant conservadas; presupuesto no reasigna obligaciones técnicas.\n',{flag:'wx'});console.log('Gates y nuevo techo integrados, producto intacto');
