const fs=require('fs'),p=require('path'),assert=require('assert/strict');const d=__dirname,f='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main/src/config/site.ts',s=fs.readFileSync(f,'utf8');fs.writeFileSync(p.join(d,'preimagenes/site-antes-imagen.ts'),s,{flag:'wx'});assert.equal(s.split('if (patch.image && images && i < images.length)').length,2);fs.writeFileSync(f,s.replace('if (patch.image && images && i < images.length)','if (patch.image && images)'));
