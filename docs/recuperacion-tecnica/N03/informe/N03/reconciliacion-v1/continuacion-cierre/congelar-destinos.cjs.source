const fs=require('fs'),p=require('path'),crypto=require('crypto');const d=__dirname;const f=p.join(d,'destinos-residuales.cjs');fs.copyFileSync(f,p.join(d,'preimagenes/destinos-residuales-sondeo.cjs'));let s=fs.readFileSync(f,'utf8');s=s.replace("const rows=[];", "const rows=[],failures=[];");s=s.replace("const result=await f();rows.push({id,kind,result,calls});", "let result,error;try{result=await f()}catch(e){error=e.message}const expectedCalls=id==='contradiccion'||id==='solo-server'||id==='sin-token'?0:kind==='runtime'?2:1;if(calls.length!==expectedCalls)failures.push({id,kind,calls,expectedCalls});if(id==='contradiccion'&&error!=='Firestore destination mismatch')failures.push({id,kind,error,expectedError:'Firestore destination mismatch'});rows.push({id,kind,result,error,calls});");s=s.replace("assert.equal(rows.find(x=>x.id==='contradiccion'&&x.kind==='guard').calls[0].includes('/projects/p-b/'),true);", "");s=s.replace("{source:crypto", "{result:failures.length?'RED':'GREEN',failures,source:crypto");s=s.replace("console.log({rows:rows.length,mismatch:'p-a configurado general/Admin, tres consumidores operan p-b'});", "console.log({rows:rows.length,failures:failures.length});process.exitCode=failures.length?1:0;");if(s.includes("if(process.argv[2]"))throw Error('unexpected');s=s.replace("const texts={", "const texts={");s=s.replace("const source=kind===", "let source=kind===");s=s.replace("const js=ts.transpileModule(source", "if(process.argv[2]==='mutant')source=source.replace(/if \\(configuredProjectId && configuredProjectId !== projectId\\)/g,'if (false)');const js=ts.transpileModule(source");fs.writeFileSync(p.join(d,'destinos-residuales-contrato.cjs'),s,{flag:'wx'});fs.writeFileSync(p.join(d,'CONTRATO-DESTINOS-RESIDUALES.md'),'# Tres selectores residuales REST\nRegla vigente de coincidencia cuando ambos destinos definidos. Runtime state, guard tenant y payment credentials mantienen selección VITE→NEXT, bases FIREBASE→VITE→literal default, retornos incompletos/sin token. Si proyecto Admin/configurado (FIREBASE_ADMIN_PROJECT_ID→FIREBASE_PROJECT_ID) definido y difiere del seleccionado, rechazar antes del fetch. No elegir otro proyecto ni imponer configuración dual. Comparar llamadas y retornos reales de callbacks extraídos, no variables solas. Son tres consumidores concretos; otros inlineREST/browser permanecen en misma fila del balance.\n',{flag:'wx'});fs.writeFileSync(p.join(d,'DESTINOS-FREEZE.json'),JSON.stringify(['CONTRATO-DESTINOS-RESIDUALES.md','destinos-residuales-contrato.cjs'].map(f=>({file:f,sha256:crypto.createHash('sha256').update(fs.readFileSync(p.join(d,f))).digest('hex')})),null,2),{flag:'wx'});
