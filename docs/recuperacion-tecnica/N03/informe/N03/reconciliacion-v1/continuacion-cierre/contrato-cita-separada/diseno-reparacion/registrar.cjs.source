const fs=require('fs'),p=require('path'),crypto=require('crypto'),assert=require('assert/strict');
const d=__dirname,canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',mirror='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03';
const h=b=>crypto.createHash('sha256').update(b).digest('hex');
const create=(f,b)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,b,{flag:'wx'});};
const proposal=p.relative(canon,p.join(d,'PROPUESTA.md'));
const note='**Estado vigente — diseño de conexión de agenda preparado, no implementado.** Liam fija backend /api/book como fuente de lectura de esas citas, conservando destinos separados e histórico navegador en su origen. La aceptación del control local de selección/rechazo de destinos sigue integrada, sin repetir pruebas. Propuesta: dos fuentes y referencias de origen para lectura/acciones; falta decidir autoridad de acceso entre proyectos. Recomendación: token del proyecto Auth navegador verificado y membresía tenant-scoped en admin_users backend, sin altas automáticas. No congelar implementación antes de esa decisión. Siete fuentes del diagnóstico mantienen huella. N03 abierta; cobro, aceptaciones, etapas y condición por tenant intactos. Techo100% TOTAL, observado92%, sin resets/efectos externos/push/deploy. Estados inferiores históricos.';
const rels=['informe/N03/reconciliacion-v1/BALANCE.md','informe/N03/reconciliacion-v1/SIGUIENTE-ACCION.md','informe/N03/cierre-sesion-v1/RETOMA.md','indice/tareas/N03.md','indice/README.md','indice/CALENDARIO.md'];
const records=[];
for(const [i,root]of [canon,mirror].entries())for(const rel of rels){const target=p.join(root,rel),before=fs.readFileSync(target),backup=p.join(d,'preimagenes',i?'espejo':'canonico',rel);create(backup,before);let text=before.toString('utf8'); const link=p.relative(p.dirname(target),p.join(root,proposal)).replaceAll('\\','/'); const first=text.indexOf('\n');text=text.slice(0,first+1)+'\n'+note+' [Diseño, controles y decisión](<'+link+'>).\n\n'+text.slice(first+1);if(rel.endsWith('BALANCE.md'))text=text.replace('Pendiente decidir autoridad de lectura; propuesta listado autenticado desde backend sin copiar/unificar.','Autoridad de lectura fijada por Liam para las citas de /api/book; histórico navegador conserva origen. Diseño de dos fuentes y acciones por origen preparado. Falta decisión de autoridad de acceso: se recomienda sesión verificada del proyecto navegador más admin_users backend del tenant; implementación y contrato local pendientes.'); fs.writeFileSync(target,text);records.push({target,backup,before:h(before),after:h(fs.readFileSync(target))});}
create(p.join(d,'REGISTROS.json'),JSON.stringify(records,null,2));
const history='# N03 — preparación de reparación de conexión de agenda\n\n'+note+'\n\nSe prometió diseño de autenticación, históricos y acciones. Se preparó propuesta concreta y matriz de controles; no se ejecutó producto ni se repitió caracterización. Decisión de lectura resuelta; decisión de autoridad de membresía pendiente. No se descuenta conexión. Próximo paso: respuesta de Liam a política de acceso; después fijar contrato local y refutar antes de implementar.\n';
for(const root of [canon,mirror])create(p.join(root,'historial/N03-diseno-conexion-agenda-v1.md'),history);
for(const r of records){assert.equal(h(fs.readFileSync(r.backup)),r.before);assert.equal(h(fs.readFileSync(r.target)),r.after);}
console.log(JSON.stringify({records:records.length,preimages:records.length,productWrites:0}));
