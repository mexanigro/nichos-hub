const fs=require('fs'),p=require('path'),assert=require('assert/strict'),crypto=require('crypto');const d=__dirname,root='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',archive='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03/informe/N03/reconciliacion-v1/continuacion-cierre/contrato-cita-separada',hash=b=>crypto.createHash('sha256').update(b).digest('hex'),write=(f,b)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,b,{flag:'wx'})},walk=x=>fs.readdirSync(x,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(p.join(x,e.name)):[p.join(x,e.name)]);for(const f of JSON.parse(fs.readFileSync(p.join(d,'FUENTES.json'),'utf8'))){const b=fs.readFileSync(f.path);assert.equal(hash(b),f.sha256);write(p.join(d,'fuentes',p.relative(root,f.path)),b)}for(const r of JSON.parse(fs.readFileSync(p.join(d,'REGISTROS.json'),'utf8'))){assert.equal(hash(fs.readFileSync(r.dest)),r.after);assert.equal(hash(fs.readFileSync(r.backup)),r.before)}write(p.join(d,'preparar-contrato-cita.cjs.source'),fs.readFileSync(p.join(d,'../preparar-contrato-cita.cjs')));const copies=[];for(const f of walk(d)){const b=fs.readFileSync(f),to=p.join(archive,p.relative(d,f))+(/\.(ts|tsx|cjs|js|ps1)$/.test(f)?'.source':'');write(to,b);assert.equal(hash(fs.readFileSync(to)),hash(b));copies.push({source:f,target:to,sha256:hash(b),bytes:b.length})}write(p.join(d,'ARCHIVO.json'),JSON.stringify(copies,null,2));write(p.join(archive,'ARCHIVO.json'),JSON.stringify(copies,null,2));for(const r of JSON.parse(fs.readFileSync(p.join(d,'REGISTROS.json'),'utf8')))for(const m of fs.readFileSync(r.dest,'utf8').matchAll(/\[Evidencia, límites y propuesta mínima\]\(([^)]+)\)/g))assert.ok(fs.existsSync(p.resolve(p.dirname(r.dest),m[1])));for(const folder of [d,archive])for(const target of ['INFORME.md','MATRIZ.md','REVISION.md'])assert.ok(fs.existsSync(p.join(folder,target)));const result={custody:'PASS',copies:copies.length,sourceFilesUnchanged:7,recordsVerified:12,acceptance:'control destinos integrado sin repetir',compatibility:'RED separados; propuesta pendiente de decisión',externalEffects:false};write(p.join(d,'CIERRE.json'),JSON.stringify(result,null,2));write(p.join(archive,'CIERRE.json'),JSON.stringify(result,null,2));console.log(result);
