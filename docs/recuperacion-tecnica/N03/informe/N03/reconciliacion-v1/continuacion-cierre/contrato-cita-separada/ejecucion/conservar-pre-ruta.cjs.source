const fs=require('fs'),p=require('path'),c=require('crypto'),assert=require('assert/strict');const d=__dirname,root='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',h=b=>c.createHash('sha256').update(b).digest('hex'),json=f=>JSON.parse(fs.readFileSync(f,'utf8').replace(/^\uFEFF/,''));const allowed=['server.ts','api/index.ts','src/lib/api/admin-auth.ts','src/components/admin/AdminDashboard.tsx','src/components/admin/AppointmentCalendar.tsx','src/lib/api/checkout-handler.ts','src/lib/api/payment-gateways.ts'];const baseline=json(p.join(d,'PRODUCTO-PRE.json')),changed=[],same=[];for(const entry of baseline){const actual=h(fs.readFileSync(p.join(root,entry.file)));if(actual!==entry.sha256){assert.ok(allowed.includes(entry.file),'fuera alcance '+entry.file);changed.push({...entry,actual});}else same.push(entry.file);}const oldGateway=fs.readFileSync(p.join(d,'../../../credencial/reparacion/preimagenes-integracion/template/src/lib/api/payment-gateways.ts'),'utf8'),newGateway=fs.readFileSync(p.join(root,'src/lib/api/payment-gateways.ts'),'utf8');assert.ok(newGateway.startsWith(oldGateway));const results={baseline:baseline.length,unchanged:same.length,changed,newFiles:['src/lib/api/crm-appointments-handler.ts','src/services/crm-appointments.ts'].map(file=>({file,sha256:h(fs.readFileSync(p.join(root,file)))})),gatewayBuildersAndCache:'prefijo bytes conservado',productOutsideAllowed:'sin cambios en censo template',limit:'hub editor tiene preimagen y controles propios; no es censo universal fuera del workspace'};fs.writeFileSync(p.join(d,'CONSERVACION.json'),JSON.stringify(results,null,2),{flag:'wx'});console.log({baseline:baseline.length,unchanged:same.length,changed:changed.map(x=>x.file)});
