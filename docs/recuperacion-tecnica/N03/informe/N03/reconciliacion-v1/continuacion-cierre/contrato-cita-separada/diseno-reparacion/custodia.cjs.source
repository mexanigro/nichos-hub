const fs=require('fs'),p=require('path'),c=require('crypto'),assert=require('assert/strict'); const d=__dirname,root='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',mirror='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03',archive=p.join(mirror,p.relative(canon,d)); const h=b=>c.createHash('sha256').update(b).digest('hex'),read=f=>fs.readFileSync(f),json=f=>JSON.parse(read(f).toString('utf8').replace(/^\uFEFF/,'')),create=(f,b)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,b,{flag:'wx'});};
const records=json(p.join(d,'REGISTROS.json')); const finalRecords=[];
for(const [i,r]of records.entries()){assert.equal(h(read(r.target)),r.after);const b=read(r.target),backup=p.join(d,'preimagenes-refutacion',String(i)+'.md');create(backup,b);let s=b.toString('utf8').replace('falta decidir autoridad de acceso entre proyectos.','falta aprobar confianza en el issuer Auth navegador y vínculo por email verificado con membresía backend.');fs.writeFileSync(r.target,s);finalRecords.push({target:r.target,backup,before:h(b),after:h(read(r.target))});}
create(p.join(d,'REGISTROS-FINALES.json'),JSON.stringify(finalRecords,null,2));
const extra=['src/lib/api/admin-auth.ts','src/lib/admin-auth.ts','src/lib/admin-users.ts','src/lib/appointment-notify-client.ts','src/components/admin/AppointmentCalendar.tsx','firestore.rules','server.ts'];const sources=[];for(const rel of extra){const b=read(p.join(root,rel));create(p.join(d,'fuentes',rel+'.source'),b);sources.push({path:p.join(root,rel),sha256:h(b)});}create(p.join(d,'FUENTES-DISENO.json'),JSON.stringify(sources,null,2));
for(const s of json(p.join(d,'../FUENTES.json')))assert.equal(h(read(s.path)),s.sha256);
const walk=x=>fs.readdirSync(x,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(p.join(x,e.name)):[p.join(x,e.name)]);const copies=[];for(const f of walk(d)){const b=read(f),to=p.join(archive,p.relative(d,f))+(/\.(cjs|js|ts|tsx|ps1)$/.test(f)?'.source':'');create(to,b);assert.equal(h(read(to)),h(b));copies.push({path:p.relative(d,f),sha256:h(b),bytes:b.length});}
for(const r of finalRecords){assert.equal(h(read(r.target)),r.after);assert.equal(h(read(r.backup)),r.before);const match=read(r.target).toString('utf8').match(/\[Diseño, controles y decisión\]\(<([^>]+)>\)/);assert.ok(match);assert.ok(fs.existsSync(p.resolve(p.dirname(r.target),match[1])));}
for(const s of sources)assert.equal(h(read(s.path)),s.sha256);
const result={result:'RED: pendiente decisión de confianza antes de freeze/implementación',gatesPreparation:'3/4',diagnosticSourceHashesUnchanged:7,newSourceSnapshots:7,records:12,custodyCopies:copies.length,newFunctionalTests:'NO EJECUTADOS',reusedTests:'Caracterización57, sensibilidad4; no repetidos',productWrites:0,externalEffects:false,usageObserved:92,ceiling:100,n03:'ABIERTA'};for(const to of[d,archive]){create(p.join(to,'ARCHIVO.json'),JSON.stringify(copies,null,2));create(p.join(to,'VERIFICACION.json'),JSON.stringify(result,null,2));}console.log(JSON.stringify(result));
