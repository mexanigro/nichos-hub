const fs=require('fs'),p=require('path'),crypto=require('crypto');const d=__dirname,o=p.join(d,'contrato-cita-separada'),hash=b=>crypto.createHash('sha256').update(b).digest('hex');fs.mkdirSync(o);fs.mkdirSync(p.join(o,'preimagenes'));const roots={template:'C:/Users/liama/Desktop/Nichos/Barber-shop-template-main'};const rels=['api/index.ts','src/lib/api/booking-handler.ts','src/lib/api/booking-validation.ts','src/lib/firebase.ts','src/services/db.ts','src/components/admin/AdminDashboard.tsx','src/components/booking/BookingWizard.tsx'];const sources=rels.map(rel=>({path:p.join(roots.template,rel),sha256:hash(fs.readFileSync(p.join(roots.template,rel)))}));fs.writeFileSync(p.join(o,'FUENTES.json'),JSON.stringify(sources,null,2),{flag:'wx'});fs.writeFileSync(p.join(o,'PLAN.md'),'# Contrato de la misma cita entre destinos separados\n\nP0: registrar aceptación de controldestinos sinrepetirpruebas, fijar superficie y controles. P1: recorrer registro API, handler/transacción y suscripción CRM reales. P2: operar sobre referenciasSDK y almacenamiento interceptado por proyecto/base/path, probarcontrolcoincidente y destinosseparados. P3: documentar compatibilidad o desconexión exacta, propuesta y decisión necesaria antesproducto.\n\nSe conservan selectores separados. No sincronización, duplicación ni unificación. No producto, DBreal, credenciales reales, instalaciones, efectos externos, push/deploy/reset. Techo100%TOTAL, inicio91%. Cobro, aceptaciones, etapas y condición tenant permanecen.\n\nContratofijo: identidad de cita = proyecto/base/appointments/id; tenant guardado procede backend. RespuestaappointmentId debe corresponder alwrite. Suscripciónreal lleva filtroclientId, ordercreatedAtdesc ylimit500. Sóloresolverádocumentos ennamespaceexacto deconsulta. Controlcoincidente debe devolver mismacita/payload/ID. Separación porbase,proyecto,ambos ydefault/(default) determina si mecanismo real conector existe, sin fabricarlo eninstrumento. CeroresolucionesporIDsinnamespace. Sensibilidad: si seomite namespace de almacenamiento simulado, negativosdeben detectar falsaconexión. No demuestra persistencia/concurrencia/auth/rules/índices nioperaciónalojada.\n',{flag:'wx'});
const acceptance='# Aceptación local del control de destinos\n\nLiam: «Acepto el control local de selección/rechazo de destinos. Integrá esa aceptación en los registros al continuar; no repitas sus pruebas». Se acepta exclusivamente retoma-metricas: preimagenRED7/productoGREEN48/mutanteRED7, selección/rechazo. No métricascompletas ni cierreN03. Evidencia anterior conservada sinrepetir. La continuación autorizada prepara contrato /api/book→lecturaCRM con destinos separados, sinproducto.\n';fs.writeFileSync(p.join(d,'retoma-metricas/ACEPTACION.md'),acceptance,{flag:'wx'});const canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',archive='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03';fs.writeFileSync(p.join(archive,'informe/N03/reconciliacion-v1/continuacion-cierre/retoma-metricas/ACEPTACION.md'),acceptance,{flag:'wx'});for(const [label,root]of [['canon',canon],['archivo',archive]]){const f=p.join(root,'informe/N03/reconciliacion-v1/BALANCE.md'),b=fs.readFileSync(f);fs.writeFileSync(p.join(o,'preimagenes/BALANCE-'+label+'.md'),b,{flag:'wx'});let s=b.toString('utf8').replace('control detenido de destinos de métricas resuelto localmente y entregado para revisión','control local de selección/rechazo de destinos aceptado por Liam').replace('Se levanta únicamente ese impedimento instrumental; no se certifican métricas completas ni se acepta/cierra N03.','Se descuenta únicamente ese control local; no se certifican métricas completas ni se cierra N03. Aceptación registrada sin repetir pruebas.').replace('producto GREEN48 y mutante RED7, para revisión.','producto GREEN48 y mutante RED7, aceptado localmente por Liam.');fs.writeFileSync(f,s)}console.log({sources:sources.length,acceptanceRecorded:true});
