const fs=require('fs'),p=require('path'),{createRequire}=require('module'),assert=require('assert/strict');const req=createRequire('/deps/package.json'),ts=req('typescript'),sdk=req('firebase-admin/firestore'),apps=req('firebase-admin/app');
const root='/template',rows=[],fails=[];let count=0;const check=(id,actual,expected)=>{count++;try{assert.deepEqual(actual,expected)}catch{fails.push({id,actual,expected})}};const compile=s=>ts.transpileModule(s,{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022,esModuleInterop:true}}).outputText;
const cache=new Map();function load(file){if(cache.has(file))return cache.get(file);const m={exports:{}};cache.set(file,m.exports);const s=fs.readFileSync(file,'utf8');new Function('require','module','exports',compile(s))(id=>id.startsWith('.')?load(p.resolve(p.dirname(file),id.replace(/\.js$/,'.ts'))):req(id),m,m.exports);return m.exports;}
const app=apps.initializeApp({projectId:'backend-project'}),db=sdk.getFirestore(app,'backend-db'),data=new Map(),ops=[],key=ref=>JSON.stringify([ref.firestore.projectId,ref.firestore.databaseId,ref.path]);const snap=ref=>({id:ref.id,exists:data.has(key(ref)),data:()=>data.get(key(ref))});
sdk.DocumentReference.prototype.get=async function(){ops.push(['get',key(this)]);return snap(this)};
sdk.DocumentReference.prototype.update=async function(patch){ops.push(['update',key(this),patch]);data.set(key(this),{...data.get(key(this)),...patch})};
sdk.Query.prototype.get=async function(){const opts=this._queryOptions,namespace={project:this.firestore.projectId,database:this.firestore.databaseId};ops.push(['query',namespace,opts.collectionId,opts.filters.map(f=>({field:f.field.segments.join('.'),op:f.op,value:f.value})),opts.fieldOrders.map(o=>({field:o.field.segments.join('.'),direction:o.direction})),opts.limit]);if(opts.collectionId==='customers')return{empty:false,docs:[]};let docs=[];for(const [k,value]of data){const [project,database,path]=JSON.parse(k);if(project===namespace.project&&database===namespace.database&&path.startsWith(opts.collectionId+'/')&&opts.filters.every(f=>{assert.equal(f.op,'EQUAL');return value[f.field.segments.join('.')]===f.value}))docs.push({id:path.split('/')[1],data:()=>value});}for(const o of opts.fieldOrders){const field=o.field.segments.join('.');docs.sort((a,b)=>{const av=a.data()[field],bv=b.data()[field],x=av?.toMillis?.()??av,y=bv?.toMillis?.()??bv;return (x<y?-1:x>y?1:0)*(o.direction==='DESCENDING'?-1:1)});}if(opts.limit)docs=docs.slice(0,opts.limit);return{empty:!docs.length,docs};};db.runTransaction=async fn=>fn({get:async ref=>{ops.push(['txget',key(ref)]);return snap(ref)},set(ref,value){ops.push(['txset',key(ref)]);data.set(key(ref),{...value,...('createdAt'in value?{createdAt:sdk.Timestamp.fromMillis(1800000000000)}:{})});return this},update(ref,value){ops.push(['txupdate',key(ref),value]);data.set(key(ref),{...data.get(key(ref)),...value});return this}});
const response=()=>({code:200,body:null,status(code){this.code=code;return this},json(body){this.body=body;return this}});
(async()=>{const booking=load(root+'/src/lib/api/booking-handler.ts').createBookingHandler({clientId:'tenant-local',loadContext:async()=>({db,FieldValue:sdk.FieldValue})});const r=response();await booking({body:{customerName:'Book real',customerEmail:'a@example.invalid',customerPhone:'123',serviceId:'s',staffId:'staff',date:'2026-10-10',time:'10:00',duration:30,status:'confirmed'}},r);check('book/positive',r.code,200);check('book/stored',data.has(key(db.doc('appointments/'+r.body.appointmentId))),true);
data.set(key(db.doc('appointments/adversarial-other')),{clientId:'other',createdAt:sdk.Timestamp.fromMillis(1800000000001)});check('instrument/filter-positive',(await db.collection('appointments').where('clientId','==','tenant-local').get()).docs.length,1);check('instrument/filter-disarmed',(await db.collection('appointments').get()).docs.length,2);const file=root+'/src/lib/api/crm-appointments-handler.ts';if(!fs.existsSync(file)){check('connection/backend-handler-exists',false,true);rows.push({missing:file,diagnostic:'RED funcional de conexión aún no implementada; book control positivo ejecutado'});}else{let allow=true;const h=load(file).createCrmAppointmentsHandlers({clientId:'tenant-local',loadDb:async()=>db,authenticate:async(_req,res)=>{if(allow)return{email:'admin@example.invalid',uid:'u',role:'owner'};res.status(403).json({error:'Forbidden'});return null}});let out=response();await h.list({query:{clientId:'attacker'}},out);check('list/code',out.code,200);check('list/identity',out.body.source,{project:'backend-project',database:'backend-db',collection:'appointments'});check('list/same-id',out.body.appointments.map(x=>x.id),[r.body.appointmentId]);
const id=r.body.appointmentId,ref=db.doc('appointments/'+id),old=data.get(key(ref));data.set(key(ref),{...old,untouched:['x']});out=response();await h.patch({params:{id},body:{status:'cancelled'}},out);check('cancel/code',out.code,200);check('cancel/same-document',data.get(key(ref)).status,'cancelled');check('cancel/unrelated',data.get(key(ref)).untouched,['x']);check('cancel/manifest',data.get(key(db.doc('daily_manifests/tenant-local_staff_2026-10-10'))).intervals,[]);
out=response();await h.patch({params:{id},body:{date:'2026-10-11',time:'11:00'}},out);check('move/code',out.code,200);check('move/date',data.get(key(ref)).date,'2026-10-11');check('move/createdAt',data.get(key(ref)).createdAt,old.createdAt);
for(const body of [{clientId:'attacker'},{origin:{source:'browser'}},{createdAt:0},{status:'hack'},{date:'bad',time:'99:90'}]){const before=ops.length;out=response();await h.patch({params:{id},body},out);check('patch/reject-'+JSON.stringify(body),out.code,400);check('patch/no-write-'+JSON.stringify(body),ops.slice(before).some(x=>['update','txupdate','txset','set','delete'].includes(x[0])),false);}
const other=db.doc('appointments/other');data.set(key(other),{...old,clientId:'other'});out=response();await h.patch({params:{id:'other'},body:{status:'cancelled'}},out);check('tenant/reject',out.code,404);check('tenant/intact',data.get(key(other)).status,old.status);out=response();await h.patch({params:{id:'missing'},body:{status:'cancelled'}},out);check('missing/reject',out.code,404);allow=false;const before=ops.length;out=response();await h.list({},out);check('auth/reject',out.code,403);check('auth/no-cita-access',ops.length,before);rows.push({ops});}
fs.writeFileSync('/salida/CONTRATO.json',JSON.stringify({checks:count,failures:fails,rows,scope:'Book real+Admin refs reales; transporte/persistencia interceptados. No prueba auth real ni UI en este archivo.'},null,2));console.log({checks:count,failures:fails.length});await apps.deleteApp(app);process.exitCode=fails.length?1:0;})().catch(e=>{console.error(e.stack);process.exitCode=2});

