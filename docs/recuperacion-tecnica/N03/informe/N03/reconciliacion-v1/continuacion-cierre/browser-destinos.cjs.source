const fs=require('fs'),{createRequire}=require('module'),assert=require('assert/strict');const req=createRequire('/deps/package.json'),ts=req('typescript'),app=req('firebase/app'),dbsdk=req('firebase/firestore'),auth=req('firebase/auth');const source=fs.readFileSync('/template/src/lib/firebase.ts','utf8'),rows=[],failures=[];const common={VITE_FIREBASE_API_KEY:'synthetic-key',VITE_FIREBASE_AUTH_DOMAIN:'synthetic.invalid',VITE_FIREBASE_PROJECT_ID:'p-a',VITE_FIREBASE_APP_ID:'synthetic-app'};const cases=[{id:'default',env:common,project:'p-a',db:'default'},{id:'named',env:{...common,VITE_FIREBASE_DATABASE_ID:'tenant-db'},project:'p-a',db:'tenant-db'},{id:'paren-default',env:{...common,VITE_FIREBASE_DATABASE_ID:'(default)'},project:'p-a',db:'(default)'},{id:'blancos',env:{...common,VITE_FIREBASE_PROJECT_ID:' p-a ',VITE_FIREBASE_DATABASE_ID:'   '},project:'p-a',db:'default'},{id:'server-no-sustituye',env:{...common,VITE_FIREBASE_PROJECT_ID:'',FIREBASE_PROJECT_ID:'p-server'}},{id:'sin-api-key',env:{...common,VITE_FIREBASE_API_KEY:''}},{id:'sin-app',env:{...common,VITE_FIREBASE_APP_ID:undefined}},{id:'conflicto-envs',env:{...common,FIREBASE_PROJECT_ID:'p-server',FIREBASE_DATABASE_ID:'server-db'},project:'p-a',db:'default'}];
(async()=>{for(const c of cases){for(const a of app.getApps())await app.deleteApp(a);const moduleLocal={exports:{}},operations=[];const deps=id=>id==='firebase/app'?app:id==='firebase/auth'?auth:id==='firebase/firestore'?{...dbsdk,getDocFromServer:async ref=>{operations.push({app:ref.firestore.app.options.projectId,project:ref.firestore._databaseId.projectId,db:ref.firestore._databaseId.database,path:ref.path});return{exists:()=>false}}}:(()=>{throw Error('unexpected '+id)})();new Function('require','module','exports','__env','console',ts.transpileModule(source.replaceAll('import.meta.env','__env'),{compilerOptions:{module:1,target:9}}).outputText)(deps,moduleLocal,moduleLocal.exports,c.env,{warn(){},log(){},error(){}});await new Promise(r=>setImmediate(r));try{assert.equal(moduleLocal.exports.isFirebaseConfigured,!!c.project);assert.deepEqual(operations,c.project?[{app:c.project,project:c.project,db:c.db,path:'system/ping'}]:[])}catch(e){failures.push({id:c.id,message:e.message})}rows.push({id:c.id,configured:moduleLocal.exports.isFirebaseConfigured,operations});}for(const a of app.getApps())await app.deleteApp(a);fs.writeFileSync('/salida/BROWSER-DESTINOS.json',JSON.stringify({result:failures.length?'RED':'GREEN',rows,failures,limites:'SDK Firebase instalado real, lectura getDocFromServer interceptada antes red. Identificadores internos SDK observados; no rules, identidad, base remota ni equivalencia de configuraciones server/browser.'},null,2));console.log({rows:rows.length,failures:failures.length});process.exitCode=failures.length?1:0})().catch(e=>{console.error(e);process.exitCode=2});
