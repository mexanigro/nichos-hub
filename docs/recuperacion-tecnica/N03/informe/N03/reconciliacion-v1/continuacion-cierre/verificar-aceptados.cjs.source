const fs=require('fs'),p=require('path'),crypto=require('crypto'),assert=require('assert/strict');const d=__dirname,root='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',ts=require(root+'/node_modules/typescript'),checks=[];function extract(file,name){const s=fs.readFileSync(file,'utf8'),a=ts.createSourceFile(file,s,99,true);return a.statements.find(n=>ts.isFunctionDeclaration(n)&&n.name?.text===name)?.getText(a)}for(const [current,pre,names]of [[root+'/server.ts',p.join(d,'preimagenes/checkout/server.ts'),['getAdminDb']],[root+'/api/index.ts',p.join(d,'preimagenes/checkout/api/index.ts'),['loadAdminFirestore','firestoreRestCreate','getFirestoreRestContext','firestoreRestGetDocument','firestoreRestPatchDocument']],[root+'/src/config/site.ts',p.join(d,'preimagenes/producto/src/config/site.ts'),['_applyBusinessMode']]])for(const name of names){const a=extract(current,name),b=extract(pre,name);assert.ok(a&&b,name);assert.equal(a,b,name);checks.push({file:current,name,identical:true,sha256:crypto.createHash('sha256').update(a).digest('hex')})}fs.writeFileSync(p.join(d,'ACEPTADOS-CONSERVADOS.json'),JSON.stringify(checks,null,2),{flag:'wx'});console.log({acceptedFunctionsIdentical:checks.length});
