const fs=require('fs'),path=require('path'),crypto=require('crypto');const d=__dirname,r=path.resolve(d,'../../..'),pre=path.join(d,'preimagenes');fs.mkdirSync(pre);const custody=[];
function update(rel,fn){const file=path.join(r,rel),bytes=fs.readFileSync(file),dest=path.join(pre,rel);fs.mkdirSync(path.dirname(dest),{recursive:true});fs.writeFileSync(dest,bytes);custody.push({path:rel,bytes:bytes.length,sha256:crypto.createHash('sha256').update(bytes).digest('hex')});fs.writeFileSync(file,fn(bytes.toString('utf8')));}
const accepted='# D05 — aceptación de Liam integrada\n\nProcedencia: mensaje de Liam en esta tarea, 2026-09-09: «Acepto D05 como GREEN local. Integrá la aceptación y la revisión externa en sus registros. N03 sigue en curso». La aceptación corresponde exclusivamente al contrato local congelado y a su evidencia; no al cierre de N03 ni a despliegue.\n\nLa revisión independiente disponible es /root/refutar_soporte (Harvey), documentada en [REVISION-FINAL.md](REVISION-FINAL.md): materiales incorporados antes del freeze, sin BLOCKERS/MATERIAL demostrados al cierre. El integrador verificó después las corridas positivas y la mutación. No se inventa otro dictamen externo ni hallazgos no recibidos.\n\nCotejo de esta continuación:332 huellas de producto coinciden con FUENTES-FINALES-r2.json; no se repitió aceptación. [Balance N03](../reconciliacion-v1/BALANCE.md). Se conservan informe, sello y evidencia del cierre; esta adenda documental posterior no modifica el contrato ni el código revisado. Preimagen del informe antes de enlazar aceptación: reconciliacion-v1/preimagenes/informe/N03/D05-v1/INFORME.md.\n\nAntes de despliegue: evidencia de tenants/servicios que deben conservar prestaciones y decisión de Liam sobre excepciones. N03 sigue en curso; techo TOTAL74%, observado73%, sin resets.\n';
fs.writeFileSync(path.join(r,'informe/N03/D05-v1/ACEPTACION.md'),accepted);
update('informe/N03/D05-v1/INFORME.md',s=>s.replace(/^(#[^\n]*\n)/,'$1\nAceptación local expresa de Liam integrada en [ACEPTACION.md](ACEPTACION.md); revisión independiente conservada. [Balance vigente de obligaciones N03](../reconciliacion-v1/BALANCE.md). Esta adenda no cambia producto ni contrato congelado.\n'));
for(const rel of ['indice/tareas/N03.md','indice/README.md','indice/PENDIENTES.md','indice/CALENDARIO.md']){const prefix=rel.includes('tareas/')?'../../':'../';const note='**N03 en curso — balance reconciliado; D05 aceptada localmente por Liam.** Book/support/stock/health-SP-H01/D05 conservadas por huellas. [Balance completo]('+prefix+'informe/N03/reconciliacion-v1/BALANCE.md) distingue cumplido local, reparación/contrato local pendiente y etapas posteriores. Única siguiente reparación propuesta:13 diagnósticos lint heredados en6 archivos hub; reproducidos1error/12advertencias. [Alcance y retoma]('+prefix+'informe/N03/reconciliacion-v1/SIGUIENTE-ACCION.md). Sólo preparación autorizada, no implementación. RE-EXT02/03, configuración/modos/fail-open/idiomas y demás deuda local no se trasladan íntegramente a otras etapas. Condición previa al despliegue por prestaciones de tenant intacta. Techo TOTAL74% N03; observado73%, sin resets. Estados inferiores conservados como históricos.\n';update(rel,s=>s.replace(/^(#[^\n]*\n)/,'$1\n'+note));}
const history='historial/2026-09-09-N03-aceptacion-D05-y-balance.md';if(fs.existsSync(path.join(r,history)))throw Error('history exists');fs.writeFileSync(path.join(r,history),'# N03 — aceptación D05 y balance de continuidad\n\nLiam aceptó D05 GREEN local y autorizó reconciliar/preparar, no reparar producto. Se integraron aceptación y revisión independiente disponible con procedencia.332 huellas template vigentes; no se repitieron suites. Lint focal sobre6 archivos recibidos reprodujo1error/12advertencias, exit1; ningún handler/proveedor invocado.\n\n[Balance](../informe/N03/reconciliacion-v1/BALANCE.md) conserva todas las familias/recepciones de ficha, impide falso cierre por diferir configuración/tenant y mantiene destinos N01/N04–N10. Única recomendación: reparar juntos13 diagnósticos de lint sin alterar contratos/precios/comportamiento; todavía no implementada. La revisión independiente propuso priorizar contrato de selectores; el integrador conserva ese impedimento pero elige deuda inequívoca menor como siguiente reparación. [Retoma](../informe/N03/reconciliacion-v1/SIGUIENTE-ACCION.md).\n\nN03 en curso; condición de prestaciones por tenant antes de desplegar conservada. Consumo73/techo TOTAL74, sin resets. Sin remoto, instalaciones, commit, push, deploy o modificaciones de producto.\n');
fs.writeFileSync(path.join(d,'CUSTODIA.json'),JSON.stringify(custody,null,2));
const lint=JSON.parse(fs.readFileSync(path.join(d,'LINT-ACTUAL.json'),'utf8').replace(/^\uFEFF/,''));fs.writeFileSync(path.join(d,'FUENTES-HUB.json'),JSON.stringify(lint.map(e=>({path:e.filePath,sha256:crypto.createHash('sha256').update(fs.readFileSync(e.filePath)).digest('hex')})),null,2));
const links=[];for(const rel of ['BALANCE.md','SIGUIENTE-ACCION.md']){const f=path.join(d,rel);for(const m of fs.readFileSync(f,'utf8').matchAll(/\]\(([^)]+)\)/g))links.push({from:rel,target:m[1],exists:fs.existsSync(path.resolve(path.dirname(f),m[1]))});}
if(links.some(l=>!l.exists))throw Error(JSON.stringify(links.filter(l=>!l.exists)));fs.writeFileSync(path.join(d,'VALIDACION-REGISTROS.json'),JSON.stringify({valid:true,links,n03:'en_curso',d05:'aceptada_GREEN_local',newRepair:'preparacion_sin_implementacion',templateDrift:JSON.parse(fs.readFileSync(path.join(d,'HUELLAS-TEMPLATE.json'),'utf8').replace(/^\uFEFF/,'')).filter(e=>!e.valid).length,lint:{files:lint.length,errors:lint.reduce((n,x)=>n+x.errorCount,0),warnings:lint.reduce((n,x)=>n+x.warningCount,0)}},null,2));console.log('Registros integrados; enlaces válidos; N03 en curso; ninguna implementación.');
