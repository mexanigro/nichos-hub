const fs=require('fs'),path=require('path'),crypto=require('crypto');const d=__dirname,root='C:/Users/liama/Desktop/Nichos-hub',ts=require(path.join(root,'node_modules/typescript'));const hash=f=>crypto.createHash('sha256').update(fs.readFileSync(f)).digest('hex');const sources=JSON.parse(fs.readFileSync(path.join(d,'FUENTES.json'),'utf8'));const checks=[];
const print=text=>{const tree=ts.createSourceFile('file.ts',text,ts.ScriptTarget.Latest,true);return ts.createPrinter({removeComments:true}).printFile(tree);};
for(const e of sources.filter(e=>e.path.includes('/api/'))){const before=fs.readFileSync(path.join(d,'preimagenes',e.path),'utf8'),after=fs.readFileSync(path.join(root,e.path),'utf8');let expected=before;if(e.path.includes('api-costs/fetch'))expected=expected.replace('NextRequest, NextResponse','NextResponse').replace('async (_req: NextRequest, _session, _ctx) =>','async () =>');if(e.path.includes('appointments/'))expected=expected.replace(/^  parse,\r?\n/m,'');if(e.path.includes('upload/'))expected=expected.replace('NextRequest, NextResponse','NextResponse');if(e.path.includes('prospects/'))expected=expected.replace('Record<string, any> & { id: string }','Record<string, unknown> & { id: string }');checks.push({name:e.path+' sólo cambio autorizado AST',valid:print(expected)===print(after)});}
for(const e of JSON.parse(fs.readFileSync(path.join(d,'FREEZE.json'),'utf8')))checks.push({name:'freeze '+e.path,valid:hash(path.join(d,e.path))===e.sha256});
const template='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main';const inherited=JSON.parse(fs.readFileSync(path.resolve(d,'../D05-v1/FUENTES-FINALES-r2.json'),'utf8'));checks.push({name:'332 fuentes template/entregas aceptadas sin deriva',valid:inherited.every(e=>hash(path.join(template,e.path)).toUpperCase()===e.sha256)});
fs.writeFileSync(path.join(d,'CONSERVACION.json'),JSON.stringify({valid:checks.every(c=>c.valid),checks},null,2));fs.writeFileSync(path.join(d,'FUENTES-FINALES.json'),JSON.stringify(sources.map(e=>({path:e.path,sha256:hash(path.join(root,e.path))})),null,2));console.log(JSON.stringify({valid:checks.every(c=>c.valid),checks:checks.length}));process.exitCode=checks.every(c=>c.valid)?0:1;
