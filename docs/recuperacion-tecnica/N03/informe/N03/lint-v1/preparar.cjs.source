const fs=require('fs'),path=require('path'),crypto=require('crypto');const d=__dirname,root='C:/Users/liama/Desktop/Nichos-hub',recon=path.resolve(d,'../reconciliacion-v1');fs.mkdirSync(path.join(d,'preimagenes'));fs.mkdirSync(path.join(d,'resultados'));
const initial=JSON.parse(fs.readFileSync(path.join(recon,'FUENTES-HUB.json'),'utf8'));const records=[];
for(const e of initial){const bytes=fs.readFileSync(e.path);if(crypto.createHash('sha256').update(bytes).digest('hex')!==e.sha256)throw Error('drift '+e.path);const rel=path.relative(root,e.path);const dest=path.join(d,'preimagenes',rel);fs.mkdirSync(path.dirname(dest),{recursive:true});fs.writeFileSync(dest,bytes);records.push({path:rel.replaceAll('\\','/'),bytes:bytes.length,sha256:e.sha256});}
fs.writeFileSync(path.join(d,'FUENTES.json'),JSON.stringify(records,null,2));fs.writeFileSync(path.join(d,'tsconfig.json'),JSON.stringify({extends:root+'/tsconfig.json',include:records.map(e=>root+'/'+e.path).concat(root+'/next-env.d.ts'),exclude:[]},null,2));
