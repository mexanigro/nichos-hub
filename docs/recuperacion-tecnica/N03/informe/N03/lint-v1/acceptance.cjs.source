const fs=require('fs'),path=require('path'),vm=require('vm'),assert=require('node:assert/strict'),crypto=require('crypto');const root='C:/Users/liama/Desktop/Nichos-hub',d=__dirname,ts=require(path.join(root,'node_modules/typescript'));
const name=process.argv[2];if(!name||fs.existsSync(path.join(d,'resultados',name+'.json')))throw Error('unique result name required');const results=[];const check=(label,fn)=>{try{fn();results.push({label,valid:true});}catch(e){results.push({label,valid:false,error:e.message});}};
function load(text,globals={}){const module={exports:{}};vm.runInNewContext(ts.transpileModule(text,{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,{module,exports:module.exports,require:id=>{throw Error('forbidden import '+id);},...globals});return module.exports;}
const original=f=>fs.readFileSync(path.join(d,'preimagenes/src',f),'utf8'),current=f=>fs.readFileSync(path.join(root,'src',f),'utf8');
function outputs(source){const pricing=load(source('lib/pricing.ts')),contracts=load(source('lib/contracts.ts'));const plans=['solo_web','web_crm','completo','base','pro','enterprise'];const texts={};for(const lang of ['en','es','ru','he','ar','unknown'])for(const plan of plans)texts[lang+'/'+plan]=contracts.getContract(lang,plan);const amounts={};for(const plan of [...plans,undefined])amounts[String(plan)]=pricing.getPlanAmount(plan);return {texts,amounts,payment:[pricing.getPaymentAmount(true),pricing.getPaymentAmount(false)],tiers:['base','pro','enterprise'].map(t=>[pricing.getTierAmount(t),pricing.getNextTier(t)]),constants:Object.fromEntries(Object.entries(pricing).filter(([,v])=>typeof v!=='function')),langs:['en','es','ru','he','ar','unknown'].map(l=>contracts.isContractLang(l))};}
const stable=x=>JSON.stringify(x,(_,v)=>v===Infinity?'Infinity':v);const before=outputs(original),after=outputs(current);
for(const key of Object.keys(before.texts))check('texto/version '+key,()=>assert.equal(stable(after.texts[key]),stable(before.texts[key])));
for(const key of ['amounts','payment','tiers','constants','langs'])check('conservación '+key,()=>assert.equal(stable(after[key]),stable(before[key])));
function extract(text,names){const tree=ts.createSourceFile('source.ts',text,ts.ScriptTarget.Latest,true);const found=tree.statements.filter(n=>ts.isFunctionDeclaration(n)&&names.includes(n.name?.text));assert.equal(found.length,names.length);return found.map(n=>n.getText(tree)).join('\n');}
const authSource=extract(current('lib/auth.ts'),['withRole','withOwner']);
const response={json:(data,init={})=>({status:init.status||200,body:JSON.parse(JSON.stringify(data))})};
const data=[{id:'a',status:'web_sent',followUpDue:'2000-01-01',createdAt:{toDate:()=>new Date('2020-01-02')},updatedAt:'raw',extra:{preserved:true}},{id:'b',status:'paid',followUpDue:'2000-01-01',createdAt:null},{id:'c',status:'web_sent',followUpDue:'2999-01-01'},{id:'d',status:'not_interested',followUpDue:'2000-01-01'},{id:'e',status:'web_sent',followUpDue:'invalid'},{id:'f',status:'web_created'}];
async function get(source,query,role,fail=false){const calls=[];let selected=data;const db={collection:collection=>{calls.push(['collection',collection]);return {where(field,op,value){calls.push(['where',field,op,value]);selected=selected.filter(x=>x[field]===value);return this;},orderBy(field,order){calls.push(['orderBy',field,order]);return this;},async get(){calls.push(['get']);if(fail)throw Error('synthetic DB failure');return {docs:selected.map(({id,...fields})=>({id,data:()=>fields}))};}};}};const auth=load(authSource,{NextResponse:response,auth:async()=>role?{user:{role}}:null});const tree=ts.createSourceFile('route.ts',source('app/api/prospects/follow-up/route.ts'),ts.ScriptTarget.Latest,true);const declaration=tree.statements.find(n=>ts.isVariableStatement(n)&&n.declarationList.declarations.some(v=>v.name.getText(tree)==='GET'));assert(declaration);const app=load('const COLLECTION="hub_prospect_followups";\n'+declaration.getText(tree),{withOwner:auth.withOwner,NextResponse:response,db,URL});try{return {result:await app.GET({url:'http://isolated.invalid/api/prospects/follow-up'+query},{params:Promise.resolve({})}),calls};}catch(error){return {error:error.message,calls};}}
(async()=>{for(const [query,role,fail] of [['','owner',false],['?pending=true','owner',false],['?status=web_sent','owner',false],['?status=web_sent&pending=true','owner',false],['?status=unknown','owner',false],['?pending=false','owner',false],['',null,false],['','lead',false],['','seller',false],['','owner',true]]){const old=await get(original,query,role,fail),now=await get(current,query,role,fail);check('GET conserva '+query+'/'+role+'/'+fail,()=>assert.equal(stable(now),stable(old)));check('GET oráculo '+query+'/'+role+'/'+fail,()=>{if(!role)assert.equal(now.result.status,401);else if(role!=='owner')assert.equal(now.result.status,403);else if(fail)assert.equal(now.error,'synthetic DB failure');else{assert.equal(now.result.status,200);if(query.includes('pending=true'))assert.deepEqual(now.result.body.map(x=>x.id),['a']);if(query===''){assert.equal(now.result.body[0].createdAt,'2020-01-02T00:00:00.000Z');assert.equal(now.result.body[0].updatedAt,'raw');assert.equal(now.result.body[0].extra.preserved,true);}assert(now.calls.some(c=>c[0]==='orderBy'&&c[1]==='updatedAt'&&c[2]==='desc'));}if(role!=='owner')assert.equal(now.calls.length,0);});}
const configFile=ts.readConfigFile(path.join(d,'tsconfig.json'),ts.sys.readFile);
const config=ts.parseJsonConfigFileContent(configFile.config,ts.sys,d);
const program=ts.createProgram(config.fileNames,config.options),checker=program.getTypeChecker();
for(const [file,symbolName,types,minimum] of [['pricing.ts','getPaymentAmount',['boolean'],1],['contracts.ts','getContract',['ContractLang','PlanType'],2]]){
 const source=program.getSourceFile(path.join(root,'src/lib',file));
 const symbol=checker.getExportsOfModule(checker.getSymbolAtLocation(source)).find(s=>s.name===symbolName);
 const signatures=checker.getTypeOfSymbolAtLocation(symbol,source).getCallSignatures();
 check('firma pública '+symbolName,()=>{assert.equal(signatures.length,1);const sig=signatures[0];assert.equal(sig.minArgumentCount,minimum);assert.equal(stable(sig.parameters.map(p=>checker.typeToString(checker.getTypeOfSymbolAtLocation(p,source)))),stable(types));});
 check('retorno público '+symbolName,()=>assert.equal(checker.typeToString(checker.getReturnTypeOfSignature(signatures[0])),symbolName==='getPaymentAmount'?'number':'{ text: string; version: string; }'));
}
const result={passed:results.filter(x=>x.valid).length,failed:results.filter(x=>!x.valid).length,checks:results,limits:'GET registered declaration + actual withRole/withOwner extracted by AST; controlled session/DB/NextResponse; no provider imports or real effects. Contract strings compared exactly.'};fs.writeFileSync(path.join(d,'resultados',name+'.json'),JSON.stringify(result,null,2));console.log(JSON.stringify({passed:result.passed,failed:result.failed}));process.exitCode=result.failed?1:0;})();
