const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),assert=require('node:assert/strict');
const repo='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main',out=__dirname,previous=path.dirname(out);
const ts=require(path.join(repo,'node_modules/typescript/lib/typescript.js'));
const read=p=>fs.readFileSync(p,'utf8').replace(/^\uFEFF/,'');const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex').toUpperCase();
function census(file){const ast=ts.createSourceFile(file,read(file),ts.ScriptTarget.Latest,true),printer=ts.createPrinter({removeComments:true}),found={routes:{},policy:{}};function visit(n){if(ts.isCallExpression(n)&&/^app\.(get|post|put|patch|delete)$/.test(n.expression.getText(ast))&&ts.isStringLiteral(n.arguments[0]))found.routes[n.expression.getText(ast)+' '+n.arguments[0].text]=printer.printNode(ts.EmitHint.Unspecified,n,ast);if((ts.isFunctionDeclaration(n)&&['getClientIp','rateLimit','loadAdminFirestore','getAdminDb'].includes(n.name?.text))||(ts.isVariableDeclaration(n)&&['RATE_LIMIT_WINDOW_MS','RATE_LIMIT_MAX_PER_WINDOW','rateLimitStore'].includes(n.name.getText(ast))))found.policy[n.name.getText(ast)]=printer.printNode(ts.EmitHint.Unspecified,n,ast);ts.forEachChild(n,visit);}visit(ast);return found;}
const result=[];for(const file of ['server.ts','api/index.ts']){const a=census(path.join(out,'preimagenes',file.replaceAll('/','__'))),b=census(path.join(repo,file));assert.deepEqual(b,a);result.push({runtime:file,routes:Object.keys(b.routes).length,policy:Object.keys(b.policy),identical:true});}
const prior=JSON.parse(read(path.join(previous,'FUENTES-INICIALES.json')));for(const row of prior.filter(r=>!['server.ts','api/index.ts'].includes(r.path)))assert.equal(hash(path.join(repo,row.path)),row.sha256);
const files=['server.ts','api/index.ts','src/lib/api/runtime-health.ts'];for(const file of files)assert.equal(hash(path.join(repo,file)),hash(path.join(out,'copia',file)));
for(const row of JSON.parse(read(path.join(out,'CONTRATO-HUELLAS.json'))))assert.equal(hash(row.Path),row.Hash);
const sources=files.map(file=>({path:file,sha256:hash(path.join(repo,file))}));
fs.writeFileSync(path.join(out,'FUENTES-FINALES.json'),JSON.stringify(sources,null,2));fs.writeFileSync(path.join(out,'CONSERVACION.json'),JSON.stringify({runtimes:result,otherSources:328,contractExact:true,executedBytesExact:true},null,2));console.log(JSON.stringify(result));
