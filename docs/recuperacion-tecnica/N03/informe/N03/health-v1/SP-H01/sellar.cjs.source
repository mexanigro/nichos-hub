const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),assert=require('node:assert/strict');
const root=__dirname,repo='C:/Users/liama/Desktop/Nichos/Barber-shop-template-main';
const read=p=>fs.readFileSync(p,'utf8').replace(/^\uFEFF/,'');const json=p=>JSON.parse(read(path.join(root,p)));const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex').toUpperCase();
for(const [name,count] of [['sph01-green',89],['sph01-incompleta',19],['sph01-regresion',99]]){const rows=json(`resultados/${name}/RESULTADOS.json`);assert.equal(rows.length,count);assert(rows.every(r=>r.valid));assert.equal(json(`resultados/${name}/ESTADO.json`).exit,0);assert.equal(json(`resultados/${name}/ESTADO.json`).timeout,false);assert(json(`resultados/${name}/DISPOSICION.json`).eliminado);}
const failures=json('resultados/sph01-mutacion/RESULTADOS.json').filter(r=>!r.valid).map(r=>r.name);assert.deepEqual(failures,['server-configured: exceso429 antes de DB','server-configured: HEAD comparte cuota','api-configured: exceso429 antes de DB','api-configured: HEAD comparte cuota']);assert.equal(json('resultados/sph01-mutacion/ESTADO.json').exit,1);assert(json('resultados/sph01-mutacion/DISPOSICION.json').eliminado);
for(const name of ['TIPOS','PARIDAD','AUDITORIA'])assert.equal(json(`resultados/${name}-ESTADO.json`).exit,0);
for(const row of json('CONTRATO-HUELLAS.json'))assert.equal(hash(row.Path),row.Hash);for(const row of json('FUENTES-FINALES.json'))assert.equal(hash(path.join(repo,row.path)),row.sha256);
const ts=require(path.join(repo,'node_modules/typescript/lib/typescript.js'));
function core(file){const ast=ts.createSourceFile(file,read(file),ts.ScriptTarget.Latest,true),printer=ts.createPrinter({removeComments:true}),found={};function walk(n){if(ts.isFunctionDeclaration(n)&&['probe','respond'].includes(n.name?.text))found[n.name.text]=printer.printNode(ts.EmitHint.Unspecified,n,ast);if(ts.isMethodDeclaration(n)&&['complete','fail'].includes(n.name.getText(ast)))found[n.name.getText(ast)]=printer.printNode(ts.EmitHint.Unspecified,n,ast);if(ts.isCallExpression(n)&&n.expression.getText(ast).endsWith('.get')&&ts.isStringLiteral(n.arguments[0])&&['/api/health','/health'].includes(n.arguments[0].text))found.readiness=printer.printNode(ts.EmitHint.Unspecified,n.arguments.at(-1),ast);ts.forEachChild(n,walk);}walk(ast);assert.equal(Object.keys(found).length,5);return found;}
assert.deepEqual(core(path.join(root,'preimagenes/src__lib__api__runtime-health.ts')),core(path.join(repo,'src/lib/api/runtime-health.ts')));
const custody=[];function visit(dir){for(const e of fs.readdirSync(dir,{withFileTypes:true})){const p=path.join(dir,e.name);if(e.isDirectory())visit(p);else custody.push({path:path.relative(root,p),bytes:fs.statSync(p).size,sha256:hash(p)});}}visit(path.join(root,'preimagenes'));fs.writeFileSync(path.join(root,'CUSTODIA.json'),JSON.stringify(custody,null,2));
const result={result:'GREEN',finding:'SP-H01 resuelto localmente',gates:'4/4',checks:207,mutation:{positive:17,expectedFailures:4},typesExit:0,parity:3,readinessCorePreserved:true,previousDeliveriesPreserved:true,blockers:[],N03:'en_curso',usage:json('CONSUMO-CIERRE.json'),sources:json('FUENTES-FINALES.json')};
fs.writeFileSync(path.join(root,'SELLO-CIERRE.json'),JSON.stringify(result,null,2));console.log(JSON.stringify(result));
