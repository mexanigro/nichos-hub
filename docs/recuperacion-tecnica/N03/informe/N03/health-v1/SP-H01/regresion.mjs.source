import fs from 'node:fs';
import {spawn} from 'node:child_process';
import {createRequire} from 'node:module';
import vm from 'node:vm';
const require = createRequire('/app/package.json');
const ts = require('typescript');
const results=[];
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
function publicBody(r,status){return JSON.stringify(r.body)===JSON.stringify({status})&&!r.headers['x-client-id']&&!r.headers['x-powered-by'];}
function check(name, valid, evidence){results.push({name,valid,evidence});console.log(JSON.stringify(results.at(-1)));}
async function request(port,path='/api/health'){const start=Date.now();const res=await fetch(`http://127.0.0.1:${port}${path}`,{signal:AbortSignal.timeout(3500)});return {code:res.status,body:await res.json().catch(()=>({nonJson:true})),headers:Object.fromEntries(res.headers),ms:Date.now()-start};}
async function monitor(port,expected){let saved;const module={exports:{}};vm.runInNewContext(ts.transpileModule(fs.readFileSync('/control/monitor-apiCheck.ts','utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS}}).outputText,{module,exports:module.exports,console,require:name=>name.includes('db/client')?{db:{query:async(_sql,args)=>{saved=args;}}}:{fetchWithRetry:async url=>{const response=await fetch(url);return {response,statusCode:response.status,responseTimeMs:1};}}});const result=await module.exports.apiCheck({clientId:'monitor-control',url:`http://127.0.0.1:${port}`});return result.success===expected&&saved[3]===expected;}
async function run(runtime,scenario){const id=`${runtime}-${scenario}`,port=runtime==='server'?3000:3001;const modeFile=`/tmp/${id}-mode`,auditFile=`/tmp/${id}-audit`;fs.writeFileSync(modeFile,'ready');fs.writeFileSync(auditFile,'');fs.writeFileSync('/tmp/count-'+id,'');const env={PATH:process.env.PATH,HOME:'/tmp',TMPDIR:'/tmp',NODE_PATH:process.env.NODE_PATH,TSX_DISABLE_CACHE:'1',NODE_ENV:'production',CLIENT_ID:'tenant-control',FIREBASE_PROJECT_ID:'isolated',FIREBASE_ADMIN_PROJECT_ID:'isolated',FIREBASE_ADMIN_CLIENT_EMAIL:'fixture@example.invalid',FIREBASE_ADMIN_PRIVATE_KEY:'synthetic-fixture',HEALTH_MODE_FILE:modeFile,HEALTH_AUDIT_FILE:auditFile,HEALTH_COUNT_FILE:"/tmp/count-"+id};if(scenario==='absent')delete env.FIREBASE_ADMIN_PRIVATE_KEY;if(scenario==='tenant-absent')delete env.CLIENT_ID;if(scenario==='early'||scenario==='late')env.HEALTH_BOOT_FAIL=scenario;
const child=spawn(process.execPath,['--import','/app/node_modules/tsx/dist/loader.mjs','--import','/control/preload.mjs',runtime==='server'?'/app/server.ts':'/control/api-worker.mjs'],{env,cwd:'/app'});let stdout='',stderr='';child.stdout.on('data',b=>stdout+=b);child.stderr.on('data',b=>stderr+=b);try{let listening=false;for(let i=0;i<450;i++){if(child.exitCode!==null)break;try{await request(port);listening=true;break;}catch{}await sleep(100);}check(`${id}: arranque efectivo`,listening,{exit:child.exitCode});if(!listening)return;
const live=await request(port,'/api/live');check(`${id}: live`,live.code===200&&publicBody(live,'ok'),live);
if(scenario!=='normal'){const health=await request(port);check(`${id}: no listo`,health.code===503&&publicBody(health,'unavailable'),health);if(['early','late','tenant-absent','incomplete'].includes(scenario)){const guard=await request(port,'/api/tenant/status');check(`${id}: bloqueo parcial`,guard.code===503,guard);}return;}
for(const mode of ['ready','trial','maintenance','failed','ready','missing','blocked','unknown','loader-failed','pending','ready','loader-pending','ready']){fs.writeFileSync(modeFile,mode);if(mode==='ready')await sleep(60);const health=await request(port);const expected=['ready','trial','maintenance'].includes(mode)?200:503;check(`${id}: ${mode}`,health.code===expected&&health.body.status===(expected===200?'ok':'unavailable')&&health.ms<3000&&!health.headers['x-client-id']&&!health.headers['x-powered-by']&&Object.keys(health.body).length===1,health);if(['pending','loader-pending'].includes(mode)){const before=fs.readFileSync('/tmp/count-'+id,'utf8');const concurrent=await Promise.all([request(port),request(port)]);check(id+': pendiente compartido '+mode,concurrent.every(r=>r.code===503)&&before===fs.readFileSync('/tmp/count-'+id,'utf8'),{before,after:fs.readFileSync('/tmp/count-'+id,'utf8')});const livePending=await request(port,'/api/live');check(`${id}: live durante ${mode}`,livePending.code===200&&livePending.ms<500&&publicBody(livePending,'ok')&&before===fs.readFileSync('/tmp/count-'+id,'utf8'),livePending);}if(mode==='ready'||mode==='failed')check(`${id}: consumidor ${mode}`,await monitor(port,expected===200),{expected});}
}catch(e){check(`${id}: ejecución`,false,String(e));}finally{child.kill('SIGTERM');for(let i=0;i<30&&child.exitCode===null&&child.signalCode===null;i++)await sleep(30);if(child.exitCode===null&&child.signalCode===null)child.kill('SIGKILL');await sleep(100);fs.writeFileSync(`/salida/${id}.stdout.txt`,stdout);fs.writeFileSync(`/salida/${id}.stderr.txt`,stderr);const audit=fs.readFileSync(auditFile,'utf8');check(`${id}: cero intentos externos`,audit.length===0,{audit});check(`${id}: proceso terminado`,child.exitCode!==null||child.signalCode!==null,{exit:child.exitCode,signal:child.signalCode});}}
const selection=process.argv[2];for(const runtime of ['server','api'])for(const scenario of selection==='mutation'?['early']:selection==='incomplete'?['incomplete']:selection==='smoke'?['normal']:['normal','absent','tenant-absent','early','late'])await run(runtime,scenario);
const audit='/tmp/observer-audit';fs.writeFileSync(audit,'');const observer=spawn(process.execPath,['--import','/control/preload.mjs','-e',"fetch('https://outside.invalid').catch(()=>process.exit(0))"],{env:{PATH:process.env.PATH,NODE_PATH:process.env.NODE_PATH,HEALTH_AUDIT_FILE:audit}});await new Promise(r=>observer.on('exit',r));check('observador sensible',observer.exitCode===0&&fs.readFileSync(audit,'utf8').includes('fetch'),{exit:observer.exitCode,audit:fs.readFileSync(audit,'utf8')});
fs.writeFileSync('/salida/RESULTADOS.json',JSON.stringify(results,null,2));console.log(JSON.stringify({passed:results.filter(r=>r.valid).length,failed:results.filter(r=>!r.valid).length}));process.exitCode=results.every(r=>r.valid)?0:1;
