param([string]$Nombre,[string]$Copia='copia',[string]$Seleccion='full',[string]$Runner='runner.mjs')
$ErrorActionPreference='Stop'; $out=$PSScriptRoot; $result=Join-Path $out ('resultados/'+$Nombre); if(Test-Path -LiteralPath $result){throw 'Resultado existente'}; New-Item -ItemType Directory -Path $result|Out-Null
$name='n03-health-'+$Nombre; if(& docker ps -a --filter "name=^/$name$" --format '{{.ID}}'){throw 'Contenedor existente'}
$argsList=@('run','--pull=never','--name',$name,'--network=none','--read-only','--cap-drop=ALL','--security-opt=no-new-privileges','--pids-limit=128','--memory=4g','--cpus=2','--user=65534:65534','--tmpfs=/tmp:rw,nosuid,size=256m','--workdir=/app','--mount',"type=bind,source=$(Join-Path $out $Copia),target=/app,readonly",'--mount','type=bind,source=C:\Users\liama\Desktop\Nichos\recuperacion-tecnica\instancias\N02-control-v1\node_modules,target=/app/node_modules,readonly','--mount','type=bind,source=C:\Users\liama\Desktop\Nichos\recuperacion-tecnica\informe\N02\docker-p1-p2-v2\complemento,target=/compat,readonly','--mount',"type=bind,source=$out,target=/control,readonly",'--mount',"type=bind,source=$result,target=/salida",'--entrypoint=/usr/bin/env','sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2','-i','PATH=/usr/local/bin:/usr/bin:/bin','HOME=/tmp','TMPDIR=/tmp','NODE_PATH=/compat/node_modules','TSX_DISABLE_CACHE=1','node',"/control/$Runner",$Seleccion)
$si=[Diagnostics.ProcessStartInfo]::new();$si.FileName=(Get-Command docker).Source;$si.UseShellExecute=$false;$si.CreateNoWindow=$true;$si.RedirectStandardOutput=$true;$si.RedirectStandardError=$true;foreach($arg in $argsList){$si.ArgumentList.Add($arg)}
$p=[Diagnostics.Process]::new();$p.StartInfo=$si;$p.Start()|Out-Null;$stdout=$p.StandardOutput.ReadToEndAsync();$stderr=$p.StandardError.ReadToEndAsync();$finished=$p.WaitForExit(180000)
if(-not $finished){& docker stop -t 2 $name|Out-Null;$p.WaitForExit(5000)|Out-Null;if(-not $p.HasExited){$p.Kill();$p.WaitForExit()}}
try{[IO.File]::WriteAllText("$result/stdout.txt",$stdout.GetAwaiter().GetResult());[IO.File]::WriteAllText("$result/stderr.txt",$stderr.GetAwaiter().GetResult());$state=& docker inspect $name --format '{{json .State}}';@{exit=$p.ExitCode;timeout=(-not $finished);command=$argsList;state=($state|ConvertFrom-Json)}|ConvertTo-Json -Depth 8|Set-Content -LiteralPath "$result/ESTADO.json" -Encoding UTF8;Write-Output "Docker exit=$($p.ExitCode) timeout=$(-not $finished)"}finally{& docker rm -f $name|Out-Null;$left=& docker ps -a --filter "name=^/$name$" --format '{{.ID}}';if($left){throw 'Disposición falló'};@{eliminado=$true;nombre=$name}|ConvertTo-Json|Set-Content -LiteralPath "$result/DISPOSICION.json" -Encoding UTF8}