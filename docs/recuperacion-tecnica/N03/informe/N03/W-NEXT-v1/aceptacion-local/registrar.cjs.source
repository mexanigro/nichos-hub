const fs=require('node:fs'),p=require('node:path'),crypto=require('node:crypto');
const base=__dirname,canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',archivo='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03',hub='C:/Users/liama/Desktop/Nichos-hub';
const sha=b=>crypto.createHash('sha256').update(b).digest('hex');
const leer=r=>JSON.parse(fs.readFileSync(r,'utf8').replace(/^\uFEFF/,''));
const escribir=(ruta,b)=>{fs.mkdirSync(p.dirname(ruta),{recursive:true});fs.writeFileSync(ruta,b,{flag:'wx'});};
const informe=p.resolve(base,'../implementacion-local/CIERRE-LOCAL.md');
if(sha(fs.readFileSync(informe))!=='a69dca28dfcd30bd477b1db480546b66c6c0242298de4c2e039d49779a561961')throw Error('Acta distinta de revisión externa');
let evidencias=0;for(const fase of ['comparacion-local','implementacion-local'])for(const f of leer(p.resolve(base,'..',fase,'EVIDENCIA-FISICA.json')).archivos){if(sha(fs.readFileSync(f.ruta))!==f.sha256)throw Error('Evidencia alterada '+f.ruta);evidencias++;}
const producto=leer(p.resolve(base,'../implementacion-local/PRODUCTO-ANTES.json'));
for(const f of producto){const ruta=f.ruta==='src/middleware.ts'?'src/proxy.ts':f.ruta;if(sha(fs.readFileSync(p.join(hub,ruta)))!==f.sha256)throw Error('Producto cambió '+ruta);}
if(fs.existsSync(p.join(hub,'src/middleware.ts')))throw Error('Middleware reapareció');
const observadas=['src/app/api/onboarding/route.ts','src/app/api/onboarding/client-info/route.ts','src/lib/wizard/config-to-wizard.ts','node_modules/@google-cloud/firestore/build/src/document.js'];
escribir(p.join(base,'FUENTES-LECTURA.json'),JSON.stringify({limite:'Lectura acotada para seleccionar propuesta; no ejecución de endpoint/SDK ni nueva auditoría',fuentes:observadas.map(ruta=>({ruta:p.join(hub,ruta),sha256:sha(fs.readFileSync(p.join(hub,ruta)))}))},null,2));
const resumen='**W-NEXT aceptada exclusivamente local y descontada de pendientes N03.** Liam aceptó el renombrado idéntico;revisión externa recuperada de “Supervisar cierre N03 en Nichos” confirma evidencia y limita su conclusión a alcance local. Actas/controles/resultados anteriores se conservan sin reejecutarlos. N03 sigue abierta. Única siguiente propuesta:no implementar ahora;preparar L02 del endpoint client-info,parches con puntos y representación anidada,con defaults actuales y hojas fuera del patch preservados. Resto de L01/L02/L12 y entregas aceptadas intactos. Techo85% TOTAL compartido,observado81%,sin resets,push/deploy. Etapas posteriores y condición de prestaciones por tenant antes del despliegue conservadas. Adenda vigente;los estados inferiores de W-NEXT pendiente/para revisión son históricos.';
const registros=[
 ['informe/N03/W-NEXT-v1/INFORME.md','aceptacion-local/ACEPTACION-Y-REVISION-EXTERNA.md','aceptacion-local/SIGUIENTE-ACCION.md'],
 ['informe/N03/W-NEXT-v1/PROPUESTA.md','aceptacion-local/ACEPTACION-Y-REVISION-EXTERNA.md','aceptacion-local/SIGUIENTE-ACCION.md'],
 ['informe/N03/cierre-sesion-v1/RETOMA.md','../W-NEXT-v1/aceptacion-local/ACEPTACION-Y-REVISION-EXTERNA.md','../W-NEXT-v1/aceptacion-local/SIGUIENTE-ACCION.md'],
 ['informe/N03/reconciliacion-v1/BALANCE.md','../W-NEXT-v1/aceptacion-local/ACEPTACION-Y-REVISION-EXTERNA.md','../W-NEXT-v1/aceptacion-local/SIGUIENTE-ACCION.md'],
 ['informe/N03/reconciliacion-v1/SIGUIENTE-ACCION.md','../W-NEXT-v1/aceptacion-local/ACEPTACION-Y-REVISION-EXTERNA.md','../W-NEXT-v1/aceptacion-local/SIGUIENTE-ACCION.md'],
 ['indice/tareas/N03.md','../../informe/N03/W-NEXT-v1/aceptacion-local/ACEPTACION-Y-REVISION-EXTERNA.md','../../informe/N03/W-NEXT-v1/aceptacion-local/SIGUIENTE-ACCION.md'],
 ['indice/README.md','../informe/N03/W-NEXT-v1/aceptacion-local/ACEPTACION-Y-REVISION-EXTERNA.md','../informe/N03/W-NEXT-v1/aceptacion-local/SIGUIENTE-ACCION.md'],
 ['indice/CALENDARIO.md','../informe/N03/W-NEXT-v1/aceptacion-local/ACEPTACION-Y-REVISION-EXTERNA.md','../informe/N03/W-NEXT-v1/aceptacion-local/SIGUIENTE-ACCION.md']
];
// Preparar/verificar todos los cambios antes de la primera escritura de registros.
const preparados=registros.map(([rel,aceptacion,siguiente])=>{
 const ruta=p.join(canon,rel),antes=fs.readFileSync(ruta),texto=antes.toString('utf8'),i=texto.indexOf('\n');
 const adenda=resumen+' [Aceptación y límites]('+aceptacion+'). [Única propuesta]('+siguiente+').\n';
 let despues=texto.slice(0,i+1)+'\n'+adenda+texto.slice(i+1);
 if(rel.endsWith('/BALANCE.md')){
  if((texto.match(/^\| W-NEXT middleware \|/gm)||[]).length!==1)throw Error('Población W-NEXT balance inesperada');
  despues=despues.replace(/^\| W-NEXT middleware \|.*\r?\n/m,'');
  const fila='| W-NEXT — aceptada localmente | Renombrado idéntico middleware→proxy;HTTP129,registro/matcher,tipos/lint y mutación reutilizada. [Aceptación externa y límites]('+aceptacion+'). Descontada de pendiente local N03;N10 y certificación remota conservados. |';
  if(!/^\| D05 y parte de NOT-A \|/m.test(despues))throw Error('Tabla de cumplidos no localizada');
  despues=despues.replace(/^(\| D05 y parte de NOT-A \|.*)$/m,'$1\n'+fila);
 }
 if(rel==='informe/N03/reconciliacion-v1/SIGUIENTE-ACCION.md')despues='# Única siguiente acción vigente — N03\n\n'+adenda+'\n## Corte histórico: lint ya aceptado, no ejecutar\n\n'+texto;
 return {rel,ruta,antes,despues:Buffer.from(despues),aceptacion,siguiente};
});
escribir(p.join(base,'FREEZE-DOCUMENTAL.json'),JSON.stringify({fecha:new Date().toISOString(),alcance:'Aceptación local W-NEXT y propuesta única L02 client-info',estadoInicial:'RED: W-NEXT para revisión y selección histórica lint',evidenciasConservadas:evidencias,productoConservado:producto.length,propuestaSha256:sha(fs.readFileSync(p.join(base,'SIGUIENTE-ACCION.md'))),consumo:81,techo:85,resets:0},null,2));
const custodia=[];
for(const f of preparados){
 for(const [raiz,version] of [[canon,'canon'],[archivo,'archivo']]){
  const ruta=p.join(raiz,f.rel),prev=fs.readFileSync(ruta),preimagen=p.join(base,'preimagenes-registros',version,f.rel);escribir(preimagen,prev);fs.writeFileSync(ruta,f.despues);custodia.push({ruta,preimagen,antes:sha(prev),despues:sha(f.despues)});
 }
}
const historia='historial/2026-09-09-N03-W-NEXT-aceptada-localmente.md';
const textoHistoria='# N03 — W-NEXT aceptada localmente\n\n'+resumen+'\n\n[Aceptación y revisión externa](../informe/N03/W-NEXT-v1/aceptacion-local/ACEPTACION-Y-REVISION-EXTERNA.md). [Única propuesta](../informe/N03/W-NEXT-v1/aceptacion-local/SIGUIENTE-ACCION.md). Se prometió registrar aceptación/descontar W-NEXT y seleccionar una acción del balance;se hizo con procedencia,preimágenes y conservación. No se ejecutó reparación L02,ni se preparó un arnés o se repitieron pruebas aceptadas. La propuesta conserva defaults/SDK/transforms y distingue lo que lee el wizard. N03 y etapas posteriores permanecen abiertas.\n';
escribir(p.join(canon,historia),textoHistoria);escribir(p.join(archivo,historia),textoHistoria);
escribir(p.join(base,'CUSTODIA-REGISTROS.json'),JSON.stringify(custodia,null,2));
// Verificación final de evidencia y producto sin reejecutar pruebas aceptadas.
for(const fase of ['comparacion-local','implementacion-local'])for(const f of leer(p.resolve(base,'..',fase,'EVIDENCIA-FISICA.json')).archivos)if(sha(fs.readFileSync(f.ruta))!==f.sha256)throw Error('Evidencia cambió al registrar');
for(const f of producto){const ruta=f.ruta==='src/middleware.ts'?'src/proxy.ts':f.ruta;if(sha(fs.readFileSync(p.join(hub,ruta)))!==f.sha256)throw Error('Producto cambió al registrar');}
const balance=fs.readFileSync(p.join(canon,'informe/N03/reconciliacion-v1/BALANCE.md'),'utf8');
if(/^\| W-NEXT middleware \|/m.test(balance)||!/^\| W-NEXT — aceptada localmente \|/m.test(balance))throw Error('Descuento inválido');
let enlaces=0;for(const f of preparados){for(const enlace of [f.aceptacion,f.siguiente]){enlaces++;if(!fs.existsSync(p.resolve(p.dirname(f.ruta),enlace)))throw Error('Enlace '+enlace);}}
escribir(p.join(base,'RESULTADO.json'),JSON.stringify({result:'GREEN',alcanzados:4,total:4,W_NEXT:'aceptada_localmente_descontada',N03:'en_curso',unicaPropuesta:'Preparar L02 de client-info',L02Implementada:false,evidenciasConservadas:evidencias,srcConservados:producto.length,registros:custodia.length,enlacesCanon:enlaces,consumo:81,techo:85,resets:0},null,2));
const caminar=dir=>fs.readdirSync(dir,{withFileTypes:true}).flatMap(x=>x.isDirectory()?caminar(p.join(dir,x.name)):[p.join(dir,x.name)]);
const mapa=[];for(const ruta of caminar(base)){const rel=p.relative(base,ruta).replaceAll('\\','/'),b=fs.readFileSync(ruta),destino=p.join(archivo,'informe/N03/W-NEXT-v1/aceptacion-local',rel+(/\.(cjs|js|mjs|ts|tsx|ps1)$/.test(rel)?'.source':''));escribir(destino,b);mapa.push({origen:ruta,destino,sha256:sha(b),bytes:b.length});}
for(const f of mapa)if(sha(fs.readFileSync(f.destino))!==f.sha256)throw Error('Archivo difiere');
const manifiesto=JSON.stringify(mapa,null,2);escribir(p.join(base,'ARCHIVO-ACEPTACION.json'),manifiesto);escribir(p.join(archivo,'informe/N03/W-NEXT-v1/aceptacion-local/ARCHIVO-ACEPTACION.json'),manifiesto);
console.log(JSON.stringify({result:'GREEN',registros:custodia.length,evidenciasConservadas:evidencias,srcConservados:producto.length,archivados:mapa.length}));
