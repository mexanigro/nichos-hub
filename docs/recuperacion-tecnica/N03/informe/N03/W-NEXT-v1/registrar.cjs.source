const fs=require('node:fs'),p=require('node:path'),crypto=require('node:crypto');
const d=__dirname,root=p.resolve(d,'../../..'),hub='C:/Users/liama/Desktop/Nichos-hub',template=p.resolve(root,'../Barber-shop-template-main');
const sha=b=>crypto.createHash('sha256').update(b).digest('hex');
const read=f=>JSON.parse(fs.readFileSync(f,'utf8').replace(/^\uFEFF/,''));
const write=(f,data)=>{fs.mkdirSync(p.dirname(f),{recursive:true});fs.writeFileSync(f,data,{flag:'wx'});};
const l06=p.resolve(d,'../L06-language-v1');
for(const row of read(p.join(l06,'FUENTES-FINALES.json')))if(sha(fs.readFileSync(p.join(hub,row.path)))!==row.sha256)throw Error('L06 drift');
const templateRows=read(p.join(l06,'FREEZE.json')).templateSources;for(const row of templateRows)if(sha(fs.readFileSync(p.join(template,row.path)))!==row.sha256)throw Error('template drift');
for(const row of read(p.join(d,'FUENTES.json')))if(sha(fs.readFileSync(p.join(hub,row.path)))!==row.sha256)throw Error('selected source drift');
write(p.join(l06,'ACEPTACION-Y-REVISION-EXTERNA.md'),`# L06-language-v1 — aceptación y revisión externa trasladada\n\nProcedencia: Liam acepta cierre local en esta conversación y traslada revisión del segundo pensamiento, separada de Harvey. Diff limitado a language:locale;34/34controles reejecutados;mutación17fallos esperados;tipos nuevamente aprobados. Copia mutante coincide con preimagen. Fallbackes→en conservado;no traducciones completas ni deployreal certificados. Objeto: CIERRE-LOCAL.md SHA256 ${sha(fs.readFileSync(p.join(l06,'CIERRE-LOCAL.md')))}.\n\nEl integrador verificó vigencia5fuenteshub/333template sin repetir esas suites. No atribuye reejecución externa aHarvey. Esta conexión deL06 se descuenta del balance;N03 abierta ycondiciónprestaciones por tenant conservada.\n`);
const custody=[];function update(rel,notice){const f=p.join(root,rel),before=fs.readFileSync(f),pre=p.join(d,'preimagenes-registros',rel);write(pre,before);if(sha(fs.readFileSync(pre))!==sha(before))throw Error('custody');fs.writeFileSync(f,before.toString('utf8').replace('\n','\n\n'+notice+'\n'));custody.push({path:rel,before:sha(before),after:sha(fs.readFileSync(f)),preimage:p.relative(root,pre)});}
update('informe/N03/L06-language-v1/INFORME.md','**L06-language-v1 aceptada localmente por Liam.** [Revisión externa trasladada, separada de Harvey](ACEPTACION-Y-REVISION-EXTERNA.md).34controles/tipos repetidos,mutación17y preimagen coincidente. Conexión local descontada;es→en conservado,sin certificartraducciones/deploy. N03 abierta.');
update('informe/N03/reconciliacion-v1/BALANCE.md','**Adenda vigente: L06-language-v1 aceptada y descontada en su conexión onboarding→config.** [Aceptación externa separada de Harvey](../L06-language-v1/ACEPTACION-Y-REVISION-EXTERNA.md). Sin rehacer balance ni reabrir entregas. Única selección local pendiente: W-NEXT,convención middleware obsoleta;[propuesta](../W-NEXT-v1/PROPUESTA.md). Advertencia vigente ycallback caracterizado;producto sin editar,registro real Next todavía por probar antes de cierre. N03 abierta,H01/ES-A restante yotras obligaciones originales intactas. Consumo79%/80%TOTAL,sin resets;condiciónprestaciones por tenant vigente. Cortes inferiores históricos.');
for(const rel of ['indice/tareas/N03.md','indice/README.md','indice/PENDIENTES.md','indice/CALENDARIO.md']){const prefix=rel.includes('/tareas/')?'../../':'../';update(rel,`**N03 vigente: conexión L06 aceptada; única preparación W-NEXT-v1.** [Propuesta](${prefix}informe/N03/W-NEXT-v1/PROPUESTA.md):src/middleware.ts→src/proxy.ts conservando bytes;advertencia vigente deNext y10casoscallback medidos. Registro/wrapper real ypreservación frente runtimeNode exigidos en contrato,NOcertificados. Sin producto editado;pendiente autorizaciónP0→P3. N03 abierta,N04/N10 ycondiciónprestaciones por tenant vigentes. Consumo79%/80%TOTAL,sin resets. Detenido para revisión;no otra reparación. Estados inferiores históricos.`);}
write(p.join(d,'CUSTODIA-REGISTROS.json'),JSON.stringify(custody,null,2));
write(p.join(root,'historial/2026-09-09-N03-W-NEXT-preparacion.md'),'# N03 — L06 aceptada y preparación W-NEXT\n\nIntegrada revisión externa L06 separada deHarvey ydescontada conexión delbalance. Una obligación seleccionada: advertencia W-NEXT heredada. Next16.2.9instalado;src/middleware.tsúnicoarchivo. Detector exacto reproducido aisladamente y10casoscallback actuales caracterizados, sinred/productomodificado. [Propuesta](../informe/N03/W-NEXT-v1/PROPUESTA.md):movimientoúnico a proxy.ts,bytesidénticos;registroNext/NextAuthreales ypreservación bajoNode obligatorios antesdecierre.\n\nPreparación paraautorización;no freeze/implementación. Retoma: autorizarpropuesta,comprobar instrumentolocalantesproducto,P0→P3conmutación. Si margen79/80TOTAL noalcanza,STOPconretomadelmismoID. N03abierta,N04/N10/condiciónprestacionestenant intactas. Sinresets,instalaciones,remoto,ramas/worktrees,commit,push/deploy.\n');
write(p.join(d,'CONSERVACION.json'),JSON.stringify({acceptedL06HubSources:5,templateSources:333,selectedSources:6,allUnchanged:true,productWritten:false,usage:79,cap:80},null,2));
console.log(JSON.stringify({registered:true,records:custody.length,productUnchanged:true}));
