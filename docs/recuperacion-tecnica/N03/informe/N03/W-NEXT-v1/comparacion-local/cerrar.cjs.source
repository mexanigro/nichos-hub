const fs=require('node:fs'),p=require('node:path'),crypto=require('node:crypto');
const base=__dirname,canon='C:/Users/liama/Desktop/Nichos/recuperacion-tecnica',archivo='C:/Users/liama/Desktop/Nichos-hub/docs/recuperacion-tecnica/N03';
const sha=b=>crypto.createHash('sha256').update(b).digest('hex');
const escribir=(ruta,bytes)=>{fs.mkdirSync(p.dirname(ruta),{recursive:true});fs.writeFileSync(ruta,bytes,{flag:'wx'});};
const json=r=>JSON.parse(fs.readFileSync(p.join(base,r),'utf8').replace(/^\uFEFF/,''));
if(json('VALIDACION-COMPLETA.json').result!=='GREEN')throw Error('Contrato no GREEN');
const custodia=[];
const resumen='**W-NEXT: preparación comparativa GREEN local4/4; implementación pendiente y NO ejecutada.** Next/NextAuth/auth.config reales:middleware y proxy conservan129 resultados HTTP;mutación de proxy rompe exactamente14 rechazos,registro/matcher y demás resultados intactos. Recomendar únicamente renombrado futuro con bytes idénticos,tras autorización específica. Copia mínima/Linux/webpack,no OAuth real/app completa/deploy. N03 sigue en curso;entregas aceptadas y obligaciones restantes intactas. Consumo80%/techo85% TOTAL,sin resets. Esta adenda sustituye el pendiente de comparación de los cortes inferiores, no autoriza migración.';
const actualizaciones=[
 ['informe/N03/W-NEXT-v1/INFORME.md','comparacion-local/INFORME-COMPARATIVO.md'],
 ['informe/N03/W-NEXT-v1/PROPUESTA.md','comparacion-local/INFORME-COMPARATIVO.md'],
 ['informe/N03/cierre-sesion-v1/RETOMA.md','../W-NEXT-v1/comparacion-local/INFORME-COMPARATIVO.md'],
 ['informe/N03/reconciliacion-v1/BALANCE.md','../W-NEXT-v1/comparacion-local/INFORME-COMPARATIVO.md'],
 ['indice/tareas/N03.md','../../informe/N03/W-NEXT-v1/comparacion-local/INFORME-COMPARATIVO.md'],
 ['indice/README.md','../informe/N03/W-NEXT-v1/comparacion-local/INFORME-COMPARATIVO.md'],
 ['indice/CALENDARIO.md','../informe/N03/W-NEXT-v1/comparacion-local/INFORME-COMPARATIVO.md']
];
for(const [rel,enlace] of actualizaciones){
 const origen=p.join(canon,rel),antes=fs.readFileSync(origen);escribir(p.join(base,'preimagenes-registros/canon',rel),antes);
 const texto=antes.toString('utf8'),corte=texto.indexOf('\n');
 const despues=Buffer.from(texto.slice(0,corte+1)+'\n'+resumen+' [Resultado,evidencia y límites]('+enlace+').\n'+texto.slice(corte+1));
 fs.writeFileSync(origen,despues);custodia.push({origen,preimagen:p.join(base,'preimagenes-registros/canon',rel),antes:sha(antes),despues:sha(despues)});
 const destino=p.join(archivo,rel);
 if(fs.existsSync(destino)){const previo=fs.readFileSync(destino);escribir(p.join(base,'preimagenes-registros/archivo',rel),previo);custodia.push({origen:destino,preimagen:p.join(base,'preimagenes-registros/archivo',rel),antes:sha(previo),despues:sha(despues)});fs.writeFileSync(destino,despues);}else escribir(destino,despues);
}
const historial='historial/2026-09-09-N03-W-NEXT-comparacion-local.md';
const textoHistorial='# N03 — W-NEXT comparación local, sin migración\n\n'+resumen+'\n\n[Acta comparativa](../informe/N03/W-NEXT-v1/comparacion-local/INFORME-COMPARATIVO.md). Prometido y hecho:comparación real en aislamiento,referencia,proxy,matcher,ejecución,accesos/rechazos,mutación,custodia y recomendación. Dos expectativas del arnés corregidas en una ronda con evidencia/preimágenes;referencia129/129,proxy129/129,mutante14fallos semánticos. Ningún producto modificado;sin instalaciones,credenciales reales,red externa,push/deploy o resets. Diferido:implementación del renombrado hasta orden explícita;resto de N03 permanece adjudicado. Detener después de esta entrega.\n';
escribir(p.join(canon,historial),textoHistorial);escribir(p.join(archivo,historial),textoHistorial);
escribir(p.join(base,'CUSTODIA-REGISTROS.json'),JSON.stringify(custodia,null,2));
escribir(p.join(base,'GATES-FINAL.json'),JSON.stringify({result:'GREEN',alcance:'preparación comparativa W-NEXT',alcanzados:4,total:4,implementacionProducto:false,N03:'en_curso',proximo:'Decisión de Liam sobre implementar renombrado único',consumo:80,techoTotal:85,resets:0},null,2));
const caminar=(dir)=>fs.readdirSync(dir,{withFileTypes:true}).flatMap(x=>{const ruta=p.join(dir,x.name);if(x.isSymbolicLink()||x.name==='node_modules'||x.name==='cache')return [];return x.isDirectory()?caminar(ruta):[ruta];});
const fisicos=caminar(base).map(ruta=>{const b=fs.readFileSync(ruta);return {ruta,bytes:b.length,sha256:sha(b)};});
escribir(p.join(base,'EVIDENCIA-FISICA.json'),JSON.stringify({fecha:new Date().toISOString(),excluidos:['node_modules montado readonly','cachés .next/cache','el propio manifiesto para evitar autorreferencia'],archivos:fisicos},null,2));
const mapa=[];
for(const ruta of caminar(base)){
 const rel=p.relative(base,ruta).replaceAll('\\','/');if(rel.startsWith('copias/'))continue;
 const sufijo=/\.(?:cjs|mjs|js|ts|tsx|ps1)$/.test(rel)?'.source':'';
 const destino=p.join(archivo,'informe/N03/W-NEXT-v1/comparacion-local',rel+sufijo),b=fs.readFileSync(ruta);escribir(destino,b);mapa.push({origen:ruta,destino,bytes:b.length,sha256:sha(b)});
}
const mapaArchivo=JSON.stringify({nota:'Copias y .next permanecen físicamente en canon; rutas y SHA256 en EVIDENCIA-FISICA. Código archivado con .source.',archivos:mapa},null,2);
escribir(p.join(base,'ARCHIVO-COMPARACION.json'),mapaArchivo);escribir(p.join(archivo,'informe/N03/W-NEXT-v1/comparacion-local/ARCHIVO-COMPARACION.json'),mapaArchivo);
for(const f of mapa)if(sha(fs.readFileSync(f.destino))!==f.sha256)throw Error('Copia difiere '+f.destino);
console.log(JSON.stringify({registros:custodia.length,archivosFisicos:fisicos.length,archivados:mapa.length,productoEditado:false}));
