const caminar=dir=>fs.readdirSync(dir,{withFileTypes:true}).flatMap(x=>{const ruta=p.join(dir,x.name);if(x.isSymbolicLink()||['node_modules','cache'].includes(x.name))return [];return x.isDirectory()?caminar(ruta):[ruta];});
const fisicos=caminar(base).map(ruta=>{const b=fs.readFileSync(ruta);return {ruta,bytes:b.length,sha256:sha(b)};});
escribir(p.join(base,'EVIDENCIA-FISICA.json'),JSON.stringify({fecha:new Date().toISOString(),excluidos:['node_modules montado readonly','cachés .next/cache','manifiesto propio e índices posteriores'],archivos:fisicos},null,2));
const mapa=[];for(const ruta of caminar(base)){const rel=p.relative(base,ruta).replaceAll('\\','/');if(rel.startsWith('copias/'))continue;const destino=p.join(archivo,'informe/N03/W-NEXT-v1/implementacion-local',rel+(/\.(cjs|mjs|js|ts|tsx|ps1)$/.test(rel)?'.source':'')),b=fs.readFileSync(ruta);escribir(destino,b);mapa.push({origen:ruta,destino,bytes:b.length,sha256:sha(b)});}
const indice=JSON.stringify({nota:'Copias y.next retenidos físicamente en canon;code.source evita descubrimiento por compilador.',archivos:mapa},null,2);escribir(p.join(base,'ARCHIVO-IMPLEMENTACION.json'),indice);escribir(p.join(archivo,'informe/N03/W-NEXT-v1/implementacion-local/ARCHIVO-IMPLEMENTACION.json'),indice);
