const actualizaciones=[['informe/N03/W-NEXT-v1/INFORME.md','implementacion-local/CIERRE-LOCAL.md'],['informe/N03/W-NEXT-v1/PROPUESTA.md','implementacion-local/CIERRE-LOCAL.md'],['informe/N03/cierre-sesion-v1/RETOMA.md','../W-NEXT-v1/implementacion-local/CIERRE-LOCAL.md'],['informe/N03/reconciliacion-v1/BALANCE.md','../W-NEXT-v1/implementacion-local/CIERRE-LOCAL.md'],['indice/tareas/N03.md','../../informe/N03/W-NEXT-v1/implementacion-local/CIERRE-LOCAL.md'],['indice/README.md','../informe/N03/W-NEXT-v1/implementacion-local/CIERRE-LOCAL.md'],['indice/CALENDARIO.md','../informe/N03/W-NEXT-v1/implementacion-local/CIERRE-LOCAL.md']];
