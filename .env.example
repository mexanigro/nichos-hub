# Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Onboarding tokens (optional) — secret para firmar los JWT de /onboarding/info.
# Si no se setea, cae a AUTH_SECRET (y luego NEXTAUTH_SECRET como legacy).
# Recomendado: usar un valor DISTINTO de AUTH_SECRET para aislar dominios de firma.
# ONBOARDING_TOKEN_SECRET=

# Owner
OWNER_EMAIL=your-email@gmail.com

# Firebase (Admin SDK)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Client SDK (public keys — user auth on landing)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# PostgreSQL (Railway - monitor-agent)
DATABASE_URL=

# Anthropic (message classification + content generation + logo SVG)
ANTHROPIC_API_KEY=

# Vercel (deploy + kill switch — pause/unpause client projects)
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Vercel template repo (optional, default: mexanigro/Barber-shop-template)
# VERCEL_TEMPLATE_REPO=

# Deploy (secret compartido hub ↔ deploy endpoint interno)
DEPLOY_SECRET=

# Cardcom (pagos)
CARDCOM_TERMINAL=
CARDCOM_API_NAME=
# Sandbox mode: terminal 1000, user CardTest1994. Test card: 4580280000000008 CVV 123
# Under 5000 NIS = success, over 5000 = failure
CARDCOM_SANDBOX=false

# Google Calendar OAuth (WhatsApp tab)
GOOGLE_REDIRECT_URI=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron secret — protege /api/cron/cardcom-charges
# 1. Generar un UUID aleatorio y ponerlo aqui y en Railway env vars
# 2. En cron-job.org configurar header: Authorization: Bearer <valor>
CRON_SECRET=

# WhatsApp agent (optional — URL del agente whatsapp-agentkit)
# WHATSAPP_AGENT_URL=
AGENT_API_SECRET=

# Twilio (envío de templates de WhatsApp desde el tab WhatsApp + costos)
# Usados en src/app/api/whatsapp-config/[clientId]/send-template/route.ts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Email transaccional (src/lib/email.ts)
# EMAIL_PROVIDER: "disabled" (no-op) | "log" (default — stdout, sin infra) | "resend" (envío real)
# Para activar envío real: EMAIL_PROVIDER=resend + RESEND_API_KEY.
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Liam de Arzac Studio <hola@arzac.studio>
EMAIL_REPLY_TO=website@arzac.studio

# Email propagado a los deploys Vercel de clientes (src/lib/deploy.ts → master-template)
# EMAIL_PROVIDER_API_KEY cae a RESEND_API_KEY si no se setea.
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM_ADDRESS=noreply@arzac.studio

# Firebase multi-database (optional, default: "default")
# FIREBASE_DATABASE_ID=

# VITE_FIREBASE_* — propagated to client Vercel deploys
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Landing page WhatsApp widget (Israeli format, no +)
# Must also be set in Railway env vars for production
NEXT_PUBLIC_WHATSAPP_NUMBER=972557719141
