#!/bin/sh
# pre-commit · verde exigido: tsc + lo que el commit puede romper (VELOCIDAD-01: npm test, test:verdad si toca tools/ o .githooks/,
# y las órdenes vivas; la batería entera la corren la sesión que cierra la orden y la verificadora). Un hook que falla para el commit.
set -e
cd "$(git rev-parse --show-toplevel)"
echo "[pre-commit] npx tsc --noEmit"
npx tsc --noEmit
echo "[pre-commit] npm run test:commit"
npm run test:commit --silent
