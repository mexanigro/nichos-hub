#!/bin/sh
# pre-commit · verde exigido: tsc + suites. Un hook que falla para el commit.
# VERDAD-01 (2026-09-20): + impacto (en H sólo lista lo staged: el grafo de secciones es de T)
#                          + veredicto --commit (afirmaciones de H impactadas, con mutación rojo→verde; motor en T por ruta fija).
set -e
cd "$(git rev-parse --show-toplevel)"
echo "[pre-commit] npx tsc --noEmit"
npx tsc --noEmit
echo "[pre-commit] npm test"
npm test --silent
echo "[pre-commit] veredicto --commit (impacto: lo staged de H)"
node tools/verdad/veredicto.mjs --commit > /dev/null
